<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind (misma config que el ejemplo que SÍ quieres) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary:   { DEFAULT:'#667eea', 600:'#667eea', 700:'#5a67d8' },
            secondary: { DEFAULT:'#764ba2', 600:'#764ba2', 700:'#6b3fa0' },
          },
          boxShadow: {
            soft:'0 4px 6px -1px rgba(0,0,0,.08), 0 2px 4px -1px rgba(0,0,0,.04)',
            card:'0 10px 30px -5px rgba(0,0,0,.10)'
          }
        }
      },
      darkMode:'media'
    }
  </script>


  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    .gradient-text {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .icon { width: 1.25rem; height: 1.25rem; }
    .icon-lg { width: 1.75rem; height: 1.75rem; }

    .hidden-card { display:none; }
  </style>
</head>
<body class="h-full bg-gradient-to-br from-slate-50 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 text-slate-800 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-4 focus:py-2 focus:rounded-lg shadow-lg">
    Saltar al contenido
  </a>

  <%
    const templatesList = Array.isArray(templates) ? templates : [];
    function safeVars(v){
      try {
        if (!v) return [];
        return Array.isArray(v) ? v : JSON.parse(v);
      } catch { return []; }
    }
  %>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Volver al Dashboard + breadcrumb -->
    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <a href="/"
           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">
          <i data-lucide="arrow-left" class="icon"></i>
          <span>Volver al Dashboard</span>
        </a>
      </div>

      <nav aria-label="Breadcrumb" class="text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li class="inline-flex items-center gap-1">
            <a href="/" class="hover:underline inline-flex items-center gap-1">
              <i data-lucide="home" class="w-3.5 h-3.5"></i> Inicio
            </a>
          </li>
          <li class="select-none">/</li>
          <li class="inline-flex items-center gap-1">
            <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
            <span class="font-medium">Plantillas</span>
          </li>
        </ol>
      </nav>
    </div>

    <!-- Header (igual estilo que el ejemplo) -->
    <header class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight gradient-text flex items-center gap-3">
            <i data-lucide="file-text" class="icon-lg text-primary"></i>
            Plantillas de Mensajes
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            Gestión de respuestas rápidas para WhatsApp
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft transition"
            onclick="openTemplateModal()">
            <i data-lucide="plus-circle" class="icon"></i>
            <span>Nueva Plantilla</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Sección de búsqueda / filtros (como el ejemplo) -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center">
            <i data-lucide="search" class="icon text-indigo-600 dark:text-indigo-400"></i>
          </div>
          Buscar plantillas
        </h2>
      </div>

      <div class="p-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:flex-wrap">
        <div class="flex-1">
          <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
            Buscar por nombre, categoría o contenido
          </label>
          <input
            type="text"
            id="searchInput"
            oninput="filterTemplates()"
            placeholder="🔍 bienvenida, seguimiento, soporte, ventas..."
            class="w-full rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0 transition"
          />
        </div>

        <div class="flex items-center gap-2 text-[13px] text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2">
          <input id="prettyFormatToggle" type="checkbox" class="accent-indigo-600">
          <label for="prettyFormatToggle" class="cursor-pointer select-none flex items-center gap-1">
            <i data-lucide="align-left" class="w-4 h-4"></i>
            <span>Dar formato al texto</span>
          </label>
        </div>

        <div class="text-sm text-slate-500 dark:text-slate-400">
          Mostrando:
          <span id="countVisible" class="font-semibold text-slate-700 dark:text-slate-200"><%= templatesList.length %></span>
          / <%= templatesList.length %> plantillas
        </div>
      </div>
    </section>

    <!-- Lista de plantillas (igual estructura de tarjeta que el ejemplo) -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center">
            <i data-lucide="list" class="icon text-blue-600 dark:text-blue-400"></i>
          </div>
          Plantillas disponibles
        </h2>
      </div>

      <div class="p-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4" id="templatesList">
        <% if (templatesList.length > 0) { %>
          <% templatesList.forEach(t => { const vars = safeVars(t.variables); %>
            <div
              class="template-card group relative rounded-xl border shadow-card p-5 bg-white dark:bg-slate-900
                     transition hover:shadow-lg hover:border-indigo-400/60 hover:bg-slate-50/60 dark:hover:bg-white/5
                     border-slate-200/70 dark:border-slate-700/70"
              data-name="<%= (t.name||'').toLowerCase() %>"
              data-cat ="<%= (t.category||'').toLowerCase() %>">

              <!-- Título + estado -->
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <div class="text-base font-semibold text-slate-900 dark:text-white flex-1 truncate">
                  <%= t.name %>
                </div>
                <span class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-[11px] font-semibold uppercase tracking-wide
                             <%= t.isActive
                                  ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300'
                                  : 'bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300' %>">
                  <i data-lucide="<%= t.isActive ? 'check' : 'x' %>" class="w-3.5 h-3.5"></i>
                  <%= t.isActive ? 'Activo' : 'Inactivo' %>
                </span>
              </div>

              <!-- Categoría -->
              <div class="text-[13px] text-slate-500 dark:text-slate-400 font-medium mb-3 flex items-center gap-1">
                <i data-lucide="folder" class="w-4 h-4 text-primary"></i>
                <span><%= t.category || 'general' %></span>
              </div>

              <!-- Contenido -->
              <div class="bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-lg p-3 text-[13px] leading-relaxed text-slate-700 dark:text-slate-200 font-mono whitespace-pre-wrap max-h-40 overflow-y-auto">
                <%= t.content %>
              </div>

              <!-- Variables -->
              <div class="flex flex-wrap gap-1.5 mt-4 min-h-[28px]">
                <% if (vars && vars.length) { %>
                  <% vars.slice(0,3).forEach(v => { %>
                    <span class="inline-flex items-center rounded-md bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                      {{<%- v %>}}
                    </span>
                  <% }) %>
                  <% if (vars.length > 3) { %>
                    <span class="inline-flex items-center rounded-md bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                      +<%= vars.length - 3 %>
                    </span>
                  <% } %>
                <% } else { %>
                  <span class="text-[12px] text-slate-400 italic">Sin variables</span>
                <% } %>
              </div>

              <!-- Acciones -->
              <div class="flex flex-wrap gap-2 mt-4">
                <button
                  class="inline-flex items-center gap-1 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 px-2.5 py-1.5 text-xs font-medium transition"
                  onclick="copyContent(`<%- (t.content||'').replace(/`/g,'\\`') %>`)">
                  <i data-lucide="clipboard-copy" class="w-3.5 h-3.5"></i>
                  Copiar
                </button>

                <button
                  class="inline-flex items-center gap-1 rounded-lg bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                  onclick="editTemplate('<%= t.id %>')">
                  <i data-lucide="edit-2" class="w-3.5 h-3.5"></i>
                  Editar
                </button>

                <button
                  class="inline-flex items-center gap-1 rounded-lg bg-indigo-100 hover:bg-indigo-200 text-indigo-700 dark:bg-indigo-900/30 dark:hover:bg-indigo-900/50 dark:text-indigo-300 px-2.5 py-1.5 text-xs font-medium transition"
                  onclick="duplicateTemplate('<%= t.id %>')">
                  <i data-lucide="copy-plus" class="w-3.5 h-3.5"></i>
                  Duplicar
                </button>

                <button
                  class="inline-flex items-center gap-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                  onclick="askDeleteTemplate('<%= t.id %>')">
                  <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                  Eliminar
                </button>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-span-full py-16 text-center">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
              <i data-lucide="inbox" class="icon-lg text-slate-400"></i>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">No hay plantillas configuradas</p>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Crea una nueva para comenzar</p>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <!-- Modal Crear/Editar -->
  <div id="templateModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-2xl w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between sticky top-0 bg-white dark:bg-slate-900 z-10">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="file-text" class="icon text-primary"></i>
          <span id="modalTitle">Nueva Plantilla</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="closeTemplateModal()">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6 space-y-4">
        <input type="hidden" id="templateId" />

        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <label class="block text-sm font-semibold mb-2">Nombre *</label>
            <input id="templateName" type="text" required class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2">Categoría *</label>
            <input id="templateCategory" type="text" required class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold mb-2 flex items-center justify-between gap-2">
            Contenido *
            <span class="text-[11px] text-slate-400">
              Vars: <span id="varsDetected">0</span> · Chars: <span id="charCount">0</span>
            </span>
          </label>
          <textarea id="templateContent" rows="6" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 font-mono" oninput="updatePreview();updateCounter();detectVariables();"></textarea>
        </div>

        <div>
          <label class="block text-sm font-semibold mb-2">Estado</label>
          <select id="templateActive" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500">
            <option value="true">Activo</option>
            <option value="false">Inactivo</option>
          </select>
        </div>

        <div>
          <p class="text-sm font-semibold mb-2 flex items-center gap-2">
            <i data-lucide="eye" class="w-4 h-4 text-indigo-500"></i>
            Vista previa
          </p>
          <div id="templatePreview" class="rounded-lg bg-slate-100 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 p-3 text-sm text-slate-800 dark:text-slate-100">
            Escribe contenido arriba para ver la vista previa...
          </div>
        </div>
      </div>

      <div class="p-6 flex justify-end gap-2 border-t border-slate-200 dark:border-slate-700">
        <button
          class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition"
          onclick="closeTemplateModal()">
          Cancelar
        </button>

        <button
          class="rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition"
          onclick="submitTemplateForm()">
          Guardar
        </button>
      </div>
    </div>
  </div>

  <!-- Modal Confirmación -->
  <div id="confirmModal" class="hidden fixed inset-0 z-[60] items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-md w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="alert-triangle" class="icon text-rose-600"></i>
          <span>¿Confirmar?</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="closeConfirmModal()">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6">
        <div id="confirmText" class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Esta acción no se puede deshacer.
        </div>

        <div class="mt-6 flex justify-end gap-2 pt-2 border-t border-slate-200 dark:border-slate-700">
          <button
            class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition"
            onclick="closeConfirmModal()">
            Cancelar
          </button>
          <button
            id="confirmOkBtn"
            class="rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition">
            Aceptar
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Iconos
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
    });

    // FILTRO
    function filterTemplates(){
      const q = (document.getElementById('searchInput').value || '').toLowerCase().trim();
      const cards = document.querySelectorAll('#templatesList .template-card');
      let visible = 0;
      cards.forEach(card => {
        const name = card.dataset.name || '';
        const cat  = card.dataset.cat || '';
        const content = (card.innerText || '').toLowerCase();
        const hit = !q || name.includes(q) || cat.includes(q) || content.includes(q);
        card.classList.toggle('hidden-card', !hit);
        if (hit) visible++;
      });
      const countEl = document.getElementById('countVisible');
      if (countEl) countEl.textContent = visible;
    }

    // MODALES
    function openTemplateModal(){
      const el = document.getElementById('templateModal');
      el.classList.remove('hidden');
      el.classList.add('flex');
      // reset básico
      document.getElementById('modalTitle').textContent = 'Nueva Plantilla';
      document.getElementById('templateId').value = '';
      document.getElementById('templateName').value = '';
      document.getElementById('templateCategory').value = '';
      document.getElementById('templateContent').value = '';
      document.getElementById('templateActive').value = 'true';
      document.getElementById('templatePreview').textContent = 'Escribe contenido arriba para ver la vista previa...';
      document.getElementById('varsDetected').textContent = '0';
      document.getElementById('charCount').textContent = '0';
    }

    function closeTemplateModal(){
      const el = document.getElementById('templateModal');
      el.classList.remove('flex');
      el.classList.add('hidden');
    }

    function openConfirmModal(){
      const el = document.getElementById('confirmModal');
      el.classList.remove('hidden');
      el.classList.add('flex');
    }

    function closeConfirmModal(){
      const el = document.getElementById('confirmModal');
      el.classList.remove('flex');
      el.classList.add('hidden');
    }

    window.addEventListener('click', (e) => {
      const tm = document.getElementById('templateModal');
      const cm = document.getElementById('confirmModal');
      if (e.target === tm) closeTemplateModal();
      if (e.target === cm) closeConfirmModal();
    });

    // CRUD
    function copyContent(text){ navigator.clipboard.writeText(text||''); }

    async function editTemplate(id){
      try {
        const res = await fetch(`/templates/api/${id}`);
        const t = await res.json();

        document.getElementById('modalTitle').textContent = 'Editar Plantilla';
        document.getElementById('templateId').value = t.id || '';
        document.getElementById('templateName').value = t.name || '';
        document.getElementById('templateCategory').value = t.category || '';
        document.getElementById('templateContent').value = t.content || '';
        document.getElementById('templateActive').value = t.isActive ? 'true' : 'false';

        updatePreview();
        updateCounter();
        detectVariables();

        const el = document.getElementById('templateModal');
        el.classList.remove('hidden');
        el.classList.add('flex');
      } catch (err) {
        alert('Error cargando plantilla');
        console.error(err);
      }
    }

    async function duplicateTemplate(id){
      try {
        const res = await fetch(`/templates/api/${id}`);
        const t = await res.json();

        const data = {
          name: (t.name || 'Plantilla') + ' (copia)',
          category: t.category || 'general',
          content: t.content || '',
          isActive: !!t.isActive
        };

        const create = await fetch('/templates/api', {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify(data)
        });

        if (create.ok) {
          location.reload();
        } else {
          alert('No se pudo duplicar');
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    async function submitTemplateForm(){
      const id = document.getElementById('templateId').value;
      const data = {
        name:     document.getElementById('templateName').value,
        category: document.getElementById('templateCategory').value,
        content:  document.getElementById('templateContent').value,
        isActive: document.getElementById('templateActive').value === 'true'
      };

      if (!data.name || !data.category || !data.content){
        alert('Completa nombre, categoría y contenido');
        return;
      }

      const url = id ? `/templates/api/${id}` : '/templates/api';
      const method = id ? 'PUT' : 'POST';

      try {
        const res = await fetch(url, {
          method,
          headers:{ 'Content-Type':'application/json' },
          body: JSON.stringify(data)
        });

        if (res.ok) {
          location.reload();
        } else {
          alert('No se pudo guardar la plantilla');
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    function askDeleteTemplate(id){
      document.getElementById('confirmText').textContent = '¿Eliminar esta plantilla? Esta acción no se puede deshacer.';
      const okBtn = document.getElementById('confirmOkBtn');
      okBtn.onclick = async () => {
        try {
          const res = await fetch(`/templates/api/${id}`, { method:'DELETE' });
          if (res.ok) {
            location.reload();
          } else {
            alert('No se pudo eliminar la plantilla');
          }
        } catch (err) {
          alert('Error: ' + err.message);
        }
      };
      openConfirmModal();
    }

    // PREVIEW / CONTADOR / VARS
    function updatePreview(){
      const content = document.getElementById('templateContent').value;
      const preview = document.getElementById('templatePreview');

      const previewContent = content
        .replace(/{{\s*nombre\s*}}/gi,  '<span class="inline-flex items-center rounded bg-amber-100 text-amber-800 px-1 py-0.5 text-[12px] font-mono font-semibold">Juan Pérez</span>')
        .replace(/{{\s*empresa\s*}}/gi, '<span class="inline-flex items-center rounded bg-amber-100 text-amber-800 px-1 py-0.5 text-[12px] font-mono font-semibold">Mi Empresa SAC</span>')
        .replace(/{{\s*telefono\s*}}/gi,'<span class="inline-flex items-center rounded bg-amber-100 text-amber-800 px-1 py-0.5 text-[12px] font-mono font-semibold">51999888777</span>')
        .replace(/{{\s*dni\s*}}/gi,     '<span class="inline-flex items-center rounded bg-amber-100 text-amber-800 px-1 py-0.5 text-[12px] font-mono font-semibold">12345678</span>')
        .replace(/{{\s*ruc\s*}}/gi,     '<span class="inline-flex items-center rounded bg-amber-100 text-amber-800 px-1 py-0.5 text-[12px] font-mono font-semibold">20123456789</span>');

      preview.innerHTML = previewContent || 'Escribe contenido arriba para ver la vista previa...';
    }

    function updateCounter(){
      const n = document.getElementById('templateContent').value.length;
      document.getElementById('charCount').textContent = n;
    }

    function detectVariables(){
      const txt = document.getElementById('templateContent').value;
      const vars = Array.from(new Set(
        (txt.match(/{{\s*[\w.-]+\s*}}/g)||[]).map(v=>v.replace(/\s+/g,''))
      ));
      document.getElementById('varsDetected').textContent = vars.length;
    }

    // guardar con ctrl+s dentro del modal
    window.addEventListener('keydown',(e)=>{
      const isMac = navigator.platform.toUpperCase().includes('MAC');
      const saveCombo = (isMac && e.metaKey && e.key.toLowerCase()==='s')
                     || (!isMac && e.ctrlKey && e.key.toLowerCase()==='s');

      if (saveCombo) {
        const modalOpen = !document.getElementById('templateModal').classList.contains('hidden');
        if (modalOpen) {
          e.preventDefault();
          submitTemplateForm();
        }
      }
    });
  </script>
</body>
</html>
