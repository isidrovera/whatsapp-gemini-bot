<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind (misma config del dashboard) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary:   { DEFAULT:'#667eea', 600:'#667eea', 700:'#5a67d8' },
            secondary: { DEFAULT:'#764ba2', 600:'#764ba2', 700:'#6b3fa0' },
          },
          boxShadow: {
            soft:'0 4px 6px -1px rgba(0,0,0,.08), 0 2px 4px -1px rgba(0,0,0,.04)',
            card:'0 10px 30px -5px rgba(0,0,0,.10)'
          }
        }
      },
      darkMode:'media'
    }
  </script>

  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Gradient text */
    .gradient-text {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Icon sizes */
    .icon { width: 1.25rem; height: 1.25rem; }
    .icon-lg { width: 1.75rem; height: 1.75rem; }
  </style>
</head>

<body class="h-full bg-gradient-to-br from-slate-50 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 text-slate-800 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-4 focus:py-2 focus:rounded-lg shadow-lg">
    Saltar al contenido
  </a>

  <%
    const list = Array.isArray(contacts) ? contacts : [];

    function stateBadgeClasses(state){
      if(state === 'REGISTERED') return 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300';
      if(state === 'WAITING_DNI' || state === 'WAITING_RUC') return 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300';
      return 'bg-sky-100 text-sky-700 dark:bg-sky-900/30 dark:text-sky-300';
    }

    function stateLabel(state){
      if(state === 'REGISTERED') return '✓ Registrado';
      if(state === 'WAITING_DNI') return '⏳ Esperando DNI';
      if(state === 'WAITING_RUC') return '⏳ Esperando RUC';
      return '🆕 Nuevo';
    }
  %>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Volver al Dashboard + breadcrumb -->
    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <a href="/"
           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">
          <i data-lucide="arrow-left" class="icon"></i>
          <span>Volver al Dashboard</span>
        </a>
      </div>

      <nav aria-label="Breadcrumb" class="text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li class="inline-flex items-center gap-1">
            <a href="/" class="hover:underline inline-flex items-center gap-1">
              <i data-lucide="home" class="w-3.5 h-3.5"></i> Inicio
            </a>
          </li>
          <li class="select-none">/</li>
          <li class="inline-flex items-center gap-1">
            <i data-lucide="users" class="w-3.5 h-3.5"></i>
            <span class="font-medium">Contactos</span>
          </li>
        </ol>
      </nav>
    </div>

    <!-- Header -->
    <header class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight gradient-text flex items-center gap-3">
            <i data-lucide="users" class="icon-lg text-primary"></i>
            Contactos
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Gestión de contactos y empresas asociadas</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            class="inline-flex items-center gap-2 rounded-xl bg-slate-600 hover:bg-slate-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft transition"
            onclick="exportExcel()">
            <i data-lucide="download" class="icon"></i>
            <span>Exportar</span>
          </button>

          <label class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft transition cursor-pointer">
            <i data-lucide="upload" class="icon"></i>
            <span>Importar Excel</span>
            <input
              id="importFileInput"
              type="file"
              accept=".xlsx,.xls"
              class="hidden"
              onchange="importExcelFile(this)"
            />
          </label>

          <button
            class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft transition"
            onclick="openCreateContact()">
            <i data-lucide="plus-circle" class="icon"></i>
            <span>Nuevo Contacto</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Buscador + Info de paginación -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <div class="flex items-center justify-between flex-wrap gap-4">
          <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
            <div class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center">
              <i data-lucide="search" class="icon text-indigo-600 dark:text-indigo-400"></i>
            </div>
            Buscar Contactos
          </h2>

          <!-- Info de paginación -->
          <div class="flex items-center gap-4 text-sm">
            <span class="text-slate-600 dark:text-slate-400">
              Mostrando <span id="showingFrom" class="font-semibold">0</span>-<span id="showingTo" class="font-semibold">0</span> de <span id="totalRecords" class="font-semibold">0</span>
            </span>

            <select id="rowsPerPageSelect" 
                    class="rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs outline-none focus:border-indigo-500 transition cursor-pointer"
                    onchange="changeRowsPerPage()">
              <option value="10">10 por página</option>
              <option value="25" selected>25 por página</option>
              <option value="50">50 por página</option>
              <option value="100">100 por página</option>
            </select>
          </div>
        </div>
      </div>

      <div class="p-6">
        <input
          id="searchInput"
          type="text"
          class="w-full rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 transition"
          placeholder="🔍 Buscar por teléfono, nombre o empresa..."
          onkeyup="filterTable()"
        />
      </div>
    </section>

    <!-- Tabla de Contactos -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center">
            <i data-lucide="list" class="icon text-blue-600 dark:text-blue-400"></i>
          </div>
          Lista de Contactos
        </h2>
      </div>

      <% if (list.length > 0) { %>
        <div class="overflow-x-auto">
          <table id="contactsTable" class="min-w-full text-sm">
            <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-400 uppercase text-xs tracking-wider font-semibold">
              <tr>
                <th class="text-left px-6 py-4">Teléfono</th>
                <th class="text-left px-6 py-4">Nombre</th>
                <th class="text-left px-6 py-4">DNI</th>
                <th class="text-left px-6 py-4">Empresa</th>
                <th class="text-left px-6 py-4">Estado</th>
                <th class="text-left px-6 py-4">Acciones</th>
              </tr>
            </thead>
            <tbody id="tableBody" class="divide-y divide-slate-100 dark:divide-slate-800">
              <% list.forEach(contact => { %>
                <tr class="contact-row hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors" 
                    data-phone="<%= contact.phoneNumber %>"
                    data-search="<%= (contact.phoneNumber + ' ' + (contact.name || '') + ' ' + (contact.dni || '') + ' ' + (contact.companyName || '')).toLowerCase() %>">
                  <td class="px-6 py-4 font-semibold text-slate-900 dark:text-white whitespace-nowrap">
                    <%= contact.phoneNumber %>
                  </td>
                  <td class="px-6 py-4 text-slate-700 dark:text-slate-300">
                    <%= contact.name || '-' %>
                  </td>
                  <td class="px-6 py-4 text-slate-700 dark:text-slate-300">
                    <%= contact.dni || '-' %>
                  </td>
                  <td class="px-6 py-4 text-slate-700 dark:text-slate-300">
                    <%= contact.companyName || '-' %>
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex flex-wrap gap-1">
                      <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-semibold leading-none <%= stateBadgeClasses(contact.state) %>">
                        <%= stateLabel(contact.state) %>
                      </span>

                      <% if (contact.humanTakeoverAt) { %>
                        <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-semibold leading-none bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300">
                          🙋 Humano
                        </span>
                      <% } %>

                      <% if (contact.isBlocked) { %>
                        <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-semibold leading-none bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300">
                          🚫 Bloqueado
                        </span>
                      <% } %>
                    </div>
                  </td>

                  <td class="px-6 py-4">
                    <div class="flex flex-wrap gap-2">
                      <!-- Ver -->
                      <button
                        class="inline-flex items-center gap-1 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                        onclick="viewContact('<%= contact.phoneNumber %>')">
                        <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                        <span>Ver</span>
                      </button>

                      <!-- Editar -->
                      <button
                        class="inline-flex items-center gap-1 rounded-lg bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                        onclick="openEditContact('<%= contact.id %>')">
                        <i data-lucide="edit-2" class="w-3.5 h-3.5"></i>
                        <span>Editar</span>
                      </button>

                      <!-- Empresas -->
                      <button
                        class="inline-flex items-center gap-1 rounded-lg bg-purple-600 hover:bg-purple-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                        onclick="openCompanies('<%= contact.id %>')">
                        <i data-lucide="building-2" class="w-3.5 h-3.5"></i>
                        <span>Empresas</span>
                      </button>

                      <!-- takeover / release -->
                      <% if (!contact.humanTakeoverAt) { %>
                        <button
                          class="inline-flex items-center gap-1 rounded-lg bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                          onclick="takeover('<%= contact.phoneNumber %>')">
                          <i data-lucide="hand" class="w-3.5 h-3.5"></i>
                          <span>Tomar</span>
                        </button>
                      <% } else { %>
                        <button
                          class="inline-flex items-center gap-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                          onclick="release('<%= contact.phoneNumber %>')">
                          <i data-lucide="check" class="w-3.5 h-3.5"></i>
                          <span>Liberar</span>
                        </button>
                      <% } %>

                      <!-- bloquear / desbloquear -->
                      <% if (!contact.isBlocked) { %>
                        <button
                          class="inline-flex items-center gap-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                          onclick="blockContact('<%= contact.phoneNumber %>')">
                          <i data-lucide="ban" class="w-3.5 h-3.5"></i>
                          <span>Bloquear</span>
                        </button>
                      <% } else { %>
                        <button
                          class="inline-flex items-center gap-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                          onclick="unblockContact('<%= contact.phoneNumber %>')">
                          <i data-lucide="unlock" class="w-3.5 h-3.5"></i>
                          <span>Desbloquear</span>
                        </button>
                      <% } %>

                      <!-- Eliminar -->
                      <button
                        class="inline-flex items-center gap-1 rounded-lg bg-red-600 hover:bg-red-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                        onclick="deleteContact('<%= contact.id %>')">
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        <span>Eliminar</span>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Controles de paginación -->
        <div class="px-6 py-4 border-t border-slate-100 dark:border-white/5 bg-slate-50/50 dark:bg-slate-800/30">
          <div class="flex items-center justify-between flex-wrap gap-4">
            <div class="text-sm text-slate-600 dark:text-slate-400">
              Página <span id="currentPageDisplay" class="font-semibold">1</span> de <span id="totalPagesDisplay" class="font-semibold">1</span>
            </div>

            <div class="flex items-center gap-2">
              <button id="btnFirstPage"
                      class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed transition"
                      onclick="goToFirstPage()"
                      title="Primera página">
                <i data-lucide="chevrons-left" class="w-4 h-4"></i>
              </button>

              <button id="btnPrevPage"
                      class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed transition"
                      onclick="prevPage()"
                      title="Página anterior">
                <i data-lucide="chevron-left" class="w-4 h-4"></i>
              </button>

              <div id="pageNumbers" class="flex items-center gap-2">
                <!-- Botones de páginas generados dinámicamente -->
              </div>

              <button id="btnNextPage"
                      class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed transition"
                      onclick="nextPage()"
                      title="Página siguiente">
                <i data-lucide="chevron-right" class="w-4 h-4"></i>
              </button>

              <button id="btnLastPage"
                      class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed transition"
                      onclick="goToLastPage()"
                      title="Última página">
                <i data-lucide="chevrons-right" class="w-4 h-4"></i>
              </button>
            </div>
          </div>
        </div>
      <% } else { %>
        <div class="px-6 py-16 text-center">
          <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="inbox" class="icon-lg text-slate-400"></i>
          </div>
          <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Sin contactos</p>
          <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Los contactos aparecerán aquí cuando hablen con el bot</p>
        </div>
      <% } %>
    </section>
  </main>

  <!-- Modales (sin cambios) -->
  <!-- Modal Ver Contacto -->
  <div id="viewModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-lg w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between sticky top-0 bg-white dark:bg-slate-900 z-10">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="info" class="icon text-primary"></i>
          <span>Información del Contacto</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="hideModal('viewModal')">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6 text-sm leading-6" id="contactDetails">
        <!-- dinámico -->
      </div>
    </div>
  </div>

  <!-- Modal Editar/Crear Contacto -->
  <div id="editModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-lg w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between sticky top-0 bg-white dark:bg-slate-900 z-10">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white" id="editModalTitle">
          <i data-lucide="edit" class="icon text-primary"></i>
          <span>Editar contacto</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="hideModal('editModal')">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6">
        <form id="editContactForm" onsubmit="return submitEditContact()">
          <input type="hidden" id="editContactId" />

          <div class="mb-4">
            <label class="block text-sm font-semibold mb-2">Teléfono</label>
            <input id="editPhoneNumber" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" disabled />
          </div>

          <div class="mb-4">
            <label class="block text-sm font-semibold mb-2">Nombre</label>
            <input id="editName" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" placeholder="Nombre completo" />
          </div>

          <div class="mb-4">
            <label class="block text-sm font-semibold mb-2">DNI</label>
            <input id="editDni" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" placeholder="8 dígitos" maxlength="8" />
          </div>

          <div class="mb-4">
            <label class="block text-sm font-semibold mb-2">Estado</label>
            <select id="editState" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 cursor-pointer">
              <option value="NEW">Nuevo</option>
              <option value="WAITING_DNI">Esperando DNI</option>
              <option value="WAITING_RUC">Esperando RUC</option>
              <option value="REGISTERED">Registrado</option>
            </select>
          </div>

          <div class="mb-4 flex items-center gap-2">
            <input type="checkbox" id="editBlocked" class="rounded border-slate-300 dark:border-slate-600" />
            <label for="editBlocked" class="text-sm font-medium select-none">Bloqueado</label>
          </div>

          <div class="flex justify-end gap-2 pt-2">
            <button
              type="button"
              class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition"
              onclick="hideModal('editModal')">
              Cancelar
            </button>

            <button
              type="submit"
              class="rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition">
              Guardar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal Empresas del contacto -->
  <div id="companiesModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-xl w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between sticky top-0 bg-white dark:bg-slate-900 z-10">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="building-2" class="icon text-primary"></i>
          <span>Empresas del Contacto</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="hideModal('companiesModal')">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6">
        <!-- lista empresas actuales -->
        <div id="companiesList" class="space-y-4 mb-8">
          <!-- dinámico -->
        </div>

        <!-- vincular empresa existente -->
        <div class="mb-8 border border-slate-200 dark:border-white/10 rounded-xl p-4">
          <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-3 flex items-center gap-2">
            <i data-lucide="link" class="w-4 h-4 text-primary"></i>
            <span>Vincular empresa existente</span>
          </h3>

          <div class="mb-4">
            <label class="block text-sm font-semibold mb-2">Empresa</label>
            <select
              id="existingCompanySelect"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 cursor-pointer">
              <option value="">-- Selecciona empresa --</option>
            </select>
          </div>

          <div class="mb-4">
            <label class="block text-sm font-semibold mb-2">Rol / Área (opcional)</label>
            <input
              id="existingCompanyRole"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500"
              placeholder="Compras, Sistemas, etc."
            />
          </div>

          <div class="mb-4 flex items-center gap-2">
            <input type="checkbox" id="existingCompanyPrimary" class="rounded border-slate-300 dark:border-slate-600" />
            <label for="existingCompanyPrimary" class="text-sm font-medium select-none">
              Marcar como principal
            </label>
          </div>

          <button
            class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition"
            type="button"
            onclick="linkExistingCompany()">
            <i data-lucide="link" class="w-4 h-4"></i>
            <span>Vincular seleccionada</span>
          </button>
        </div>

        <!-- agregar nueva empresa -->
        <form id="companyForm" onsubmit="return submitAddCompany()">
          <input type="hidden" id="companiesContactId" />

          <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-3 flex items-center gap-2">
            <i data-lucide="plus-circle" class="w-4 h-4 text-primary"></i>
            <span>Agregar nueva empresa</span>
          </h3>

          <div class="mb-4">
            <label class="block text-sm font-semibold mb-2">RUC</label>
            <input id="companyRuc" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" placeholder="11 dígitos" maxlength="11" required />
          </div>

          <div class="mb-4">
            <label class="block text-sm font-semibold mb-2">Razón Social</label>
            <input id="companyName" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" placeholder="Ej. COPIER COMPANY S.A.C." required />
          </div>

          <div class="mb-4">
            <label class="block text-sm font-semibold mb-2">Rol / Área (opcional)</label>
            <input id="companyRole" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" placeholder="Compras, Sistemas, etc." />
          </div>

          <div class="mb-4 flex items-center gap-2">
            <input type="checkbox" id="companyPrimary" class="rounded border-slate-300 dark:border-slate-600" />
            <label for="companyPrimary" class="text-sm font-medium select-none">Marcar como principal</label>
          </div>

          <div class="flex justify-end gap-2 pt-2 border-t border-slate-200 dark:border-slate-700">
            <button
              type="button"
              class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition"
              onclick="hideModal('companiesModal')">
              Cerrar
            </button>

            <button
              type="submit"
              class="rounded-lg bg-purple-600 hover:bg-purple-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition">
              Agregar empresa
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    // Iconos
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
      initPagination();
    });

    /* ========================================
       SISTEMA DE PAGINACIÓN
       ======================================== */
    let currentPage = 1;
    let rowsPerPage = 25;
    let allRows = [];
    let filteredRows = [];

    function initPagination() {
      allRows = Array.from(document.querySelectorAll('.contact-row'));
      filteredRows = [...allRows];
      updatePagination();
    }

    function updatePagination() {
      const totalRows = filteredRows.length;
      const totalPages = Math.ceil(totalRows / rowsPerPage) || 1;

      // Ajustar página actual si es necesario
      if (currentPage > totalPages) {
        currentPage = totalPages;
      }

      // Calcular rangos
      const startIndex = (currentPage - 1) * rowsPerPage;
      const endIndex = Math.min(startIndex + rowsPerPage, totalRows);

      // Actualizar displays
      document.getElementById('showingFrom').textContent = totalRows > 0 ? startIndex + 1 : 0;
      document.getElementById('showingTo').textContent = endIndex;
      document.getElementById('totalRecords').textContent = totalRows;
      document.getElementById('currentPageDisplay').textContent = currentPage;
      document.getElementById('totalPagesDisplay').textContent = totalPages;

      // Ocultar todas las filas
      allRows.forEach(row => row.style.display = 'none');

      // Mostrar solo las filas de la página actual
      for (let i = startIndex; i < endIndex; i++) {
        if (filteredRows[i]) {
          filteredRows[i].style.display = '';
        }
      }

      // Actualizar botones
      document.getElementById('btnFirstPage').disabled = currentPage === 1;
      document.getElementById('btnPrevPage').disabled = currentPage === 1;
      document.getElementById('btnNextPage').disabled = currentPage === totalPages;
      document.getElementById('btnLastPage').disabled = currentPage === totalPages;

      // Generar botones de números de página
      renderPageNumbers(totalPages);

      // Regenerar iconos de lucide
      if (window.lucide) window.lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
    }

    function renderPageNumbers(totalPages) {
      const pageNumbersContainer = document.getElementById('pageNumbers');
      pageNumbersContainer.innerHTML = '';

      // Mostrar máximo 5 números de página
      let startPage = Math.max(1, currentPage - 2);
      let endPage = Math.min(totalPages, currentPage + 2);

      // Ajustar si estamos cerca del inicio o final
      if (currentPage <= 3) {
        endPage = Math.min(5, totalPages);
      }
      if (currentPage >= totalPages - 2) {
        startPage = Math.max(1, totalPages - 4);
      }

      for (let i = startPage; i <= endPage; i++) {
        const button = document.createElement('button');
        button.className = `inline-flex items-center justify-center w-9 h-9 rounded-lg border-2 text-sm font-semibold transition ${
          i === currentPage
            ? 'bg-indigo-600 border-indigo-600 text-white'
            : 'bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700'
        }`;
        button.textContent = i;
        button.onclick = () => goToPage(i);
        pageNumbersContainer.appendChild(button);
      }
    }

    function goToPage(page) {
      currentPage = page;
      updatePagination();
    }

    function nextPage() {
      const totalPages = Math.ceil(filteredRows.length / rowsPerPage) || 1;
      if (currentPage < totalPages) {
        currentPage++;
        updatePagination();
      }
    }

    function prevPage() {
      if (currentPage > 1) {
        currentPage--;
        updatePagination();
      }
    }

    function goToFirstPage() {
      currentPage = 1;
      updatePagination();
    }

    function goToLastPage() {
      const totalPages = Math.ceil(filteredRows.length / rowsPerPage) || 1;
      currentPage = totalPages;
      updatePagination();
    }

    function changeRowsPerPage() {
      rowsPerPage = parseInt(document.getElementById('rowsPerPageSelect').value);
      currentPage = 1;
      updatePagination();
    }

    function filterTable() {
      const input = document.getElementById('searchInput');
      const filter = input.value.toLowerCase().trim();

      if (!filter) {
        filteredRows = [...allRows];
      } else {
        filteredRows = allRows.filter(row => {
          const searchData = row.getAttribute('data-search') || '';
          return searchData.includes(filter);
        });
      }

      currentPage = 1;
      updatePagination();
    }

    /* Helpers UI */
    function showModal(id){ 
      const el = document.getElementById(id);
      el.classList.remove('hidden');
      el.classList.add('flex');
    }
    function hideModal(id){ 
      const el = document.getElementById(id);
      el.classList.remove('flex');
      el.classList.add('hidden');
    }

    window.addEventListener('click', (e) => {
      document.querySelectorAll('#viewModal,#editModal,#companiesModal').forEach(m => {
        if (e.target === m) hideModal(m.id);
      });
    });

    /* Render empresas en modal VER */
    function renderCompaniesSection(contact) {
      const companies = Array.isArray(contact.companies) ? contact.companies : [];

      if (!companies.length) {
        const legacyName = contact.companyName || '-';
        const legacyRuc  = contact.ruc || '-';
        return `
          <div class="py-3 flex">
            <div class="w-32 shrink-0 text-slate-500 dark:text-slate-400 font-medium">Empresa</div>
            <div class="text-slate-900 dark:text-white">
              ${legacyName}
              <div class="text-xs text-slate-500 dark:text-slate-400">${legacyRuc}</div>
            </div>
          </div>
        `;
      }

      const primary = companies.find(c => c.isPrimary) || companies[0];
      const rest = companies.filter(c => c !== primary);

      const primaryHTML = `
        <div class="py-3 flex">
          <div class="w-32 shrink-0 text-slate-500 dark:text-slate-400 font-medium">Empresa principal</div>
          <div class="text-slate-900 dark:text-white font-semibold">
            ${primary.company?.name || '-'}
            <div class="text-xs text-slate-500 dark:text-slate-400">
              RUC: ${primary.company?.ruc || '-'}
              ${primary.role ? ` · Rol: ${primary.role}` : ''}
            </div>
            <div class="inline-flex items-center mt-2 rounded-md bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300 px-2 py-1 text-[11px] font-semibold">
              Empresa activa
            </div>
          </div>
        </div>
      `;

      const extrasHTML = rest.length
        ? `
          <div class="py-3 flex">
            <div class="w-32 shrink-0 text-slate-500 dark:text-slate-400 font-medium">Otras empresas</div>
            <div class="text-slate-900 dark:text-white space-y-2">
              ${rest.map(cc => `
                <div class="border border-slate-200 dark:border-white/10 rounded-lg p-2">
                  <div class="font-medium">${cc.company?.name || '-'}</div>
                  <div class="text-xs text-slate-500 dark:text-slate-400">
                    RUC: ${cc.company?.ruc || '-'}
                    ${cc.role ? ` · Rol: ${cc.role}` : ''}
                  </div>
                </div>
              `).join('')}
            </div>
          </div>
        `
        : '';

      return primaryHTML + extrasHTML;
    }

    /* VIEW CONTACT */
    async function viewContact(phoneNumber) {
      try {
        const res = await fetch(`/contacts/api/${phoneNumber}`);
        const contact = await res.json();

        if (contact.error) {
          alert('No se encontró el contacto');
          return;
        }

        const companiesHTML = renderCompaniesSection(contact);

        const html = `
          <div class="divide-y divide-slate-100 dark:divide-white/5 text-sm leading-6">
            <div class="py-3 flex">
              <div class="w-32 shrink-0 text-slate-500 dark:text-slate-400 font-medium">Teléfono</div>
              <div class="text-slate-900 dark:text-white font-semibold break-all">${contact.phoneNumber}</div>
            </div>

            <div class="py-3 flex">
              <div class="w-32 shrink-0 text-slate-500 dark:text-slate-400 font-medium">billysId</div>
              <div class="text-slate-900 dark:text-white break-all text-xs">${contact.billysId || '-'}</div>
            </div>

            <div class="py-3 flex">
              <div class="w-32 shrink-0 text-slate-500 dark:text-slate-400 font-medium">Nombre</div>
              <div class="text-slate-900 dark:text-white">${contact.name || '-'}</div>
            </div>

            <div class="py-3 flex">
              <div class="w-32 shrink-0 text-slate-500 dark:text-slate-400 font-medium">DNI</div>
              <div class="text-slate-900 dark:text-white">${contact.dni || '-'}</div>
            </div>

            <div class="py-3 flex">
              <div class="w-32 shrink-0 text-slate-500 dark:text-slate-400 font-medium">Estado</div>
              <div class="text-slate-900 dark:text-white">${contact.state}</div>
            </div>

            ${companiesHTML}

            <div class="py-3 flex">
              <div class="w-32 shrink-0 text-slate-500 dark:text-slate-400 font-medium">Bloqueado</div>
              <div class="text-slate-900 dark:text-white">${contact.isBlocked ? '🚫 Sí' : '✅ No'}</div>
            </div>

            <div class="py-3 flex">
              <div class="w-32 shrink-0 text-slate-500 dark:text-slate-400 font-medium">Takeover activo</div>
              <div class="text-slate-900 dark:text-white">${contact.humanTakeoverAt ? '🙋 Sí' : '🤖 No'}</div>
            </div>

            <div class="py-3 flex">
              <div class="w-32 shrink-0 text-slate-500 dark:text-slate-400 font-medium">Registro</div>
              <div class="text-slate-900 dark:text-white">${new Date(contact.createdAt).toLocaleString('es-PE')}</div>
            </div>
          </div>
        `;

        document.getElementById('contactDetails').innerHTML = html;
        showModal('viewModal');
      } catch (error) {
        alert('Error al cargar información del contacto');
        console.error(error);
      }
    }

    /* EDIT / CREATE CONTACT */
    function openCreateContact() {
      document.getElementById('editModalTitle').innerText = 'Nuevo contacto';
      document.getElementById('editContactId').value = '';
      document.getElementById('editPhoneNumber').value = '';
      document.getElementById('editPhoneNumber').disabled = false;
      document.getElementById('editName').value = '';
      document.getElementById('editDni').value = '';
      document.getElementById('editState').value = 'NEW';
      document.getElementById('editBlocked').checked = false;
      showModal('editModal');
    }

    async function openEditContact(contactId) {
      try {
        const tr = Array.from(document.querySelectorAll('#contactsTable tbody tr'))
          .find(r => r.innerHTML.includes(contactId));
        const phone = tr ? tr.getAttribute('data-phone') : null;

        if (!phone) {
          alert('No pude obtener el teléfono del contacto para editar');
          return;
        }

        const res = await fetch(`/contacts/api/${phone}`);
        const contact = await res.json();
        if (contact.error) {
          alert('No se encontró el contacto');
          return;
        }

        document.getElementById('editModalTitle').innerText = 'Editar contacto';
        document.getElementById('editContactId').value = contact.id;
        document.getElementById('editPhoneNumber').value = contact.phoneNumber;
        document.getElementById('editPhoneNumber').disabled = true;
        document.getElementById('editName').value = contact.name || '';
        document.getElementById('editDni').value = contact.dni || '';
        document.getElementById('editState').value = contact.state || 'NEW';
        document.getElementById('editBlocked').checked = !!contact.isBlocked;

        showModal('editModal');
      } catch (err) {
        console.error(err);
        alert('Error al cargar datos del contacto');
      }
    }

    async function submitEditContact() {
      const contactId = document.getElementById('editContactId').value.trim();
      const phone     = document.getElementById('editPhoneNumber').value.trim();
      const name      = document.getElementById('editName').value.trim();
      const dni       = document.getElementById('editDni').value.trim();
      const state     = document.getElementById('editState').value;
      const blocked   = document.getElementById('editBlocked').checked;

      try {
        if (!contactId) {
          if (!phone) {
            alert('Teléfono requerido');
            return false;
          }

          const createRes = await fetch(`/contacts/api-import`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              rows: [{
                phoneNumber: phone,
                name,
                dni,
                companies: [],
              }]
            })
          });

          const createJson = await createRes.json();
          if (createJson.error) {
            alert('Error creando contacto: ' + createJson.error);
            return false;
          }
        } else {
          const updateRes = await fetch(`/contacts/api/contact/${contactId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name,
              dni,
              state,
              isBlocked: blocked,
            })
          });
          const updateJson = await updateRes.json();
          if (updateJson.error) {
            alert('Error actualizando contacto: ' + updateJson.error);
            return false;
          }
        }

        alert('✅ Guardado');
        location.reload();
      } catch (err) {
        console.error(err);
        alert('❌ Error al guardar');
      }

      return false;
    }

    /* DELETE CONTACT */
    async function deleteContact(contactId) {
      if (!confirm('¿Eliminar este contacto y su historial? Esta acción no se puede deshacer.')) return;
      try {
        const res = await fetch(`/contacts/api/contact/${contactId}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          alert('✅ Contacto eliminado');
          location.reload();
        } else {
          alert('❌ Error al eliminar');
        }
      } catch (err) {
        console.error(err);
        alert('❌ Error al eliminar');
      }
    }

    /* COMPANIES */
    async function openCompanies(contactId) {
      document.getElementById('companiesContactId').value = contactId;

      const tr = Array.from(document.querySelectorAll('#contactsTable tbody tr'))
        .find(r => r.innerHTML.includes(contactId));
      const phone = tr ? tr.getAttribute('data-phone') : null;
      if (!phone) {
        alert('No pude obtener el teléfono del contacto');
        return;
      }

      try {
        const resContact = await fetch(`/contacts/api/${phone}`);
        const contact = await resContact.json();
        if (contact.error) {
          alert('No se encontró el contacto');
          return;
        }
        renderCompaniesModalList(contact);

        const resCompanies = await fetch('/contacts/api-companies');
        const companiesJson = await resCompanies.json();
        if (companiesJson.ok) {
          fillExistingCompaniesSelect(companiesJson.companies);
        } else {
          fillExistingCompaniesSelect([]);
        }

        showModal('companiesModal');
      } catch (err) {
        console.error(err);
        alert('❌ Error cargando empresas');
      }
    }

    function renderCompaniesModalList(contact) {
      const companiesListEl = document.getElementById('companiesList');
      const companies = Array.isArray(contact.companies) ? contact.companies : [];

      if (!companies.length) {
        companiesListEl.innerHTML = `
          <div class="text-slate-500 dark:text-slate-400 text-sm">
            Este contacto no tiene empresas asociadas todavía.
          </div>
        `;
        return;
      }

      companiesListEl.innerHTML = companies.map(cc => `
        <div class="border border-slate-200 dark:border-white/10 rounded-lg p-3">
          <div class="flex items-start justify-between gap-3">
            <div>
              <div class="font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                ${cc.company?.name || '-'}
                ${cc.isPrimary ? `<span class="text-[10px] inline-flex items-center rounded bg-indigo-600 text-white px-1.5 py-0.5 font-semibold">Principal</span>` : ''}
              </div>
              <div class="text-xs text-slate-500 dark:text-slate-400">
                RUC: ${cc.company?.ruc || '-'}
                ${cc.role ? ` · Rol: ${cc.role}` : ''}
              </div>
            </div>

            <div class="flex flex-col gap-2 text-right">
              ${cc.isPrimary ? '' : `
                <button
                  class="inline-flex items-center justify-center rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-[11px] font-semibold px-2 py-1 shadow-soft transition"
                  onclick="makePrimary('${contact.id}','${cc.companyId}')">
                  Hacer principal
                </button>
              `}

              <button
                class="inline-flex items-center justify-center rounded-lg bg-red-600 hover:bg-red-700 text-white text-[11px] font-semibold px-2 py-1 shadow-soft transition"
                onclick="removeCompany('${contact.id}','${cc.companyId}')">
                Quitar
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    function fillExistingCompaniesSelect(companies) {
      const sel = document.getElementById('existingCompanySelect');
      sel.innerHTML = '<option value="">-- Selecciona empresa --</option>';

      (companies || []).forEach(co => {
        const opt = document.createElement('option');
        opt.value = co.id;
        opt.textContent = `${co.name || '(sin nombre)'}  -  RUC: ${co.ruc || '-'}`;
        sel.appendChild(opt);
      });
    }

    async function linkExistingCompany() {
      const contactId = document.getElementById('companiesContactId').value.trim();
      const companyId = document.getElementById('existingCompanySelect').value.trim();
      const role      = document.getElementById('existingCompanyRole').value.trim();
      const primary   = document.getElementById('existingCompanyPrimary').checked;

      if (!contactId || !companyId) {
        alert('Selecciona una empresa');
        return;
      }

      try {
        const res = await fetch(`/contacts/api/${contactId}/company/link-existing`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ companyId, role, primary })
        });

        const data = await res.json();
        if (data.error) {
          alert('❌ Error vinculando empresa: ' + data.error);
          return;
        }

        alert('✅ Empresa vinculada');
        location.reload();
      } catch (err) {
        console.error(err);
        alert('❌ Error vinculando empresa');
      }
    }

    async function submitAddCompany() {
      const contactId = document.getElementById('companiesContactId').value.trim();
      const ruc       = document.getElementById('companyRuc').value.trim();
      const name      = document.getElementById('companyName').value.trim();
      const role      = document.getElementById('companyRole').value.trim();
      const primary   = document.getElementById('companyPrimary').checked;

      if (!contactId || !ruc || !name) {
        alert('RUC y Razón Social son obligatorios');
        return false;
      }

      try {
        const res = await fetch(`/contacts/api/${contactId}/company`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ruc, name, role, primary })
        });

        const data = await res.json();
        if (data.error) {
          alert('❌ Error agregando empresa: ' + data.error);
          return false;
        }

        alert('✅ Empresa agregada');
        location.reload();
      } catch (err) {
        console.error(err);
        alert('❌ Error agregando empresa');
      }

      return false;
    }

    async function makePrimary(contactId, companyId) {
      try {
        const res = await fetch(`/contacts/api/${contactId}/company/${companyId}/primary`, { method: 'POST' });
        const data = await res.json();
        if (data.error) {
          alert('❌ Error marcando como principal: ' + data.error);
          return;
        }
        alert('✅ Empresa marcada como principal');
        location.reload();
      } catch (err) {
        console.error(err);
        alert('❌ Error marcando como principal');
      }
    }

    async function removeCompany(contactId, companyId) {
      if (!confirm('¿Quitar esta empresa del contacto?')) return;
      try {
        const res = await fetch(`/contacts/api/${contactId}/company/${companyId}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.error) {
          alert('❌ Error quitando empresa: ' + data.error);
          return;
        }
        alert('✅ Empresa removida');
        location.reload();
      } catch (err) {
        console.error(err);
        alert('❌ Error quitando empresa');
      }
    }

    /* TAKEOVER / BLOCK */
    async function takeover(phoneNumber) {
      if (!confirm('¿Activar intervención humana para este contacto?')) return;
      try {
        const res = await fetch(`/contacts/api/${phoneNumber}/takeover`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert('✅ Takeover activado. El bot no responderá durante 1 hora.');
          location.reload();
        } else {
          alert('❌ Error al activar takeover');
        }
      } catch (error) {
        console.error(error);
        alert('❌ Error al activar takeover');
      }
    }

    async function release(phoneNumber) {
      if (!confirm('¿Liberar intervención humana? El bot volverá a responder.')) return;
      try {
        const res = await fetch(`/contacts/api/${phoneNumber}/release`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert('✅ Takeover liberado. El bot volverá a responder.');
          location.reload();
        } else {
          alert('❌ Error al liberar takeover');
        }
      } catch (error) {
        console.error(error);
        alert('❌ Error al liberar takeover');
      }
    }

    async function blockContact(phoneNumber) {
      const reason = prompt('Razón del bloqueo (opcional):');
      if (reason === null) return;
      try {
        const res = await fetch(`/contacts/api/${phoneNumber}/block`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason })
        });
        const data = await res.json();
        if (data.success) {
          alert('✅ Contacto bloqueado');
          location.reload();
        } else {
          alert('❌ Error al bloquear contacto');
        }
      } catch (error) {
        console.error(error);
        alert('❌ Error al bloquear contacto');
      }
    }

    async function unblockContact(phoneNumber) {
      if (!confirm('¿Desbloquear este contacto?')) return;
      try {
        const res = await fetch(`/contacts/api/${phoneNumber}/unblock`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert('✅ Contacto desbloqueado');
          location.reload();
        } else {
          alert('❌ Error al desbloquear contacto');
        }
      } catch (error) {
        console.error(error);
        alert('❌ Error al desbloquear contacto');
      }
    }

    /* IMPORT / EXPORT */
    async function exportExcel() {
      try {
        const res = await fetch('/contacts/api-export');
        
        if (!res.ok) {
          throw new Error('Error al exportar contactos');
        }

        const blob = await res.blob();
        const url = URL.createObjectURL(blob);

        const a = document.createElement('a');
        a.href = url;
        a.download = `contactos-${new Date().toISOString().split('T')[0]}.xlsx`;
        document.body.appendChild(a);
        a.click();
        
        setTimeout(() => {
          a.remove();
          URL.revokeObjectURL(url);
        }, 100);

        alert('✅ Contactos exportados exitosamente como archivo Excel');
      } catch (err) {
        console.error(err);
        alert('❌ Error al exportar contactos');
      }
    }

    async function importExcelFile(inputEl) {
      const file = inputEl.files && inputEl.files[0];
      if (!file) return;

      // Validar tipo de archivo
      const validExtensions = ['.xlsx', '.xls'];
      const fileName = file.name.toLowerCase();
      const isValidFile = validExtensions.some(ext => fileName.endsWith(ext));

      if (!isValidFile) {
        alert('❌ Por favor selecciona un archivo Excel válido (.xlsx o .xls)');
        inputEl.value = '';
        return;
      }

      // Mostrar indicador de carga
      const originalText = inputEl.parentElement.querySelector('span').textContent;
      inputEl.parentElement.querySelector('span').textContent = 'Importando...';

      try {
        const formData = new FormData();
        formData.append('file', file);

        const res = await fetch('/contacts/api-import-file', {
          method: 'POST',
          body: formData
        });

        const data = await res.json();

        if (data.success) {
          alert(`✅ Importación exitosa!\n\nTotal de filas procesadas: ${data.totalRows}`);
          location.reload();
        } else {
          alert('❌ Error importando: ' + (data.error || 'Error desconocido'));
        }
      } catch (err) {
        console.error(err);
        alert('❌ Error al procesar el archivo Excel');
      } finally {
        // Restaurar texto y limpiar input
        inputEl.parentElement.querySelector('span').textContent = originalText;
        inputEl.value = '';
      }
    }
  </script>
</body>
</html>