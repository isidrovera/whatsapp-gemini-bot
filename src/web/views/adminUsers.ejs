<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Usuarios Admin' %> - WhatsApp Bot Admin</title>

  <!-- Fuente -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary:   { DEFAULT:'#667eea', 600:'#667eea', 700:'#5a67d8' },
            secondary: { DEFAULT:'#764ba2', 600:'#764ba2', 700:'#6b3fa0' },
          },
          boxShadow: {
            soft:'0 4px 6px -1px rgba(0,0,0,.08), 0 2px 4px -1px rgba(0,0,0,.04)',
            card:'0 10px 30px -5px rgba(0,0,0,.10)'
          }
        }
      },
      darkMode:'media'
    }
  </script>

  <!-- Utilidades externas del dashboard -->
  <link rel="stylesheet" href="/css/ui.css">

  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    /* Animaciones suaves para modales */
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes slideUp {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .modal-backdrop {
      animation: fadeIn 0.2s ease-out;
    }
    .modal-content {
      animation: slideUp 0.3s ease-out;
    }
    /* Loading spinner */
    .spinner {
      border: 2px solid #f3f3f3;
      border-top: 2px solid #667eea;
      border-radius: 50%;
      width: 16px;
      height: 16px;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
  </style>
</head>
<body class="h-full bg-gradient-to-br from-slate-50 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 text-slate-800 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-4 focus:py-2 focus:rounded-lg shadow-lg">
    Saltar al contenido
  </a>

  <%
    const adminsList = Array.isArray(admins) ? admins : [];
    const currentId  = typeof currentUserId !== 'undefined' ? currentUserId : null;
    const df = new Intl.DateTimeFormat('es-PE', { dateStyle: 'short' });
    function fmtDate(d){ try { return df.format(new Date(d)); } catch { return '-'; } }
    const avatarFallback = (name) => (name || '?').substring(0,1).toUpperCase();
  %>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Volver al Dashboard + breadcrumb -->
    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <a href="/"
           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors">
          <i data-lucide="arrow-left" class="icon"></i>
          <span>Volver al Dashboard</span>
        </a>
      </div>

      <nav aria-label="Breadcrumb" class="text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li class="inline-flex items-center gap-1">
            <a href="/" class="hover:underline inline-flex items-center gap-1">
              <i data-lucide="home" class="w-3.5 h-3.5"></i> Inicio
            </a>
          </li>
          <li class="select-none">/</li>
          <li class="inline-flex items-center gap-1">
            <i data-lucide="shield" class="w-3.5 h-3.5"></i>
            <span class="font-medium">Usuarios Admin</span>
          </li>
        </ol>
      </nav>
    </div>

    <!-- Header -->
    <header class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight gradient-text flex items-center gap-3">
            <i data-lucide="shield" class="icon-lg text-primary"></i>
            Usuarios Admin
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Gestión de administradores del sistema</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft transition-all active:scale-95"
                  onclick="showModal('addModal')">
            <i data-lucide="plus-circle" class="icon"></i>
            <span>Agregar Usuario</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Tabla -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center">
            <i data-lucide="users" class="icon text-indigo-600 dark:text-indigo-400"></i>
          </div>
          Lista de Administradores
        </h2>
      </div>

      <% if (adminsList.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-400 uppercase text-xs tracking-wider font-semibold">
              <tr>
                <th class="text-left px-6 py-4">Usuario</th>
                <th class="text-left px-6 py-4">Nombre</th>
                <th class="text-left px-6 py-4">Contacto</th>
                <th class="text-left px-6 py-4">Rol</th>
                <th class="text-left px-6 py-4">Estado</th>
                <th class="text-left px-6 py-4">2FA</th>
                <th class="text-left px-6 py-4">Registro</th>
                <th class="text-left px-6 py-4">Acciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
              <% adminsList.forEach(admin => { %>
                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                  <!-- Usuario + avatar -->
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 rounded-full bg-slate-200 dark:bg-slate-700 flex items-center justify-center overflow-hidden">
                        <% if (admin.avatarUrl) { %>
                          <img src="<%= admin.avatarUrl %>" alt="avatar" class="w-10 h-10 object-cover">
                        <% } else { %>
                          <span class="text-sm font-semibold text-slate-600 dark:text-slate-200">
                            <%= avatarFallback(admin.name || admin.username) %>
                          </span>
                        <% } %>
                      </div>
                      <div>
                        <div class="flex items-center gap-2">
                          <span class="font-semibold text-slate-900 dark:text-white"><%= admin.username %></span>
                          <% if (admin.id === currentId) { %>
                            <span class="inline-flex items-center rounded-md bg-sky-100 text-sky-700 dark:bg-sky-900/30 dark:text-sky-300 px-2 py-0.5 text-[11px] font-semibold leading-none">Tú</span>
                          <% } %>
                        </div>
                        <% if (admin.dni) { %>
                          <p class="text-[11px] text-slate-400 dark:text-slate-500">DNI: <%= admin.dni %></p>
                        <% } %>
                      </div>
                    </div>
                  </td>

                  <!-- Nombre -->
                  <td class="px-6 py-4 text-slate-700 dark:text-slate-300"><%= admin.name || '-' %></td>

                  <!-- Contacto -->
                  <td class="px-6 py-4">
                    <div class="flex flex-col gap-1">
                      <span class="text-slate-700 dark:text-slate-200 text-xs"><%= admin.email || '—' %></span>
                      <span class="text-slate-400 dark:text-slate-500 text-xs flex items-center gap-1">
                        <i data-lucide="smartphone" class="w-3 h-3"></i>
                        <%= admin.phone || '—' %>
                      </span>
                    </div>
                  </td>

                  <!-- Rol -->
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[11px] font-semibold
                      <%= admin.role === 'SUPER_ADMIN'
                        ? 'bg-rose-100 text-rose-700 dark:bg-rose-900/20 dark:text-rose-200'
                        : admin.role === 'ADMIN'
                          ? 'bg-indigo-100 text-indigo-700 dark:bg-indigo-900/20 dark:text-indigo-200'
                          : 'bg-slate-100 text-slate-700 dark:bg-slate-800/40 dark:text-slate-200' %>">
                      <i data-lucide="shield-check" class="w-3 h-3"></i>
                      <%= admin.role || 'ADMIN' %>
                    </span>
                  </td>

                  <!-- Estado -->
                  <td class="px-6 py-4">
                    <% if (admin.isActive) { %>
                      <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-200 px-2.5 py-0.5 text-[11px] font-semibold">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                        Activo
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 text-slate-600 dark:bg-slate-800/40 dark:text-slate-200 px-2.5 py-0.5 text-[11px] font-semibold">
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                        Inactivo
                      </span>
                    <% } %>
                  </td>

                  <!-- 2FA -->
                  <td class="px-6 py-4">
                    <% if (admin.twoFAEnabled) { %>
                      <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-200 px-2.5 py-0.5 text-[11px] font-semibold">
                        <i data-lucide="lock-keyhole" class="w-3 h-3"></i>
                        Activo
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 text-amber-700 dark:bg-amber-900/20 dark:text-amber-200 px-2.5 py-0.5 text-[11px] font-semibold">
                        <i data-lucide="lock" class="w-3 h-3"></i>
                        No
                      </span>
                    <% } %>
                  </td>

                  <!-- Registro -->
                  <td class="px-6 py-4 text-slate-600 dark:text-slate-400">
                    <time datetime="<%= new Date(admin.createdAt).toISOString() %>"><%= fmtDate(admin.createdAt) %></time>
                  </td>

                  <!-- Acciones -->
                  <td class="px-6 py-4">
                    <div class="flex flex-wrap gap-2">
                      <!-- Editar -->
                      <button
                        class="inline-flex items-center gap-1 rounded-lg bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition-all active:scale-95"
                        onclick="editAdmin('<%= admin.id %>')">
                        ✏️ <span>Editar</span>
                      </button>

                      <% if (admin.id === currentId) { %>
                        <!-- Cambiar mi contraseña -->
                        <button
                          class="inline-flex items-center gap-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition-all active:scale-95"
                          onclick="changeMyPassword('<%= admin.id %>')">
                          🔑 <span>Cambiar Contraseña</span>
                        </button>

                        <!-- Gestionar 2FA -->
                        <% if (admin.twoFAEnabled) { %>
                          <button
                            class="inline-flex items-center gap-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition-all active:scale-95"
                            onclick="disable2FA('<%= admin.id %>')">
                            🔓 <span>Desactivar 2FA</span>
                          </button>
                        <% } else { %>
                          <button
                            class="inline-flex items-center gap-1 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition-all active:scale-95"
                            onclick="setup2FA('<%= admin.id %>')">
                            🔐 <span>Activar 2FA</span>
                          </button>
                        <% } %>
                      <% } else { %>
                        <!-- Resetear contraseña -->
                        <button
                          class="inline-flex items-center gap-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition-all active:scale-95"
                          onclick="resetPassword('<%= admin.id %>')">
                          🔄 <span>Resetear</span>
                        </button>

                        <!-- Eliminar -->
                        <button
                          class="inline-flex items-center gap-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition-all active:scale-95"
                          onclick="deleteAdmin('<%= admin.id %>')">
                          🗑️ <span>Eliminar</span>
                        </button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="px-6 py-16 text-center">
          <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="inbox" class="icon-lg text-slate-400"></i>
          </div>
          <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Sin usuarios</p>
          <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Agrega el primer administrador</p>
        </div>
      <% } %>
    </section>
  </main>

  <!-- ============================================ -->
  <!-- MODAL: Agregar Usuario -->
  <!-- ============================================ -->
  <div id="addModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm modal-backdrop p-4">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-2xl w-full max-h-[90vh] overflow-y-auto border border-slate-200/70 dark:border-white/10 modal-content">
      <div class="sticky top-0 z-10 px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between bg-white dark:bg-slate-900">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="user-plus" class="icon text-primary"></i> Agregar Usuario Admin
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white transition-colors" onclick="hideModal('addModal')" type="button">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>
      <div class="p-6">
        <form onsubmit="addAdmin(event)" class="space-y-4">
          <!-- DNI con búsqueda -->
          <div>
            <label for="dni" class="block text-sm font-semibold mb-2 text-slate-700 dark:text-slate-300">DNI</label>
            <div class="flex gap-2">
              <input id="dni" type="text" placeholder="12345678" maxlength="8" pattern="[0-9]{8}"
                class="flex-1 rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 transition-colors">
              <button type="button" onclick="consultarDNI()" 
                class="inline-flex items-center gap-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 text-sm font-medium shadow-soft transition-all active:scale-95">
                <i data-lucide="search" class="w-4 h-4"></i>
                <span class="hidden sm:inline">Consultar RENIEC</span>
                <span class="sm:hidden">Buscar</span>
              </button>
            </div>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Ingresa el DNI y haz clic en Consultar para autocompletar los datos</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="sm:col-span-2">
              <label for="name" class="block text-sm font-semibold mb-2 text-slate-700 dark:text-slate-300">Nombre Completo</label>
              <input id="name" type="text" placeholder="Ej: Juan Pérez"
                class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 transition-colors">
            </div>
            
            <div class="sm:col-span-2">
              <label for="username" class="block text-sm font-semibold mb-2 text-slate-700 dark:text-slate-300">Usuario *</label>
              <input id="username" type="text" required placeholder="Ej: admin2"
                class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 transition-colors">
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold mb-2 text-slate-700 dark:text-slate-300">Correo</label>
              <input id="email" type="email" placeholder="admin@empresa.com"
                class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 transition-colors">
            </div>

            <div>
              <label for="phone" class="block text-sm font-semibold mb-2 text-slate-700 dark:text-slate-300">Teléfono / WhatsApp</label>
              <input id="phone" type="text" placeholder="999999999"
                class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 transition-colors">
            </div>

            <div class="sm:col-span-2">
              <label for="avatarUrl" class="block text-sm font-semibold mb-2 text-slate-700 dark:text-slate-300">URL de foto / avatar</label>
              <input id="avatarUrl" type="text" placeholder="https://..."
                class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 transition-colors">
            </div>

            <div>
              <label for="role" class="block text-sm font-semibold mb-2 text-slate-700 dark:text-slate-300">Rol</label>
              <select id="role"
                class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 transition-colors">
                <option value="ADMIN">ADMIN</option>
                <option value="SUPER_ADMIN">SUPER_ADMIN</option>
                <option value="OPERATOR">OPERATOR</option>
                <option value="TECH">TECH</option>
              </select>
            </div>

            <div class="flex items-center gap-2 pt-6">
              <input id="isActive" type="checkbox" checked
                class="w-4 h-4 rounded border-slate-300 text-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-colors">
              <label for="isActive" class="text-sm text-slate-700 dark:text-slate-200">Activo</label>
            </div>

            <div class="sm:col-span-2">
              <label for="password" class="block text-sm font-semibold mb-2 text-slate-700 dark:text-slate-300">Contraseña *</label>
              <input id="password" type="password" required minlength="6" placeholder="Mínimo 6 caracteres"
                class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 transition-colors">
            </div>
          </div>

          <div class="flex justify-end gap-2 pt-4 border-t border-slate-200 dark:border-slate-700">
            <button type="button" class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-4 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition-colors" onclick="hideModal('addModal')">
              Cancelar
            </button>
            <button type="submit" class="rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-4 py-2 shadow-soft transition-all active:scale-95">
              Crear Usuario
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- MODAL: Editar Usuario -->
  <!-- ============================================ -->
  <div id="editModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm modal-backdrop p-4">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-2xl w-full max-h-[90vh] overflow-y-auto border border-slate-200/70 dark:border-white/10 modal-content">
      <div class="sticky top-0 z-10 px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between bg-white dark:bg-slate-900">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="pencil" class="icon text-amber-600"></i> Editar Usuario
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white transition-colors" onclick="hideModal('editModal')" type="button">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>
      <div class="p-6">
        <form onsubmit="updateAdmin(event)" class="space-y-4">
          <input id="edit-id" type="hidden">

          <!-- DNI con búsqueda -->
          <div>
            <label for="edit-dni" class="block text-sm font-semibold mb-2 text-slate-700 dark:text-slate-300">DNI</label>
            <div class="flex gap-2">
              <input id="edit-dni" type="text" maxlength="8" pattern="[0-9]{8}"
                class="flex-1 rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 transition-colors">
              <button type="button" onclick="consultarDNIEdit()" 
                class="inline-flex items-center gap-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 text-sm font-medium shadow-soft transition-all active:scale-95">
                <i data-lucide="search" class="w-4 h-4"></i>
                <span class="hidden sm:inline">Consultar RENIEC</span>
                <span class="sm:hidden">Buscar</span>
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="sm:col-span-2">
              <label for="edit-name" class="block text-sm font-semibold mb-2 text-slate-700 dark:text-slate-300">Nombre Completo</label>
              <input id="edit-name" type="text"
