# ===== Database (en Docker el host es 'db') =====
DATABASE_URL=postgresql://postgres:system15@db:5432/whatsapp_bot?schema=public

# ===== Gemini AI =====
GEMINI_API_KEY=

# ===== External APIs (opcional) =====
RENIEC_API_TOKEN=
SUNAT_API_TOKEN=

# ===== Web Server =====
WEB_PORT=3000

# ===== Sesión / Cookies =====
SESSION_SECRET=whatsapp-bot-super-secret-key-change-in-production

# ⚠️ CRÍTICO: Configuración para proxy con HTTPS
BEHIND_PROXY=true           # Express confía en X-Forwarded-Proto del proxy
COOKIE_SECURE=true          # Cookies solo por HTTPS
# CROSS_SITE=false          # (opcional) Solo si necesitas cross-origin

# ===== Entorno / Zona horaria =====
NODE_ENV=production
TZ=America/Lima

# ===== Prisma =====
PRISMA_CLIENT_ENGINE_TYPE=binary