# ===== Database (en Docker el host es 'db') =====
DATABASE_URL=postgresql://postgres:system15@db:5432/whatsapp_bot?schema=public

# ===== Gemini AI =====
GEMINI_API_KEY=

# ===== External APIs (opcional) =====
RENIEC_API_TOKEN=
SUNAT_API_TOKEN=

# ===== Web Server =====
WEB_PORT=3000

# ===== Sesión / Cookies =====
SESSION_SECRET=whatsapp-bot-super-secret-key-change-in-production
COOKIE_SECURE=false
TRUST_PROXY=0

# ===== Entorno / Zona horaria =====
NODE_ENV=production
TZ=America/Lima

# ===== Prisma =====
# Fuerza engines binarios (útil en contenedores)
PRISMA_CLIENT_ENGINE_TYPE=binary
