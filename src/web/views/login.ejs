<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Login - WhatsApp Bot Admin</title>

  <!-- Fuente + Tailwind -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'media',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            brandA: '#667eea',
            brandB: '#764ba2',
          },
        }
      }
    };
  </script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration:.001ms!important;
        animation-iteration-count:1!important;
        transition-duration:.001ms!important;
        scroll-behavior:auto!important
      }
    }
    @keyframes slideIn {
      from { opacity:0; transform:translateX(20px); }
      to   { opacity:1; transform:translateX(0); }
    }
    .bg-hero {
      background: linear-gradient(135deg, rgba(102, 126, 234, 0.95) 0%, rgba(118, 75, 162, 0.95) 100%),
                  url('https://images.unsplash.com/photo-1557683316-973673baf926?w=1200&q=80');
      background-size: cover;
      background-position: center;
    }
  </style>
</head>
<body class="h-full overflow-hidden">

  <div class="flex h-full">
    
    <!-- LADO IZQUIERDO - Hero Section -->
    <div class="hidden lg:flex lg:w-1/2 bg-hero relative">
      <div class="absolute inset-0 bg-gradient-to-br from-brandA/30 to-brandB/30"></div>
      
      <div class="relative z-10 flex flex-col justify-between p-12 text-white w-full">
        <!-- Logo/Brand -->
        <div>
          <div class="flex items-center gap-3 mb-3">
            <div class="w-12 h-12 rounded-xl bg-white/20 backdrop-blur-sm flex items-center justify-center text-2xl">
              🤖
            </div>
            <span class="text-xl font-semibold">WhatsApp Bot</span>
          </div>
        </div>

        <!-- Contenido central -->
        <div class="mb-20">
          <h1 class="text-5xl font-bold leading-tight mb-4">
            Welcome<br/>Back
          </h1>
          <p class="text-lg text-white/90 max-w-md leading-relaxed">
            Gestiona tus conversaciones y automatizaciones de WhatsApp desde un solo lugar.
          </p>
        </div>

        <!-- Footer -->
        <div class="flex items-center gap-4 text-white/80 text-sm">
          <a href="#" class="hover:text-white transition">Términos</a>
          <span>•</span>
          <a href="#" class="hover:text-white transition">Privacidad</a>
          <span>•</span>
          <span>© 2025</span>
        </div>
      </div>
    </div>

    <!-- LADO DERECHO - Formulario -->
    <div class="w-full lg:w-1/2 flex items-center justify-center bg-white p-8">
      <div class="w-full max-w-md animate-[slideIn_.5s_ease-out]">
        
        <!-- Header mobile -->
        <div class="lg:hidden mb-8 text-center">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br from-brandA to-brandB mb-3 shadow-lg">
            <span class="text-2xl">🤖</span>
          </div>
          <h2 class="text-2xl font-bold text-slate-800">WhatsApp Bot Admin</h2>
        </div>

        <!-- Título -->
        <div class="mb-8">
          <h2 class="text-3xl font-bold text-slate-800 mb-2">Sign in</h2>
          <p class="text-slate-500">Ingresa tus credenciales para continuar</p>
        </div>

        <!-- Error Alert -->
        <% if (error) { %>
          <div class="mb-6 flex items-start gap-2 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3" role="alert">
            <span class="text-base">⚠️</span>
            <span class="flex-1"><%= error %></span>
          </div>
        <% } %>

        <!-- Formulario -->
        <form method="POST" action="/auth/login" class="space-y-5">
          <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>

          <!-- Usuario -->
          <div>
            <label for="username" class="block text-sm font-medium text-slate-700 mb-2">
              Email Address
            </label>
            <input
              type="text"
              id="username"
              name="username"
              required
              autofocus
              placeholder="admin@example.com"
              class="block w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-brandA focus:ring-2 focus:ring-brandA/20"
            />
          </div>

          <!-- Password -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <label for="password" class="block text-sm font-medium text-slate-700">
                Password
              </label>
              <a href="#" class="text-sm text-brandA hover:text-brandB transition">
                Lost your password?
              </a>
            </div>
            <input
              type="password"
              id="password"
              name="password"
              required
              placeholder="••••••••"
              class="block w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-brandA focus:ring-2 focus:ring-brandA/20"
            />
          </div>

          <!-- Remember me -->
          <div class="flex items-center">
            <input
              type="checkbox"
              id="remember"
              name="remember"
              class="w-4 h-4 rounded border-slate-300 text-brandA focus:ring-2 focus:ring-brandA/20"
            />
            <label for="remember" class="ml-2 text-sm text-slate-600">
              Remember Me
            </label>
          </div>

          <!-- Botón -->
          <button
            type="submit"
            class="w-full rounded-lg bg-gradient-to-r from-brandA to-brandB text-white font-medium text-sm py-3 shadow-md hover:shadow-lg active:scale-[.98] transition-all"
          >
            SIGN IN NOW
          </button>
        </form>

        <!-- Credenciales por defecto -->
        <div class="mt-6 rounded-lg bg-amber-50 border border-amber-200 px-4 py-3">
          <div class="flex items-center gap-2 text-amber-800 font-medium text-xs mb-2">
            <span>💡</span>
            <span>Credenciales por defecto</span>
          </div>
          <div class="text-xs text-amber-900 space-y-1">
            <p><span class="font-medium">Usuario:</span> <code class="font-mono bg-white/70 px-2 py-0.5 rounded">admin</code></p>
            <p><span class="font-medium">Contraseña:</span> <code class="font-mono bg-white/70 px-2 py-0.5 rounded">admin123</code></p>
          </div>
        </div>

        <!-- Footer mobile -->
        <div class="mt-8 text-center text-xs text-slate-400 lg:hidden">
          <p>© 2025 WhatsApp Bot Admin. Todos los derechos reservados.</p>
        </div>
      </div>
    </div>

  </div>

</body>
</html>