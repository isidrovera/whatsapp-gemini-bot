<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Calendario' %> - WhatsApp Bot Admin</title>

  <!-- Fuente -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind (misma config del ejemplo) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary:   { DEFAULT:'#667eea', 600:'#667eea', 700:'#5a67d8' },
            secondary: { DEFAULT:'#764ba2', 600:'#764ba2', 700:'#6b3fa0' },
          },
          boxShadow: {
            soft:'0 4px 6px -1px rgba(0,0,0,.08), 0 2px 4px -1px rgba(0,0,0,.04)',
            card:'0 10px 30px -5px rgba(0,0,0,.10)'
          }
        }
      },
      darkMode:'media'
    }
  </script>

  <!-- Utilidades externas del dashboard -->
  <link rel="stylesheet" href="/css/ui.css">

  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Gradient text (igual al ejemplo) */
    .gradient-text {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Icon sizes (igual al ejemplo) */
    .icon { width: 1.25rem; height: 1.25rem; }
    .icon-lg { width: 1.75rem; height: 1.75rem; }
  </style>
</head>

<body class="h-full bg-gradient-to-br from-slate-50 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 text-slate-800 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-4 focus:py-2 focus:rounded-lg shadow-lg">
    Saltar al contenido
  </a>

  <%
    const evts = Array.isArray(events) ? events : [];
    const now  = new Date();
    const fmt  = new Intl.DateTimeFormat('es-PE', { month:'long', year:'numeric' });

    // leyenda de tipos
    const TYPE_META = {
      holiday:       { dot:'bg-rose-500',    chip:'bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300', label:'🎉 Feriado' },
      special_event: { dot:'bg-amber-500',   chip:'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300', label:'⭐ Evento Especial' },
      closure:       { dot:'bg-slate-500',   chip:'bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-200',    label:'🔒 Cierre' }
    };
  %>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Volver al Dashboard + breadcrumb -->
    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <a href="/"
           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">
          <i data-lucide="arrow-left" class="icon"></i>
          <span>Volver al Dashboard</span>
        </a>
      </div>

      <nav aria-label="Breadcrumb" class="text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li class="inline-flex items-center gap-1">
            <a href="/" class="hover:underline inline-flex items-center gap-1">
              <i data-lucide="home" class="w-3.5 h-3.5"></i> Inicio
            </a>
          </li>
          <li class="select-none">/</li>
          <li class="inline-flex items-center gap-1">
            <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
            <span class="font-medium">Calendario</span>
          </li>
        </ol>
      </nav>
    </div>

    <!-- Header -->
    <header class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight gradient-text flex items-center gap-3">
            <i data-lucide="calendar" class="icon-lg text-primary"></i>
            Calendario
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            Feriados, eventos especiales y cierres de operación
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <div class="hidden sm:flex items-center gap-2 rounded-xl bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 px-2 py-1.5 text-sm">
            <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-rose-500"></span> Feriado</span>
            <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-500"></span> Evento</span>
            <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-slate-500"></span> Cierre</span>
          </div>

          <button class="inline-flex items-center gap-2 rounded-xl bg-slate-600 hover:bg-slate-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft"
                  onclick="goToday()">
            <i data-lucide="clock" class="icon"></i>
            <span>Hoy</span>
          </button>

          <button class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft"
                  onclick="showModal('addModal')">
            <i data-lucide="plus-circle" class="icon"></i>
            <span>Agregar Evento</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Calendario -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <!-- Barra mes -->
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <button type="button" class="rounded-lg p-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700"
                  onclick="prevMonth()" aria-label="Mes anterior">
            <i data-lucide="chevron-left" class="icon"></i>
          </button>
          <button type="button" class="rounded-lg p-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700"
                  onclick="nextMonth()" aria-label="Mes siguiente">
            <i data-lucide="chevron-right" class="icon"></i>
          </button>
        </div>
        <div class="text-lg font-bold text-slate-800 dark:text-white">
          <span id="monthLabel"><%= fmt.format(now) %></span>
        </div>
        <div class="text-xs text-slate-500 dark:text-slate-400">
          <span id="yearRange"></span>
        </div>
      </div>

      <!-- Cabecera días -->
      <div class="grid grid-cols-7 bg-slate-50 dark:bg-slate-800/50 text-[11px] uppercase tracking-wide text-slate-500 dark:text-slate-400">
        <% ['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'].forEach(d => { %>
          <div class="px-3 py-2 text-center"><%= d %></div>
        <% }) %>
      </div>

      <!-- Grilla -->
      <div id="monthGrid" class="grid grid-cols-7 auto-rows-[140px] sm:auto-rows-[160px] lg:auto-rows-[180px]"></div>
    </section>

    <!-- Lista plana de eventos (por si se desea revisar) -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center">
            <i data-lucide="list" class="icon text-indigo-600 dark:text-indigo-400"></i>
          </div>
          Próximos eventos
        </h2>
      </div>
      <div class="p-6">
        <% if (evts.length > 0) { %>
          <ul class="space-y-3">
            <% evts
               .slice().sort((a,b)=> (a.dateYMD < b.dateYMD ? -1 : 1))
               .map(e => ({...e, meta: TYPE_META[e.type] || TYPE_META.closure}))
               .forEach(e => { %>
              <li class="flex items-start justify-between gap-3 rounded-xl border border-slate-200 dark:border-white/10 p-4 hover:shadow-sm transition">
                <div class="flex items-start gap-3">
                  <span class="mt-1 w-2 h-2 rounded-full <%= e.meta.dot %>"></span>
                  <div>
                    <div class="text-sm font-semibold text-slate-800 dark:text-white"><%= e.title %></div>
                    <div class="text-xs text-slate-500 dark:text-slate-400">
                      <time datetime="<%= e.dateYMD %>"><%= new Date(e.dateYMD).toLocaleDateString('es-PE',{ weekday:'long', year:'numeric', month:'long', day:'numeric'}) %></time>
                    </div>
                    <% if (e.description) { %>
                      <p class="text-sm text-slate-600 dark:text-slate-300 mt-1 whitespace-pre-wrap"><%= e.description %></p>
                    <% } %>
                    <div class="mt-2 inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-semibold leading-none <%= e.meta.chip %>">
                      <%= e.meta.label %>
                      <% if (e.isRecurring) { %><span class="ml-2">• 🔄 Anual</span><% } %>
                    </div>
                  </div>
                </div>
                <div class="flex-shrink-0 flex gap-2">
                  <button class="inline-flex items-center gap-1 rounded-lg bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1.5 text-xs font-medium"
                          onclick="editEvent('<%= e.id %>')">
                    <i data-lucide="pencil" class="w-3.5 h-3.5"></i> Editar
                  </button>
                  <button class="inline-flex items-center gap-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-2.5 py-1.5 text-xs font-medium"
                          onclick="deleteEvent('<%= e.id %>')">
                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Eliminar
                  </button>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <div class="px-6 py-12 text-center">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
              <i data-lucide="inbox" class="icon-lg text-slate-400"></i>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Sin eventos</p>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Agrega un evento para comenzar</p>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <!-- Modal Agregar Evento -->
  <div id="addModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-md w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="calendar-plus" class="icon text-primary"></i>
          Agregar Evento
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="hideModal('addModal')">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6">
        <form onsubmit="addEvent(event)" class="space-y-4">
          <div>
            <label for="title" class="block text-sm font-semibold mb-2">Título *</label>
            <input id="title" required placeholder="Ej: Fiestas Patrias"
                   class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>

          <div>
            <label for="date" class="block text-sm font-semibold mb-2">Fecha *</label>
            <input id="date" type="date" required
                   class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>

          <div>
            <label for="type" class="block text-sm font-semibold mb-2">Tipo *</label>
            <select id="type" required
                    class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500">
              <option value="">Seleccionar...</option>
              <option value="holiday">🎉 Feriado</option>
              <option value="special_event">⭐ Evento Especial</option>
              <option value="closure">🔒 Cierre</option>
            </select>
          </div>

          <div>
            <label for="description" class="block text-sm font-semibold mb-2">Descripción (opcional)</label>
            <textarea id="description" placeholder="Descripción del evento..."
                      class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 min-h-[80px] resize-y"></textarea>
          </div>

          <div class="flex items-start gap-2">
            <input id="isRecurring" type="checkbox"
                   class="mt-[2px] w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-0" />
            <label for="isRecurring" class="text-sm select-none">Evento anual (se repite cada año)</label>
          </div>

          <div class="flex justify-end gap-2 pt-2">
            <button type="button"
                    class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white"
                    onclick="hideModal('addModal')">
              Cancelar
            </button>
            <button type="submit"
                    class="rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-3 py-2 shadow-soft">
              Guardar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal Editar Evento -->
  <div id="editModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-md w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="pencil" class="icon text-amber-500"></i>
          Editar Evento
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="hideModal('editModal')">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6">
        <form onsubmit="updateEvent(event)" class="space-y-4">
          <input type="hidden" id="edit-id" />
          <div>
            <label for="edit-title" class="block text-sm font-semibold mb-2">Título *</label>
            <input id="edit-title" required
                   class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>
          <div>
            <label for="edit-date" class="block text-sm font-semibold mb-2">Fecha *</label>
            <input id="edit-date" type="date" required
                   class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>
          <div>
            <label for="edit-type" class="block text-sm font-semibold mb-2">Tipo *</label>
            <select id="edit-type" required
                    class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500">
              <option value="holiday">🎉 Feriado</option>
              <option value="special_event">⭐ Evento Especial</option>
              <option value="closure">🔒 Cierre</option>
            </select>
          </div>
          <div>
            <label for="edit-description" class="block text-sm font-semibold mb-2">Descripción (opcional)</label>
            <textarea id="edit-description"
                      class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 min-h-[80px] resize-y"></textarea>
          </div>
          <div class="flex items-start gap-2">
            <input id="edit-isRecurring" type="checkbox"
                   class="mt-[2px] w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-0" />
            <label for="edit-isRecurring" class="text-sm select-none">Evento anual</label>
          </div>

          <div class="flex justify-between gap-2 pt-2">
            <button type="button"
                    class="inline-flex items-center gap-2 rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold px-3 py-2"
                    onclick="deleteEventFromModal()">
              <i data-lucide="trash-2" class="icon"></i> Eliminar
            </button>

            <div class="flex gap-2">
              <button type="button"
                      class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white"
                      onclick="hideModal('editModal')">
                Cancelar
              </button>
              <button type="submit"
                      class="rounded-lg bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold px-3 py-2">
                Actualizar
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    // Iconos
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
    });

    // ======= Estado y helpers de calendario (sin slider) =======
    const evts = <%- JSON.stringify(evts || []) %>;
    const monthGrid   = document.getElementById('monthGrid');
    const monthLabel  = document.getElementById('monthLabel');
    const yearRangeEl = document.getElementById('yearRange');

    let state = (() => {
      const d = new Date();
      return { year: d.getFullYear(), month: d.getMonth() }; // 0-11
    })();

    const pad = n => String(n).padStart(2,'0');
    const toYMD = (y,m,d) => `${y}-${pad(m+1)}-${pad(d)}`;
    const mondayIdx = d => ((d.getDay() === 0) ? 6 : d.getDay() - 1);

    function renderMonth(){
      // encabezado
      const labelDate = new Date(state.year, state.month, 1);
      monthLabel.textContent = labelDate.toLocaleDateString('es-PE', { month:'long', year:'numeric' });
      yearRangeEl.textContent = state.year;

      // grilla (6 filas x 7 columnas)
      monthGrid.innerHTML = '';
      const first = new Date(state.year, state.month, 1);
      const lead = mondayIdx(first);
      const start = new Date(state.year, state.month, 1 - lead);

      for (let i=0; i<42; i++) {
        const d = new Date(start); d.setDate(start.getDate()+i);
        const inMonth = (d.getMonth() === state.month);
        const isToday = sameYMD(d, new Date());

        const cell = document.createElement('div');
        cell.className =
          `border border-slate-100 dark:border-slate-800 p-2
           ${inMonth ? 'bg-white dark:bg-slate-900' : 'bg-slate-50/70 dark:bg-slate-900/40 text-slate-400'}`;

        // cabecera del día
        cell.innerHTML = `
          <div class="flex items-center justify-between mb-1">
            <div class="text-xs font-semibold ${inMonth ? 'text-slate-700 dark:text-white' : 'text-slate-400'}">${d.getDate()}</div>
            ${isToday ? '<span class="text-[10px] px-1.5 py-0.5 rounded bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300 font-semibold">Hoy</span>' : ''}
          </div>
        `;

        // eventos del día
        const items = evts.filter(e => e.dateYMD === toYMD(d.getFullYear(), d.getMonth(), d.getDate()));
        items.forEach(e => {
          const dot =
            e.type === 'holiday'       ? 'bg-rose-500'  :
            e.type === 'special_event' ? 'bg-amber-500' :
                                          'bg-slate-500';
          const safeTitle = escapeHtml(e.title || '');
          cell.innerHTML += `
            <button
              class="w-full text-left mt-1 flex items-center gap-2 text-xs rounded px-2 py-1 hover:bg-slate-50 dark:hover:bg-slate-800 transition"
              onclick="editEvent('${e.id}')"
              title="${safeTitle}">
              <span class="w-2 h-2 rounded-full ${dot}"></span>
              <span class="line-clamp-1">${safeTitle}</span>
            </button>
          `;
        });

        monthGrid.appendChild(cell);
      }
    }

    function sameYMD(a,b){
      return a.getFullYear()===b.getFullYear() && a.getMonth()===b.getMonth() && a.getDate()===b.getDate();
    }
    function prevMonth(){
      if (state.month === 0) { state.month = 11; state.year--; } else { state.month--; }
      renderMonth();
    }
    function nextMonth(){
      if (state.month === 11) { state.month = 0; state.year++; } else { state.month++; }
      renderMonth();
    }
    function goToday(){
      const d = new Date();
      state.year = d.getFullYear(); state.month = d.getMonth();
      renderMonth();
    }

    function escapeHtml(str){
      return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
    }

    // ======= CRUD EVENTOS =======
    async function addEvent(e){
      e.preventDefault();
      const data = {
        title: document.getElementById('title').value,
        date: document.getElementById('date').value,
        type: document.getElementById('type').value,
        description: document.getElementById('description').value,
        isRecurring: document.getElementById('isRecurring').checked
      };
      try{
        const res = await fetch('/calendar/api', {
          method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data)
        });
        const result = await res.json();
        if(result.success){ alert('✅ Evento agregado'); location.reload(); }
        else { alert('❌ Error: ' + (result.error || 'No se pudo agregar')); }
      }catch(err){ alert('❌ Error al agregar'); console.error(err); }
    }

    async function editEvent(id){
      try{
        const res = await fetch(`/calendar/api/${id}`);
        const event = await res.json();

        document.getElementById('edit-id').value = event.id;
        document.getElementById('edit-title').value = event.title || '';
        document.getElementById('edit-date').value = event.dateYMD;
        document.getElementById('edit-type').value = event.type || 'closure';
        document.getElementById('edit-description').value = event.description || '';
        document.getElementById('edit-isRecurring').checked = !!event.isRecurring;

        showModal('editModal');
      }catch(err){ alert('❌ Error al cargar'); console.error(err); }
    }

    async function updateEvent(e){
      e.preventDefault();
      const id = document.getElementById('edit-id').value;
      const data = {
        title: document.getElementById('edit-title').value,
        date: document.getElementById('edit-date').value,
        type: document.getElementById('edit-type').value,
        description: document.getElementById('edit-description').value,
        isRecurring: document.getElementById('edit-isRecurring').checked
      };
      try{
        const res = await fetch(`/calendar/api/${id}`, {
          method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data)
        });
        const result = await res.json();
        if(result.success){ alert('✅ Evento actualizado'); location.reload(); }
        else { alert('❌ Error al actualizar'); }
      }catch(err){ alert('❌ Error al actualizar'); console.error(err); }
    }

    async function deleteEvent(id){
      if(!confirm('¿Eliminar este evento?')) return;
      try{
        const res = await fetch(`/calendar/api/${id}`, { method:'DELETE' });
        const result = await res.json();
        if(result.success){ alert('✅ Evento eliminado'); location.reload(); }
        else { alert('❌ Error al eliminar'); }
      }catch(err){ alert('❌ Error al eliminar'); console.error(err); }
    }

    function deleteEventFromModal(){
      const id = document.getElementById('edit-id').value;
      hideModal('editModal');
      deleteEvent(id);
    }

    // ======= Modales (igual patrón que el ejemplo) =======
    function showModal(id){
      const el = document.getElementById(id);
      el.classList.remove('hidden');
      el.classList.add('flex');
    }
    function hideModal(id){
      const el = document.getElementById(id);
      el.classList.remove('flex');
      el.classList.add('hidden');
      if(id==='addModal'){
        document.getElementById('title').value = '';
        document.getElementById('date').value = '';
        document.getElementById('type').value = '';
        document.getElementById('description').value = '';
        document.getElementById('isRecurring').checked = false;
      }
    }
    window.addEventListener('click', (e) => {
      ['addModal','editModal'].forEach(mid=>{
        const modal = document.getElementById(mid);
        if (e.target === modal) hideModal(mid);
      });
    });

    // Inicial
    renderMonth();
  </script>
</body>
</html>
