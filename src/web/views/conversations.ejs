<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente + Tailwind -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui'] },
          colors: {
            primary: { DEFAULT: '#1e3a8a', 600: '#1e3a8a', 700:'#1e40af' },
          },
          boxShadow: {
            soft: '0 10px 25px -10px rgba(0,0,0,.15)',
          }
        }
      },
      darkMode: 'media'
    }
  </script>

  <!-- Motion / Icons -->
  <script src="https://unpkg.com/@motionone/dom/dist/motion.min.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    .sidebar-link-active {
      background-color: rgba(255,255,255,.12);
      color:#fff !important;
      font-weight:600;
    }

    /* modal overlay (mismo patrón que contactos/calendar) */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1000;
      background: rgba(0,0,0,0.6);
      backdrop-filter: blur(4px);
      padding: 1rem;
    }
    .modal.show {
      display: flex;
      align-items: flex-start;
      justify-content: center;
    }
  </style>
</head>
<body class="h-full bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-3 focus:py-2 focus:rounded-lg shadow">
    Saltar al contenido
  </a>

  <%
    const convList = Array.isArray(contacts) ? contacts : [];

    function isActive(p){
      return (page === p) ? 'sidebar-link-active' : '';
    }

    function lastPreviewText(c){
      if (!c.conversations || !c.conversations.length) return '';
      const raw = c.conversations[0].content || '';
      return raw.length > 80 ? raw.substring(0,80) + '...' : raw;
    }

    function fmtDateShort(d){
      try {
        return new Date(d).toLocaleDateString('es-PE');
      } catch {
        return '-';
      }
    }
  %>

  <div class="min-h-screen w-full flex relative">

    <!-- Overlay móvil sidebar -->
    <div id="mobile-sidebar-overlay"
         class="fixed inset-0 bg-black/40 z-40 opacity-0 pointer-events-none transition-opacity md:hidden">
    </div>

    <!-- Sidebar -->
    <aside id="sidebar"
           class="w-[280px] flex flex-col bg-gradient-to-b from-primary to-primary-700 text-white shadow-soft
                  fixed inset-y-0 left-0 z-50 -translate-x-full transition-transform md:translate-x-0 md:relative md:flex"
           role="navigation"
           aria-label="Menú principal">

      <div class="px-5 py-6 border-b border-white/10 bg-white/5 backdrop-blur flex items-center justify-between">
        <h2 class="text-xl font-semibold flex items-center gap-2">
          <i data-lucide="bot" class="w-5 h-5"></i> Bot Admin
        </h2>

        <!-- Botón cerrar sidebar móvil -->
        <button id="close-sidebar-btn"
                class="md:hidden inline-flex items-center justify-center rounded-lg text-white/70 hover:text-white hover:bg-white/10 p-2"
                aria-label="Cerrar menú">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <nav class="py-4 flex-1 overflow-y-auto">
        <ul class="px-2 space-y-1 text-[15px] leading-5">
          <li>
            <a href="/"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('dashboard') %>">
              <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
              <span>Dashboard</span>
            </a>
          </li>

          <li>
            <a href="/contacts"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('contacts') %>">
              <i data-lucide="users" class="w-5 h-5"></i>
              <span>Contactos</span>
            </a>
          </li>

          <li>
            <a href="/conversations"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('conversations') %>">
              <i data-lucide="message-circle" class="w-5 h-5"></i>
              <span>Conversaciones</span>
            </a>
          </li>

          <li>
            <a href="/blocked"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('blocked') %>">
              <i data-lucide="ban" class="w-5 h-5"></i>
              <span>Bloqueados</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/calendar"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('calendar') %>">
              <i data-lucide="calendar" class="w-5 h-5"></i>
              <span>Calendario</span>
            </a>
          </li>

          <li>
            <a href="/working-hours"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('working-hours') %>">
              <i data-lucide="clock" class="w-5 h-5"></i>
              <span>Horarios</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/departments"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('departments') %>">
              <i data-lucide="building-2" class="w-5 h-5"></i>
              <span>Departamentos</span>
            </a>
          </li>

          <li>
            <a href="/products"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('products') %>">
              <i data-lucide="package" class="w-5 h-5"></i>
              <span>Productos</span>
            </a>
          </li>

          <li>
            <a href="/auto-responses"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('auto-responses') %>">
              <i data-lucide="robot" class="w-5 h-5"></i>
              <span>Auto-respuestas</span>
            </a>
          </li>

          <li>
            <a href="/tags"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('tags') %>">
              <i data-lucide="tags" class="w-5 h-5"></i>
              <span>Tags</span>
            </a>
          </li>

          <li>
            <a href="/templates"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('templates') %>">
              <i data-lucide="file-text" class="w-5 h-5"></i>
              <span>Plantillas</span>
            </a>
          </li>

          <li>
            <a href="/metrics"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('metrics') %>">
              <i data-lucide="line-chart" class="w-5 h-5"></i>
              <span>Métricas</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/admin-users"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('admin-users') %>">
              <i data-lucide="shield" class="w-5 h-5"></i>
              <span>Usuarios Admin</span>
            </a>
          </li>

          <li>
            <a href="/settings"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('settings') %>">
              <i data-lucide="settings" class="w-5 h-5"></i>
              <span>Configuración</span>
            </a>
          </li>
        </ul>
      </nav>

      <div class="mt-auto p-4 bg-white/5 border-t border-white/10">
        <div class="rounded-xl bg-white/10 p-3">
          <div class="text-[11px] uppercase tracking-wide opacity-80">Sesión activa</div>
          <div class="font-semibold text-sm mt-1 flex items-center gap-2">
            <i data-lucide="user" class="w-4 h-4"></i>
            <span><%= user || 'Admin' %></span>
          </div>
        </div>

        <form method="POST" action="/auth/logout" class="mt-3">
          <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>
          <button type="submit"
            class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-white/20 bg-red-500/20 hover:bg-red-500/30 text-white py-2.5 text-sm font-medium transition">
            <i data-lucide="log-out" class="w-4 h-4"></i> Cerrar sesión
          </button>
        </form>
      </div>
    </aside>

    <!-- Main -->
    <main id="main-content" class="flex-1 p-4 md:p-8 md:ml-0 ml-0 w-full md:w-auto">

      <!-- Header -->
      <header class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft px-6 py-5 mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-start justify-between w-full md:w-auto">
          <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white flex items-center gap-3">
            <i data-lucide="message-circle" class="w-7 h-7 text-primary"></i>
            <span>Conversaciones</span>
          </h1>

          <!-- botón abrir sidebar móvil -->
          <button id="open-sidebar-btn"
                  class="md:hidden inline-flex items-center justify-center rounded-lg text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 p-2 shadow-soft"
                  aria-label="Abrir menú">
            <i data-lucide="menu" class="w-6 h-6"></i>
          </button>
        </div>
      </header>

      <!-- Card principal -->
      <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-soft border border-slate-100/70 dark:border-white/5">
        <!-- Search -->
        <div class="px-6 pt-6 pb-4">
          <label for="searchInput" class="sr-only">Buscar conversación</label>
          <div class="relative">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
            <input
              id="searchInput"
              type="text"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 pl-10 pr-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
              placeholder="🔍 Buscar por teléfono o nombre..."
              onkeyup="filterConversations()"
            />
          </div>
        </div>

        <!-- Lista de conversaciones -->
        <div class="px-6 pb-6">
          <% if (convList.length > 0) { %>
            <div id="conversationList" class="grid gap-4">
              <% convList.forEach(contact => { %>
                <div
                  class="group rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 shadow-soft hover:border-indigo-500 hover:shadow-lg transition cursor-pointer"
                  data-phone="<%= contact.phoneNumber %>"
                  data-name="<%= contact.name || '' %>"
                >
                  <!-- header -->
                  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2">
                    <div class="flex items-start gap-3">
                      <div class="flex flex-col">
                        <div class="text-slate-900 dark:text-white font-semibold leading-5 text-[15px]">
                          <%= contact.name || contact.phoneNumber %>
                        </div>
                        <div class="text-[13px] text-slate-500 dark:text-slate-400 flex flex-wrap gap-3 mt-1">
                          <span class="inline-flex items-center gap-1">
                            <i data-lucide="phone" class="w-4 h-4 text-slate-400"></i>
                            <%= contact.phoneNumber %>
                          </span>
                          <% if (contact.companyName) { %>
                            <span class="inline-flex items-center gap-1">
                              <i data-lucide="building-2" class="w-4 h-4 text-slate-400"></i>
                              <%= contact.companyName %>
                            </span>
                          <% } %>
                        </div>
                      </div>
                    </div>

                    <div class="text-[12px] text-slate-400 dark:text-slate-500">
                      <%= fmtDateShort(contact.updatedAt) %>
                    </div>
                  </div>

                  <!-- preview último mensaje -->
                  <% if (contact.conversations && contact.conversations.length > 0) { %>
                    <div class="mt-3 text-[13px] leading-relaxed text-slate-600 dark:text-slate-300 italic">
                      <span class="text-slate-400 dark:text-slate-500">Último mensaje:</span>
                      <%= lastPreviewText(contact) %>
                    </div>
                  <% } %>

                  <!-- acciones -->
                  <div class="flex flex-wrap gap-2 mt-4">
                    <button
                      class="inline-flex items-center justify-center rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-2.5 py-1.5 shadow-soft transition"
                      onclick="viewConversation('<%= contact.phoneNumber %>', '<%= contact.name || contact.phoneNumber %>')"
                    >
                      Ver Historial
                    </button>

                    <button
                      class="inline-flex items-center justify-center rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold px-2.5 py-1.5 shadow-soft transition"
                      onclick="deleteConversation('<%= contact.phoneNumber %>')"
                    >
                      Eliminar
                    </button>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center text-slate-500 dark:text-slate-400 py-16">
              <div class="text-4xl mb-3">😌</div>
              <p class="text-base font-semibold text-slate-700 dark:text-white mb-1">
                Sin conversaciones
              </p>
              <p class="text-sm text-slate-500 dark:text-slate-400">
                Las conversaciones aparecerán aquí cuando hablen con el bot
              </p>
            </div>
          <% } %>
        </div>
      </section>
    </main>
  </div>

  <!-- Modal Ver Conversación -->
  <div id="viewModal" class="modal">
    <div
      class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft w-full max-w-3xl border border-slate-200 dark:border-white/10 max-h-[90vh] flex flex-col overflow-hidden"
    >
      <!-- Header sticky -->
      <div class="px-6 py-4 border-b border-slate-200 dark:border-white/10 bg-slate-50/60 dark:bg-slate-800/60 backdrop-blur flex items-center justify-between sticky top-0 z-10">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
          <i data-lucide="messages-square" class="w-5 h-5 text-primary"></i>
          <span id="modalTitle">💬 Conversación</span>
        </h2>
        <button
          class="text-slate-400 hover:text-slate-600 dark:text-slate-400 dark:hover:text-white text-xl leading-none"
          onclick="hideModal('viewModal')"
        >
          &times;
        </button>
      </div>

      <!-- Body scrollable -->
      <div id="messageContainer" class="flex-1 overflow-y-auto p-6 space-y-4 text-sm">
        <!-- mensajes dinámicos -->
      </div>
    </div>
  </div>

  <script>
    // Cargar iconos lucide
    window.lucide && lucide.createIcons();

    // Sidebar móvil reutilizamos lógica
    (function(){
      const sidebar   = document.getElementById('sidebar');
      const overlay   = document.getElementById('mobile-sidebar-overlay');
      const openBtn   = document.getElementById('open-sidebar-btn');
      const closeBtn  = document.getElementById('close-sidebar-btn');

      function openSidebar(){
        sidebar.classList.remove('-translate-x-full');
        overlay.classList.remove('opacity-0','pointer-events-none');
      }
      function closeSidebar(){
        sidebar.classList.add('-translate-x-full');
        overlay.classList.add('opacity-0','pointer-events-none');
      }

      if (openBtn)  openBtn.addEventListener('click', openSidebar);
      if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
      if (overlay)  overlay.addEventListener('click', closeSidebar);
    })();

    // Filtro de conversaciones
    function filterConversations() {
      const input = document.getElementById('searchInput');
      const filter = input.value.toLowerCase();
      const cards = document.querySelectorAll('#conversationList > div[data-phone]');

      cards.forEach(card => {
        const phone = (card.dataset.phone || '').toLowerCase();
        const name = (card.dataset.name || '').toLowerCase();
        if (phone.includes(filter) || name.includes(filter)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Escape HTML helper
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // Renderizar mensaje individual como burbuja estilo chat
    function renderMessageBubble(msg){
      const isUser = msg.role === 'USER';
      const roleLabel = isUser ? '👤 Usuario' : '🤖 Bot';
      const time = new Date(msg.createdAt).toLocaleString('es-PE');

      // estilos de burbuja tailwind
      const baseBubble =
        'max-w-[80%] rounded-xl px-4 py-3 text-sm leading-relaxed shadow-soft ' +
        (isUser
          ? 'bg-indigo-50 text-slate-900 ml-auto rounded-br-md dark:bg-indigo-900/40 dark:text-white'
          : 'bg-slate-100 text-slate-900 mr-auto rounded-bl-md dark:bg-slate-800 dark:text-slate-100');

      const roleClass = 'text-[10px] font-semibold uppercase tracking-wide ' +
        (isUser
          ? 'text-indigo-500 dark:text-indigo-300'
          : 'text-slate-500 dark:text-slate-400');

      const timeClass = 'text-[10px] text-slate-400 dark:text-slate-500 mt-2';

      return `
        <div class="${isUser ? 'flex justify-end' : 'flex justify-start'}">
          <div class="${baseBubble}">
            <div class="${roleClass} mb-1">${roleLabel}</div>
            <div class="whitespace-pre-wrap break-words text-[13px]">${escapeHtml(msg.content)}</div>
            <div class="${timeClass}">${time}</div>
          </div>
        </div>
      `;
    }

    // Ver conversación
    async function viewConversation(phoneNumber, name) {
      try {
        const res = await fetch(`/conversations/api/${phoneNumber}`);
        const data = await res.json();

        // set título modal
        document.getElementById('modalTitle').textContent = `💬 ${name}`;

        const container = document.getElementById('messageContainer');

        if (data.messages && data.messages.length > 0) {
          container.innerHTML = data.messages
            .map(renderMessageBubble)
            .join('');
        } else {
          container.innerHTML = `
            <div class="text-center text-slate-500 dark:text-slate-400 py-16 text-sm">
              <div class="text-3xl mb-2">😌</div>
              <div class="font-semibold text-slate-700 dark:text-white mb-1">Sin mensajes</div>
              <div class="text-slate-500 dark:text-slate-400 text-xs">No hay historial disponible.</div>
            </div>
          `;
        }

        showModal('viewModal');

        // scroll al final
        requestAnimationFrame(() => {
          container.scrollTop = container.scrollHeight;
        });

      } catch (error) {
        alert('Error al cargar conversación');
        console.error(error);
      }
    }

    // Eliminar conversación
    async function deleteConversation(phoneNumber) {
      if (!confirm('¿Eliminar el historial completo de esta conversación?\n\nEsta acción no se puede deshacer.')) return;

      try {
        const res = await fetch(`/conversations/api/${phoneNumber}`, {
          method: 'DELETE'
        });
        const data = await res.json();

        if (data.success) {
          alert('✅ Conversación eliminada');
          location.reload();
        } else {
          alert('❌ Error al eliminar conversación');
        }
      } catch (error) {
        alert('❌ Error al eliminar conversación');
        console.error(error);
      }
    }

    // Modal show/hide
    function showModal(modalId) {
      document.getElementById(modalId).classList.add('show');
    }

    function hideModal(modalId) {
      document.getElementById(modalId).classList.remove('show');
    }

    // Cerrar modal clickeando overlay
    window.addEventListener('click', (e) => {
      const modals = document.getElementsByClassName('modal');
      for (let modal of modals) {
        if (e.target === modal) {
          modal.classList.remove('show');
        }
      }
    });
  </script>
</body>
</html>
