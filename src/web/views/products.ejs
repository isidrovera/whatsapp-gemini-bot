<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind (misma config del dashboard) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary:   { DEFAULT:'#667eea', 600:'#667eea', 700:'#5a67d8' },
            secondary: { DEFAULT:'#764ba2', 600:'#764ba2', 700:'#6b3fa0' },
          },
          boxShadow: {
            soft:'0 4px 6px -1px rgba(0,0,0,.08), 0 2px 4px -1px rgba(0,0,0,.04)',
            card:'0 10px 30px -5px rgba(0,0,0,.10)'
          }
        }
      },
      darkMode:'media'
    }
  </script>

  <!-- Utilidades externas del dashboard -->
  <link rel="stylesheet" href="/css/ui.css">

  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Gradient text */
    .gradient-text {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Icon sizes */
    .icon { width: 1.25rem; height: 1.25rem; }
    .icon-lg { width: 1.75rem; height: 1.75rem; }

    .hidden-card { display: none; }
  </style>
</head>

<body class="h-full bg-gradient-to-br from-slate-50 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 text-slate-800 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-4 focus:py-2 focus:rounded-lg shadow-lg">
    Saltar al contenido
  </a>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Volver al Dashboard + breadcrumb -->
    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <a href="/"
           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">
          <i data-lucide="arrow-left" class="icon"></i>
          <span>Volver al Dashboard</span>
        </a>
      </div>

      <nav aria-label="Breadcrumb" class="text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li class="inline-flex items-center gap-1">
            <a href="/" class="hover:underline inline-flex items-center gap-1">
              <i data-lucide="home" class="w-3.5 h-3.5"></i> Inicio
            </a>
          </li>
          <li class="select-none">/</li>
          <li class="inline-flex items-center gap-1">
            <i data-lucide="package" class="w-3.5 h-3.5"></i>
            <span class="font-medium">Productos</span>
          </li>
        </ol>
      </nav>
    </div>

    <!-- Header -->
    <header class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight gradient-text flex items-center gap-3">
            <i data-lucide="package" class="icon-lg text-primary"></i>
            Catálogo de Productos
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            Gestiona tu inventario de productos y servicios
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft transition"
            onclick="openNewProductModal()">
            <i data-lucide="plus-circle" class="icon"></i>
            <span>Nuevo Producto</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Buscador y filtros -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center">
            <i data-lucide="search" class="icon text-indigo-600 dark:text-indigo-400"></i>
          </div>
          Buscar Productos
        </h2>
      </div>

      <div class="p-6">
        <div class="flex flex-col sm:flex-row gap-4">
          <div class="flex-1">
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
              Buscar por nombre, categoría o descripción
            </label>
            <input
              id="searchInput"
              type="text"
              class="w-full rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 transition"
              placeholder="Ej: Impresora HP, Tóner Negro"
              oninput="filterProducts()"
            />
          </div>

          <div class="flex-shrink-0 sm:w-64">
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
              Filtrar por categoría
            </label>
            <select
              id="categoryFilter"
              onchange="filterProducts()"
              class="w-full rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm text-slate-900 dark:text-slate-100 outline-none focus:border-indigo-500 transition">
              <option value="">Todas las categorías</option>
              <% if (categories && categories.length > 0) { %>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat %>"><%= cat %></option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <div class="flex-shrink-0 sm:w-48">
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
              Estado
            </label>
            <select
              id="statusFilter"
              onchange="filterProducts()"
              class="w-full rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm text-slate-900 dark:text-slate-100 outline-none focus:border-indigo-500 transition">
              <option value="">Todos</option>
              <option value="true">Activos</option>
              <option value="false">Inactivos</option>
            </select>
          </div>
        </div>

        <div class="mt-4 text-sm text-slate-500 dark:text-slate-400">
          Mostrando: <span id="countVisible" class="font-semibold text-slate-700 dark:text-slate-200"><%= (products||[]).length %></span> / <%= (products||[]).length %> productos
        </div>
      </div>
    </section>

    <!-- Lista de Productos -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center">
            <i data-lucide="list" class="icon text-blue-600 dark:text-blue-400"></i>
          </div>
          Lista de Productos
        </h2>
      </div>

      <div class="p-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3" id="productsList">
        <% if (products && products.length > 0) { %>
          <% products.forEach(product => { %>
            <div
              class="product-card group relative rounded-xl border shadow-card p-5 bg-white dark:bg-slate-900
                     transition hover:shadow-lg hover:border-indigo-400/60 hover:bg-slate-50/60 dark:hover:bg-white/5
                     border-slate-200/70 dark:border-slate-700/70"
              data-category="<%= product.category %>"
              data-status="<%= product.isActive %>"
              data-search-text="<%- [
                product.name || '',
                product.category || '',
                product.description || '',
                ...(product.keywords||[]).map(k=>k.keyword).join(' ')
              ].join(' ').toLowerCase() %>"
            >
              <!-- Imagen / Placeholder -->
              <div class="w-full h-36 rounded-lg overflow-hidden bg-slate-100 dark:bg-slate-800 flex items-center justify-center mb-4 shadow-inner">
                <% if (product.imageUrl) { %>
                  <img src="<%= product.imageUrl %>" alt="<%= product.name %>"
                       class="w-full h-full object-cover object-center"/>
                <% } else { %>
                  <i data-lucide="image" class="w-10 h-10 text-slate-400"></i>
                <% } %>
              </div>

              <!-- Nombre + estado -->
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <div class="text-base font-semibold text-slate-900 dark:text-white flex-1">
                  <%= product.name %>
                </div>

                <span class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-[11px] font-semibold uppercase tracking-wide
                             <%= product.isActive
                                  ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300'
                                  : 'bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300' %>">
                  <i data-lucide="<%= product.isActive ? 'check' : 'x' %>" class="w-3.5 h-3.5"></i>
                  <%= product.isActive ? 'Activo' : 'Inactivo' %>
                </span>
              </div>

              <!-- Categoría -->
              <div class="text-[13px] text-slate-500 dark:text-slate-400 font-medium mb-3 flex items-center gap-1">
                <i data-lucide="folder" class="w-4 h-4 text-primary"></i>
                <span><%= product.category %></span>
              </div>

              <!-- Descripción -->
              <% if (product.description) { %>
                <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-3 line-clamp-3">
                  <%= product.description %>
                </p>
              <% } else { %>
                <p class="text-sm text-slate-400 dark:text-slate-500 italic mb-3">Sin descripción</p>
              <% } %>

              <!-- Precio -->
              <% if (product.price) { %>
                <div class="text-lg font-bold text-emerald-600 dark:text-emerald-400 mb-4">
                  S/ <%= product.price.toFixed(2) %>
                </div>
              <% } %>

              <!-- Keywords -->
              <div class="flex flex-wrap gap-1.5 mb-4 min-h-[28px]">
                <% if (product.keywords && product.keywords.length > 0) { %>
                  <% product.keywords.slice(0,3).forEach(kw => { %>
                    <span class="inline-flex items-center rounded-md bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                      <%= kw.keyword %>
                    </span>
                  <% }) %>
                  <% if (product.keywords.length > 3) { %>
                    <span class="inline-flex items-center rounded-md bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                      +<%= product.keywords.length - 3 %>
                    </span>
                  <% } %>
                <% } else { %>
                  <span class="text-[12px] text-slate-400 italic">Sin keywords</span>
                <% } %>
              </div>

              <!-- Acciones -->
              <div class="flex flex-wrap gap-2">
                <button
                  class="inline-flex items-center gap-1 rounded-lg bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                  onclick="editProduct('<%= product.id %>')">
                  <i data-lucide="edit-2" class="w-3.5 h-3.5"></i>
                  <span>Editar</span>
                </button>

                <button
                  class="inline-flex items-center gap-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                  onclick="manageKeywords('<%= product.id %>')">
                  <i data-lucide="key" class="w-3.5 h-3.5"></i>
                  <span>Keywords</span>
                </button>

                <button
                  class="inline-flex items-center gap-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                  onclick="askDeleteProduct('<%= product.id %>')">
                  <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                  <span>Eliminar</span>
                </button>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-span-full py-16 text-center">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
              <i data-lucide="inbox" class="icon-lg text-slate-400"></i>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">No hay productos configurados</p>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Crea uno nuevo para comenzar</p>
          </div>
        <% } %>
      </div>
    </section>

  </main>

  <!-- Modal Crear/Editar Producto -->
  <div id="product-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-xl w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between sticky top-0 bg-white dark:bg-slate-900 z-10">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="package" class="icon text-primary"></i>
          <span id="product-modal-title">Nuevo Producto</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="closeProductModal()">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6">
        <input type="hidden" id="productId" />

        <div class="grid gap-4 md:grid-cols-2">
          <div class="md:col-span-2">
            <label class="block text-sm font-semibold mb-2">Nombre *</label>
            <input id="productName" type="text" required class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2">Categoría *</label>
            <input id="productCategory" type="text" required placeholder="ej: Impresora, Tóner" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2">Precio (S/)</label>
            <input id="productPrice" type="number" step="0.01" min="0" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>

          <div class="md:col-span-2">
            <label class="block text-sm font-semibold mb-2">Descripción</label>
            <textarea id="productDescription" rows="3" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 min-h-[80px]"></textarea>
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2">URL de imagen</label>
            <input id="productImageUrl" type="text" placeholder="https://..." class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2">Estado</label>
            <select id="productActive" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500">
              <option value="true">Activo</option>
              <option value="false">Inactivo</option>
            </select>
          </div>
        </div>

        <div class="mt-6 flex justify-end gap-2 pt-2 border-t border-slate-200 dark:border-slate-700">
          <button
            type="button"
            class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition"
            onclick="closeProductModal()">
            Cancelar
          </button>

          <button
            id="product-save-btn"
            class="rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition"
            onclick="submitProductForm()">
            Guardar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Keywords -->
  <div id="keyword-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-md w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="key" class="icon text-primary"></i>
          <span>Gestionar Keywords</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="closeKeywordModal()">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6">
        <input type="hidden" id="keywordProductId" />
        
        <!-- Lista actual de keywords -->
        <div id="keywordsList" class="mb-5 text-sm text-slate-700 dark:text-slate-200">
          <div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400 font-semibold mb-2">
            Keywords actuales:
          </div>
          <div id="keywordsChips" class="flex flex-wrap gap-2">
            <!-- dinámico -->
          </div>
        </div>

        <!-- Agregar nueva -->
        <div class="grid gap-4">
          <div>
            <label class="block text-sm font-semibold mb-2">Nueva palabra clave</label>
            <input id="keywordText" type="text" placeholder="ej: hp laserjet, toner negro" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>
        </div>

        <div class="mt-6 flex justify-end gap-2 pt-2 border-t border-slate-200 dark:border-slate-700">
          <button class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition" onclick="closeKeywordModal()">Cerrar</button>
          <button class="rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition" onclick="submitKeywordForm()">Agregar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Confirmación -->
  <div id="confirm-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-md w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="alert-triangle" class="icon text-rose-600"></i>
          <span>¿Confirmar?</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="closeConfirmModal()">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6">
        <div id="confirmText" class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Esta acción no se puede deshacer.
        </div>

        <div class="mt-6 flex justify-end gap-2 pt-2 border-t border-slate-200 dark:border-slate-700">
          <button class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition" onclick="closeConfirmModal()">Cancelar</button>
          <button id="confirmOkBtn" class="rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition">Aceptar</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Iconos
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
    });

    // === Refs
    const searchInputEl  = document.getElementById('searchInput');
    const categoryFilterEl = document.getElementById('categoryFilter');
    const statusFilterEl = document.getElementById('statusFilter');
    const countVisibleEl = document.getElementById('countVisible');

    // === Filtrado
    function filterProducts() {
      const searchQuery = (searchInputEl.value || '').trim().toLowerCase();
      const category = categoryFilterEl.value;
      const status = statusFilterEl.value;
      
      const cards = document.querySelectorAll('.product-card');
      let visible = 0;

      cards.forEach(card => {
        const searchText = card.getAttribute('data-search-text') || '';
        const cardCategory = card.getAttribute('data-category');
        const cardStatus = card.getAttribute('data-status');

        const matchSearch = !searchQuery || searchText.includes(searchQuery);
        const matchCategory = !category || cardCategory === category;
        const matchStatus = !status || cardStatus === status;

        const match = matchSearch && matchCategory && matchStatus;
        
        card.classList.toggle('hidden-card', !match);
        if (match) visible++;
      });

      countVisibleEl.textContent = String(visible);
    }

    // === Modales (helpers comunes)
    function openFlex(id){ const el = document.getElementById(id); el.classList.remove('hidden'); el.classList.add('flex'); }
    function closeFlex(id){ const el = document.getElementById(id); el.classList.remove('flex'); el.classList.add('hidden'); }

    // === Producto CRUD
    const productModal = 'product-modal';
    const productTitleEl = document.getElementById('product-modal-title');
    const productIdEl = document.getElementById('productId');
    const productNameEl = document.getElementById('productName');
    const productCategoryEl = document.getElementById('productCategory');
    const productDescriptionEl = document.getElementById('productDescription');
    const productPriceEl = document.getElementById('productPrice');
    const productImageUrlEl = document.getElementById('productImageUrl');
    const productActiveEl = document.getElementById('productActive');

    function openNewProductModal() {
      productTitleEl.textContent = 'Nuevo Producto';
      productIdEl.value = '';
      productNameEl.value = '';
      productCategoryEl.value = '';
      productDescriptionEl.value = '';
      productPriceEl.value = '';
      productImageUrlEl.value = '';
      productActiveEl.value = 'true';
      openFlex(productModal);
    }

    async function editProduct(id) {
      try {
        const res = await fetch(`/products/api/${id}`);
        const product = await res.json();

        productTitleEl.textContent = 'Editar Producto';
        productIdEl.value = product.id || '';
        productNameEl.value = product.name || '';
        productCategoryEl.value = product.category || '';
        productDescriptionEl.value = product.description || '';
        productPriceEl.value = product.price != null ? product.price : '';
        productImageUrlEl.value = product.imageUrl || '';
        productActiveEl.value = product.isActive ? 'true' : 'false';

        openFlex(productModal);
      } catch (err) {
        alert('❌ Error al cargar el producto');
        console.error(err);
      }
    }

    function closeProductModal() {
      closeFlex(productModal);
    }

    async function submitProductForm() {
      const id = productIdEl.value;
      const data = {
        name: productNameEl.value.trim(),
        category: productCategoryEl.value.trim(),
        description: productDescriptionEl.value.trim(),
        price: productPriceEl.value ? parseFloat(productPriceEl.value) : undefined,
        imageUrl: productImageUrlEl.value.trim(),
        isActive: productActiveEl.value === 'true'
      };

      if (!data.name || !data.category) {
        alert('Nombre y categoría son obligatorios');
        return;
      }

      try {
        const url = id ? `/products/api/${id}` : '/products/api';
        const method = id ? 'PUT' : 'POST';

        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (res.ok) {
          alert('✅ Producto guardado');
          location.reload();
        } else {
          alert('❌ No se pudo guardar el producto');
        }
      } catch (err) {
        alert('❌ Error: ' + err.message);
      }
    }

    // === Eliminar Producto
    function askDeleteProduct(id) {
      document.getElementById('confirmText').textContent =
        '¿Eliminar este producto? Esta acción no se puede deshacer.';

      const okBtn = document.getElementById('confirmOkBtn');
      okBtn.onclick = async () => {
        try {
          const res = await fetch(`/products/api/${id}`, { method: 'DELETE' });
          if (res.ok) {
            alert('✅ Producto eliminado');
            location.reload();
          } else {
            alert('❌ No se pudo eliminar el producto');
          }
        } catch (err) {
          alert('❌ Error: ' + err.message);
        }
      };

      openFlex('confirm-modal');
    }

    function closeConfirmModal() {
      closeFlex('confirm-modal');
    }

    // === Keywords
    const keywordModal = 'keyword-modal';
    const keywordProductIdEl = document.getElementById('keywordProductId');
    const keywordTextEl = document.getElementById('keywordText');
    const keywordsChipsEl = document.getElementById('keywordsChips');

    async function manageKeywords(productId) {
      keywordProductIdEl.value = productId;
      keywordTextEl.value = '';
      keywordsChipsEl.innerHTML = '<span class="text-slate-400 text-xs">Cargando…</span>';

      try {
        const res = await fetch(`/products/api/${productId}`);
        const product = await res.json();

        if (product.keywords && product.keywords.length > 0) {
          keywordsChipsEl.innerHTML = '';
          product.keywords.forEach(kw => {
            const chip = document.createElement('span');
            chip.className = 'inline-flex items-center gap-1 rounded-md bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300 px-2 py-0.5 text-[11px] font-semibold leading-none';
            chip.innerHTML = `
              ${kw.keyword}
              <button class="ml-1 hover:text-rose-600" title="Eliminar" onclick="askDeleteKeyword('${kw.id}')">
                <i data-lucide="x" class="w-3.5 h-3.5"></i>
              </button>
            `;
            keywordsChipsEl.appendChild(chip);
          });
          if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
        } else {
          keywordsChipsEl.innerHTML = '<span class="text-xs text-slate-400 italic">Sin keywords</span>';
        }
      } catch (err) {
        keywordsChipsEl.innerHTML = '<span class="text-rose-500 text-xs">Error cargando keywords</span>';
        console.error(err);
      }

      openFlex(keywordModal);
    }

    function closeKeywordModal() {
      closeFlex(keywordModal);
    }

    async function submitKeywordForm() {
      const productId = keywordProductIdEl.value;
      const keyword = keywordTextEl.value.trim();

      if (!keyword) {
        alert('Ingresa una palabra clave');
        return;
      }

      try {
        const res = await fetch(`/products/api/${productId}/keywords`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ keyword })
        });

        if (res.ok) {
          alert('✅ Keyword agregada');
          location.reload();
        } else {
          alert('❌ No se pudo agregar la keyword');
        }
      } catch (err) {
        alert('❌ Error: ' + err.message);
      }
    }

    function askDeleteKeyword(id) {
      document.getElementById('confirmText').textContent = '¿Eliminar esta keyword?';

      const okBtn = document.getElementById('confirmOkBtn');
      okBtn.onclick = async () => {
        try {
          const res = await fetch(`/products/api/keywords/${id}`, { method: 'DELETE' });
          if (res.ok) {
            alert('✅ Keyword eliminada');
            location.reload();
          } else {
            alert('❌ No se pudo eliminar la keyword');
          }
        } catch (err) {
          alert('❌ Error: ' + err.message);
        }
      };

      openFlex('confirm-modal');
    }

    // Cerrar modales al click fuera
    window.addEventListener('click', (e) => {
      ['product-modal', 'keyword-modal', 'confirm-modal'].forEach(mid => {
        const m = document.getElementById(mid);
        if (e.target === m) closeFlex(mid);
      });
    });

    // Exponer funciones
    window.filterProducts = filterProducts;
    window.openNewProductModal = openNewProductModal;
    window.closeProductModal = closeProductModal;
    window.editProduct = editProduct;
    window.submitProductForm = submitProductForm;
    window.askDeleteProduct = askDeleteProduct;
    window.closeConfirmModal = closeConfirmModal;
    window.manageKeywords = manageKeywords;
    window.closeKeywordModal = closeKeywordModal;
    window.submitKeywordForm = submitKeywordForm;
    window.askDeleteKeyword = askDeleteKeyword;
  </script>
</body>
</html>