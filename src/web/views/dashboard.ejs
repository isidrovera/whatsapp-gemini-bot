<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente + Tailwind -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui'] },
          colors: {
            primary: { DEFAULT: '#667eea', 600: '#667eea', 700:'#5a67d8' },
            secondary: { DEFAULT: '#764ba2', 600: '#764ba2', 700:'#6b3fa0' },
          },
          boxShadow: {
            soft: '0 4px 6px -1px rgba(0,0,0,.08), 0 2px 4px -1px rgba(0,0,0,.04)',
            card: '0 10px 30px -5px rgba(0,0,0,.1)',
          },
          animation: {
            'fade-in': 'fadeIn 0.5s ease-out',
            'slide-up': 'slideUp 0.5s ease-out',
            'scale-in': 'scaleIn 0.3s ease-out',
          },
          keyframes: {
            fadeIn: {
              '0%': { opacity: '0' },
              '100%': { opacity: '1' },
            },
            slideUp: {
              '0%': { opacity: '0', transform: 'translateY(10px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' },
            },
            scaleIn: {
              '0%': { opacity: '0', transform: 'scale(0.95)' },
              '100%': { opacity: '1', transform: 'scale(1)' },
            },
          }
        }
      },
      darkMode: 'media'
    }
  </script>

  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }
    
    /* Sidebar active state */
    .sidebar-link-active {
      background: linear-gradient(135deg, rgba(255,255,255,.15) 0%, rgba(255,255,255,.08) 100%);
      color: #fff !important;
      font-weight: 600;
      box-shadow: 0 2px 8px rgba(0,0,0,.1);
    }

    /* Smooth scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.3);
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(148, 163, 184, 0.5);
    }

    /* Card hover effect */
    .card-hover {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .card-hover:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px -10px rgba(0,0,0,.15);
    }

    /* Gradient text */
    .gradient-text {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Pulse animation for status indicators */
    @keyframes pulse-ring {
      0% {
        transform: scale(0.95);
        opacity: 1;
      }
      50% {
        transform: scale(1.05);
        opacity: 0.7;
      }
      100% {
        transform: scale(0.95);
        opacity: 1;
      }
    }
    .pulse-ring {
      animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
  </style>
</head>
<body class="h-full bg-gradient-to-br from-slate-50 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 text-slate-800 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-4 focus:py-2 focus:rounded-lg shadow-lg">
    Saltar al contenido
  </a>

  <%
    // Helpers / Defaults
    const s  = (typeof stats !== 'undefined' && stats && typeof stats === 'object') ? stats : {};
    const rc = (typeof recentContacts !== 'undefined' && Array.isArray(recentContacts)) ? recentContacts : [];
    const rp = (typeof recentProducts !== 'undefined' && Array.isArray(recentProducts)) ? recentProducts : [];
    const ws = (typeof whatsappStatus !== 'undefined' && whatsappStatus && typeof whatsappStatus === 'object')
      ? whatsappStatus
      : { connected:false, hasQR:false };

    const nf = new Intl.NumberFormat('es-PE');
    const df = new Intl.DateTimeFormat('es-PE', { dateStyle: 'short' });
    function fmtNum(v){ return nf.format(Number(v || 0)); }
    function fmtDate(d){ try { return df.format(new Date(d)); } catch { return '-'; } }
    function isActive(p){ return (page === p || (!page && p==='dashboard')) ? 'sidebar-link-active' : ''; }
  %>

  <div class="min-h-screen w-full flex relative">

    <!-- Overlay móvil -->
    <div id="mobile-sidebar-overlay"
         class="fixed inset-0 bg-black/50 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden">
    </div>

    <!-- Sidebar -->
    <aside id="sidebar"
           class="w-72 flex flex-col bg-gradient-to-br from-primary via-primary-600 to-secondary text-white shadow-2xl
                  fixed inset-y-0 left-0 z-50 -translate-x-full transition-transform duration-300 ease-out md:translate-x-0 md:relative md:flex"
           role="navigation"
           aria-label="Menú principal">

      <!-- Header -->
      <div class="px-6 py-6 border-b border-white/10 bg-white/5 backdrop-blur-sm">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-white/20 backdrop-blur-sm flex items-center justify-center shadow-lg">
              <i data-lucide="bot" class="w-6 h-6"></i>
            </div>
            <div>
              <h2 class="text-lg font-bold">Bot Admin</h2>
              <p class="text-xs text-white/70">Panel de control</p>
            </div>
          </div>

          <!-- Botón cerrar sidebar móvil -->
          <button id="close-sidebar-btn"
                  class="md:hidden inline-flex items-center justify-center rounded-lg text-white/70 hover:text-white hover:bg-white/10 p-2 transition"
                  aria-label="Cerrar menú">
            <i data-lucide="x" class="w-5 h-5"></i>
          </button>
        </div>
      </div>

      <!-- Navigation -->
      <nav class="py-4 flex-1 overflow-y-auto">
        <ul class="px-3 space-y-1 text-sm">
          <li>
            <a href="/"
               class="group flex items-center gap-3 rounded-xl px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-all <%= isActive('dashboard') %>"
               aria-current="<%= isActive('dashboard') ? 'page' : false %>">
              <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
              <span>Dashboard</span>
            </a>
          </li>

          <li>
            <a href="/contacts"
               class="group flex items-center gap-3 rounded-xl px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-all <%= isActive('contacts') %>"
               aria-current="<%= isActive('contacts') ? 'page' : false %>">
              <i data-lucide="users" class="w-5 h-5"></i>
              <span>Contactos</span>
            </a>
          </li>

          <li>
            <a href="/conversations"
               class="group flex items-center gap-3 rounded-xl px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-all <%= isActive('conversations') %>"
               aria-current="<%= isActive('conversations') ? 'page' : false %>">
              <i data-lucide="message-circle" class="w-5 h-5"></i>
              <span>Conversaciones</span>
            </a>
          </li>

          <li>
            <a href="/blocked"
               class="group flex items-center gap-3 rounded-xl px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-all <%= isActive('blocked') %>"
               aria-current="<%= isActive('blocked') ? 'page' : false %>">
              <i data-lucide="ban" class="w-5 h-5"></i>
              <span>Bloqueados</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/calendar"
               class="group flex items-center gap-3 rounded-xl px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-all <%= isActive('calendar') %>"
               aria-current="<%= isActive('calendar') ? 'page' : false %>">
              <i data-lucide="calendar" class="w-5 h-5"></i>
              <span>Calendario</span>
            </a>
          </li>

          <li>
            <a href="/working-hours"
               class="group flex items-center gap-3 rounded-xl px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-all <%= isActive('working-hours') %>"
               aria-current="<%= isActive('working-hours') ? 'page' : false %>">
              <i data-lucide="clock" class="w-5 h-5"></i>
              <span>Horarios</span>
            </a>
          </li>

          <li>
            <a href="/admin-users"
               class="group flex items-center gap-3 rounded-xl px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-all <%= isActive('admin-users') %>"
               aria-current="<%= isActive('admin-users') ? 'page' : false %>">
              <i data-lucide="shield" class="w-5 h-5"></i>
              <span>Usuarios Admin</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/settings"
               class="group flex items-center gap-3 rounded-xl px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-all <%= isActive('settings') %>"
               aria-current="<%= isActive('settings') ? 'page' : false %>">
              <i data-lucide="settings" class="w-5 h-5"></i>
              <span>Configuración</span>
            </a>
          </li>

          <li>
            <a href="/departments"
               class="group flex items-center gap-3 rounded-xl px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-all <%= isActive('departments') %>"
               aria-current="<%= isActive('departments') ? 'page' : false %>">
              <i data-lucide="building-2" class="w-5 h-5"></i>
              <span>Departamentos</span>
            </a>
          </li>

          <li>
            <a href="/products"
               class="group flex items-center gap-3 rounded-xl px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-all <%= isActive('products') %>"
               aria-current="<%= isActive('products') ? 'page' : false %>">
              <i data-lucide="package" class="w-5 h-5"></i>
              <span>Productos</span>
            </a>
          </li>

          <li>
            <a href="/auto-responses"
               class="group flex items-center gap-3 rounded-xl px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-all <%= isActive('auto-responses') %>"
               aria-current="<%= isActive('auto-responses') ? 'page' : false %>">
              <i data-lucide="bot" class="w-5 h-5"></i>
              <span>Auto-respuestas</span>
            </a>
          </li>

          <li>
            <a href="/tags"
               class="group flex items-center gap-3 rounded-xl px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-all <%= isActive('tags') %>"
               aria-current="<%= isActive('tags') ? 'page' : false %>">
              <i data-lucide="tag" class="w-5 h-5"></i>
              <span>Tags</span>
            </a>
          </li>

          <li>
            <a href="/templates"
               class="group flex items-center gap-3 rounded-xl px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-all <%= isActive('templates') %>"
               aria-current="<%= isActive('templates') ? 'page' : false %>">
              <i data-lucide="file-text" class="w-5 h-5"></i>
              <span>Plantillas</span>
            </a>
          </li>

          <li>
            <a href="/metrics"
               class="group flex items-center gap-3 rounded-xl px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-all <%= isActive('metrics') %>"
               aria-current="<%= isActive('metrics') ? 'page' : false %>">
              <i data-lucide="bar-chart-3" class="w-5 h-5"></i>
              <span>Métricas</span>
            </a>
          </li>

          <li>
            <a href="/companies"
              class="group flex items-center gap-3 rounded-xl px-4 py-2.5 text-white/80 hover:text-white hover:bg-white/10 transition-all <%= isActive('companies') %>"
              aria-current="<%= isActive('companies') ? 'page' : false %>">
              <i data-lucide="building" class="w-5 h-5"></i>
              <span>Empresas</span>
            </a>
          </li>
        </ul>
      </nav>

      <!-- User section -->
      <div class="mt-auto p-4 bg-black/10 border-t border-white/10 backdrop-blur-sm">
        <div class="rounded-xl bg-white/10 backdrop-blur-sm p-3.5 mb-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center">
              <i data-lucide="user" class="w-5 h-5"></i>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-xs text-white/60 font-medium">Sesión activa</p>
              <p class="font-semibold text-sm truncate"><%= user || 'Admin' %></p>
            </div>
          </div>
        </div>
        
        <form method="POST" action="/auth/logout">
          <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>
          <button type="submit"
                  class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-red-500/20 hover:bg-red-500/30 backdrop-blur-sm text-white py-2.5 text-sm font-medium transition-all shadow-lg hover:shadow-xl">
            <i data-lucide="log-out" class="w-4 h-4"></i> 
            <span>Cerrar sesión</span>
          </button>
        </form>
      </div>
    </aside>

    <!-- Main Content -->
    <main id="main-content" class="flex-1 p-4 md:p-8 w-full overflow-x-hidden">

      <!-- Header -->
      <header class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 px-6 py-5 mb-8 animate-fade-in">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          
          <div class="flex items-center justify-between w-full md:w-auto">
            <div>
              <h1 class="text-3xl font-bold tracking-tight gradient-text flex items-center gap-3">
                <i data-lucide="bar-chart-3" class="w-8 h-8 text-primary"></i>
                Dashboard
              </h1>
              <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Vista general del sistema</p>
            </div>

            <!-- Botón abrir sidebar móvil -->
            <button id="open-sidebar-btn"
                    class="md:hidden inline-flex items-center justify-center rounded-xl text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 p-2.5 shadow-soft transition"
                    aria-label="Abrir menú">
              <i data-lucide="menu" class="w-6 h-6"></i>
            </button>
          </div>

          <!-- WhatsApp Status -->
          <div class="flex flex-col sm:flex-row sm:items-center gap-3">
            <%
              const status = ws.connected ? 'connected' : 'disconnected';
              const label  = 'WhatsApp';
              const value  = ws.connected ? 'Conectado' : (ws.hasQR ? 'Esperando escaneo' : 'Desconectado');
              const icon   = ws.connected ? 'check-circle' : (ws.hasQR ? 'qr-code' : 'x-circle');
              const badgeClass = ws.connected
                ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20'
                : ws.hasQR
                  ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20'
                  : 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20';
            %>

            <div class="inline-flex items-center gap-2.5 rounded-xl px-4 py-2.5 text-sm font-medium border <%= badgeClass %> backdrop-blur-sm <%= ws.connected ? 'pulse-ring' : '' %>">
              <i data-lucide="<%= icon %>" class="w-4 h-4"></i>
              <span class="font-semibold"><%= value %></span>
            </div>

            <% if (ws.connected && ws.botNumber) { %>
              <div class="inline-flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-3 py-2 rounded-xl">
                <i data-lucide="phone" class="w-4 h-4"></i>
                <span class="font-medium"><%= ws.botNumber %></span>
              </div>
            <% } %>

            <% if (!ws.connected && ws.hasQR) { %>
              <a href="/auth/qr"
                 class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white px-4 py-2.5 text-sm font-semibold transition-all shadow-lg hover:shadow-xl">
                <i data-lucide="qr-code" class="w-4 h-4"></i> 
                <span>Ver QR</span>
              </a>
            <% } %>

            <% if (ws.connected) { %>
              <button
                class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-rose-500 to-red-600 hover:from-rose-600 hover:to-red-700 text-white px-4 py-2.5 text-sm font-semibold transition-all shadow-lg hover:shadow-xl"
                onclick="disconnectWhatsApp()">
                <i data-lucide="power" class="w-4 h-4"></i>
                <span>Desconectar</span>
              </button>
            <% } %>
          </div>
        </div>
      </header>

      <!-- KPI Cards -->
      <section aria-label="Indicadores principales"
               class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 mb-8">

        <% const cards = [
          { t:'TOTAL CONTACTOS',    n:fmtNum(s.totalContacts),       l:'Usuarios en el sistema',            bg:'bg-blue-50 dark:bg-blue-900/10', tc:'text-blue-600 dark:text-blue-400', ic:'bg-blue-100 dark:bg-blue-900/30', i:'users' },
          { t:'REGISTRADOS',        n:fmtNum(s.registeredContacts),  l:'Con DNI y RUC',                     bg:'bg-emerald-50 dark:bg-emerald-900/10', tc:'text-emerald-600 dark:text-emerald-400', ic:'bg-emerald-100 dark:bg-emerald-900/30', i:'user-check' },
          { t:'BLOQUEADOS',         n:fmtNum(s.blockedCount),        l:'Números/grupos bloqueados',         bg:'bg-rose-50 dark:bg-rose-900/10', tc:'text-rose-600 dark:text-rose-400', ic:'bg-rose-100 dark:bg-rose-900/30', i:'user-x' },
          { t:'MENSAJES TOTALES',   n:fmtNum(s.totalMessages),       l:'En historial completo',             bg:'bg-violet-50 dark:bg-violet-900/10', tc:'text-violet-600 dark:text-violet-400', ic:'bg-violet-100 dark:bg-violet-900/30', i:'messages-square' },
          { t:'MENSAJES HOY',       n:fmtNum(s.messagesToday),       l:'Conversaciones activas',            bg:'bg-orange-50 dark:bg-orange-900/10', tc:'text-orange-600 dark:text-orange-400', ic:'bg-orange-100 dark:bg-orange-900/30', i:'message-circle' },
          { t:'HUMAN TAKEOVER',     n:fmtNum(s.humanTakeovers),      l:'Intervenciones activas',            bg:'bg-yellow-50 dark:bg-yellow-900/10', tc:'text-yellow-600 dark:text-yellow-400', ic:'bg-yellow-100 dark:bg-yellow-900/30', i:'hand' },
          { t:'DEPARTAMENTOS',      n:fmtNum(s.departmentsCount),    l:'Áreas operativas',                  bg:'bg-cyan-50 dark:bg-cyan-900/10', tc:'text-cyan-600 dark:text-cyan-400', ic:'bg-cyan-100 dark:bg-cyan-900/30', i:'building-2' },
          { t:'PRODUCTOS',          n:fmtNum(s.productsCount),       l:'Catálogo activo',                   bg:'bg-indigo-50 dark:bg-indigo-900/10', tc:'text-indigo-600 dark:text-indigo-400', ic:'bg-indigo-100 dark:bg-indigo-900/30', i:'package' },
          { t:'AUTO-RESPUESTAS',    n:fmtNum(s.autoResponsesCount),  l:'Flows y reglas',                    bg:'bg-teal-50 dark:bg-teal-900/10', tc:'text-teal-600 dark:text-teal-400', ic:'bg-teal-100 dark:bg-teal-900/30', i:'bot' },
          { t:'TAGS',               n:fmtNum(s.tagsCount),           l:'Segmentación',                      bg:'bg-sky-50 dark:bg-sky-900/10', tc:'text-sky-600 dark:text-sky-400', ic:'bg-sky-100 dark:bg-sky-900/30', i:'tags' },
          { t:'PLANTILLAS',         n:fmtNum(s.templatesCount),      l:'Mensajes predefinidos',             bg:'bg-fuchsia-50 dark:bg-fuchsia-900/10', tc:'text-fuchsia-600 dark:text-fuchsia-400', ic:'bg-fuchsia-100 dark:bg-fuchsia-900/30', i:'file-text' },
        ]; %>

        <% cards.forEach((card, idx) => { %>
          <div
            class="group relative overflow-hidden rounded-2xl <%= card.bg %> shadow-soft hover:shadow-card border border-slate-200/50 dark:border-white/5 p-6 transition-all duration-300 card-hover animate-slide-up"
            style="animation-delay: <%= idx * 0.05 %>s"
            data-card
          >
            <!-- Icon in top right -->
            <div class="absolute top-4 right-4 w-14 h-14 rounded-2xl <%= card.ic %> flex items-center justify-center opacity-40">
              <i data-lucide="<%= card.i %>" class="w-7 h-7 <%= card.tc %>"></i>
            </div>

            <div class="relative">
              <h3 class="text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 font-semibold mb-3"><%= card.t %></h3>
              <div class="text-5xl font-black <%= card.tc %> mb-2" data-kpi><%= card.n %></div>
              <p class="text-sm text-slate-600 dark:text-slate-400"><%= card.l %></p>
            </div>
          </div>
        <% }) %>
      </section>

      <!-- Quick Actions -->
      <section aria-label="Accesos rápidos" class="mb-8 animate-fade-in">
        <h2 class="text-xl font-bold text-slate-800 dark:text-white mb-4 flex items-center gap-2">
          <i data-lucide="zap" class="w-5 h-5 text-primary"></i>
          Acciones rápidas
        </h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <button
            type="button"
            onclick="safeNavigate('/products/new')"
            class="group text-left relative overflow-hidden rounded-2xl bg-white dark:bg-slate-900 p-6 border border-slate-200/50 dark:border-white/5 shadow-soft hover:shadow-card transition-all duration-300 card-hover w-full">
            <div class="absolute -right-6 -top-6 w-24 h-24 rounded-full bg-gradient-to-br from-indigo-500 to-blue-600 opacity-5 group-hover:opacity-10 transition-opacity"></div>
            <div class="relative flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-500 to-blue-600 opacity-10 flex items-center justify-center flex-shrink-0">
                <i data-lucide="plus-circle" class="w-6 h-6 text-indigo-600 dark:text-indigo-400"></i>
              </div>
              <div>
                <h3 class="font-bold text-slate-800 dark:text-white mb-1">Nuevo producto</h3>
                <p class="text-sm text-slate-600 dark:text-slate-400">Agregar al catálogo</p>
              </div>
            </div>
          </button>

          <button
            type="button"
            onclick="safeNavigate('/auto-responses/new')"
            class="group text-left relative overflow-hidden rounded-2xl bg-white dark:bg-slate-900 p-6 border border-slate-200/50 dark:border-white/5 shadow-soft hover:shadow-card transition-all duration-300 card-hover w-full">
            <div class="absolute -right-6 -top-6 w-24 h-24 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 opacity-5 group-hover:opacity-10 transition-opacity"></div>
            <div class="relative flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 opacity-10 flex items-center justify-center flex-shrink-0">
                <i data-lucide="sparkles" class="w-6 h-6 text-emerald-600 dark:text-emerald-400"></i>
              </div>
              <div>
                <h3 class="font-bold text-slate-800 dark:text-white mb-1">Auto-respuesta</h3>
                <p class="text-sm text-slate-600 dark:text-slate-400">Crear regla o flujo</p>
              </div>
            </div>
          </button>

          <button
            type="button"
            onclick="safeNavigate('/templates/new')"
            class="group text-left relative overflow-hidden rounded-2xl bg-white dark:bg-slate-900 p-6 border border-slate-200/50 dark:border-white/5 shadow-soft hover:shadow-card transition-all duration-300 card-hover w-full">
            <div class="absolute -right-6 -top-6 w-24 h-24 rounded-full bg-gradient-to-br from-fuchsia-500 to-purple-600 opacity-5 group-hover:opacity-10 transition-opacity"></div>
            <div class="relative flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-fuchsia-500 to-purple-600 opacity-10 flex items-center justify-center flex-shrink-0">
                <i data-lucide="file-plus" class="w-6 h-6 text-fuchsia-600 dark:text-fuchsia-400"></i>
              </div>
              <div>
                <h3 class="font-bold text-slate-800 dark:text-white mb-1">Nueva plantilla</h3>
                <p class="text-sm text-slate-600 dark:text-slate-400">Mensaje predefinido</p>
              </div>
            </div>
          </button>
        </div>
      </section>

      <!-- Recent Contacts -->
      <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 mb-8 overflow-hidden animate-fade-in">
        <div class="px-6 py-5 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
          <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center">
              <i data-lucide="user-round" class="w-4 h-4 text-white"></i>
            </div>
            Contactos recientes
          </h2>
        </div>

        <% if (rc.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
              <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-400 uppercase text-xs tracking-wider font-semibold">
                <tr>
                  <th class="text-left px-6 py-4">Teléfono</th>
                  <th class="text-left px-6 py-4">Nombre</th>
                  <th class="text-left px-6 py-4">Empresa</th>
                  <th class="text-left px-6 py-4">Estado</th>
                  <th class="text-left px-6 py-4">Registro</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                <% rc.forEach(contact => { %>
                  <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                    <td class="px-6 py-4 font-semibold text-slate-900 dark:text-white"><%= contact.phoneNumber %></td>
                    <td class="px-6 py-4 text-slate-700 dark:text-slate-300"><%= contact.name || '-' %></td>
                    <td class="px-6 py-4 text-slate-600 dark:text-slate-400"><%= contact.companyName || '-' %></td>
                    <td class="px-6 py-4">
                      <% if (contact.state === 'REGISTERED') { %>
                        <span class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300">
                          <i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Registrado
                        </span>
                      <% } else if (contact.state === 'WAITING_DNI' || contact.state === 'WAITING_RUC') { %>
                        <span class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300">
                          <i data-lucide="clock" class="w-3.5 h-3.5"></i> Esperando
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold bg-sky-100 text-sky-700 dark:bg-sky-900/30 dark:text-sky-300">
                          <i data-lucide="sparkles" class="w-3.5 h-3.5"></i> Nuevo
                        </span>
                      <% } %>
                    </td>
                    <td class="px-6 py-4 text-slate-600 dark:text-slate-400">
                      <% const d = new Date(contact.createdAt); %>
                      <time datetime="<%= d.toISOString() %>"><%= fmtDate(d) %></time>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="px-6 py-16 text-center">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
              <i data-lucide="inbox" class="w-8 h-8 text-slate-400"></i>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Sin contactos recientes</p>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Los nuevos contactos aparecerán aquí</p>
          </div>
        <% } %>
      </section>

      <!-- Recent Products -->
      <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden animate-fade-in">
        <div class="px-6 py-5 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
          <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center">
              <i data-lucide="shopping-bag" class="w-4 h-4 text-white"></i>
            </div>
            Productos recientes
          </h2>
        </div>

        <% if (rp.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
              <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-400 uppercase text-xs tracking-wider font-semibold">
                <tr>
                  <th class="text-left px-6 py-4">SKU</th>
                  <th class="text-left px-6 py-4">Nombre</th>
                  <th class="text-left px-6 py-4">Estado</th>
                  <th class="text-left px-6 py-4">Creado</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                <% rp.forEach(p => { %>
                  <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                    <td class="px-6 py-4 font-semibold text-slate-900 dark:text-white"><%= p.sku || '-' %></td>
                    <td class="px-6 py-4 text-slate-700 dark:text-slate-300"><%= p.name || '-' %></td>
                    <td class="px-6 py-4">
                      <% if (p.isActive) { %>
                        <span class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300">
                          <i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Activo
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300">
                          <i data-lucide="x-circle" class="w-3.5 h-3.5"></i> Inactivo
                        </span>
                      <% } %>
                    </td>
                    <td class="px-6 py-4 text-slate-600 dark:text-slate-400">
                      <% const d = new Date(p.createdAt); %>
                      <time datetime="<%= d.toISOString() %>"><%= fmtDate(d) %></time>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="px-6 py-16 text-center">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
              <i data-lucide="package-open" class="w-8 h-8 text-slate-400"></i>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Sin productos recientes</p>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Los últimos productos aparecerán aquí</p>
          </div>
        <% } %>
      </section>

    </main>
  </div>

  <!-- Scripts -->
  <script>
    // Initialize Lucide icons
    window.lucide && lucide.createIcons();

    // Mobile sidebar toggle
    (function(){
      const sidebar   = document.getElementById('sidebar');
      const overlay   = document.getElementById('mobile-sidebar-overlay');
      const openBtn   = document.getElementById('open-sidebar-btn');
      const closeBtn  = document.getElementById('close-sidebar-btn');

      function openSidebar(){
        sidebar.classList.remove('-translate-x-full');
        overlay.classList.remove('opacity-0','pointer-events-none');
      }
      function closeSidebar(){
        sidebar.classList.add('-translate-x-full');
        overlay.classList.add('opacity-0','pointer-events-none');
      }

      if (openBtn)  openBtn.addEventListener('click', openSidebar);
      if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
      if (overlay)  overlay.addEventListener('click', closeSidebar);
    })();

    // Disconnect WhatsApp
    async function disconnectWhatsApp() {
      if (!confirm('¿Seguro que deseas desconectar WhatsApp?')) return;
      
      try {
        const res = await fetch('/auth/logout-whatsapp', {
          method: 'POST',
          credentials: 'include'
        });

        if (!res.ok) {
          const text = await res.text();
          alert('Error al desconectar: ' + text);
          return;
        }

        let msg = 'WhatsApp desconectado correctamente';
        const ct = res.headers.get('content-type') || '';
        if (ct.includes('application/json')) {
          const data = await res.json();
          if (data && data.message) msg = data.message;
        }
        
        alert('✅ ' + msg);
        window.location.reload();
      } catch (err) {
        alert('❌ Error al desconectar WhatsApp');
        console.error(err);
      }
    }

    // Safe navigation
    async function safeNavigate(url) {
      try {
        const res = await fetch(url, {
          method: 'HEAD',
          credentials: 'include'
        });

        if (res.ok) {
          window.location.href = url;
        } else if (res.status === 404) {
          alert('Esta función aún no está disponible.');
        } else if (res.status === 401 || res.status === 403) {
          alert('No autorizado. Inicia sesión de nuevo.');
          window.location.href = '/auth/login';
        } else {
          alert('No se pudo abrir: ' + url);
        }
      } catch (err) {
        console.error(err);
        alert('Error al navegar');
      }
    }

    // Animated counter for KPIs
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReduced) {
      const nums = document.querySelectorAll('[data-kpi]');
      nums.forEach(node => {
        const finalText = node.textContent.trim();
        const cleanText = finalText.replace(/\./g,'').replace(/,/g,'');
        const finalVal = parseInt(cleanText) || 0;
        
        if (finalVal <= 0) return;

        let current = 0;
        const duration = 1500;
        const steps = 60;
        const increment = finalVal / steps;
        const stepDuration = duration / steps;
        const nf = new Intl.NumberFormat('es-PE');

        const counter = setInterval(() => {
          current += increment;
          if (current >= finalVal) {
            node.textContent = nf.format(finalVal);
            clearInterval(counter);
          } else {
            node.textContent = nf.format(Math.floor(current));
          }
        }, stepDuration);
      });
    }

    // Re-initialize icons after any dynamic content changes
    setTimeout(() => {
      window.lucide && lucide.createIcons();
    }, 100);
  </script>
</body>
</html>