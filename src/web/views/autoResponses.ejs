  <!-- Scripts -->
  <script>
    // Iconos
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
    });

    // ====== LÓGICA (idéntica a la tuya, sólo sin CSS personalizado) ======

    // Insertar variable en el textarea
    function insertVariable(variable) {
      const textarea = document.getElementById('responseContent');
      const start = textarea.selectionStart || 0;
      const end = textarea.selectionEnd || 0;
      const text = textarea.value || '';
      textarea.value = text.substring(0, start) + variable + text.substring(end);
      textarea.focus();
      const pos = start + variable.length;
      textarea.setSelectionRange(pos, pos);
      setTimeout(() => { if (window.lucide) lucide.createIcons(); }, 10);
    }

    // Abrir modal nuevo
    function openNewResponseModal() {
      document.getElementById('responseId').value = '';
      document.getElementById('responseTrigger').value = '';
      document.getElementById('responseContent').value = '';
      document.getElementById('responseCategory').value = '';
      document.getElementById('responsePriority').value = '1';
      document.getElementById('responseActive').value = 'true';
      document.getElementById('testResult').innerHTML = '';
      document.getElementById('testMessage').value = '';
      document.getElementById('modalTitle').textContent = 'Nueva Respuesta Automática';
      showModal('responseModal');
    }

    // Cerrar modal
    function closeResponseModal() { hideModal('responseModal'); }

    // Mostrar / ocultar modal (Tailwind)
    function showModal(id){
      const el = document.getElementById(id);
      el.classList.remove('hidden');
      el.classList.add('flex');
    }
    function hideModal(id){
      const el = document.getElementById(id);
      el.classList.remove('flex');
      el.classList.add('hidden');
    }
    // Click fuera cierra modal
    window.addEventListener('click', (e) => {
      const m = document.getElementById('responseModal');
      if (e.target === m) hideModal('responseModal');
    });

    // Guardar (create/update)
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('responseForm');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('responseId').value;
        const data = {
          trigger:  document.getElementById('responseTrigger').value,
          response: document.getElementById('responseContent').value,
          category: document.getElementById('responseCategory').value,
          priority: parseInt(document.getElementById('responsePriority').value, 10),
          isActive: document.getElementById('responseActive').value === 'true'
        };
        try {
          const url = id ? `/auto-responses/api/${id}` : '/auto-responses/api';
          const method = id ? 'PUT' : 'POST';
          const res = await fetch(url, { method, headers:{ 'Content-Type':'application/json' }, body: JSON.stringify(data) });
          if (res.ok) location.reload();
          else alert('Error al guardar respuesta');
        } catch (err) { alert('Error: ' + err.message); }
      });
    });

    // Eliminar
    async function deleteResponse(id) {
      if (!confirm('¿Eliminar esta respuesta automática?')) return;
      try {
        const res = await fetch(`/auto-responses/api/${id}`, { method: 'DELETE' });
        if (res.ok) location.reload();
        else alert('No se pudo eliminar');
      } catch (err) { alert('Error: ' + err.message); }
    }

    // Editar
    async function editResponse(id) {
      try {
        const res = await fetch(`/auto-responses/api/${id}`);
        const resp = await res.json();
        document.getElementById('responseId').value = resp.id;
        document.getElementById('responseTrigger').value = resp.trigger;
        document.getElementById('responseContent').value = resp.response;
        document.getElementById('responseCategory').value = resp.category || '';
        document.getElementById('responsePriority').value = resp.priority;
        document.getElementById('responseActive').value = resp.isActive ? 'true' : 'false';
        document.getElementById('testResult').innerHTML = '';
        document.getElementById('testMessage').value = '';
        document.getElementById('modalTitle').textContent = 'Editar Respuesta Automática';
        showModal('responseModal');
      } catch (err) { alert('Error: ' + err.message); }
    }

    // Probar trigger con variables
    async function testTriggerWithVariables() {
      const message = document.getElementById('testMessage').value;
      const resultDiv = document.getElementById('testResult');
      if (!message) {
        resultDiv.innerHTML = `
          <div class="rounded-md bg-rose-100 text-rose-700 px-3 py-2 text-xs font-medium dark:bg-rose-900/30 dark:text-rose-300">
            Por favor escribe un mensaje de prueba
          </div>`;
        return;
      }
      try {
        const res = await fetch('/auto-responses/api/test-with-variables', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message })
        });
        const result = await res.json();
        if (result && result.found && result.response) {
          const ctx = result.context && result.context.contact
            ? `${result.context.contact.name || ''}${result.context.contact.companyName ? ', ' + result.context.contact.companyName : ''}`
            : '';
          resultDiv.innerHTML = `
            <div class="rounded-md bg-emerald-100 text-emerald-700 px-3 py-2 text-xs font-medium leading-relaxed dark:bg-emerald-900/30 dark:text-emerald-300">
              ✅ Se activaría esta respuesta:<br><br>
              <div class="font-mono text-xs whitespace-pre-wrap bg-white/50 dark:bg-black/20 p-2 rounded mt-2">${result.response}</div>
              <br><small class="text-[10px] opacity-75">Datos de prueba: ${ctx}</small>
            </div>`;
        } else {
          resultDiv.innerHTML = `
            <div class="rounded-md bg-rose-100 text-rose-700 px-3 py-2 text-xs font-medium dark:bg-rose-900/30 dark:text-rose-300">
              ❌ No se activaría ninguna respuesta automática
            </div>`;
        }
      } catch (err) {
        resultDiv.innerHTML = `
          <div class="rounded-md bg-rose-100 text-rose-700 px-3 py-2 text-xs font-medium dark:bg-rose-900/30 dark:text-rose-300">
            Error al probar: ${err.message}
          </div>`;
      }
    }
  </script>
</body>
</html>
