<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind (misma config del dashboard) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary:   { DEFAULT:'#667eea', 600:'#667eea', 700:'#5a67d8' },
            secondary: { DEFAULT:'#764ba2', 600:'#764ba2', 700:'#6b3fa0' },
          },
          boxShadow: {
            soft:'0 4px 6px -1px rgba(0,0,0,.08), 0 2px 4px -1px rgba(0,0,0,.04)',
            card:'0 10px 30px -5px rgba(0,0,0,.10)'
          }
        }
      },
      darkMode:'media'
    }
  </script>



  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Gradient text */
    .gradient-text {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Icon sizes */
    .icon { width: 1.25rem; height: 1.25rem; }
    .icon-lg { width: 1.75rem; height: 1.75rem; }

    .hidden-row { display: none; }
  </style>
</head>

<body class="h-full bg-gradient-to-br from-slate-50 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 text-slate-800 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-4 focus:py-2 focus:rounded-lg shadow-lg">
    Saltar al contenido
  </a>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Volver al Dashboard + breadcrumb -->
    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <a href="/"
           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">
          <i data-lucide="arrow-left" class="icon"></i>
          <span>Volver al Dashboard</span>
        </a>
      </div>

      <nav aria-label="Breadcrumb" class="text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li class="inline-flex items-center gap-1">
            <a href="/" class="hover:underline inline-flex items-center gap-1">
              <i data-lucide="home" class="w-3.5 h-3.5"></i> Inicio
            </a>
          </li>
          <li class="select-none">/</li>
          <li class="inline-flex items-center gap-1">
            <i data-lucide="building" class="w-3.5 h-3.5"></i>
            <span class="font-medium">Empresas</span>
          </li>
        </ol>
      </nav>
    </div>

    <!-- Header -->
    <header class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight gradient-text flex items-center gap-3">
            <i data-lucide="building" class="icon-lg text-primary"></i>
            Empresas
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Gestión de clientes corporativos, sucursales y contactos</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            class="inline-flex items-center gap-2 rounded-xl bg-slate-600 hover:bg-slate-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft transition"
            onclick="exportExcel()">
            <i data-lucide="download" class="icon"></i>
            <span>Exportar Excel</span>
          </button>

          <label class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft transition cursor-pointer">
            <i data-lucide="upload" class="icon"></i>
            <span>Importar Excel</span>
            <input
              type="file"
              id="importFileInput"
              accept=".xlsx,.xls,.csv"
              class="hidden"
              onchange="importExcel(event)"
            />
          </label>

          <button
            class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft transition"
            onclick="openCompanyModal()">
            <i data-lucide="plus-circle" class="icon"></i>
            <span>Nueva Empresa</span>
          </button>
        </div>
      </div>
    </header>

    <% if (error) { %>
      <div class="rounded-xl bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300 px-4 py-3 text-sm font-medium shadow-soft border border-rose-200 dark:border-rose-800">
        <div class="flex items-center gap-2">
          <i data-lucide="alert-circle" class="icon"></i>
          <span><%= error %></span>
        </div>
      </div>
    <% } %>

    <!-- Buscador -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center">
            <i data-lucide="search" class="icon text-indigo-600 dark:text-indigo-400"></i>
          </div>
          Buscar Empresas
        </h2>
      </div>

      <div class="p-6">
        <div class="flex flex-col sm:flex-row sm:items-end gap-4">
          <div class="flex-1">
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
              Buscar por RUC/DNI, Razón Social
            </label>
            <input
              id="searchInput"
              type="text"
              class="w-full rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 transition"
              placeholder="Ej: 20601234567 / ACME / Pérez"
              oninput="filterRows()"
            />
          </div>

          <div class="text-sm text-slate-500 dark:text-slate-400 flex-shrink-0">
            Total: <span id="countVisible" class="font-semibold text-slate-700 dark:text-slate-200"><%= companies.length %></span> / <%= companies.length %> empresas
          </div>
        </div>
      </div>
    </section>

    <!-- Tabla de Empresas -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center">
            <i data-lucide="list" class="icon text-blue-600 dark:text-blue-400"></i>
          </div>
          Lista de Empresas
        </h2>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full text-sm" id="companiesTable">
          <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-400 uppercase text-xs tracking-wider font-semibold">
            <tr>
              <th class="text-left px-6 py-4">Doc</th>
              <th class="text-left px-6 py-4">Número</th>
              <th class="text-left px-6 py-4">Razón Social</th>
              <th class="text-left px-6 py-4">Estado</th>
              <th class="text-left px-6 py-4">Sucursales</th>
              <th class="text-left px-6 py-4">Creación</th>
              <th class="text-left px-6 py-4">Acciones</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-100 dark:divide-slate-800" id="companiesTbody">
            <% if (companies && companies.length > 0) { %>
              <% companies.forEach(c => { %>
                <tr
                  class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors"
                  data-row-id="<%= c.id %>"
                  data-search-text="<%- [
                    c.tipoDoc || '',
                    c.numeroDoc || '',
                    c.razonSocial || '',
                    c.estadoSunat || ''
                  ].join(' ').toLowerCase() %>"
                >
                  <td class="px-6 py-4 font-semibold text-slate-900 dark:text-white">
                    <%= c.tipoDoc || '-' %>
                  </td>
                  <td class="px-6 py-4 text-slate-700 dark:text-slate-300">
                    <%= c.numeroDoc || '-' %>
                  </td>
                  <td class="px-6 py-4 text-slate-700 dark:text-slate-300">
                    <div class="font-semibold truncate max-w-[260px]"><%= c.razonSocial %></div>
                  </td>
                  <td class="px-6 py-4">
                    <% if (c.estadoSunat) { %>
                      <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-semibold leading-none
                        <%= c.estadoSunat.toLowerCase().includes('activo') || c.estadoSunat.toLowerCase().includes('habido')
                          ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300'
                          : 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300'
                        %>">
                        <%= c.estadoSunat %>
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-semibold leading-none bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                        -
                      </span>
                    <% } %>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <span class="inline-flex items-center rounded-md bg-sky-100 text-sky-700 dark:bg-sky-900/30 dark:text-sky-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                      <%= c.branches ? c.branches.length : 0 %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-slate-600 dark:text-slate-400">
                    <time datetime="<%= new Date(c.createdAt).toISOString() %>">
                      <%= new Date(c.createdAt).toLocaleString('es-PE', { dateStyle: 'short' }) %>
                    </time>
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex flex-wrap gap-2">
                      <!-- Ver detalle -->
                      <a
                        class="inline-flex items-center gap-1 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                        href="/companies/<%= c.id %>">
                        <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                        <span>Ver</span>
                      </a>

                      <!-- Editar -->
                      <button
                        class="inline-flex items-center gap-1 rounded-lg bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                        onclick="openCompanyModal(
                          '<%= c.id %>',
                          '<%- c.tipoDoc || '' %>',
                          '<%- c.numeroDoc || '' %>',
                          '<%- (c.razonSocial||'').replace(/\"/g,'&quot;') %>',
                          '<%- c.estadoSunat||'' %>',
                          '<%- c.condicionSunat||'' %>',
                          '<%- (c.direccionFiscal||'').replace(/\"/g,'&quot;') %>',
                          '<%- c.distritoFiscal||'' %>',
                          '<%- c.provinciaFiscal||'' %>',
                          '<%- c.departamentoFiscal||'' %>'
                        )">
                        <i data-lucide="edit-2" class="w-3.5 h-3.5"></i>
                        <span>Editar</span>
                      </button>

                      <!-- Eliminar -->
                      <button
                        class="inline-flex items-center gap-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                        onclick="deleteCompany('<%= c.id %>')">
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        <span>Eliminar</span>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="px-6 py-16 text-center">
                  <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
                    <i data-lucide="inbox" class="icon-lg text-slate-400"></i>
                  </div>
                  <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">No hay empresas registradas</p>
                  <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Agrega la primera empresa</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <!-- Modal Crear/Editar Empresa -->
  <div id="company-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-2xl w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between sticky top-0 bg-white dark:bg-slate-900 z-10">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="building" class="icon text-primary"></i>
          <span id="modal-title">Nueva Empresa</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="closeCompanyModal()">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6">
        <input type="hidden" id="companyId" />

        <div class="grid gap-4 md:grid-cols-2">
          <!-- TipoDoc -->
          <div>
            <label class="block text-sm font-semibold mb-2">Tipo Doc *</label>
            <select
              id="tipoDoc"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500">
              <option value="RUC">RUC</option>
              <option value="DNI">DNI</option>
            </select>
          </div>

          <!-- NumeroDoc con lookup -->
          <div>
            <label class="block text-sm font-semibold mb-2">Nº Documento *</label>
            <div class="flex gap-2">
              <input
                id="numeroDoc"
                type="text"
                class="flex-1 rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500"
                placeholder="RUC o DNI"
              />
              <button
                class="rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-3 text-xs font-semibold transition shadow-soft"
                type="button"
                onclick="lookupDoc()"
                title="Consultar SUNAT / RENIEC">
                <i data-lucide="search" class="w-4 h-4"></i>
              </button>
            </div>
          </div>

          <!-- Razon Social -->
          <div class="md:col-span-2">
            <label class="block text-sm font-semibold mb-2">Razón Social / Nombre *</label>
            <input
              id="razonSocial"
              type="text"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500"
              placeholder="ACME S.A.C. / Juan Perez"
            />
          </div>

          <!-- Estado SUNAT -->
          <div class="md:col-span-2">
            <label class="block text-sm font-semibold mb-2">Estado SUNAT</label>
            <input
              id="estadoSunat"
              type="text"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500"
              placeholder="ACTIVO / BAJA / PERSONA NATURAL"
            />
          </div>

          <!-- Condición SUNAT -->
          <div class="md:col-span-2">
            <label class="block text-sm font-semibold mb-2">Condición SUNAT</label>
            <input
              id="condicionSunat"
              type="text"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500"
              placeholder="HABIDO / NO HABIDO"
            />
          </div>

          <!-- Dirección Fiscal -->
          <div class="md:col-span-2">
            <label class="block text-sm font-semibold mb-2">Dirección Fiscal SUNAT</label>
            <input
              id="direccionFiscal"
              type="text"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500"
              placeholder="AV. JOSE GALVEZ BARRENECHEA NRO 566 ..."
            />
          </div>

          <!-- Distrito / Provincia -->
          <div>
            <label class="block text-sm font-semibold mb-2">Distrito Fiscal</label>
            <input
              id="distritoFiscal"
              type="text"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2">Provincia Fiscal</label>
            <input
              id="provinciaFiscal"
              type="text"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500"
            />
          </div>

          <!-- Departamento -->
          <div class="md:col-span-2">
            <label class="block text-sm font-semibold mb-2">Departamento Fiscal</label>
            <input
              id="departamentoFiscal"
              type="text"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500"
            />
          </div>
        </div>

        <div class="mt-6 flex justify-end gap-2 pt-2 border-t border-slate-200 dark:border-slate-700">
          <button
            type="button"
            class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition"
            onclick="closeCompanyModal()">
            Cancelar
          </button>

          <button
            id="modal-save-btn"
            class="rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition"
            onclick="saveCompany()">
            Guardar
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Iconos
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
    });

    // Refs DOM
    const modalEl        = document.getElementById('company-modal');
    const modalTitleEl   = document.getElementById('modal-title');
    const companyIdEl    = document.getElementById('companyId');
    const tipoDocEl      = document.getElementById('tipoDoc');
    const numeroDocEl    = document.getElementById('numeroDoc');
    const razonSocialEl  = document.getElementById('razonSocial');
    const estadoSunatEl  = document.getElementById('estadoSunat');
    const condicionSunatEl     = document.getElementById('condicionSunat');
    const direccionFiscalEl    = document.getElementById('direccionFiscal');
    const distritoFiscalEl     = document.getElementById('distritoFiscal');
    const provinciaFiscalEl    = document.getElementById('provinciaFiscal');
    const departamentoFiscalEl = document.getElementById('departamentoFiscal');
    const tbodyEl        = document.getElementById('companiesTbody');
    const searchInputEl  = document.getElementById('searchInput');
    const countVisibleEl = document.getElementById('countVisible');

    // Buscador
    function filterRows() {
      const q = searchInputEl.value.trim().toLowerCase();
      const rows = tbodyEl.querySelectorAll('tr[data-row-id]');
      let visible = 0;
      rows.forEach(row => {
        const hay = row.getAttribute('data-search-text') || '';
        const match = !q || hay.includes(q);
        row.classList.toggle('hidden-row', !match);
        if (match) visible++;
      });
      countVisibleEl.textContent = visible.toString();
    }

    // Modal Open/Close
    function openCompanyModal(
      id,
      tipoDoc,
      numeroDoc,
      razonSocial,
      estadoSunat,
      condicionSunat,
      direccionFiscal,
      distritoFiscal,
      provinciaFiscal,
      departamentoFiscal
    ) {
      if (id) {
        modalTitleEl.textContent = 'Editar Empresa';
        companyIdEl.value = id;
        tipoDocEl.value = tipoDoc || 'RUC';
        numeroDocEl.value = numeroDoc || '';
        razonSocialEl.value = razonSocial || '';
        estadoSunatEl.value = estadoSunat || '';
        condicionSunatEl.value     = condicionSunat || '';
        direccionFiscalEl.value    = direccionFiscal || '';
        distritoFiscalEl.value     = distritoFiscal || '';
        provinciaFiscalEl.value    = provinciaFiscal || '';
        departamentoFiscalEl.value = departamentoFiscal || '';
      } else {
        modalTitleEl.textContent = 'Nueva Empresa';
        companyIdEl.value = '';
        tipoDocEl.value = 'RUC';
        numeroDocEl.value = '';
        razonSocialEl.value = '';
        estadoSunatEl.value = '';
        condicionSunatEl.value     = '';
        direccionFiscalEl.value    = '';
        distritoFiscalEl.value     = '';
        provinciaFiscalEl.value    = '';
        departamentoFiscalEl.value = '';
      }
      modalEl.classList.remove('hidden');
      modalEl.classList.add('flex');
    }

    function closeCompanyModal() {
      modalEl.classList.remove('flex');
      modalEl.classList.add('hidden');
    }

    // Lookup Doc
    async function lookupDoc() {
      const tipo = tipoDocEl.value.trim();
      const num  = numeroDocEl.value.trim();
      if (!num) {
        alert('Ingresa un número de documento');
        return;
      }
      try {
        let url = '';
        if (tipo === 'RUC') {
          url = '/companies/api/lookup-ruc/' + encodeURIComponent(num);
        } else {
          url = '/companies/api/lookup-dni/' + encodeURIComponent(num);
        }

        const res = await fetch(url);
        if (!res.ok) {
          alert('No encontrado en fuente externa');
          return;
        }
        const info = await res.json();

        if (tipo === 'RUC') {
          if (info.razonSocial && !razonSocialEl.value) {
            razonSocialEl.value = info.razonSocial;
          }
          if (info.estado && !estadoSunatEl.value) {
            estadoSunatEl.value = info.estado;
          }
          if (info.condicion && !condicionSunatEl.value) {
            condicionSunatEl.value = info.condicion;
          }
          if (info.direccion && !direccionFiscalEl.value) {
            direccionFiscalEl.value = info.direccion;
          }
          if (info.distrito && !distritoFiscalEl.value) {
            distritoFiscalEl.value = info.distrito;
          }
          if (info.provincia && !provinciaFiscalEl.value) {
            provinciaFiscalEl.value = info.provincia;
          }
          if (info.departamento && !departamentoFiscalEl.value) {
            departamentoFiscalEl.value = info.departamento;
          }
        } else {
          const fullName = [
            info.nombres || '',
            info.apellidoPaterno || '',
            info.apellidoMaterno || ''
          ].join(' ').trim();
          if (fullName && !razonSocialEl.value) {
            razonSocialEl.value = fullName;
          }
          if (!estadoSunatEl.value) {
            estadoSunatEl.value = 'PERSONA NATURAL';
          }
        }
      } catch (err) {
        console.error(err);
        alert('Error consultando SUNAT/RENIEC');
      }
    }

    // Guardar (Create/Update)
    async function saveCompany() {
      const id          = companyIdEl.value.trim();
      const tipoDoc     = tipoDocEl.value.trim();
      const numeroDoc   = numeroDocEl.value.trim();
      const razonSocial = razonSocialEl.value.trim();
      const estadoSunat        = estadoSunatEl.value.trim();
      const condicionSunat     = condicionSunatEl.value.trim();
      const direccionFiscal    = direccionFiscalEl.value.trim();
      const distritoFiscal     = distritoFiscalEl.value.trim();
      const provinciaFiscal    = provinciaFiscalEl.value.trim();
      const departamentoFiscal = departamentoFiscalEl.value.trim();

      if (!tipoDoc || !numeroDoc || !razonSocial) {
        alert('TipoDoc, Nº Documento y Razón Social son obligatorios');
        return;
      }

      try {
        let res;
        if (id) {
          res = await fetch('/companies/api/company/' + encodeURIComponent(id), {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              razonSocial,
              estadoSunat,
              condicionSunat,
              direccionFiscal,
              distritoFiscal,
              provinciaFiscal,
              departamentoFiscal,
            })
          });
        } else {
          res = await fetch('/companies/api/company', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              tipoDoc,
              numeroDoc,
              razonSocial,
              estadoSunat,
              condicionSunat,
              direccionFiscal,
              distritoFiscal,
              provinciaFiscal,
              departamentoFiscal,
            })
          });
        }

        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          alert('Error guardando empresa: ' + (data.error || res.statusText));
          return;
        }

        alert('✅ Empresa guardada exitosamente');
        window.location.reload();
      } catch (err) {
        console.error(err);
        alert('Error de red al guardar empresa');
      }
    }

    // Eliminar
    async function deleteCompany(id) {
      if (!confirm('¿Eliminar esta empresa y TODAS sus sucursales/contactos?\n\nEsta acción no se puede deshacer.')) {
        return;
      }

      try {
        const res = await fetch('/companies/api/company/' + encodeURIComponent(id), {
          method: 'DELETE'
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          alert('Error eliminando empresa: ' + (data.error || res.statusText));
          return;
        }
        alert('✅ Empresa eliminada exitosamente');
        window.location.reload();
      } catch (err) {
        console.error(err);
        alert('Error de red al eliminar empresa');
      }
    }

    // Export Excel
    async function exportExcel() {
      try {
        const res = await fetch('/companies/api/export');
        if (!res.ok) {
          alert('No se pudo exportar');
          return;
        }
        const blob = await res.blob();
        const url  = window.URL.createObjectURL(blob);
        const a    = document.createElement('a');
        a.href     = url;
        a.download = `empresas_${new Date().toISOString().split('T')[0]}.xlsx`;
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(url);
        document.body.removeChild(a);
      } catch (err) {
        console.error(err);
        alert('Error exportando Excel');
      }
    }

    // Import Excel
    async function importExcel(ev) {
      const fileInput = ev.target;
      if (!fileInput.files || !fileInput.files[0]) {
        alert('Selecciona un archivo primero');
        return;
      }
      const file = fileInput.files[0];

      const formData = new FormData();
      formData.append('file', file);

      try {
        const res = await fetch('/companies/api/import', {
          method: 'POST',
          body: formData
        });
        const data = await res.json().catch(() => ({}));

        if (!res.ok || !data.ok) {
          alert('Error importando Excel: ' + (data.error || res.statusText));
          return;
        }

        alert(
          '✅ Importación completada:\n\n' +
          `Empresas creadas: ${data.summary.companiesCreated}\n` +
          `Empresas actualizadas: ${data.summary.companiesUpdated}\n` +
          `Sucursales creadas: ${data.summary.branchesCreated}\n` +
          `Sucursales actualizadas: ${data.summary.branchesUpdated}\n` +
          `Contactos creados: ${data.summary.contactsCreated}\n` +
          `Contactos actualizados: ${data.summary.contactsUpdated}`
        );

        window.location.reload();
      } catch (err) {
        console.error(err);
        alert('Error de red al importar Excel');
      } finally {
        fileInput.value = '';
      }
    }

    // Cerrar modal al hacer clic fuera
    window.addEventListener('click', (e) => {
      if (e.target === modalEl) {
        closeCompanyModal();
      }
    });

    // Exponer funciones globalmente
    window.filterRows        = filterRows;
    window.openCompanyModal  = openCompanyModal;
    window.closeCompanyModal = closeCompanyModal;
    window.lookupDoc         = lookupDoc;
    window.saveCompany       = saveCompany;
    window.deleteCompany     = deleteCompany;
    window.exportExcel       = exportExcel;
    window.importExcel       = importExcel;
  </script>
</body>
</html>