    /* ----------------------------------
     * TAKEOVER / BLOCK
     * ---------------------------------- */
    async function takeover(phoneNumber) {
      if (!confirm('¿Activar intervención humana para este contacto?')) return;
      try {
        const res = await fetch(`/contacts/api/${phoneNumber}/takeover`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert('✅ Takeover activado. El bot no responderá durante 1 hora.');
          location.reload();
        } else {
          alert('❌ Error al activar takeover');
        }
      } catch (error) {
        console.error(error);
        alert('❌ Error al activar takeover');
      }
    }

    async function release(phoneNumber) {
      if (!confirm('¿Liberar intervención humana? El bot volverá a responder.')) return;
      try {
        const res = await fetch(`/contacts/api/${phoneNumber}/release`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert('✅ Takeover liberado. El bot volverá a responder.');
          location.reload();
        } else {
          alert('❌ Error al liberar takeover');
        }
      } catch (error) {
        console.error(error);
        alert('❌ Error al liberar takeover');
      }
    }

    async function blockContact(phoneNumber) {
      const reason = prompt('Razón del bloqueo (opcional):');
      if (reason === null) return;
      try {
        const res = await fetch(`/contacts/api/${phoneNumber}/block`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason })
        });
        const data = await res.json();
        if (data.success) {
          alert('✅ Contacto bloqueado');
          location.reload();
        } else {
          alert('❌ Error al bloquear contacto');
        }
      } catch (error) {
        console.error(error);
        alert('❌ Error al bloquear contacto');
      }
    }

    async function unblockContact(phoneNumber) {
      if (!confirm('¿Desbloquear este contacto?')) return;
      try {
        const res = await fetch(`/contacts/api/${phoneNumber}/unblock`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert('✅ Contacto desbloqueado');
          location.reload();
        } else {
          alert('❌ Error al desbloquear contacto');
        }
      } catch (error) {
        console.error(error);
        alert('❌ Error al desbloquear contacto');
      }
    }

    /* ----------------------------------
     * IMPORT / EXPORT
     * ---------------------------------- */
    async function exportExcel() {
      try {
        // Mostrar loading en el botón
        const btn = event.target.closest('button');
        const originalHTML = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 mr-1 animate-spin"></i>Exportando...';
        lucide.createIcons();

        const res = await fetch('/contacts/api-export');
        
        if (!res.ok) {
          throw new Error('Error al exportar contactos');
        }

        // Convertir la respuesta a blob (archivo binario Excel)
        const blob = await res.blob();
        
        // Crear URL temporal del blob
        const url = URL.createObjectURL(blob);

        // Crear enlace temporal y hacer click para descargar
        const a = document.createElement('a');
        a.href = url;
        a.download = `contactos-${new Date().toISOString().split('T')[0]}.xlsx`;
        document.body.appendChild(a);
        a.click();
        
        // Limpiar
        setTimeout(() => {
          a.remove();
          URL.revokeObjectURL(url);
        }, 100);

        // Restaurar botón
        btn.disabled = false;
        btn.innerHTML = originalHTML;
        lucide.createIcons();

        alert('✅ Contactos exportados exitosamente como archivo Excel');
      } catch (err) {
        console.error(err);
        
        // Restaurar botón en caso de error
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = originalHTML;
          lucide.createIcons();
        }
        
        alert('❌ Error al exportar contactos');
      }
    }

    async function importExcelFile(inputEl) {
      const file = inputEl.files && inputEl.files[0];
      if (!file) return;

      // Este front no está usando SheetJS todavía.
      // Vamos a soportar .json directo para pruebas rápidas.
      if (file.type === 'application/json' || file.name.endsWith('.json')) {
        try {
          const text = await file.text();
          const parsed = JSON.parse(text);

          // esperamos rows: [...] como pide /api-import
          const rows = Array.isArray(parsed) ? parsed : parsed.rows;
          if (!Array.isArray(rows)) {
            alert('El JSON no tiene "rows" válidos');
            inputEl.value = '';
            return;
          }

          const res = await fetch('/contacts/api-import', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ rows })
          });

          const data = await res.json();
          if (data.error) {
            alert('❌ Error importando: ' + data.error);
          } else {
            alert('✅ Importación completa');
            location.reload();
          }
        } catch (err) {
          console.error(err);
          alert('❌ Error leyendo el archivo');
        }

        inputEl.value = '';
        return;
      }

      alert('📥 Importar Excel (.xlsx) aún no está implementado en el front. Puedes importar un .json con "rows".');
      inputEl.value = '';
    }
  </script>
