  <!-- Scripts -->
  <script>
    // Iconos
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
    });

    // ====== Utilidades ======
    function showLoading(button) {
      button.disabled = true;
      button.dataset.originalText = button.innerHTML;
      button.innerHTML = '<div class="spinner"></div><span class="ml-2">Cargando...</span>';
    }

    function hideLoading(button) {
      if (button.dataset.originalText) {
        button.innerHTML = button.dataset.originalText;
        button.disabled = false;
      }
    }

    function showToast(message, type = 'success') {
      const icon = type === 'success' ? '✅' : type === 'error' ? '❌' : 'ℹ️';
      alert(`${icon} ${message}`);
    }

    // ====== Consultar DNI ======
    async function consultarDNI() {
      const dni = document.getElementById('dni').value.trim();
      if (!dni || !/^\d{8}$/.test(dni)) {
        showToast('Por favor ingresa un DNI válido de 8 dígitos', 'error');
        return;
      }

      try {
        const res = await fetch('/admin-users/api/validate-dni', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ dni })
        });

        const result = await res.json();

        if (result.success && result.data) {
          document.getElementById('name').value = result.data.name;
          showToast('Datos cargados desde RENIEC', 'success');
        } else {
          showToast(result.error || 'DNI no encontrado', 'error');
        }
      } catch (err) {
        console.error(err);
        showToast('Error al consultar DNI', 'error');
      }
    }

    async function consultarDNIEdit() {
      const dni = document.getElementById('edit-dni').value.trim();
      if (!dni || !/^\d{8}$/.test(dni)) {
        showToast('Por favor ingresa un DNI válido de 8 dígitos', 'error');
        return;
      }

      try {
        const res = await fetch('/admin-users/api/validate-dni', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ dni })
        });

        const result = await res.json();

        if (result.success && result.data) {
          document.getElementById('edit-name').value = result.data.name;
          showToast('Datos cargados desde RENIEC', 'success');
        } else {
          showToast(result.error || 'DNI no encontrado', 'error');
        }
      } catch (err) {
        console.error(err);
        showToast('Error al consultar DNI', 'error');
      }
    }

    // ====== CRUD Admins ======
    async function addAdmin(e) {
      e.preventDefault();
      const button = e.target.querySelector('button[type="submit"]');
      showLoading(button);

      const data = {
        username: document.getElementById('username').value,
        name: document.getElementById('name').value,
        password: document.getElementById('password').value,
        email: document.getElementById('email').value,
        phone: document.getElementById('phone').value,
        avatarUrl: document.getElementById('avatarUrl').value,
        dni: document.getElementById('dni').value,
        role: document.getElementById('role').value,
        isActive: document.getElementById('isActive').checked
      };

      try {
        const res = await fetch('/admin-users/api', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();

        if (result.success) {
          showToast('Usuario creado exitosamente', 'success');
          location.reload();
        } else {
          showToast(result.error || 'No se pudo crear', 'error');
        }
      } catch (err) {
        showToast('Error al crear usuario', 'error');
        console.error(err);
      } finally {
        hideLoading(button);
      }
    }

    async function editAdmin(id) {
      try {
        const res = await fetch(`/admin-users/api/${id}`);
        const admin = await res.json();

        document.getElementById('edit-id').value = admin.id;
        document.getElementById('edit-username').value = admin.username;
        document.getElementById('edit-name').value = admin.name || '';
        document.getElementById('edit-email').value = admin.email || '';
        document.getElementById('edit-phone').value = admin.phone || '';
        document.getElementById('edit-avatarUrl').value = admin.avatarUrl || '';
        document.getElementById('edit-dni').value = admin.dni || '';
        document.getElementById('edit-role').value = admin.role || 'ADMIN';
        document.getElementById('edit-isActive').checked = admin.isActive !== false;

        showModal('editModal');
      } catch (err) {
        showToast('Error al cargar usuario', 'error');
        console.error(err);
      }
    }

    async function updateAdmin(e) {
      e.preventDefault();
      const button = e.target.querySelector('button[type="submit"]');
      showLoading(button);

      const id = document.getElementById('edit-id').value;
      const data = {
        username: document.getElementById('edit-username').value,
        name: document.getElementById('edit-name').value,
        email: document.getElementById('edit-email').value,
        phone: document.getElementById('edit-phone').value,
        avatarUrl: document.getElementById('edit-avatarUrl').value,
        dni: document.getElementById('edit-dni').value,
        role: document.getElementById('edit-role').value,
        isActive: document.getElementById('edit-isActive').checked
      };

      try {
        const res = await fetch(`/admin-users/api/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();

        if (result.success) {
          showToast('Usuario actualizado', 'success');
          location.reload();
        } else {
          showToast('Error al actualizar', 'error');
        }
      } catch (err) {
        showToast('Error al actualizar usuario', 'error');
        console.error(err);
      } finally {
        hideLoading(button);
      }
    }

    function changeMyPassword(id) {
      document.getElementById('change-id').value = id;
      document.getElementById('currentPassword').value = '';
      document.getElementById('newPassword').value = '';
      document.getElementById('confirmPassword').value = '';
      showModal('changePasswordModal');
    }

    async function changePassword(e) {
      e.preventDefault();
      const button = e.target.querySelector('button[type="submit"]');

      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      if (newPassword !== confirmPassword) {
        showToast('Las contraseñas no coinciden', 'error');
        return;
      }

      showLoading(button);

      const data = {
        currentPassword: document.getElementById('currentPassword').value,
        newPassword
      };
      const id = document.getElementById('change-id').value;

      try {
        const res = await fetch(`/admin-users/api/${id}/change-password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();

        if (result.success) {
          showToast('Contraseña cambiada exitosamente', 'success');
          hideModal('changePasswordModal');
        } else {
          showToast(result.error || 'No se pudo cambiar', 'error');
        }
      } catch (err) {
        showToast('Error al cambiar contraseña', 'error');
        console.error(err);
      } finally {
        hideLoading(button);
      }
    }

    function resetPassword(id) {
      document.getElementById('reset-id').value = id;
      document.getElementById('resetNewPassword').value = '';
      showModal('resetPasswordModal');
    }

    async function resetPasswordSubmit(e) {
      e.preventDefault();
      const button = e.target.querySelector('button[type="submit"]');
      showLoading(button);

      const id = document.getElementById('reset-id').value;
      const data = {
        newPassword: document.getElementById('resetNewPassword').value
      };

      try {
        const res = await fetch(`/admin-users/api/${id}/reset-password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();

        if (result.success) {
          showToast('Contraseña reseteada exitosamente', 'success');
          hideModal('resetPasswordModal');
        } else {
          showToast(result.error || 'No se pudo resetear', 'error');
        }
      } catch (err) {
        showToast('Error al resetear contraseña', 'error');
        console.error(err);
      } finally {
        hideLoading(button);
      }
    }

    async function deleteAdmin(id) {
      if (!confirm('¿Eliminar este usuario administrador?\n\nEsta acción no se puede deshacer.')) return;

      try {
        const res = await fetch(`/admin-users/api/${id}`, { method: 'DELETE' });
        const result = await res.json();

        if (result.success) {
          showToast('Usuario eliminado', 'success');
          location.reload();
        } else {
          showToast(result.error || 'No se pudo eliminar', 'error');
        }
      } catch (err) {
        showToast('Error al eliminar usuario', 'error');
        console.error(err);
      }
    }

    // ====== 2FA ======
    function setup2FA(id) {
      document.getElementById('2fa-setup-id').value = id;
      document.getElementById('2fa-step1').classList.remove('hidden');
      document.getElementById('2fa-step2').classList.add('hidden');
      showModal('setup2FAModal');
    }

    async function generateQRCode() {
      const id = document.getElementById('2fa-setup-id').value;

      try {
        const res = await fetch(`/admin-users/api/${id}/2fa/setup`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const result = await res.json();

        if (result.success) {
          document.getElementById('qrCodeContainer').innerHTML = `<img src="${result.qrCode}" alt="QR Code" class="w-48 h-48">`;
          document.getElementById('manualSecret').textContent = result.secret;
          document.getElementById('2fa-step1').classList.add('hidden');
          document.getElementById('2fa-step2').classList.remove('hidden');
        } else {
          showToast(result.error || 'Error al generar QR', 'error');
        }
      } catch (err) {
        showToast('Error al generar código QR', 'error');
        console.error(err);
      }
    }

    async function verify2FACode(e) {
      e.preventDefault();
      const button = e.target.querySelector('button[type="submit"]');
      showLoading(button);

      const id = document.getElementById('2fa-setup-id').value;
      const code = document.getElementById('2fa-code').value;

      try {
        const res = await fetch(`/admin-users/api/${id}/2fa/enable`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code })
        });
        const result = await res.json();

        if (result.success) {
          showToast('2FA activado exitosamente', 'success');
          hideModal('setup2FAModal');
          location.reload();
        } else {
          showToast(result.error || 'Código incorrecto', 'error');
        }
      } catch (err) {
        showToast('Error al verificar código', 'error');
        console.error(err);
      } finally {
        hideLoading(button);
      }
    }

    function disable2FA(id) {
      document.getElementById('disable-2fa-id').value = id;
      document.getElementById('disable2fa-password').value = '';
      showModal('disable2FAModal');
    }

    async function disable2FASubmit(e) {
      e.preventDefault();
      const button = e.target.querySelector('button[type="submit"]');
      showLoading(button);

      const id = document.getElementById('disable-2fa-id').value;
      const currentPassword = document.getElementById('disable2fa-password').value;

      try {
        const res = await fetch(`/admin-users/api/${id}/2fa/disable`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ currentPassword })
        });
        const result = await res.json();

        if (result.success) {
          showToast('2FA desactivado exitosamente', 'success');
          hideModal('disable2FAModal');
          location.reload();
        } else {
          showToast(result.error || 'Error al desactivar 2FA', 'error');
        }
      } catch (err) {
        showToast('Error al desactivar 2FA', 'error');
        console.error(err);
      } finally {
        hideLoading(button);
      }
    }

    // ====== Modales ======
    function showModal(id) {
      const el = document.getElementById(id);
      el.classList.remove('hidden');
      el.classList.add('flex');
      document.body.style.overflow = 'hidden';
      
      // Actualizar iconos después de mostrar modal
      setTimeout(() => {
        if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
      }, 50);
    }

    function hideModal(id) {
      const el = document.getElementById(id);
      el.classList.remove('flex');
      el.classList.add('hidden');
      document.body.style.overflow = '';
    }

    // Cerrar modal al hacer clic fuera
    window.addEventListener('click', (e) => {
      document.querySelectorAll('[id$="Modal"]').forEach(m => {
        if (e.target === m) hideModal(m.id);
      });
    });

    // Cerrar modal con ESC
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('[id$="Modal"]').forEach(m => {
          if (!m.classList.contains('hidden')) hideModal(m.id);
        });
      }
    });
  </script>
</body>
</html>
