generator client {
  provider      = "prisma-client-js"
  // Soporte para ambos engines y entornos Debian bookworm/bullseye
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             String          @id @default(uuid())
  username       String          @unique
  password       String
  name           String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  email          String?         @unique
  phone          String?
  avatarUrl      String?         @map("avatar_url")
  role           String          @default("ADMIN")
  isActive       Boolean         @default(true) @map("is_active")
  dni            String?         @unique
  twoFAEnabled   Boolean         @default(false) @map("twofa_enabled")
  twoFASecret    String?         @map("twofa_secret")
  lastLoginAt    DateTime?       @map("last_login_at") @db.Timestamp(6)
  lastLoginIp    String?         @map("last_login_ip")
  notes          InternalNote[]
  trustedDevices TrustedDevice[]

  @@map("admins")
}

model TrustedDevice {
  id          String   @id @default(uuid())
  adminId     String   @map("admin_id")
  deviceToken String   @unique @map("device_token")
  deviceName  String?  @map("device_name")
  userAgent   String?  @map("user_agent")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  lastUsedAt  DateTime @default(now()) @map("last_used_at")
  expiresAt   DateTime @map("expires_at")
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([deviceToken])
  @@map("trusted_devices")
}

model Contact {
  id              String                @id @default(uuid())
  phoneNumber     String                @unique @map("phone_number")
  billysId        String?               @unique @map("billys_id")
  name            String?
  dni             String?               @unique
  ruc             String?               @unique
  companyName     String?               @map("company_name")
  state           String                @default("NEW")
  isBlocked       Boolean               @default(false) @map("is_blocked")
  humanTakeoverAt DateTime?             @map("human_takeover_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  nextAction      String?               @map("next_action")
  companies       ContactCompany[]
  conversations   ConversationHistory[]

  @@map("contacts")
}

model Company {
  id                 String           @id @default(uuid())
  tipoDoc            String?          @default("RUC") @map("tipo_doc")
  numeroDoc          String?          @unique @map("numero_doc")
  razonSocial        String?          @map("razon_social")
  estadoSunat        String?          @map("estado_sunat")
  ruc                String?          @unique
  name               String           @default("")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  condicionSunat     String?          @map("condicion_sunat")
  direccionFiscal    String?          @map("direccion_fiscal")
  distritoFiscal     String?          @map("distrito_fiscal")
  provinciaFiscal    String?          @map("provincia_fiscal")
  departamentoFiscal String?          @map("departamento_fiscal")
  branches           Branch[]
  contacts           ContactCompany[]

  @@map("companies")
}

model Branch {
  id           String          @id @default(uuid())
  companyId    String          @map("company_id")
  nombre       String
  direccion    String
  distrito     String?
  provincia    String?
  departamento String?
  referencia   String?
  telefono     String?
  email        String?
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  contacts     BranchContact[]
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("branches")
}

model BranchContact {
  id        String   @id @default(uuid())
  branchId  String   @map("branch_id")
  nombre    String
  cargo     String?
  email     String?
  celular   String?
  whatsapp  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("branch_contacts")
}

model ContactCompany {
  id        String   @id @default(uuid())
  contactId String   @map("contact_id")
  companyId String   @map("company_id")
  role      String?
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, companyId])
  @@index([contactId])
  @@index([companyId])
  @@map("contact_companies")
}

/// *
/// * ================================
/// * NÚMEROS BLOQUEADOS CON PERMISOS GRANULARES
/// * ================================
model BlockedNumber {
  id                 String      @id @default(uuid())
  identifier         String      @unique
  reason             String?
  blockedAt          DateTime    @default(now()) @map("blocked_at")
  canUseOdoo         Boolean     @default(false) @map("can_use_odoo")
  canCreateTickets   Boolean     @default(false) @map("can_create_tickets")
  canSeeHistory      Boolean     @default(false) @map("can_see_history")
  canTalkToHuman     Boolean     @default(false) @map("can_talk_to_human")
  canUseAI           Boolean     @default(false) @map("can_use_ai")
  canUseAutoResponse Boolean     @default(true)  @map("can_use_auto_response")
  customPermissions  Json?       @map("custom_permissions")
  notes              String?
  blockedBy          String?     @map("blocked_by")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  expiresAt          DateTime?   @map("expires_at")
  type               BlockType   @default(PHONE)
  accessLevel        AccessLevel @default(BLOCKED) @map("access_level")

  @@index([identifier])
  @@index([accessLevel])
  @@index([type])
  @@map("blocked_numbers")
}

model ConversationHistory {
  id          String   @id @default(uuid())
  phoneNumber String   @map("phone_number")
  role        String
  content     String
  createdAt   DateTime @default(now()) @map("created_at")
  contact     Contact  @relation(fields: [phoneNumber], references: [phoneNumber])

  @@index([phoneNumber, createdAt])
  @@map("conversation_history")
}

model SystemVariable {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_variables")
}

/// *
/// * ================================
/// * TABLA DE CONFIGURACIÓN UNIFICADA
/// * ================================
model Configuration {
  id          String   @id @default(uuid())
  category    String
  key         String
  value       String?
  isEncrypted Boolean  @default(false) @map("is_encrypted")
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([category, key], name: "category_key")
  @@map("configurations")
}

/// *
/// * ================================
/// * CALENDARIO (FERIADOS Y EVENTOS)
/// * ================================
model CalendarEvent {
  id          String   @id @default(uuid())
  title       String
  date        DateTime @db.Date
  type        String
  description String?
  isRecurring Boolean  @default(false) @map("is_recurring")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([date, type, title])
  @@index([date])
  @@map("calendar_events")
}

/// *
/// * ================================
/// * HORARIOS DE TRABAJO
/// * ================================
model WorkingHours {
  id         String   @id @default(uuid())
  dayOfWeek  Int      @unique @map("day_of_week")
  isWorkday  Boolean  @default(true) @map("is_workday")
  openTime   String?  @map("open_time")
  closeTime  String?  @map("close_time")
  breakStart String?  @map("break_start")
  breakEnd   String?  @map("break_end")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("working_hours")
}

/// *
/// * =========================================
/// * DEPARTAMENTOS / ÁREAS (enrutamiento)
/// * =========================================
model Department {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  phoneNumber String?             @map("phone_number")
  email       String?
  isActive    Boolean             @default(true) @map("is_active")
  sortOrder   Int                 @default(0) @map("sort_order")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  contacts    DepartmentContact[]
  keywords    DepartmentKeyword[]

  @@map("departments")
}

model DepartmentKeyword {
  id           String     @id @default(uuid())
  departmentId String     @map("department_id")
  keyword      String
  priority     Int        @default(1)
  createdAt    DateTime   @default(now()) @map("created_at")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, keyword])
  @@index([departmentId])
  @@map("department_keywords")
}

model DepartmentContact {
  id           String     @id @default(uuid())
  departmentId String     @map("department_id")
  name         String
  phoneNumber  String     @map("phone_number")
  role         String?
  isActive     Boolean    @default(true) @map("is_active")
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@map("department_contacts")
}

/// *
/// * ================================
/// * PRODUCTOS / SERVICIOS
/// * ================================
model Product {
  id          String           @id @default(uuid())
  name        String
  category    String
  description String?
  price       Float?
  imageUrl    String?          @map("image_url")
  isActive    Boolean          @default(true) @map("is_active")
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  keywords    ProductKeyword[]

  @@index([category])
  @@map("products")
}

model ProductKeyword {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  keyword   String
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, keyword])
  @@index([productId])
  @@map("product_keywords")
}

/// *
/// * ================================
/// * RESPUESTAS AUTOMÁTICAS (FAQs)
/// * ================================
model AutoResponse {
  id        String   @id @default(uuid())
  trigger   String
  response  String
  isActive  Boolean  @default(true) @map("is_active")
  priority  Int      @default(1)
  category  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([trigger])
  @@map("auto_responses")
}

/// *
/// * ================================
/// * AUTOMATION / WORKFLOWS
/// * ================================
model AutomationRule {
  id          String   @id @default(uuid())
  name        String
  description String?
  trigger     String
  condition   String
  action      String
  actionData  String
  isActive    Boolean  @default(true) @map("is_active")
  priority    Int      @default(1) @map("priority")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("automation_rules")
}

/// *
/// * ================================
/// * MÉTRICAS Y ANÁLISIS
/// * ================================
model ConversationMetric {
  id              String   @id @default(uuid())
  date            DateTime @unique @db.Date
  totalMessages   Int      @default(0) @map("total_messages")
  uniqueContacts  Int      @default(0) @map("unique_contacts")
  newContacts     Int      @default(0) @map("new_contacts")
  serviceRequests Int      @default(0) @map("service_requests")
  salesInquiries  Int      @default(0) @map("sales_inquiries")
  humanTakeovers  Int      @default(0) @map("human_takeovers")
  avgResponseTime Float?   @map("avg_response_time")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("conversation_metrics")
}

/// *
/// * ================================
/// * ETIQUETAS / TAGS
/// * ================================
model Tag {
  id            String            @id @default(uuid())
  name          String            @unique
  color         String?
  description   String?
  createdAt     DateTime          @default(now()) @map("created_at")
  conversations ConversationTag[]

  @@map("tags")
}

model ConversationTag {
  id          String   @id @default(uuid())
  phoneNumber String   @map("phone_number")
  tagId       String   @map("tag_id")
  createdAt   DateTime @default(now()) @map("created_at")
  tag         Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([phoneNumber, tagId])
  @@index([phoneNumber])
  @@index([tagId])
  @@map("conversation_tags")
}

/// *
/// * ================================
/// * PLANTILLAS DE MENSAJES
/// * ================================
model MessageTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  content   String
  category  String
  variables String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("message_templates")
}

/// *
/// * ================================
/// * NOTAS INTERNAS
/// * ================================
model InternalNote {
  id          String   @id @default(uuid())
  phoneNumber String   @map("phone_number")
  adminId     String   @map("admin_id")
  note        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  admin       Admin    @relation(fields: [adminId], references: [id])

  @@index([phoneNumber])
  @@index([adminId])
  @@map("internal_notes")
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  key         String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([key])
  @@index([isActive])
  @@map("api_keys")
}

enum BlockType {
  PHONE
  GROUP
}

enum AccessLevel {
  BLOCKED
  RESTRICTED
  LIMITED
  STANDARD
  FULL
  VIP
}
