<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Respuestas Automáticas' %> - WhatsApp Bot Admin</title>

  <!-- Fuente -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind (misma config que el dashboard morado) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary:   { DEFAULT:'#667eea', 600:'#667eea', 700:'#5a67d8' },
            secondary: { DEFAULT:'#764ba2', 600:'#764ba2', 700:'#6b3fa0' },
          },
          boxShadow: {
            soft:'0 4px 6px -1px rgba(0,0,0,.08), 0 2px 4px -1px rgba(0,0,0,.04)',
            card:'0 10px 30px -5px rgba(0,0,0,.10)'
          }
        }
      },
      darkMode:'media'
    }
  </script>


  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="h-full bg-gradient-to-br from-slate-50 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 text-slate-800 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-4 focus:py-2 focus:rounded-lg shadow-lg">
    Saltar al contenido
  </a>

  <%
    const list = Array.isArray(responses) ? responses : [];
    const df = new Intl.DateTimeFormat('es-PE', { dateStyle: 'short' });
    function fmtDate(d){ try { return df.format(new Date(d)); } catch { return '-'; } }
  %>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Volver al Dashboard + breadcrumb -->
    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <a href="/"
           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">
          <i data-lucide="arrow-left" class="icon"></i>
          <span>Volver al Dashboard</span>
        </a>
        <button class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft"
                onclick="openNewResponseModal()">
          <i data-lucide="plus-circle" class="icon"></i>
          <span>Nueva Respuesta</span>
        </button>
      </div>

      <nav aria-label="Breadcrumb" class="text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li class="inline-flex items-center gap-1">
            <a href="/" class="hover:underline inline-flex items-center gap-1">
              <i data-lucide="home" class="w-3.5 h-3.5"></i> Inicio
            </a>
          </li>
          <li class="select-none">/</li>
          <li class="inline-flex items-center gap-1">
            <i data-lucide="robot" class="w-3.5 h-3.5"></i>
            <span class="font-medium">Respuestas Automáticas</span>
          </li>
        </ol>
      </nav>
    </div>

    <!-- Header -->
    <header class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight gradient-text flex items-center gap-3">
            <i data-lucide="message-square-text" class="icon-lg text-primary"></i>
            Respuestas Automáticas (FAQs)
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            Reglas que se activan por palabra clave. Tienen prioridad sobre Gemini AI.
          </p>
        </div>
      </div>
    </header>

    <!-- Info tip -->
    <div class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5">
      <div class="px-6 py-4 text-sm text-sky-800 bg-sky-50 rounded-t-2xl border-b border-slate-100 dark:bg-sky-900/30 dark:text-sky-200 dark:border-white/5 flex items-start gap-3">
        <div class="text-lg leading-none">💡</div>
        <div>
          <strong class="block font-semibold text-slate-900 dark:text-white">Tip:</strong>
          <span class="text-slate-700 dark:text-slate-300">
            Usa <em class="font-semibold">variables</em> para personalizar la respuesta: <code class="font-mono text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">{"{{nombre}}"}</code>,
            <code class="font-mono text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">{"{{empresa}}"}</code>, etc.
          </span>
        </div>
      </div>
    </div>

    <!-- Lista -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center">
            <i data-lucide="list" class="icon text-indigo-600 dark:text-indigo-400"></i>
          </div>
          Respuestas configuradas
        </h2>
      </div>

      <div id="responsesList" class="px-6 py-6">
        <% if (list.length > 0) { %>
          <div class="space-y-4">
            <% list.forEach(resp => { %>
              <div class="relative border border-slate-200 dark:border-white/10 rounded-xl p-5 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-indigo-400/60 transition">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                  <div class="min-w-0 flex-1">
                    <div class="text-slate-900 dark:text-white font-semibold text-base flex flex-wrap items-center gap-2">
                      <span class="break-all">🔑 "<%= resp.trigger %>"</span>

                      <% if (resp.isActive) { %>
                        <span class="inline-flex items-center rounded-md bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                          Activo
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center rounded-md bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                          Inactivo
                        </span>
                      <% } %>

                      <span class="inline-flex items-center rounded-md bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                        Prioridad: <%= resp.priority %>
                      </span>
                    </div>

                    <% if (resp.category) { %>
                      <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                        📂 <%= resp.category %>
                      </div>
                    <% } %>

                    <div class="mt-3 text-sm text-slate-700 dark:text-slate-300 leading-relaxed rounded-lg bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-white/10 px-3 py-3 whitespace-pre-line break-words">
                      <%= resp.response %>
                    </div>
                  </div>

                  <div class="flex-shrink-0 flex gap-2">
                    <button
                      class="inline-flex items-center justify-center rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                      onclick="editResponse('<%= resp.id %>')">
                      ✏️ <span class="hidden sm:inline">&nbsp;Editar</span>
                    </button>

                    <button
                      class="inline-flex items-center justify-center rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                      onclick="deleteResponse('<%= resp.id %>')">
                      🗑️ <span class="hidden sm:inline">&nbsp;Eliminar</span>
                    </button>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="px-6 py-16 text-center">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
              <i data-lucide="inbox" class="icon-lg text-slate-400"></i>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">No hay respuestas automáticas configuradas</p>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Crea una para comenzar</p>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <!-- Modal Crear/Editar Respuesta (Tailwind-only) -->
  <div id="responseModal" class="hidden fixed inset-0 z-50 items-start justify-center bg-black/60 backdrop-blur-sm p-4 overflow-y-auto">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card w-full max-w-2xl border border-slate-200 dark:border-white/10 max-h-[90vh] overflow-y-auto">
      <!-- Header sticky -->
      <div class="px-6 py-4 border-b border-slate-200 dark:border-white/10 flex items-center justify-between sticky top-0 bg-white dark:bg-slate-900 z-10">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
          <i data-lucide="bot" class="icon text-primary"></i>
          <span id="modalTitle">Nueva Respuesta Automática</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="closeResponseModal()">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <!-- Body -->
      <div class="p-6">
        <form id="responseForm" class="space-y-5">
          <input type="hidden" id="responseId">

          <div>
            <label class="block mb-2 text-sm font-semibold">Palabra clave de activación *</label>
            <input
              id="responseTrigger" required placeholder="ej: horario, precio, ubicación"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 focus:ring-0"
            >
            <small class="block text-xs text-slate-500 dark:text-slate-400 mt-1">
              La respuesta se activará cuando el cliente escriba esta palabra.
            </small>
          </div>

          <div>
            <label class="block mb-2 text-sm font-semibold">Respuesta *</label>
            <textarea
              id="responseContent" rows="5" required placeholder="La respuesta que recibirá el cliente…"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 focus:ring-0"
            ></textarea>

