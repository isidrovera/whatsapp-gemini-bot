# ==================================
# DATABASE
# ==================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=system15
POSTGRES_DB=whatsapp_bot
POSTGRES_PORT=5432

# Para Docker (interno)
DATABASE_URL=postgresql://postgres:system15@postgres:5432/whatsapp_bot?schema=public

# Para desarrollo local (comentar cuando uses Docker)
# DATABASE_URL=postgresql://postgres:system15@localhost:5432/whatsapp_bot?schema=public

# ==================================
# GEMINI AI
# ==================================
GEMINI_API_KEY=

# ==================================
# EXTERNAL APIs (opcional)
# ==================================
RENIEC_API_TOKEN=
SUNAT_API_TOKEN=

# ==================================
# WEB SERVER
# ==================================
WEB_PORT=3000

# ==================================
# SESSION
# ==================================
SESSION_SECRET=whatsapp-bot-super-secret-key-change-in-production

# ==================================
# NODE ENVIRONMENT
# ==================================
NODE_ENV=production
LOG_LEVEL=info