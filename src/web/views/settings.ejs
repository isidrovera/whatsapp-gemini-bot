<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente + Tailwind -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary:{ DEFAULT:'#1e3a8a', 600:'#1e3a8a', 700:'#1e40af' },
          },
          boxShadow:{ soft:'0 10px 25px -10px rgba(0,0,0,.15)' }
        }
      },
      darkMode:'media'
    }
  </script>

  <!-- motion + íconos -->
  <script src="https://unpkg.com/@motionone/dom/dist/motion.min.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration:.001ms !important;
        animation-iteration-count:1 !important;
        transition-duration:.001ms !important;
        scroll-behavior:auto !important;
      }
    }
    .sidebar-link-active{
      background-color:rgba(255,255,255,.12);
      color:#fff !important;
      font-weight:600;
    }
    .tab-active{
      background-color:rgb(30 64 175 / .08);
      color:rgb(30 58 138 / 1);
    }
    .dark .tab-active{
      background-color:rgb(30 64 175 / .25);
      color:#fff;
    }
  </style>
</head>

<body class="h-full bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
<a href="#main-content"
   class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-3 focus:py-2 focus:rounded-lg shadow">
  Saltar al contenido
</a>

<%
  // Helper para marcar item activo en sidebar
  function isActive(p){
    return (page === p || (!page && p==='dashboard')) ? 'sidebar-link-active' : '';
  }

  // Tabs disponibles según categorías existentes
  const tabs = [];
  if (grouped.gemini)        tabs.push({id:'gemini',        label:'Gemini AI',        icon:'bot'});
  if (grouped.odoo)          tabs.push({id:'odoo',          label:'Odoo ERP',         icon:'building-2'});
  if (grouped.external_api)  tabs.push({id:'external_api',  label:'APIs Externas',    icon:'plug'});
  if (grouped.company)       tabs.push({id:'company',       label:'Empresa',          icon:'phone'});
  if (grouped.system)        tabs.push({id:'system',        label:'Sistema',          icon:'settings'});

  // Pestaña de API Keys SIEMPRE visible
  tabs.push({id:'api_keys', label:'API / Tokens', icon:'key-round'});

  // cuál tab se abre primero
  const defaultTab = tabs.length ? tabs[0].id : null;
%>

<div class="min-h-screen w-full flex relative">

  <!-- Overlay móvil -->
  <div id="mobile-sidebar-overlay"
       class="fixed inset-0 bg-black/40 z-40 opacity-0 pointer-events-none transition-opacity md:hidden"></div>

  <!-- SIDEBAR -->
  <aside id="sidebar"
         class="w-[280px] flex flex-col bg-gradient-to-b from-primary to-primary-700 text-white shadow-soft
                fixed inset-y-0 left-0 z-50 -translate-x-full transition-transform md:translate-x-0 md:relative md:flex"
         role="navigation"
         aria-label="Menú principal">

    <div class="px-5 py-6 border-b border-white/10 bg-white/5 backdrop-blur flex items-center justify-between">
      <h2 class="text-xl font-semibold flex items-center gap-2">
        <i data-lucide="bot" class="w-5 h-5"></i> Bot Admin
      </h2>

      <!-- Botón cerrar sidebar móvil -->
      <button id="close-sidebar-btn"
              class="md:hidden inline-flex items-center justify-center rounded-lg text-white/70 hover:text-white hover:bg-white/10 p-2"
              aria-label="Cerrar menú">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <nav class="py-4 flex-1 overflow-y-auto">
      <ul class="px-2 space-y-1 text-[15px] leading-5">
        <li>
          <a href="/"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('dashboard') %>"
             aria-current="<%= isActive('dashboard') ? 'page' : false %>">
            <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
            <span>Dashboard</span>
          </a>
        </li>

        <li>
          <a href="/contacts"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('contacts') %>"
             aria-current="<%= isActive('contacts') ? 'page' : false %>">
            <i data-lucide="users" class="w-5 h-5"></i>
            <span>Contactos</span>
          </a>
        </li>

        <li>
          <a href="/conversations"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('conversations') %>"
             aria-current="<%= isActive('conversations') ? 'page' : false %>">
            <i data-lucide="message-circle" class="w-5 h-5"></i>
            <span>Conversaciones</span>
          </a>
        </li>

        <li>
          <a href="/blocked"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('blocked') %>"
             aria-current="<%= isActive('blocked') ? 'page' : false %>">
            <i data-lucide="ban" class="w-5 h-5"></i>
            <span>Bloqueados</span>
          </a>
        </li>

        <li><div class="my-3 h-px bg-white/10"></div></li>

        <li>
          <a href="/calendar"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('calendar') %>"
             aria-current="<%= isActive('calendar') ? 'page' : false %>">
            <i data-lucide="calendar" class="w-5 h-5"></i>
            <span>Calendario</span>
          </a>
        </li>

        <li>
          <a href="/working-hours"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('working-hours') %>"
             aria-current="<%= isActive('working-hours') ? 'page' : false %>">
            <i data-lucide="clock" class="w-5 h-5"></i>
            <span>Horarios</span>
          </a>
        </li>

        <li>
          <a href="/admin-users"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('admin-users') %>"
             aria-current="<%= isActive('admin-users') ? 'page' : false %>">
            <i data-lucide="shield" class="w-5 h-5"></i>
            <span>Usuarios Admin</span>
          </a>
        </li>

        <li><div class="my-3 h-px bg-white/10"></div></li>

        <li>
          <a href="/settings"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white hover:bg-white/10 transition <%= isActive('settings') %>"
             aria-current="<%= isActive('settings') ? 'page' : false %>">
            <i data-lucide="settings" class="w-5 h-5"></i>
            <span>Configuración</span>
          </a>
        </li>

        <li>
          <a href="/departments"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('departments') %>"
             aria-current="<%= isActive('departments') ? 'page' : false %>">
            <i data-lucide="building-2" class="w-5 h-5"></i>
            <span>Departamentos</span>
          </a>
        </li>

        <li>
          <a href="/products"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('products') %>"
             aria-current="<%= isActive('products') ? 'page' : false %>">
            <i data-lucide="package" class="w-5 h-5"></i>
            <span>Productos</span>
          </a>
        </li>

        <li>
          <a href="/auto-responses"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('auto-responses') %>"
             aria-current="<%= isActive('auto-responses') ? 'page' : false %>">
            <i data-lucide="robot" class="w-5 h-5"></i>
            <span>Auto-respuestas</span>
          </a>
        </li>

        <li>
          <a href="/tags"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('tags') %>"
             aria-current="<%= isActive('tags') ? 'page' : false %>">
            <i data-lucide="tags" class="w-5 h-5"></i>
            <span>Tags</span>
          </a>
        </li>

        <li>
          <a href="/templates"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('templates') %>"
             aria-current="<%= isActive('templates') ? 'page' : false %>">
            <i data-lucide="file-text" class="w-5 h-5"></i>
            <span>Plantillas</span>
          </a>
        </li>

        <li>
          <a href="/metrics"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('metrics') %>"
             aria-current="<%= isActive('metrics') ? 'page' : false %>">
            <i data-lucide="line-chart" class="w-5 h-5"></i>
            <span>Métricas</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="mt-auto p-4 bg-white/5 border-t border-white/10">
      <div class="rounded-xl bg-white/10 p-3">
        <div class="text-[11px] uppercase tracking-wide opacity-80">Sesión activa</div>
        <div class="font-semibold text-sm mt-1 flex items-center gap-2">
          <i data-lucide="user" class="w-4 h-4"></i>
          <%= user || 'Admin' %>
        </div>
      </div>

      <form method="POST" action="/auth/logout" class="mt-3">
        <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% } %>
        <button type="submit"
                class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-white/20 bg-red-500/20 hover:bg-red-500/30 text-white py-2.5 text-sm font-medium transition">
          <i data-lucide="log-out" class="w-4 h-4"></i> Cerrar sesión
        </button>
      </form>
    </div>
  </aside>

  <!-- MAIN -->
  <main id="main-content" class="flex-1 p-4 md:p-8 w-full md:w-auto">

    <!-- HEADER -->
    <header class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft px-6 py-5 mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex items-start justify-between w-full md:w-auto">
        <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white flex items-center gap-3">
          <i data-lucide="settings" class="w-7 h-7 text-primary"></i>
          Configuración del Sistema
        </h1>

        <!-- abrir sidebar móvil -->
        <button id="open-sidebar-btn"
                class="md:hidden inline-flex items-center justify-center rounded-lg text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 p-2 shadow-soft"
                aria-label="Abrir menú">
          <i data-lucide="menu" class="w-6 h-6"></i>
        </button>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:justify-end w/full md:w-auto">
        <button id="btnResetDirty"
                title="Descartar cambios no guardados"
                class="hidden inline-flex items-center justify-center gap-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-200 px-3 py-2 text-sm font-medium shadow"
                type="button">
          <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
          Descartar
        </button>

        <button id="btnSaveAll"
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-2 text-sm font-semibold shadow-soft transition"
                type="button"
                onclick="saveAllConfigs()">
          <i data-lucide="save" class="w-4 h-4"></i>
          Guardar Todos
        </button>
      </div>
    </header>

    <!-- ALERTS -->
    <section class="space-y-3 mb-6">
      <div class="flex items-start gap-3 rounded-2xl bg-amber-50 text-amber-800 dark:bg-amber-900/30 dark:text-amber-200 p-4 border-l-4 border-amber-400 shadow-soft">
        <div class="rounded-lg bg-amber-100 text-amber-700 dark:bg-amber-900/50 dark:text-amber-200 p-2 flex-shrink-0">
          <i data-lucide="alert-triangle" class="w-4 h-4"></i>
        </div>
        <div class="text-sm leading-relaxed">
          <p class="font-semibold text-amber-900 dark:text-amber-100 mb-1">Importante:</p>
          <p>Los valores marcados como “Encriptado” se guardan de forma segura. Después de guardar se mostrarán como ********.</p>
        </div>
      </div>

      <div class="flex items-start gap-3 rounded-2xl bg-blue-50 text-blue-800 dark:bg-blue-900/30 dark:text-blue-200 p-4 border-l-4 border-blue-400 shadow-soft">
        <div class="rounded-lg bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-200 p-2 flex-shrink-0">
          <i data-lucide="info" class="w-4 h-4"></i>
        </div>
        <div class="text-sm leading-relaxed">
          <p class="font-semibold text-blue-900 dark:text-blue-100 mb-1">Tip:</p>
          <p>Los cambios en Gemini y Odoo pueden requerir reiniciar el bot para aplicarse completamente.</p>
        </div>
      </div>
    </section>

    <!-- TABS -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-soft border border-slate-100/70 dark:border-white/5 mb-6">
      <div class="px-6 py-4 border-b border-slate-100/70 dark:border-white/5 flex flex-wrap gap-2 items-center">
        <% tabs.forEach(t => { %>
          <button
            class="tab-btn inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800 transition
                   <%= t.id === defaultTab ? 'tab-active' : '' %>"
            data-tab="<%= t.id %>">
            <i data-lucide="<%= t.icon %>" class="w-4 h-4"></i>
            <span><%= t.label %></span>
          </button>
        <% }) %>
      </div>

      <!-- PANELS WRAPPER -->
      <div class="p-6">

        <% /* ------------- GEMINI PANEL ------------- */ %>
        <% if (grouped.gemini) { %>
        <section
          class="tab-panel <%= defaultTab === 'gemini' ? '' : 'hidden' %>"
          data-tab-panel="gemini">

          <div class="flex items-start justify-between flex-col md:flex-row gap-4 mb-4">
            <div>
              <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i data-lucide="bot" class="w-5 h-5 text-primary"></i>
                Gemini AI
              </h2>
              <p class="text-sm text-slate-500 dark:text-slate-400">
                Configuración de modelo e API Key.
              </p>
            </div>

            <button type="button"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 text-sm font-semibold shadow-soft transition whitespace-nowrap"
              onclick="reinitializeService('gemini')">
              <i data-lucide="refresh-cw" class="w-4 h-4"></i>
              Reiniciar Gemini
            </button>
          </div>

          <div class="rounded-xl border border-slate-200/70 dark:border-white/10 bg-white dark:bg-slate-900 shadow-soft max-h-[70vh] overflow-y-auto p-4 space-y-4">
            <% grouped.gemini.forEach(config => { %>
              <div class="flex flex-col md:grid md:grid-cols-[260px,1fr] gap-4 rounded-lg border border-slate-200/70 dark:border-white/10 p-4 hover:border-indigo-400/60 hover:bg-slate-50/50 dark:hover:bg-white/5 transition">
                <div class="space-y-2">
                  <div class="text-sm font-semibold text-slate-900 dark:text-white">
                    <%= config.key.replace(/_/g,' ').toUpperCase() %>
                  </div>
                  <% if (config.description) { %>
                    <div class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                      <%= config.description %>
                    </div>
                  <% } %>

                  <% if (config.isEncrypted) { %>
                    <span class="inline-flex items-center gap-2 rounded-full bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 px-2 py-1 text-[11px] font-bold uppercase tracking-wide w-fit">
                      <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                      Encriptado
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-2 rounded-full bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 px-2 py-1 text-[11px] font-bold uppercase tracking-wide w-fit">
                      <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                      Texto plano
                    </span>
                  <% } %>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 sm:items-start">
                  <% if (config.key === 'model') { %>
                    <select
                      class="config-input w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm px-3 py-2.5 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                      data-category="<%= config.category %>"
                      data-key="<%= config.key %>"
                      data-encrypted="<%= config.isEncrypted %>">
                      <option value="gemini-2.5-flash" <%= config.value === 'gemini-2.5-flash' ? 'selected' : '' %>>gemini-2.5-flash</option>
                      <option value="gemini-2.0-flash-exp" <%= config.value === 'gemini-2.0-flash-exp' ? 'selected' : '' %>>Gemini 2.0 Flash Experimental</option>
                      <option value="gemini-1.5-pro" <%= config.value === 'gemini-1.5-pro' ? 'selected' : '' %>>Gemini 1.5 Pro</option>
                      <option value="gemini-1.5-flash" <%= config.value === 'gemini-1.5-flash' ? 'selected' : '' %>>Gemini 1.5 Flash</option>
                    </select>
                  <% } else { %>
                    <div class="flex w-full gap-2">
                      <input
                        type="<%= config.isEncrypted ? 'password' : 'text' %>"
                        class="config-input flex-1 rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm px-3 py-2.5 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 <%= config.isEncrypted ? 'bg-amber-50 dark:bg-amber-900/20 border-amber-300 dark:border-amber-600' : '' %>"
                        value="<%= config.value || '' %>"
                        data-category="<%= config.category %>"
                        data-key="<%= config.key %>"
                        data-encrypted="<%= config.isEncrypted %>"
                        placeholder="<%= config.description || 'Ingrese valor...' %>"/>

                      <% if (config.isEncrypted) { %>
                        <button
                          class="toggle-eye inline-flex items-center justify-center rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-200 px-2.5 py-2 text-xs font-medium shadow"
                          type="button"
                          aria-label="Mostrar/Ocultar">
                          👁️
                        </button>
                      <% } %>
                    </div>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        </section>
        <% } %>

        <% /* ------------- ODOO PANEL ------------- */ %>
        <% if (grouped.odoo) { %>
        <section
          class="tab-panel <%= defaultTab === 'odoo' ? '' : 'hidden' %>"
          data-tab-panel="odoo">

          <div class="mb-4">
            <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <i data-lucide="building-2" class="w-5 h-5 text-primary"></i>
              Odoo ERP
            </h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">
              Conexión con ERP / credenciales.
            </p>
          </div>

          <div class="rounded-xl border border-slate-200/70 dark:border-white/10 bg-white dark:bg-slate-900 shadow-soft max-h-[70vh] overflow-y-auto p-4 space-y-4">
            <% grouped.odoo.forEach(config => { %>
              <div class="flex flex-col md:grid md:grid-cols-[260px,1fr] gap-4 rounded-lg border border-slate-200/70 dark:border-white/10 p-4 hover:border-indigo-400/60 hover:bg-slate-50/50 dark:hover:bg-white/5 transition">
                <div class="space-y-2">
                  <div class="text-sm font-semibold text-slate-900 dark:text-white">
                    <%= config.key.replace(/_/g,' ').toUpperCase() %>
                  </div>
                  <% if (config.description) { %>
                    <div class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                      <%= config.description %>
                    </div>
                  <% } %>

                  <% if (config.isEncrypted) { %>
                    <span class="inline-flex items-center gap-2 rounded-full bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 px-2 py-1 text-[11px] font-bold uppercase tracking-wide w-fit">
                      <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                      Encriptado
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-2 rounded-full bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 px-2 py-1 text-[11px] font-bold uppercase tracking-wide w-fit">
                      <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                      Texto plano
                    </span>
                  <% } %>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 sm:items-start">
                  <div class="flex w-full gap-2">
                    <input
                      type="<%= config.isEncrypted ? 'password' : 'text' %>"
                      class="config-input flex-1 rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm px-3 py-2.5 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 <%= config.isEncrypted ? 'bg-amber-50 dark:bg-amber-900/20 border-amber-300 dark:border-amber-600' : '' %>"
                      value="<%= config.value || '' %>"
                      data-category="<%= config.category %>"
                      data-key="<%= config.key %>"
                      data-encrypted="<%= config.isEncrypted %>"
                      placeholder="<%= config.description || 'Ingrese valor...' %>"/>

                    <% if (config.isEncrypted) { %>
                      <button
                        class="toggle-eye inline-flex items-center justify-center rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-200 px-2.5 py-2 text-xs font-medium shadow"
                        type="button"
                        aria-label="Mostrar/Ocultar">
                        👁️
                      </button>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </section>
        <% } %>

        <% /* ------------- EXTERNAL API PANEL ------------- */ %>
        <% if (grouped.external_api) { %>
        <section
          class="tab-panel <%= defaultTab === 'external_api' ? '' : 'hidden' %>"
          data-tab-panel="external_api">

          <div class="mb-4">
            <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <i data-lucide="plug" class="w-5 h-5 text-primary"></i>
              APIs Externas
            </h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">
              Tokens y llaves para integraciones de terceros.
            </p>
          </div>

          <div class="rounded-xl border border-slate-200/70 dark:border-white/10 bg-white dark:bg-slate-900 shadow-soft max-h-[70vh] overflow-y-auto p-4 space-y-4">
            <% grouped.external_api.forEach(config => { %>
              <div class="flex flex-col md:grid md:grid-cols-[260px,1fr] gap-4 rounded-lg border border-slate-200/70 dark:border-white/10 p-4 hover:border-indigo-400/60 hover:bg-slate-50/50 dark:hover:bg-white/5 transition">
                <div class="space-y-2">
                  <div class="text-sm font-semibold text-slate-900 dark:text-white">
                    <%= config.key.replace(/_/g,' ').toUpperCase() %>
                  </div>
                  <% if (config.description) { %>
                    <div class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                      <%= config.description %>
                    </div>
                  <% } %>

                  <% if (config.isEncrypted) { %>
                    <span class="inline-flex items-center gap-2 rounded-full bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 px-2 py-1 text-[11px] font-bold uppercase tracking-wide w-fit">
                      <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                      Encriptado
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-2 rounded-full bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 px-2 py-1 text-[11px] font-bold uppercase tracking-wide w-fit">
                      <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                      Texto plano
                    </span>
                  <% } %>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 sm:items-start">
                  <div class="flex w-full gap-2">
                    <input
                      type="<%= config.isEncrypted ? 'password' : 'text' %>"
                      class="config-input flex-1 rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm px-3 py-2.5 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 <%= config.isEncrypted ? 'bg-amber-50 dark:bg-amber-900/20 border-amber-300 dark:border-amber-600' : '' %>"
                      value="<%= config.value || '' %>"
                      data-category="<%= config.category %>"
                      data-key="<%= config.key %>"
                      data-encrypted="<%= config.isEncrypted %>"
                      placeholder="<%= config.description || 'Ingrese valor...' %>"/>

                    <% if (config.isEncrypted) { %>
                      <button
                        class="toggle-eye inline-flex items-center justify-center rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-200 px-2.5 py-2 text-xs font-medium shadow"
                        type="button"
                        aria-label="Mostrar/Ocultar">
                        👁️
                      </button>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </section>
        <% } %>

        <% /* ------------- COMPANY PANEL ------------- */ %>
        <% if (grouped.company) { %>
        <section
          class="tab-panel <%= defaultTab === 'company' ? '' : 'hidden' %>"
          data-tab-panel="company">

          <div class="mb-4">
            <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <i data-lucide="phone" class="w-5 h-5 text-primary"></i>
              Información de la Empresa
            </h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">
              Datos visibles al cliente (teléfono, correo, etc).
            </p>
          </div>

          <div class="rounded-xl border border-slate-200/70 dark:border-white/10 bg-white dark:bg-slate-900 shadow-soft max-h-[70vh] overflow-y-auto p-4 space-y-4">
            <% grouped.company.forEach(config => { %>
              <div class="flex flex-col md:grid md:grid-cols-[260px,1fr] gap-4 rounded-lg border border-slate-200/70 dark:border-white/10 p-4 hover:border-indigo-400/60 hover:bg-slate-50/50 dark:hover:bg-white/5 transition">
                <div class="space-y-2">
                  <div class="text-sm font-semibold text-slate-900 dark:text-white">
                    <%= config.key.replace(/_/g,' ').toUpperCase() %>
                  </div>
                  <% if (config.description) { %>
                    <div class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                      <%= config.description %>
                    </div>
                  <% } %>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 sm:items-start">
                  <input
                    type="text"
                    class="config-input w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm px-3 py-2.5 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                    value="<%= config.value || '' %>"
                    data-category="<%= config.category %>"
                    data-key="<%= config.key %>"
                    data-encrypted="false"
                    placeholder="<%= config.description || 'Ingrese valor...' %>"/>
                </div>
              </div>
            <% }) %>
          </div>
        </section>
        <% } %>

        <% /* ------------- SYSTEM PANEL ------------- */ %>
        <% if (grouped.system) { %>
        <section
          class="tab-panel <%= defaultTab === 'system' ? '' : 'hidden' %>"
          data-tab-panel="system">

          <div class="mb-4">
            <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <i data-lucide="settings" class="w-5 h-5 text-primary"></i>
              Sistema
            </h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">
              Flags internos y comportamientos del bot.
            </p>
          </div>

          <div class="rounded-xl border border-slate-200/70 dark:border-white/10 bg-white dark:bg-slate-900 shadow-soft max-h-[70vh] overflow-y-auto p-4 space-y-4">
            <% grouped.system.forEach(config => { %>
              <div class="flex flex-col md:grid md:grid-cols-[260px,1fr] gap-4 rounded-lg border border-slate-200/70 dark:border-white/10 p-4 hover:border-indigo-400/60 hover:bg-slate-50/50 dark:hover:bg-white/5 transition">
                <div class="space-y-2">
                  <div class="text-sm font-semibold text-slate-900 dark:text-white">
                    <%= config.key.replace(/_/g,' ').toUpperCase() %>
                  </div>
                  <% if (config.description) { %>
                    <div class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                      <%= config.description %>
                    </div>
                  <% } %>

                  <% if (config.isEncrypted) { %>
                    <span class="inline-flex items-center gap-2 rounded-full bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 px-2 py-1 text-[11px] font-bold uppercase tracking-wide w-fit">
                      <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                      Encriptado
                    </span>
                  <% } %>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 sm:items-start">
                  <% if (config.key === 'auto_response_enabled' || config.key === 'department_routing_enabled') { %>
                    <select
                      class="config-input w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm px-3 py-2.5 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                      data-category="<%= config.category %>"
                      data-key="<%= config.key %>"
                      data-encrypted="false">
                      <option value="true" <%= config.value === 'true' ? 'selected' : '' %>>Habilitado</option>
                      <option value="false" <%= config.value === 'false' ? 'selected' : '' %>>Deshabilitado</option>
                    </select>
                  <% } else { %>
                    <div class="flex w-full gap-2">
                      <input
                        type="<%= config.isEncrypted ? 'password' : 'text' %>"
                        class="config-input flex-1 rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm px-3 py-2.5 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 <%= config.isEncrypted ? 'bg-amber-50 dark:bg-amber-900/20 border-amber-300 dark:border-amber-600' : '' %>"
                        value="<%= config.value || '' %>"
                        data-category="<%= config.category %>"
                        data-key="<%= config.key %>"
                        data-encrypted="<%= config.isEncrypted %>"
                        placeholder="<%= config.description || 'Ingrese valor...' %>"/>

                      <% if (config.isEncrypted) { %>
                        <button
                          class="toggle-eye inline-flex items-center justify-center rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-200 px-2.5 py-2 text-xs font-medium shadow"
                          type="button"
                          aria-label="Mostrar/Ocultar">
                          👁️
                        </button>
                      <% } %>
                    </div>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        </section>
        <% } %>

        <% /* ------------- API KEYS PANEL ------------- */ %>
        <section
          class="tab-panel <%= defaultTab === 'api_keys' ? '' : 'hidden' %>"
          data-tab-panel="api_keys">

          <div class="flex items-start justify-between flex-col md:flex-row gap-4 mb-4">
            <div>
              <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i data-lucide="key-round" class="w-5 h-5 text-primary"></i>
                API / Tokens
              </h2>
              <p class="text-sm text-slate-500 dark:text-slate-400">
                Estas llaves controlan acceso externo al bot (ej. Odoo, Postman). Cada request a
                <code class="px-1 py-0.5 rounded bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-200 text-[11px] font-mono">/api/send-message</code>
                debe enviar una cabecera
                <code class="px-1 py-0.5 rounded bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-200 text-[11px] font-mono">x-api-key</code>.
              </p>
            </div>

            <button
              id="btnNewApiKey"
              type="button"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 text-sm font-semibold shadow-soft transition whitespace-nowrap">
              <i data-lucide="plus" class="w-4 h-4"></i>
              Nueva API Key
            </button>
          </div>

          <div class="rounded-xl border border-slate-200/70 dark:border-white/10 bg-white dark:bg-slate-900 shadow-soft p-0 overflow-hidden">
            <table class="min-w-full text-sm">
              <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-300 text-left uppercase text-[11px] tracking-wide font-bold border-b border-slate-200/70 dark:border-white/10">
                <tr>
                  <th class="px-4 py-3">Nombre</th>
                  <th class="px-4 py-3">Preview</th>
                  <th class="px-4 py-3">Estado</th>
                  <th class="px-4 py-3">Último uso</th>
                  <th class="px-4 py-3">Expira</th>
                  <th class="px-4 py-3 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody id="apiKeysTableBody" class="divide-y divide-slate-200/70 dark:divide-white/5 text-slate-700 dark:text-slate-200">
                <tr id="apiKeysErrorRow" class="hidden">
                  <td colspan="6" class="px-4 py-4 text-red-600 dark:text-red-400 text-center text-sm font-medium">
                    Error al cargar llaves
                  </td>
                </tr>
                <tr id="apiKeysEmptyRow" class="hidden">
                  <td colspan="6" class="px-4 py-6 text-center text-slate-400 dark:text-slate-500 text-sm">
                    No hay llaves creadas todavía.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Modal para nueva API Key (muestra key completa una sola vez) -->
          <div id="apiKeyModal"
               class="fixed inset-0 z-[9999] bg-black/50 hidden items-center justify-center p-4">
            <div class="bg-white dark:bg-slate-900 rounded-xl shadow-xl max-w-lg w-full p-6 text-slate-800 dark:text-slate-100">
              <h3 class="text-lg font-bold flex items-center gap-2 text-slate-900 dark:text-white mb-2">
                <i data-lucide="key-round" class="w-5 h-5 text-primary"></i>
                Nueva API Key
              </h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 mb-4 leading-relaxed">
                Copia esta clave ahora. Por seguridad, no se volverá a mostrar completa.
              </p>

              <div class="bg-slate-100 dark:bg-slate-800 rounded-lg p-3 mb-4 font-mono text-[13px] break-all"
                   id="apiKeyFullValue"></div>

              <div class="flex items-center justify-end gap-3">
                <button
                  type="button"
                  id="btnCloseApiKeyModal"
                  class="inline-flex items-center justify-center rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 text-sm font-semibold shadow-soft">
                  Entendido
                </button>
              </div>
            </div>
          </div>
        </section>

      </div>
    </section>
  </main>
</div>

<!-- Indicador "guardado ok" -->
<div id="saveIndicator"
     class="hidden fixed bottom-6 right-6 z-[2000] items-center gap-2 rounded-xl bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300 shadow-soft px-4 py-3 text-sm font-bold"
     role="status" aria-live="polite">
  <span>✅</span><span>Configuración guardada</span>
</div>

<script>
  // íconos lucide
  if (window.lucide) { lucide.createIcons(); }

  // ===== SIDEBAR MÓVIL =====
  (function(){
    const sidebar   = document.getElementById('sidebar');
    const overlay   = document.getElementById('mobile-sidebar-overlay');
    const openBtn   = document.getElementById('open-sidebar-btn');
    const closeBtn  = document.getElementById('close-sidebar-btn');

    function openSidebar(){
      sidebar.classList.remove('-translate-x-full');
      overlay.classList.remove('opacity-0','pointer-events-none');
    }
    function closeSidebar(){
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('opacity-0','pointer-events-none');
    }

    openBtn && openBtn.addEventListener('click', openSidebar);
    closeBtn && closeBtn.addEventListener('click', closeSidebar);
    overlay && overlay.addEventListener('click', closeSidebar);
  })();

  // ===== ANIMACIONES SUAVES =====
  (function(){
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReduced && window.motion) {
      const cards = document.querySelectorAll('.tab-panel [class*="border-slate-200"]');
      cards.forEach((el,i)=>{
        motion.animate(
          el,
          { opacity:[0,1], transform:['translateY(8px)','translateY(0)'] },
          { duration:.4, delay:i*0.03, easing:'ease-out' }
        );
      });
    }
  })();

  // ===== TABS =====
  const tabBtns   = document.querySelectorAll('.tab-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');

  function activateTab(id){
    tabBtns.forEach(btn=>{
      const isActive = btn.dataset.tab === id;
      btn.classList.toggle('tab-active', isActive);
    });
    tabPanels.forEach(panel=>{
      panel.classList.toggle('hidden', panel.dataset.tabPanel !== id);
    });
  }

  tabBtns.forEach(btn=>{
    btn.addEventListener('click', ()=>{
      activateTab(btn.dataset.tab);
    });
  });

  // ====== CONFIG SAVE LOGIC ======
  const SECRET_SENTINEL = '********';
  let dirty = false;
  const btnReset = document.getElementById('btnResetDirty');
  const saveIndicator = document.getElementById('saveIndicator');

  function markDirty(){
    if(!dirty){
      dirty = true;
      btnReset.classList.remove('hidden');
      btnReset.classList.add('inline-flex');
    }
  }

  // toggle 👁️ para inputs password
  document.querySelectorAll('.toggle-eye').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const input = btn.previousElementSibling;
      if(!input) return;
      input.type = (input.type === 'password') ? 'text' : 'password';
    });
  });

  // detectar cambios para estado dirty
  document.querySelectorAll('.config-input').forEach(el=>{
    el.addEventListener('input', markDirty);
    el.addEventListener('change', markDirty);
  });

  // descartar cambios
  btnReset && btnReset.addEventListener('click', ()=>{ location.reload(); });

  // aviso al salir con cambios sin guardar
  window.addEventListener('beforeunload', (e)=>{
    if(!dirty) return;
    e.preventDefault();
    e.returnValue = '';
  });

  // mostrar indicador guardado
  function showSaveIndicator(){
    saveIndicator.classList.remove('hidden');
    saveIndicator.classList.add('flex');
    setTimeout(()=>{
      saveIndicator.classList.remove('flex');
      saveIndicator.classList.add('hidden');
    },2200);
  }

  // guardar TODOS
  async function saveAllConfigs(){
    const inputs = document.querySelectorAll('.config-input');
    const configs = [];
    inputs.forEach(input=>{
      const category    = input.dataset.category;
      const key         = input.dataset.key;
      const value       = input.value;
      const isEncrypted = input.dataset.encrypted === 'true';

      if(!category || !key) return;

      // no enviar secretos si no cambiaron
      if(isEncrypted && (!value || value === SECRET_SENTINEL)) return;

      configs.push({ category, key, value, isEncrypted });
    });

    try{
      const res = await fetch('/settings/api/bulk', {
        method:'POST',
        headers:{ 'Content-Type':'application/json' },
        body:JSON.stringify({ configs })
      });
      const result = await res.json();
      if(result.success){
        dirty = false;
        btnReset.classList.add('hidden');
        btnReset.classList.remove('inline-flex');
        showSaveIndicator();
      }else{
        alert('❌ Error al guardar: ' + (result.error || 'Desconocido'));
      }
    }catch(err){
      alert('❌ Error al guardar configuración');
      console.error(err);
    }
  }

  // auto-guardado on blur
  document.querySelectorAll('.config-input').forEach(input=>{
    input.addEventListener('blur', async function(){
      const category    = this.dataset.category;
      const key         = this.dataset.key;
      const value       = this.value;
      const isEncrypted = this.dataset.encrypted === 'true';

      if(!category || !key) return;
      if(isEncrypted && (!value || value === SECRET_SENTINEL)) return;

      try{
        await fetch('/settings/api', {
          method:'POST',
          headers:{ 'Content-Type':'application/json' },
          body:JSON.stringify({ category, key, value, isEncrypted })
        });
      }catch(error){
        console.error('Error auto-saving:', error);
      }
    });
  });

  // atajo Ctrl/⌘+S
  window.addEventListener('keydown',(e)=>{
    const isMac = navigator.platform.toUpperCase().includes('MAC');
    const combo = (isMac && e.metaKey && e.key.toLowerCase()==='s') ||
                  (!isMac && e.ctrlKey && e.key.toLowerCase()==='s');
    if(combo){
      e.preventDefault();
      document.getElementById('btnSaveAll').click();
    }
  });

  // reinicio servicio
  async function reinitializeService(service){
    try{
      const res = await fetch(`/settings/api/reinitialize/${service}`, { method:'POST' });
      const result = await res.json();
      if(result.success){
        alert('✅ ' + service.charAt(0).toUpperCase()+service.slice(1) + ' reiniciado exitosamente');
      }else{
        alert('❌ Error al reiniciar: ' + (result.error || 'Desconocido') + (result.detail ? '\nDetalle: '+result.detail : ''));
      }
    }catch(error){
      alert('❌ Error al reiniciar el servicio');
      console.error(error);
    }
  }

  // ======================
  //  API KEYS TAB LOGIC
  // ======================
  const apiKeysTableBody   = document.getElementById('apiKeysTableBody');
  const apiKeysErrorRow    = document.getElementById('apiKeysErrorRow');
  const apiKeysEmptyRow    = document.getElementById('apiKeysEmptyRow');
  const btnNewApiKey       = document.getElementById('btnNewApiKey');
  const apiKeyModal        = document.getElementById('apiKeyModal');
  const apiKeyFullValueEl  = document.getElementById('apiKeyFullValue');
  const btnCloseApiKeyModal= document.getElementById('btnCloseApiKeyModal');

  async function loadApiKeys(){
    try {
      apiKeysErrorRow.classList.add('hidden');

      const res = await fetch('/settings/api-keys');
      const data = await res.json();

      // limpiar filas previas
      [...apiKeysTableBody.querySelectorAll('tr.apiKeyRow')].forEach(tr => tr.remove());

      if (!data.success) {
        apiKeysErrorRow.classList.remove('hidden');
        apiKeysEmptyRow.classList.add('hidden');
        return;
      }

      const list = data.data || [];
      if (list.length === 0) {
        apiKeysEmptyRow.classList.remove('hidden');
        return;
      } else {
        apiKeysEmptyRow.classList.add('hidden');
      }

      list.forEach(k => {
        const tr = document.createElement('tr');
        tr.className = 'apiKeyRow hover:bg-slate-50 dark:hover:bg-slate-800/40 transition';

        const lastUsed = k.lastUsedAt ? new Date(k.lastUsedAt).toLocaleString() : '—';
        const expires  = k.expiresAt  ? new Date(k.expiresAt).toLocaleDateString() : '—';

        const stateBadge = k.isActive
          ? `<span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300 px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide">
               <i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Activa
             </span>`
          : `<span class="inline-flex items-center gap-1 rounded-full bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300 px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide">
               <i data-lucide="pause-circle" class="w-3.5 h-3.5"></i> Inactiva
             </span>`;

        tr.innerHTML = `
          <td class="px-4 py-3 font-medium">${k.name || '(sin nombre)'}</td>

          <td class="px-4 py-3 font-mono text-[12px] text-slate-600 dark:text-slate-400 break-all">
            <span class="apiKeyPreview">${k.preview}</span>
          </td>

          <td class="px-4 py-3">${stateBadge}</td>

          <td class="px-4 py-3 text-slate-500 dark:text-slate-400 text-[13px]">${lastUsed}</td>

          <td class="px-4 py-3 text-slate-500 dark:text-slate-400 text-[13px]">${expires}</td>

          <td class="px-4 py-3 text-right text-[13px]">
            <div class="inline-flex items-center gap-2">
              <button
                class="toggleKeyState inline-flex items-center justify-center rounded-md px-2 py-1 text-xs font-semibold shadow-soft
                       ${k.isActive
                         ? 'bg-red-500/20 text-red-600 hover:bg-red-500/30 dark:bg-red-900/20 dark:text-red-300'
                         : 'bg-emerald-500/20 text-emerald-600 hover:bg-emerald-500/30 dark:bg-emerald-900/20 dark:text-emerald-300'
                       }"
                data-id="${k.id}"
                data-enable="${k.isActive ? 'false' : 'true'}"
                title="${k.isActive ? 'Desactivar' : 'Activar'}">
                ${k.isActive ? 'Desactivar' : 'Activar'}
              </button>

              <button
                class="deleteKey inline-flex items-center justify-center rounded-md px-2 py-1 bg-slate-200 text-slate-700 hover:bg-red-600 hover:text-white dark:bg-slate-700 dark:text-slate-200 dark:hover:bg-red-600 text-xs font-semibold shadow-soft"
                data-id="${k.id}"
                title="Eliminar">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
              </button>
            </div>
          </td>
        `;

        apiKeysTableBody.appendChild(tr);
      });

      if (window.lucide) { window.lucide.createIcons(); }

      apiKeysTableBody.querySelectorAll('.toggleKeyState').forEach(btn=>{
        btn.addEventListener('click', async ()=>{
          const id = btn.getAttribute('data-id');
          const enableStr = btn.getAttribute('data-enable');
          const enable = enableStr === 'true';

          try {
            const resp = await fetch(`/settings/api-keys/${id}/toggle`, {
              method: 'PATCH',
              headers: {'Content-Type':'application/json'},
              body: JSON.stringify({ enable })
            });
            const json = await resp.json();
            if(!json.success){
              alert('❌ No se pudo cambiar estado: ' + (json.error || 'Error'));
              return;
            }
            loadApiKeys();
          } catch (err){
            alert('❌ Error al cambiar estado');
            console.error(err);
          }
        });
      });

      apiKeysTableBody.querySelectorAll('.deleteKey').forEach(btn=>{
        btn.addEventListener('click', async ()=>{
          const id = btn.getAttribute('data-id');
          if(!confirm('¿Eliminar esta API key? Esta acción no se puede deshacer.')) return;
          try {
            const resp = await fetch(`/settings/api-keys/${id}`, { method: 'DELETE' });
            const json = await resp.json();
            if(!json.success){
              alert('❌ No se pudo eliminar: ' + (json.error || 'Error'));
              return;
            }
            loadApiKeys();
          } catch (err){
            alert('❌ Error al eliminar key');
            console.error(err);
          }
        });
      });

    } catch(err){
      console.error(err);
      apiKeysErrorRow.classList.remove('hidden');
    }
  }

  // Crear nueva key
  btnNewApiKey && btnNewApiKey.addEventListener('click', async ()=>{
    const name = prompt('Nombre para esta API Key (ej. "Odoo Producción"):');
    if(!name) return;

    const description = prompt('Descripción (opcional):') || '';
    let expiresAt = prompt('Fecha de expiración (YYYY-MM-DD) o deja vacío:') || '';
    if (expiresAt.trim() === '') expiresAt = '';

    try{
      const resp = await fetch('/settings/api-keys', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({
          name,
          description,
          expiresAt: expiresAt || null
        })
      });
      const json = await resp.json();
      if(!json.success){
        alert('❌ Error creando API key: ' + (json.error || 'Error'));
        return;
      }

      // Mostrar modal con la key completa (solo una vez)
      apiKeyFullValueEl.textContent = json.data.key;
      apiKeyModal.classList.remove('hidden');
      apiKeyModal.classList.add('flex');

      loadApiKeys();
    }catch(err){
      alert('❌ Error creando API key');
      console.error(err);
    }
  });

  btnCloseApiKeyModal && btnCloseApiKeyModal.addEventListener('click', ()=>{
    apiKeyModal.classList.add('hidden');
    apiKeyModal.classList.remove('flex');
  });

  // cargar llaves al entrar a la página
  loadApiKeys();

  // export globals usados en onclick / inline
  window.saveAllConfigs       = saveAllConfigs;
  window.reinitializeService  = reinitializeService;
</script>
</body>
</html>
