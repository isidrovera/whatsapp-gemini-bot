<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente + Tailwind -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui'] },
          colors: {
            primary: { DEFAULT: '#1e3a8a', 600: '#1e3a8a', 700:'#1e40af' },
          },
          boxShadow: {
            soft: '0 10px 25px -10px rgba(0,0,0,.15)',
          }
        }
      },
      darkMode: 'media'
    }
  </script>

  <!-- Motion / Icons -->
  <script src="https://unpkg.com/@motionone/dom/dist/motion.min.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    .sidebar-link-active {
      background-color: rgba(255,255,255,.12);
      color:#fff !important;
      font-weight:600;
    }
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1000;
      background: rgba(0,0,0,0.6);
      backdrop-filter: blur(4px);
      overflow-y: auto;
      padding: 1rem;
    }
    .modal.show {
      display: flex;
      align-items: flex-start;
      justify-content: center;
    }
  </style>
</head>
<body class="h-full bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-3 focus:py-2 focus:rounded-lg shadow">
    Saltar al contenido
  </a>

  <%
    const list = Array.isArray(contacts) ? contacts : [];
    function isActive(p){
      return (page === p) ? 'sidebar-link-active' : '';
    }

    function stateBadgeClasses(state){
      if(state === 'REGISTERED') return 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300';
      if(state === 'WAITING_DNI' || state === 'WAITING_RUC') return 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300';
      return 'bg-sky-100 text-sky-700 dark:bg-sky-900/30 dark:text-sky-300';
    }

    function stateLabel(state){
      if(state === 'REGISTERED') return '✓ Registrado';
      if(state === 'WAITING_DNI') return '⏳ Esperando DNI';
      if(state === 'WAITING_RUC') return '⏳ Esperando RUC';
      return '🆕 Nuevo';
    }
  %>

  <div class="min-h-screen w-full flex relative">

    <!-- Overlay móvil sidebar -->
    <div id="mobile-sidebar-overlay"
         class="fixed inset-0 bg-black/40 z-40 opacity-0 pointer-events-none transition-opacity md:hidden">
    </div>

    <!-- Sidebar -->
    <aside id="sidebar"
           class="w-[280px] flex flex-col bg-gradient-to-b from-primary to-primary-700 text-white shadow-soft
                  fixed inset-y-0 left-0 z-50 -translate-x-full transition-transform md:translate-x-0 md:relative md:flex"
           role="navigation"
           aria-label="Menú principal">

      <div class="px-5 py-6 border-b border-white/10 bg-white/5 backdrop-blur flex items-center justify-between">
        <h2 class="text-xl font-semibold flex items-center gap-2">
          <i data-lucide="bot" class="w-5 h-5"></i> Bot Admin
        </h2>

        <button id="close-sidebar-btn"
                class="md:hidden inline-flex items-center justify-center rounded-lg text-white/70 hover:text-white hover:bg-white/10 p-2"
                aria-label="Cerrar menú">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <nav class="py-4 flex-1 overflow-y-auto">
        <ul class="px-2 space-y-1 text-[15px] leading-5">
          <li>
            <a href="/"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('dashboard') %>">
              <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
              <span>Dashboard</span>
            </a>
          </li>

          <li>
            <a href="/contacts"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('contacts') %>">
              <i data-lucide="users" class="w-5 h-5"></i>
              <span>Contactos</span>
            </a>
          </li>

          <li>
            <a href="/conversations"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('conversations') %>">
              <i data-lucide="message-circle" class="w-5 h-5"></i>
              <span>Conversaciones</span>
            </a>
          </li>

          <li>
            <a href="/blocked"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('blocked') %>">
              <i data-lucide="ban" class="w-5 h-5"></i>
              <span>Bloqueados</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/calendar"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('calendar') %>">
              <i data-lucide="calendar" class="w-5 h-5"></i>
              <span>Calendario</span>
            </a>
          </li>

          <li>
            <a href="/working-hours"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('working-hours') %>">
              <i data-lucide="clock" class="w-5 h-5"></i>
              <span>Horarios</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/departments"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('departments') %>">
              <i data-lucide="building-2" class="w-5 h-5"></i>
              <span>Departamentos</span>
            </a>
          </li>

          <li>
            <a href="/products"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('products') %>">
              <i data-lucide="package" class="w-5 h-5"></i>
              <span>Productos</span>
            </a>
          </li>

          <li>
            <a href="/auto-responses"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('auto-responses') %>">
              <i data-lucide="robot" class="w-5 h-5"></i>
              <span>Auto-respuestas</span>
            </a>
          </li>

          <li>
            <a href="/tags"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('tags') %>">
              <i data-lucide="tags" class="w-5 h-5"></i>
              <span>Tags</span>
            </a>
          </li>

          <li>
            <a href="/templates"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('templates') %>">
              <i data-lucide="file-text" class="w-5 h-5"></i>
              <span>Plantillas</span>
            </a>
          </li>

          <li>
            <a href="/metrics"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('metrics') %>">
              <i data-lucide="line-chart" class="w-5 h-5"></i>
              <span>Métricas</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/admin-users"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('admin-users') %>">
              <i data-lucide="shield" class="w-5 h-5"></i>
              <span>Usuarios Admin</span>
            </a>
          </li>

          <li>
            <a href="/settings"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('settings') %>">
              <i data-lucide="settings" class="w-5 h-5"></i>
              <span>Configuración</span>
            </a>
          </li>
        </ul>
      </nav>

      <div class="mt-auto p-4 bg-white/5 border-t border-white/10">
        <div class="rounded-xl bg-white/10 p-3">
          <div class="text-[11px] uppercase tracking-wide opacity-80">Sesión activa</div>
          <div class="font-semibold text-sm mt-1 flex items-center gap-2">
            <i data-lucide="user" class="w-4 h-4"></i>
            <span><%= user || 'Admin' %></span>
          </div>
        </div>

        <form method="POST" action="/auth/logout" class="mt-3">
          <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>
          <button type="submit"
            class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-white/20 bg-red-500/20 hover:bg-red-500/30 text-white py-2.5 text-sm font-medium transition">
            <i data-lucide="log-out" class="w-4 h-4"></i> Cerrar sesión
          </button>
        </form>
      </div>
    </aside>

    <!-- Main Content -->
    <main id="main-content" class="flex-1 p-4 md:p-8 md:ml-0 ml-0 w-full md:w-auto">
      <!-- Header -->
      <header class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft px-6 py-5 mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-start justify-between w-full md:w-auto">
          <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white flex items-center gap-3">
            <i data-lucide="users" class="w-7 h-7 text-primary"></i>
            <span>Contactos</span>
          </h1>

          <!-- botón abrir sidebar móvil -->
          <button id="open-sidebar-btn"
                  class="md:hidden inline-flex items-center justify-center rounded-lg text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 p-2 shadow-soft"
                  aria-label="Abrir menú">
            <i data-lucide="menu" class="w-6 h-6"></i>
          </button>
        </div>

        <!-- Acciones globales -->
        <div class="flex flex-wrap gap-2">
          <!-- Nuevo contacto -->
          <button
            class="inline-flex items-center justify-center rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-3 py-2 shadow-soft transition"
            onclick="openCreateContact()"
            title="Crear contacto manual"
          >
            <i data-lucide="plus" class="w-4 h-4 mr-1"></i>
            Nuevo
          </button>

          <!-- Exportar -->
          <button
            class="inline-flex items-center justify-center rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold px-3 py-2 shadow-soft transition"
            onclick="exportExcel()"
            title="Exportar contactos y empresas"
          >
            <i data-lucide="download" class="w-4 h-4 mr-1"></i>
            Exportar
          </button>

          <!-- Importar -->
          <label
            class="inline-flex items-center justify-center rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold px-3 py-2 shadow-soft transition cursor-pointer"
            title="Importar contactos desde Excel"
          >
            <i data-lucide="upload" class="w-4 h-4 mr-1"></i>
            Importar
            <input
              id="importFileInput"
              type="file"
              accept=".xlsx,.xls,.json"
              class="hidden"
              onchange="importExcelFile(this)"
            />
          </label>
        </div>
      </header>

      <!-- Content Card -->
      <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-soft border border-slate-100/70 dark:border-white/5">
        <!-- Search -->
        <div class="px-6 pt-6 pb-3">
          <label for="searchInput" class="sr-only">Buscar contacto</label>
          <div class="relative">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
            <input
              id="searchInput"
              type="text"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 pl-10 pr-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
              placeholder="🔍 Buscar por teléfono, nombre o empresa..."
              onkeyup="filterTable()"
            />
          </div>
        </div>

        <!-- Tabla -->
        <div class="px-6 pb-6">
          <% if (list.length > 0) { %>
            <div class="overflow-x-auto rounded-xl border border-slate-100 dark:border-white/5 mt-4">
              <table id="contactsTable" class="min-w-full text-sm text-left">
                <thead class="bg-slate-50/60 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 uppercase text-[11px] tracking-wide font-medium border-b border-slate-100 dark:border-white/5">
                  <tr>
                    <th class="px-4 py-3 font-semibold">Teléfono</th>
                    <th class="px-4 py-3 font-semibold">Nombre</th>
                    <th class="px-4 py-3 font-semibold">DNI</th>
                    <th class="px-4 py-3 font-semibold">Empresa</th>
                    <th class="px-4 py-3 font-semibold">Estado</th>
                    <th class="px-4 py-3 font-semibold text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-white/5 bg-white dark:bg-slate-900">
                  <% list.forEach(contact => { %>
                    <tr class="hover:bg-slate-50/50 dark:hover:bg-white/5 transition" data-phone="<%= contact.phoneNumber %>">
                      <td class="px-4 py-3 font-semibold text-slate-900 dark:text-white align-top whitespace-nowrap">
                        <%= contact.phoneNumber %>
                      </td>
                      <td class="px-4 py-3 text-slate-700 dark:text-slate-200 align-top">
                        <%= contact.name || '-' %>
                      </td>
                      <td class="px-4 py-3 text-slate-700 dark:text-slate-200 align-top">
                        <%= contact.dni || '-' %>
                      </td>
                      <td class="px-4 py-3 text-slate-700 dark:text-slate-200 align-top">
                        <%= contact.companyName || '-' %>
                      </td>
                      <td class="px-4 py-3 text-slate-700 dark:text-slate-200 align-top">
                        <span class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-[11px] font-semibold <%= stateBadgeClasses(contact.state) %>">
                          <%= stateLabel(contact.state) %>
                        </span>

                        <% if (contact.humanTakeoverAt) { %>
                          <span class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-[11px] font-semibold bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 ml-1">
                            🙋 Humano
                          </span>
                        <% } %>

                        <% if (contact.isBlocked) { %>
                          <span class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-[11px] font-semibold bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300 ml-1">
                            🚫 Bloqueado
                          </span>
                        <% } %>
                      </td>

                      <td class="px-4 py-3 text-right align-top">
                        <div class="flex flex-wrap gap-2 justify-end">

                          <!-- Ver -->
                          <button
                            class="inline-flex items-center justify-center rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-2.5 py-1.5 shadow-soft transition"
                            onclick="viewContact('<%= contact.phoneNumber %>')"
                          >
                            Ver
                          </button>

                          <!-- Editar -->
                          <button
                            class="inline-flex items-center justify-center rounded-lg bg-slate-600 hover:bg-slate-700 text-white text-xs font-semibold px-2.5 py-1.5 shadow-soft transition"
                            onclick="openEditContact('<%= contact.id %>')"
                          >
                            Editar
                          </button>

                          <!-- Empresas -->
                          <button
                            class="inline-flex items-center justify-center rounded-lg bg-purple-600 hover:bg-purple-700 text-white text-xs font-semibold px-2.5 py-1.5 shadow-soft transition"
                            onclick="openCompanies('<%= contact.id %>')"
                          >
                            Empresas
                          </button>

                          <!-- takeover / release -->
                          <% if (!contact.humanTakeoverAt) { %>
                            <button
                              class="inline-flex items-center justify-center rounded-lg bg-amber-500 hover:bg-amber-600 text-white text-xs font-semibold px-2.5 py-1.5 shadow-soft transition"
                              onclick="takeover('<%= contact.phoneNumber %>')"
                            >
                              Tomar
                            </button>
                          <% } else { %>
                            <button
                              class="inline-flex items-center justify-center rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-2.5 py-1.5 shadow-soft transition"
                              onclick="release('<%= contact.phoneNumber %>')"
                            >
                              Liberar
                            </button>
                          <% } %>

                          <!-- bloquear / desbloquear -->
                          <% if (!contact.isBlocked) { %>
                            <button
                              class="inline-flex items-center justify-center rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold px-2.5 py-1.5 shadow-soft transition"
                              onclick="blockContact('<%= contact.phoneNumber %>')"
                            >
                              Bloquear
                            </button>
                          <% } else { %>
                            <button
                              class="inline-flex items-center justify-center rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-2.5 py-1.5 shadow-soft transition"
                              onclick="unblockContact('<%= contact.phoneNumber %>')"
                            >
                              Desbloquear
                            </button>
                          <% } %>

                          <!-- Eliminar -->
                          <button
                            class="inline-flex items-center justify-center rounded-lg bg-red-600 hover:bg-red-700 text-white text-xs font-semibold px-2.5 py-1.5 shadow-soft transition"
                            onclick="deleteContact('<%= contact.id %>')"
                          >
                            Eliminar
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="text-center text-slate-500 dark:text-slate-400 py-16">
              <div class="text-4xl mb-3">😌</div>
              <p class="text-base font-semibold text-slate-700 dark:text-white mb-1">
                Sin contactos
              </p>
              <p class="text-sm text-slate-500 dark:text-slate-400">
                Los contactos aparecerán aquí cuando hablen con el bot
              </p>
            </div>
          <% } %>
        </div>
      </section>
    </main>
  </div>

  <!-- Modal Ver Contacto -->
  <div id="viewModal" class="modal">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft w-full max-w-lg border border-slate-200 dark:border-white/10 max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-slate-200 dark:border-white/10 flex items-center justify-between sticky top-0 bg-white dark:bg-slate-900 z-10">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
          <i data-lucide="info" class="w-5 h-5 text-primary"></i>
          <span>Información del Contacto</span>
        </h2>
        <button
          class="text-slate-400 hover:text-slate-600 dark:text-slate-400 dark:hover:text-white text-xl leading-none"
          onclick="hideModal('viewModal')"
        >
          &times;
        </button>
      </div>

      <div class="p-6 text-sm leading-6" id="contactDetails">
        <!-- dinámico -->
      </div>
    </div>
  </div>

  <!-- Modal Editar Contacto / Crear Contacto -->
  <div id="editModal" class="modal">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft w-full max-w-lg border border-slate-200 dark:border-white/10 max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-slate-200 dark:border-white/10 flex items-center justify-between sticky top-0 bg-white dark:bg-slate-900 z-10">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2" id="editModalTitle">
          <i data-lucide="edit" class="w-5 h-5 text-primary"></i>
          <span>Editar contacto</span>
        </h2>
        <button
          class="text-slate-400 hover:text-slate-600 dark:text-slate-400 dark:hover:text-white text-xl leading-none"
          onclick="hideModal('editModal')"
        >
          &times;
        </button>
      </div>

      <div class="p-6 text-sm leading-6">
        <form id="editContactForm" onsubmit="return submitEditContact()">
          <input type="hidden" id="editContactId" />

          <div class="mb-4">
            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1">Teléfono</label>
            <input id="editPhoneNumber" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm px-3 py-2.5 outline-none focus:border-indigo-500 transition-colors" disabled />
          </div>

          <div class="mb-4">
            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1">Nombre</label>
            <input id="editName" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm px-3 py-2.5 outline-none focus:border-indigo-500 transition-colors" placeholder="Nombre completo" />
          </div>

          <div class="mb-4">
            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1">DNI</label>
            <input id="editDni" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm px-3 py-2.5 outline-none focus:border-indigo-500 transition-colors" placeholder="8 dígitos" maxlength="8" />
          </div>

          <div class="mb-4">
            <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1">Estado</label>
            <select id="editState" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm px-3 py-2.5 outline-none focus:border-indigo-500 transition-colors cursor-pointer">
              <option value="NEW">Nuevo</option>
              <option value="WAITING_DNI">Esperando DNI</option>
