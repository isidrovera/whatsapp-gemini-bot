<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente + Tailwind -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui'] },
          colors: {
            primary: { DEFAULT: '#1e3a8a', 600: '#1e3a8a', 700:'#1e40af' },
          },
          boxShadow: {
            soft: '0 10px 25px -10px rgba(0,0,0,.15)',
          }
        }
      },
      darkMode: 'media'
    }
  </script>

  <!-- Motion / Icons -->
  <script src="https://unpkg.com/@motionone/dom/dist/motion.min.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    .sidebar-link-active {
      background-color: rgba(255,255,255,.12);
      color:#fff !important;
      font-weight:600;
    }

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1000;
      background: rgba(0,0,0,0.6);
      backdrop-filter: blur(4px);
      overflow-y: auto;
      padding: 1rem;
    }
    .modal.show {
      display: flex;
      align-items: flex-start;
      justify-content: center;
    }
    
    .variable-tag {
      display: inline-block;
      background-color: #e0e7ff;
      color: #3730a3;
      padding: 0.125rem 0.5rem;
      border-radius: 0.375rem;
      font-size: 0.75rem;
      font-family: 'Courier New', monospace;
      cursor: pointer;
      transition: all 0.2s;
    }
    
    .variable-tag:hover {
      background-color: #c7d2fe;
      transform: scale(1.05);
    }
    
    .dark .variable-tag {
      background-color: #312e81;
      color: #c7d2fe;
    }
    
    .dark .variable-tag:hover {
      background-color: #3730a3;
    }
  </style>
</head>
<body class="h-full bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-3 focus:py-2 focus:rounded-lg shadow">
    Saltar al contenido
  </a>

  <%
    const list = Array.isArray(responses) ? responses : [];
    function isActive(p){
      return (page === p) ? 'sidebar-link-active' : '';
    }
  %>

  <div class="min-h-screen w-full flex relative">

    <!-- Overlay móvil -->
    <div id="mobile-sidebar-overlay"
         class="fixed inset-0 bg-black/40 z-40 opacity-0 pointer-events-none transition-opacity md:hidden">
    </div>

    <!-- Sidebar -->
    <aside id="sidebar"
           class="w-[280px] flex flex-col bg-gradient-to-b from-primary to-primary-700 text-white shadow-soft
                  fixed inset-y-0 left-0 z-50 -translate-x-full transition-transform md:translate-x-0 md:relative md:flex"
           role="navigation"
           aria-label="Menú principal">

      <div class="px-5 py-6 border-b border-white/10 bg-white/5 backdrop-blur flex items-center justify-between">
        <h2 class="text-xl font-semibold flex items-center gap-2">
          <i data-lucide="bot" class="w-5 h-5"></i> Bot Admin
        </h2>

        <button id="close-sidebar-btn"
                class="md:hidden inline-flex items-center justify-center rounded-lg text-white/70 hover:text-white hover:bg-white/10 p-2"
                aria-label="Cerrar menú">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <nav class="py-4 flex-1 overflow-y-auto">
        <ul class="px-2 space-y-1 text-[15px] leading-5">
          <li>
            <a href="/"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('dashboard') %>">
              <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
              <span>Dashboard</span>
            </a>
          </li>

          <li>
            <a href="/contacts"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('contacts') %>">
              <i data-lucide="users" class="w-5 h-5"></i>
              <span>Contactos</span>
            </a>
          </li>

          <li>
            <a href="/conversations"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('conversations') %>">
              <i data-lucide="message-circle" class="w-5 h-5"></i>
              <span>Conversaciones</span>
            </a>
          </li>

          <li>
            <a href="/blocked"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('blocked') %>">
              <i data-lucide="ban" class="w-5 h-5"></i>
              <span>Bloqueados</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/calendar"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('calendar') %>">
              <i data-lucide="calendar" class="w-5 h-5"></i>
              <span>Calendario</span>
            </a>
          </li>

          <li>
            <a href="/working-hours"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('working-hours') %>">
              <i data-lucide="clock" class="w-5 h-5"></i>
              <span>Horarios</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/departments"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('departments') %>">
              <i data-lucide="building-2" class="w-5 h-5"></i>
              <span>Departamentos</span>
            </a>
          </li>

          <li>
            <a href="/products"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('products') %>">
              <i data-lucide="package" class="w-5 h-5"></i>
              <span>Productos</span>
            </a>
          </li>

          <li>
            <a href="/auto-responses"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('auto-responses') %>">
              <i data-lucide="robot" class="w-5 h-5"></i>
              <span>Auto-respuestas</span>
            </a>
          </li>

          <li>
            <a href="/tags"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('tags') %>">
              <i data-lucide="tags" class="w-5 h-5"></i>
              <span>Tags</span>
            </a>
          </li>

          <li>
            <a href="/templates"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('templates') %>">
              <i data-lucide="file-text" class="w-5 h-5"></i>
              <span>Plantillas</span>
            </a>
          </li>

          <li>
            <a href="/metrics"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('metrics') %>">
              <i data-lucide="line-chart" class="w-5 h-5"></i>
              <span>Métricas</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/admin-users"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('admin-users') %>">
              <i data-lucide="shield" class="w-5 h-5"></i>
              <span>Usuarios Admin</span>
            </a>
          </li>

          <li>
            <a href="/settings"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('settings') %>">
              <i data-lucide="settings" class="w-5 h-5"></i>
              <span>Configuración</span>
            </a>
          </li>
        </ul>
      </nav>

      <div class="mt-auto p-4 bg-white/5 border-t border-white/10">
        <div class="rounded-xl bg-white/10 p-3">
          <div class="text-[11px] uppercase tracking-wide opacity-80">Sesión activa</div>
          <div class="font-semibold text-sm mt-1 flex items-center gap-2">
            <i data-lucide="user" class="w-4 h-4"></i>
            <span><%= user || 'Admin' %></span>
          </div>
        </div>

        <form method="POST" action="/auth/logout" class="mt-3">
          <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>
          <button type="submit"
            class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-white/20 bg-red-500/20 hover:bg-red-500/30 text-white py-2.5 text-sm font-medium transition">
            <i data-lucide="log-out" class="w-4 h-4"></i> Cerrar sesión
          </button>
        </form>
      </div>
    </aside>

    <!-- Main -->
    <main id="main-content" class="flex-1 p-4 md:p-8 md:ml-0 ml-0 w-full md:w-auto">
      <!-- Header -->
      <header class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft px-6 py-5 mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-start justify-between w-full md:w-auto">
          <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white flex items-center gap-3">
            <i data-lucide="message-square-text" class="w-7 h-7 text-primary"></i>
            <span>Respuestas Automáticas (FAQs)</span>
          </h1>

          <button id="open-sidebar-btn"
                  class="md:hidden inline-flex items-center justify-center rounded-lg text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 p-2 shadow-soft"
                  aria-label="Abrir menú">
            <i data-lucide="menu" class="w-6 h-6"></i>
          </button>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:justify-end w-full md:w-auto">
          <button class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 text-sm font-semibold shadow-soft transition"
                  onclick="openNewResponseModal()">
            <i data-lucide="plus-circle" class="w-4 h-4"></i>
            <span>Nueva Respuesta</span>
          </button>
        </div>
      </header>

      <!-- Info -->
      <div class="rounded-2xl bg-white dark:bg-slate-900 shadow-soft border border-slate-100/70 dark:border-white/5 mb-6">
        <div class="px-6 py-4 text-sm text-sky-800 bg-sky-50 rounded-t-2xl border-b border-slate-100/70 dark:bg-sky-900/30 dark:text-sky-200 dark:border-white/5 flex items-start gap-3">
          <div class="text-lg leading-none">💡</div>
          <div>
            <strong class="block font-semibold text-slate-900 dark:text-white">Tip:</strong>
            <span class="text-slate-700 dark:text-slate-300">
              Las respuestas automáticas se activan cuando el cliente escribe una palabra clave específica.
              Tienen prioridad sobre Gemini AI. <strong>Puedes usar variables</strong> para personalizar las respuestas.
            </span>
          </div>
        </div>
      </div>

      <!-- Lista de respuestas -->
      <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-soft border border-slate-100/70 dark:border-white/5">
        <div class="px-6 py-4 border-b border-slate-100/70 dark:border-white/5 flex items-center justify-between">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <i data-lucide="list" class="w-5 h-5 text-primary"></i>
            <span>Respuestas Configuradas</span>
          </h2>
        </div>

        <div id="responsesList" class="px-6 py-6">
          <% if (list.length > 0) { %>
            <div class="space-y-4">
              <% list.forEach(resp => { %>
                <div class="relative border border-slate-200 dark:border-white/10 rounded-xl p-5 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-indigo-400/60 transition">
                  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                    <div class="min-w-0 flex-1">
                      <div class="text-slate-900 dark:text-white font-semibold text-base flex flex-wrap items-center gap-2">
                        <span class="text-slate-900 dark:text-white break-all">🔑 "<%= resp.trigger %>"</span>

                        <% if (resp.isActive) { %>
                          <span class="inline-flex items-center rounded-md bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                            Activo
                          </span>
                        <% } else { %>
                          <span class="inline-flex items-center rounded-md bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                            Inactivo
                          </span>
                        <% } %>

                        <span class="inline-flex items-center rounded-md bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                          Prioridad: <%= resp.priority %>
                        </span>
                      </div>

                      <% if (resp.category) { %>
                        <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                          📂 <%= resp.category %>
                        </div>
                      <% } %>

                      <div class="mt-3 text-sm text-slate-700 dark:text-slate-300 leading-relaxed rounded-lg bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-white/10 px-3 py-3 whitespace-pre-line break-words">
                        <%= resp.response %>
                      </div>
                    </div>

                    <div class="flex-shrink-0 flex gap-2">
                      <button
                        class="inline-flex items-center justify-center rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                        onclick="editResponse('<%= resp.id %>')">
                        ✏️
                        <span class="hidden sm:inline">&nbsp;Editar</span>
                      </button>

                      <button
                        class="inline-flex items-center justify-center rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                        onclick="deleteResponse('<%= resp.id %>')">
                        🗑️
                        <span class="hidden sm:inline">&nbsp;Eliminar</span>
                      </button>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center text-slate-500 dark:text-slate-400 py-16">
              <div class="text-4xl mb-3">😶</div>
              <p class="text-base font-semibold text-slate-700 dark:text-white mb-1">
                No hay respuestas automáticas configuradas
              </p>
              <p class="text-sm text-slate-500 dark:text-slate-400">
                Crea una para comenzar.
              </p>
            </div>
          <% } %>
        </div>
      </section>
    </main>
  </div>

  <!-- Modal Crear/Editar Respuesta -->
  <div id="responseModal" class="modal">
    <div
      class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft w-full max-w-2xl border border-slate-200 dark:border-white/10
             max-h-[90vh] overflow-y-auto"
    >
      <!-- Header modal sticky -->
      <div class="px-6 py-4 border-b border-slate-200 dark:border-white/10 flex items-center justify-between sticky top-0 bg-white dark:bg-slate-900 z-10">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
          <span>🤖</span>
          <span>Nueva Respuesta Automática</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:text-slate-400 dark:hover:text-white text-xl leading-none"
                onclick="closeResponseModal()">
          &times;
        </button>
      </div>

      <!-- Body -->
      <div class="p-6">
        <form id="responseForm" class="space-y-5">
          <input type="hidden" id="responseId">

          <div>
            <label class="block mb-2 text-sm font-semibold text-slate-700 dark:text-slate-200">
              Palabra clave de activación *
            </label>
            <input
              type="text"
              id="responseTrigger"
              required
              placeholder="ej: horario, precio, ubicación"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
            >
            <small class="block text-xs text-slate-500 dark:text-slate-400 mt-1">
              La respuesta se activará cuando el cliente escriba esta palabra
            </small>
          </div>

          <div>
            <label class="block mb-2 text-sm font-semibold text-slate-700 dark:text-slate-200">
              Respuesta *
            </label>
            <textarea
              id="responseContent"
              rows="5"
              required
              placeholder="La respuesta que recibirá el cliente..."
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
            ></textarea>
            
            <!-- Variables disponibles -->
            <div class="mt-3 p-3 rounded-lg bg-indigo-50 dark:bg-indigo-950/30 border border-indigo-200 dark:border-indigo-800">
              <div class="text-xs font-semibold text-indigo-900 dark:text-indigo-200 mb-2 flex items-center gap-2">
                <i data-lucide="sparkles" class="w-3 h-3"></i>
                <span>Variables disponibles (haz clic para insertar):</span>
              </div>
              <div class="flex flex-wrap gap-1.5">
                <span class="variable-tag" onclick="insertVariable('{{nombre}}')">{{nombre}}</span>
                <span class="variable-tag" onclick="insertVariable('{{dni}}')">{{dni}}</span>
                <span class="variable-tag" onclick="insertVariable('{{empresa}}')">{{empresa}}</span>
                <span class="variable-tag" onclick="insertVariable('{{ruc}}')">{{ruc}}</span>
                <span class="variable-tag" onclick="insertVariable('{{telefono}}')">{{telefono}}</span>
                <span class="variable-tag" onclick="insertVariable('{{producto}}')">{{producto}}</span>
                <span class="variable-tag" onclick="insertVariable('{{categoria}}')">{{categoria}}</span>
                <span class="variable-tag" onclick="insertVariable('{{precio}}')">{{precio}}</span>
                <span class="variable-tag" onclick="insertVariable('{{fecha}}')">{{fecha}}</span>
                <span class="variable-tag" onclick="insertVariable('{{hora}}')">{{hora}}</span>
              </div>
              <small class="block text-xs text-indigo-700 dark:text-indigo-300 mt-2">
                💡 Las variables se reemplazarán automáticamente con los datos del contacto.
              </small>
            </div>
          </div>

          <div>
            <label class="block mb-2 text-sm font-semibold text-slate-700 dark:text-slate-200">
              Categoría
            </label>
            <input
              type="text"
              id="responseCategory"
              placeholder="ej: info, support, sales"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
            >
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block mb-2 text-sm font-semibold text-slate-700 dark:text-slate-200">
                Prioridad
              </label>
              <input
                type="number"
                id="responsePriority"
                value="1"
                min="1"
                class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
              >
              <small class="block text-xs text-slate-500 dark:text-slate-400 mt-1">
                Menor número = mayor prioridad
              </small>
            </div>

            <div>
              <label class="block mb-2 text-sm font-semibold text-slate-700 dark:text-slate-200">
                Estado
              </label>
              <select
                id="responseActive"
                class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
              >
                <option value="true">Activo</option>
                <option value="false">Inactivo</option>
              </select>
            </div>
          </div>

          <!-- Sección de prueba CON VARIABLES -->
          <div class="rounded-lg bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-white/10 p-4">
            <strong class="text-sm font-semibold text-slate-700 dark:text-slate-200 flex items-center gap-2">
              <span>🧪</span> <span>Probar respuesta con variables</span>
            </strong>

            <div class="mt-3 space-y-3">
              <input
                type="text"
                id="testMessage"
                placeholder="Escribe un mensaje de prueba..."
                class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
              >

              <button
                type="button"
                class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 text-xs font-semibold shadow-soft transition"
                onclick="testTriggerWithVariables()"
              >
                <i data-lucide="play-circle" class="w-4 h-4"></i>
                <span>Probar con Variables</span>
              </button>

              <div id="testResult" class="text-sm"></div>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex justify-end gap-2 pt-4">
            <button
              type="button"
              class="inline-flex items-center justify-center rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition"
              onclick="closeResponseModal()"
            >
              Cancelar
            </button>

            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition"
            >
              Guardar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    // Iconos lucide
    window.lucide && lucide.createIcons();

    // Insertar variable en textarea
    function insertVariable(variable) {
      const textarea = document.getElementById('responseContent');
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const text = textarea.value;
      
      textarea.value = text.substring(0, start) + variable + text.substring(end);
      textarea.focus();
      textarea.setSelectionRange(start + variable.length, start + variable.length);
      
      // Recrear iconos lucide después de insertar
      setTimeout(() => window.lucide && lucide.createIcons(), 10);
    }

    // Sidebar móvil
    (function(){
      const sidebar   = document.getElementById('sidebar');
      const overlay   = document.getElementById('mobile-sidebar-overlay');
      const openBtn   = document.getElementById('open-sidebar-btn');
      const closeBtn  = document.getElementById('close-sidebar-btn');

      function openSidebar(){
        sidebar.classList.remove('-translate-x-full');
        overlay.classList.remove('opacity-0','pointer-events-none');
      }
      function closeSidebar(){
        sidebar.classList.add('-translate-x-full');
        overlay.classList.add('opacity-0','pointer-events-none');
      }

      if (openBtn)  openBtn.addEventListener('click', openSidebar);
      if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
      if (overlay)  overlay.addEventListener('click', closeSidebar);
    })();

    function openNewResponseModal() {
      document.getElementById('responseId').value = '';
      document.getElementById('responseTrigger').value = '';
      document.getElementById('responseContent').value = '';
      document.getElementById('responseCategory').value = '';
      document.getElementById('responsePriority').value = '1';
      document.getElementById('responseActive').value = 'true';
      document.getElementById('testResult').innerHTML = '';
      document.getElementById('testMessage').value = '';
      document.getElementById('responseModal').classList.add('show');
    }

    function closeResponseModal() {
      document.getElementById('responseModal').classList.remove('show');
    }

    document.getElementById('responseForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const id = document.getElementById('responseId').value;
      const data = {
        trigger: document.getElementById('responseTrigger').value,
        response: document.getElementById('responseContent').value,
        category: document.getElementById('responseCategory').value,
        priority: parseInt(document.getElementById('responsePriority').value),
        isActive: document.getElementById('responseActive').value === 'true'
      };

      try {
        const url = id ? `/auto-responses/api/${id}` : '/auto-responses/api';
        const method = id ? 'PUT' : 'POST';

        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (res.ok) {
          location.reload();
        } else {
          alert('Error al guardar respuesta');
        }
      } catch (error) {
        alert('Error: ' + error.message);
      }
    });

    async function deleteResponse(id) {
      if (!confirm('¿Eliminar esta respuesta automática?')) return;

      try {
        const res = await fetch(`/auto-responses/api/${id}`, { method: 'DELETE' });
        if (res.ok) {
          location.reload();
        }
      } catch (error) {
        alert('Error: ' + error.message);
      }
    }

    async function editResponse(id) {
      try {
        const res = await fetch(`/auto-responses/api/${id}`);
        const resp = await res.json();

        document.getElementById('responseId').value = resp.id;
        document.getElementById('responseTrigger').value = resp.trigger;
        document.getElementById('responseContent').value = resp.response;
        document.getElementById('responseCategory').value = resp.category || '';
        document.getElementById('responsePriority').value = resp.priority;
        document.getElementById('responseActive').value = resp.isActive ? 'true' : 'false';
        document.getElementById('testResult').innerHTML = '';
        document.getElementById('testMessage').value = '';

        document.getElementById('responseModal').classList.add('show');
      } catch (error) {
        alert('Error: ' + error.message);
      }
    }

    async function testTriggerWithVariables() {
      const message = document.getElementById('testMessage').value;
      const resultDiv = document.getElementById('testResult');

      if (!message) {
        resultDiv.innerHTML = `
          <div class="rounded-md bg-rose-100 text-rose-700 px-3 py-2 text-xs font-medium dark:bg-rose-900/30 dark:text-rose-300">
            Por favor escribe un mensaje de prueba
          </div>`;
        return;
      }

      try {
        const res = await fetch('/auto-responses/api/test-with-variables', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message })
        });

        const result = await res.json();

        if (result && result.found && result.response) {
          resultDiv.innerHTML = `
            <div class="rounded-md bg-emerald-100 text-emerald-700 px-3 py-2 text-xs font-medium leading-relaxed dark:bg-emerald-900/30 dark:text-emerald-300">
              ✅ Se activaría esta respuesta:<br><br>
              <div class="font-mono text-xs whitespace-pre-wrap bg-white/50 dark:bg-black/20 p-2 rounded mt-2">
${result.response}</div>
              <br>
              <small class="text-[10px] opacity-75">Datos de prueba: ${result.context.contact.name}, ${result.context.contact.companyName}</small>
            </div>
          `;
        } else {
          resultDiv.innerHTML = `
            <div class="rounded-md bg-rose-100 text-rose-700 px-3 py-2 text-xs font-medium dark:bg-rose-900/30 dark:text-rose-300">
              ❌ No se activaría ninguna respuesta automática
            </div>
          `;
        }
      } catch (error) {
        resultDiv.innerHTML = `
          <div class="rounded-md bg-rose-100 text-rose-700 px-3 py-2 text-xs font-medium dark:bg-rose-900/30 dark:text-rose-300">
            Error al probar: ${error.message}
          </div>
        `;
      }
    }
  </script>
</body>
</html>
