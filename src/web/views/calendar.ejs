<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente + Tailwind -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui'] },
          colors: {
            primary: { DEFAULT: '#1e3a8a', 600: '#1e3a8a', 700:'#1e40af' },
          },
          boxShadow: {
            soft: '0 10px 25px -10px rgba(0,0,0,.15)',
          }
        }
      },
      darkMode: 'media'
    }
  </script>

  <!-- Motion / Icons -->
  <script src="https://unpkg.com/@motionone/dom/dist/motion.min.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    .sidebar-link-active {
      background-color: rgba(255,255,255,.12);
      color:#fff !important;
      font-weight:600;
    }

    /* Overlay modal */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1000;
      background: rgba(0,0,0,0.6);
      backdrop-filter: blur(4px);
      overflow-y: auto;
      padding: 1rem;
    }
    .modal.show {
      display: flex;
      align-items: flex-start;
      justify-content: center;
    }
  </style>
</head>
<body class="h-full bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-3 focus:py-2 focus:rounded-lg shadow">
    Saltar al contenido
  </a>

  <%
    const evts = Array.isArray(events) ? events : [];
    function isActive(p){
      return (page === p) ? 'sidebar-link-active' : '';
    }
  %>

  <div class="min-h-screen w-full flex relative">

    <!-- Overlay móvil -->
    <div id="mobile-sidebar-overlay"
         class="fixed inset-0 bg-black/40 z-40 opacity-0 pointer-events-none transition-opacity md:hidden">
    </div>

    <!-- Sidebar -->
    <aside id="sidebar"
           class="w-[280px] flex flex-col bg-gradient-to-b from-primary to-primary-700 text-white shadow-soft
                  fixed inset-y-0 left-0 z-50 -translate-x-full transition-transform md:translate-x-0 md:relative md:flex"
           role="navigation"
           aria-label="Menú principal">

      <div class="px-5 py-6 border-b border-white/10 bg-white/5 backdrop-blur flex items-center justify-between">
        <h2 class="text-xl font-semibold flex items-center gap-2">
          <i data-lucide="bot" class="w-5 h-5"></i> Bot Admin
        </h2>

        <!-- Botón cerrar sidebar móvil -->
        <button id="close-sidebar-btn"
                class="md:hidden inline-flex items-center justify-center rounded-lg text-white/70 hover:text-white hover:bg-white/10 p-2"
                aria-label="Cerrar menú">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <nav class="py-4 flex-1 overflow-y-auto">
        <ul class="px-2 space-y-1 text-[15px] leading-5">
          <li>
            <a href="/"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('dashboard') %>">
              <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
              <span>Dashboard</span>
            </a>
          </li>

          <li>
            <a href="/contacts"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('contacts') %>">
              <i data-lucide="users" class="w-5 h-5"></i>
              <span>Contactos</span>
            </a>
          </li>

          <li>
            <a href="/conversations"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('conversations') %>">
              <i data-lucide="message-circle" class="w-5 h-5"></i>
              <span>Conversaciones</span>
            </a>
          </li>

          <li>
            <a href="/blocked"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('blocked') %>">
              <i data-lucide="ban" class="w-5 h-5"></i>
              <span>Bloqueados</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/calendar"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('calendar') %>">
              <i data-lucide="calendar" class="w-5 h-5"></i>
              <span>Calendario</span>
            </a>
          </li>

          <li>
            <a href="/working-hours"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('working-hours') %>">
              <i data-lucide="clock" class="w-5 h-5"></i>
              <span>Horarios</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/departments"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('departments') %>">
              <i data-lucide="building-2" class="w-5 h-5"></i>
              <span>Departamentos</span>
            </a>
          </li>

          <li>
            <a href="/products"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('products') %>">
              <i data-lucide="package" class="w-5 h-5"></i>
              <span>Productos</span>
            </a>
          </li>

          <li>
            <a href="/auto-responses"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('auto-responses') %>">
              <i data-lucide="robot" class="w-5 h-5"></i>
              <span>Auto-respuestas</span>
            </a>
          </li>

          <li>
            <a href="/tags"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('tags') %>">
              <i data-lucide="tags" class="w-5 h-5"></i>
              <span>Tags</span>
            </a>
          </li>

          <li>
            <a href="/templates"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('templates') %>">
              <i data-lucide="file-text" class="w-5 h-5"></i>
              <span>Plantillas</span>
            </a>
          </li>

          <li>
            <a href="/metrics"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('metrics') %>">
              <i data-lucide="line-chart" class="w-5 h-5"></i>
              <span>Métricas</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/admin-users"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('admin-users') %>">
              <i data-lucide="shield" class="w-5 h-5"></i>
              <span>Usuarios Admin</span>
            </a>
          </li>

          <li>
            <a href="/settings"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('settings') %>">
              <i data-lucide="settings" class="w-5 h-5"></i>
              <span>Configuración</span>
            </a>
          </li>
        </ul>
      </nav>

      <div class="mt-auto p-4 bg-white/5 border-t border-white/10">
        <div class="rounded-xl bg-white/10 p-3">
          <div class="text-[11px] uppercase tracking-wide opacity-80">Sesión activa</div>
          <div class="font-semibold text-sm mt-1 flex items-center gap-2">
            <i data-lucide="user" class="w-4 h-4"></i>
            <span><%= user || 'Admin' %></span>
          </div>
        </div>

        <form method="POST" action="/auth/logout" class="mt-3">
          <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>
          <button type="submit"
            class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-white/20 bg-red-500/20 hover:bg-red-500/30 text-white py-2.5 text-sm font-medium transition">
            <i data-lucide="log-out" class="w-4 h-4"></i> Cerrar sesión
          </button>
        </form>
      </div>
    </aside>

    <!-- Main Content -->
    <main id="main-content" class="flex-1 p-4 md:p-8 md:ml-0 ml-0 w-full md:w-auto">
      <!-- Header -->
      <header class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft px-6 py-5 mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-start justify-between w-full md:w-auto">
          <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white flex items-center gap-3">
            <i data-lucide="calendar" class="w-7 h-7 text-primary"></i>
            <span>Calendario</span>
          </h1>

          <!-- Sidebar móvil -->
          <button id="open-sidebar-btn"
                  class="md:hidden inline-flex items-center justify-center rounded-lg text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 p-2 shadow-soft"
                  aria-label="Abrir menú">
            <i data-lucide="menu" class="w-6 h-6"></i>
          </button>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:justify-end w-full md:w-auto">
          <button
            class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 text-sm font-semibold shadow-soft transition"
            onclick="showModal('addModal')"
          >
            <i data-lucide="plus-circle" class="w-4 h-4"></i>
            <span>Agregar Evento</span>
          </button>
        </div>
      </header>

      <!-- Contenido -->
      <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-soft border border-slate-100/70 dark:border-white/5">
        <div class="px-6 py-4 border-b border-slate-100/70 dark:border-white/5 flex items-center justify-between">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <i data-lucide="star" class="w-5 h-5 text-primary"></i>
            <span>Feriados y Eventos Especiales</span>
          </h2>
        </div>

        <div class="px-6 py-6">
          <% if (evts.length > 0) { %>
            <div class="grid gap-4 lg:grid-cols-2">
              <% evts.forEach(event => {

                const t = event.type;
                const colorBar =
                  t === 'holiday'        ? 'bg-rose-500'
                : t === 'special_event' ? 'bg-amber-500'
                                        : 'bg-slate-500';

                const bgSoft =
                  t === 'holiday'
                    ? 'bg-rose-50 dark:bg-rose-900/10'
                    : t === 'special_event'
                    ? 'bg-amber-50 dark:bg-amber-900/10'
                    : 'bg-slate-50 dark:bg-slate-800/30';

                const chipBg =
                  t === 'holiday'
                    ? 'bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300'
                    : t === 'special_event'
                    ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300'
                    : 'bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-200';

                const chipText =
                  t === 'holiday'
                    ? '🎉 Feriado'
                    : t === 'special_event'
                    ? '⭐ Evento Especial'
                    : '🔒 Cierre';

              %>
              <div class="flex rounded-xl border-2 border-slate-200 dark:border-white/10 shadow-sm hover:shadow-md hover:border-indigo-400/60 transition <%= bgSoft %>">
                <!-- Columna color -->
                <div class="w-1 rounded-l-xl <%= colorBar %>"></div>

                <!-- Contenido -->
                <div class="flex-1 p-5">
                  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                    <div class="min-w-0 flex-1">
                      <div class="text-slate-900 dark:text-white font-semibold text-base flex flex-col">
                        <span class="truncate break-words"><%= event.title %></span>
                        <span class="text-xs text-slate-500 dark:text-slate-400 mt-1 flex items-center gap-2">
                          <span class="font-medium">📅</span>
                          <span class="date-label" data-ymd="<%= event.dateYMD %>"></span>
                        </span>
                      </div>

                      <div class="mt-2 flex flex-wrap gap-2 text-[11px] leading-none font-semibold">
                        <span class="inline-flex items-center rounded-md px-2 py-1 <%= chipBg %>">
                          <%= chipText %>
                        </span>

                        <% if (event.isRecurring) { %>
                          <span class="inline-flex items-center rounded-md bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300 px-2 py-1">
                            🔄 Anual
                          </span>
                        <% } %>
                      </div>

                      <% if (event.description) { %>
                        <div class="mt-3 text-sm text-slate-700 dark:text-slate-300 leading-relaxed whitespace-pre-line break-words">
                          <%= event.description %>
                        </div>
                      <% } %>
                    </div>

                    <div class="flex-shrink-0 flex gap-2">
                      <button
                        class="inline-flex items-center justify-center rounded-lg bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                        onclick="editEvent('<%= event.id %>')"
                      >
                        ✏️
                        <span class="hidden sm:inline">&nbsp;Editar</span>
                      </button>

                      <button
                        class="inline-flex items-center justify-center rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                        onclick="deleteEvent('<%= event.id %>')"
                      >
                        🗑️
                        <span class="hidden sm:inline">&nbsp;Eliminar</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center text-slate-500 dark:text-slate-400 py-16">
              <div class="text-4xl mb-3">😌</div>
              <p class="text-base font-semibold text-slate-700 dark:text-white mb-1">
                Sin eventos
              </p>
              <p class="text-sm text-slate-500 dark:text-slate-400">
                Agrega feriados y eventos especiales
              </p>
            </div>
          <% } %>
        </div>
      </section>
    </main>
  </div>

  <!-- Modal Agregar Evento -->
  <div id="addModal" class="modal">
    <div
      class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft w-full max-w-md border border-slate-200 dark:border-white/10 max-h-[90vh] overflow-y-auto"
    >
      <div class="px-6 py-4 border-b border-slate-200 dark:border-white/10 flex items-center justify-between sticky top-0 bg-white dark:bg-slate-900 z-10">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
          <span>➕</span>
          <span>Agregar Evento</span>
        </h2>
        <button
          class="text-slate-400 hover:text-slate-600 dark:text-slate-400 dark:hover:text-white text-xl leading-none"
          onclick="hideModal('addModal')"
        >
          &times;
        </button>
      </div>

      <div class="p-6">
        <form onsubmit="addEvent(event)" class="space-y-5">
          <div>
            <label class="block mb-2 text-sm font-semibold text-slate-700 dark:text-slate-200" for="title">
              Título *
            </label>
            <input
              type="text"
              id="title"
              required
              placeholder="Ej: Día de la Independencia"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
            />
          </div>

          <div>
            <label class="block mb-2 text-sm font-semibold text-slate-700 dark:text-slate-200" for="date">
              Fecha *
            </label>
            <input
              type="date"
              id="date"
              required
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
            />
          </div>

          <div>
            <label class="block mb-2 text-sm font-semibold text-slate-700 dark:text-slate-200" for="type">
              Tipo *
            </label>
            <select
              id="type"
              required
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
            >
              <option value="">Seleccionar...</option>
              <option value="holiday">🎉 Feriado</option>
              <option value="special_event">⭐ Evento Especial</option>
              <option value="closure">🔒 Cierre</option>
            </select>
          </div>

          <div>
            <label class="block mb-2 text-sm font-semibold text-slate-700 dark:text-slate-200" for="description">
              Descripción (opcional)
            </label>
            <textarea
              id="description"
              placeholder="Descripción del evento..."
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0 min-h-[80px] resize-y"
            ></textarea>
          </div>

          <div class="flex items-start gap-2">
            <input
              type="checkbox"
              id="isRecurring"
              class="mt-[2px] w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-0"
            />
            <label for="isRecurring" class="text-sm text-slate-700 dark:text-slate-200 select-none">
              Evento anual (se repite cada año)
            </label>
          </div>

          <div class="flex justify-end gap-2 pt-2">
            <button
              type="button"
              class="inline-flex items-center justify-center rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition"
              onclick="hideModal('addModal')"
            >
              Cancelar
            </button>

            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition"
            >
              Guardar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal Editar Evento -->
  <div id="editModal" class="modal">
    <div
      class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft w-full max-w-md border border-slate-200 dark:border-white/10 max-h-[90vh] overflow-y-auto"
    >
      <div class="px-6 py-4 border-b border-slate-200 dark:border-white/10 flex items-center justify-between sticky top-0 bg-white dark:bg-slate-900 z-10">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
          <span>✏️</span>
          <span>Editar Evento</span>
        </h2>
        <button
          class="text-slate-400 hover:text-slate-600 dark:text-slate-400 dark:hover:text-white text-xl leading-none"
          onclick="hideModal('editModal')"
        >
          &times;
        </button>
      </div>

      <div class="p-6">
        <form onsubmit="updateEvent(event)" class="space-y-5">
          <input type="hidden" id="edit-id" />

          <div>
            <label class="block mb-2 text-sm font-semibold text-slate-700 dark:text-slate-200" for="edit-title">
              Título *
            </label>
            <input
              type="text"
              id="edit-title"
              required
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
            />
          </div>

          <div>
            <label class="block mb-2 text-sm font-semibold text-slate-700 dark:text-slate-200" for="edit-date">
              Fecha *
            </label>
            <input
              type="date"
              id="edit-date"
              required
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
            />
          </div>

          <div>
            <label class="block mb-2 text-sm font-semibold text-slate-700 dark:text-slate-200" for="edit-type">
              Tipo *
            </label>
            <select
              id="edit-type"
              required
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
            >
              <option value="holiday">🎉 Feriado</option>
              <option value="special_event">⭐ Evento Especial</option>
              <option value="closure">🔒 Cierre</option>
            </select>
          </div>

          <div>
            <label class="block mb-2 text-sm font-semibold text-slate-700 dark:text-slate-200" for="edit-description">
              Descripción (opcional)
            </label>
            <textarea
              id="edit-description"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0 min-h-[80px] resize-y"
            ></textarea>
          </div>

          <div class="flex items-start gap-2">
            <input
              type="checkbox"
              id="edit-isRecurring"
              class="mt-[2px] w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-0"
            />
            <label for="edit-isRecurring" class="text-sm text-slate-700 dark:text-slate-200 select-none">
              Evento anual
            </label>
          </div>

          <div class="flex justify-end gap-2 pt-2">
            <button
              type="button"
              class="inline-flex items-center justify-center rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition"
              onclick="hideModal('editModal')"
            >
              Cancelar
            </button>

            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition"
            >
              Actualizar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    // Iconos lucide
    window.lucide && lucide.createIcons();

    // Sidebar móvil
    (function(){
      const sidebar   = document.getElementById('sidebar');
      const overlay   = document.getElementById('mobile-sidebar-overlay');
      const openBtn   = document.getElementById('open-sidebar-btn');
      const closeBtn  = document.getElementById('close-sidebar-btn');

      function openSidebar(){
        sidebar.classList.remove('-translate-x-full');
        overlay.classList.remove('opacity-0','pointer-events-none');
      }
      function closeSidebar(){
        sidebar.classList.add('-translate-x-full');
        overlay.classList.add('opacity-0','pointer-events-none');
      }

      if (openBtn)  openBtn.addEventListener('click', openSidebar);
      if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
      if (overlay)  overlay.addEventListener('click', closeSidebar);
    })();

    // ===== Helpers de fecha en el FRONT =====
    function formatYMDLong(ymd, locale = 'es-PE') {
      // ymd: "YYYY-MM-DD"
      const [y, m, d] = ymd.split('-').map(Number);
      const date = new Date(y, m - 1, d);
      return date.toLocaleDateString(locale, {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric'
      });
    }

    function renderDateLabels() {
      document.querySelectorAll('.date-label').forEach(el => {
        const ymd = el.getAttribute('data-ymd');
        el.textContent = formatYMDLong(ymd);
      });
    }

    // ====== CRUD EVENTOS (misma lógica que tenías) ======

    // Agregar evento
    async function addEvent(e) {
      e.preventDefault();

      const data = {
        title: document.getElementById('title').value,
        date: document.getElementById('date').value,
        type: document.getElementById('type').value,
        description: document.getElementById('description').value,
        isRecurring: document.getElementById('isRecurring').checked
      };

      try {
        const res = await fetch('/calendar/api', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await res.json();

        if (result.success) {
          alert('✅ Evento agregado exitosamente');
          location.reload();
        } else {
          alert('❌ Error: ' + (result.error || 'No se pudo agregar'));
        }
      } catch (error) {
        alert('❌ Error al agregar evento');
        console.error(error);
      }
    }

    // Editar evento
    async function editEvent(id) {
      try {
        const res = await fetch(`/calendar/api/${id}`);
        const event = await res.json();

        document.getElementById('edit-id').value = event.id;
        document.getElementById('edit-title').value = event.title;
        document.getElementById('edit-date').value = event.dateYMD; // usamos dateYMD crudo
        document.getElementById('edit-type').value = event.type;
        document.getElementById('edit-description').value = event.description || '';
        document.getElementById('edit-isRecurring').checked = event.isRecurring;

        showModal('editModal');
      } catch (error) {
        alert('❌ Error al cargar evento');
        console.error(error);
      }
    }

    // Actualizar evento
    async function updateEvent(e) {
      e.preventDefault();

      const id = document.getElementById('edit-id').value;
      const data = {
        title: document.getElementById('edit-title').value,
        date: document.getElementById('edit-date').value,
        type: document.getElementById('edit-type').value,
        description: document.getElementById('edit-description').value,
        isRecurring: document.getElementById('edit-isRecurring').checked
      };

      try {
        const res = await fetch(`/calendar/api/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await res.json();

        if (result.success) {
          alert('✅ Evento actualizado');
          location.reload();
        } else {
          alert('❌ Error al actualizar');
        }
      } catch (error) {
        alert('❌ Error al actualizar evento');
        console.error(error);
      }
    }

    // Eliminar evento
    async function deleteEvent(id) {
      if (!confirm('¿Eliminar este evento?')) return;

      try {
        const res = await fetch(`/calendar/api/${id}`, { method: 'DELETE' });
        const result = await res.json();

        if (result.success) {
          alert('✅ Evento eliminado');
          location.reload();
        } else {
          alert('❌ Error al eliminar');
        }
      } catch (error) {
        alert('❌ Error al eliminar evento');
        console.error(error);
      }
    }

    // Mostrar / ocultar modal
    function showModal(modalId) {
      document.getElementById(modalId).classList.add('show');
    }

    function hideModal(modalId) {
      document.getElementById(modalId).classList.remove('show');
    }

    // Cerrar modal al clickear fuera
    window.onclick = function(event) {
      const modals = document.getElementsByClassName('modal');
      for (let modal of modals) {
        if (event.target === modal) {
          modal.classList.remove('show');
        }
      }
    }

    // Render inicial de fechas
    renderDateLabels();
  </script>
</body>
</html>
