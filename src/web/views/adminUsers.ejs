<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Usuarios Admin' %> - WhatsApp Bot Admin</title>

  <!-- Fuente -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind (misma config del dashboard) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary:   { DEFAULT:'#667eea', 600:'#667eea', 700:'#5a67d8' },
            secondary: { DEFAULT:'#764ba2', 600:'#764ba2', 700:'#6b3fa0' },
          },
          boxShadow: {
            soft:'0 4px 6px -1px rgba(0,0,0,.08), 0 2px 4px -1px rgba(0,0,0,.04)',
            card:'0 10px 30px -5px rgba(0,0,0,.10)'
          }
        }
      },
      darkMode:'media'
    }
  </script>

  <!-- Utilidades externas del dashboard (card-link, gradient-text, pulse-ring, icon, etc.) -->
  <link rel="stylesheet" href="/css/ui.css">

  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="h-full bg-gradient-to-br from-slate-50 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 text-slate-800 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-4 focus:py-2 focus:rounded-lg shadow-lg">
    Saltar al contenido
  </a>

  <%
    // ===== Helpers / defaults =====
    const adminsList = Array.isArray(admins) ? admins : [];
    const currentId  = typeof currentUserId !== 'undefined' ? currentUserId : null;
    const nf = new Intl.NumberFormat('es-PE');
    const df = new Intl.DateTimeFormat('es-PE', { dateStyle: 'short' });
    function fmtDate(d){ try { return df.format(new Date(d)); } catch { return '-'; } }
  %>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Volver al Dashboard + breadcrumb -->
    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <a href="/"
           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">
          <i data-lucide="arrow-left" class="icon"></i>
          <span>Volver al Dashboard</span>
        </a>
      </div>

      <nav aria-label="Breadcrumb" class="text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li class="inline-flex items-center gap-1">
            <a href="/" class="hover:underline inline-flex items-center gap-1">
              <i data-lucide="home" class="w-3.5 h-3.5"></i> Inicio
            </a>
          </li>
          <li class="select-none">/</li>
          <li class="inline-flex items-center gap-1">
            <i data-lucide="shield" class="w-3.5 h-3.5"></i>
            <span class="font-medium">Usuarios Admin</span>
          </li>
        </ol>
      </nav>
    </div>

    <!-- Header -->
    <header class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight gradient-text flex items-center gap-3">
            <i data-lucide="shield" class="icon-lg text-primary"></i>
            Usuarios Admin
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Gestión de administradores del sistema</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft"
                  onclick="showModal('addModal')">
            <i data-lucide="plus-circle" class="icon"></i>
            <span>Agregar Usuario</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Tabla -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center">
            <i data-lucide="users" class="icon text-indigo-600 dark:text-indigo-400"></i>
          </div>
          Lista de Administradores
        </h2>
      </div>

      <% if (adminsList.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-400 uppercase text-xs tracking-wider font-semibold">
              <tr>
                <th class="text-left px-6 py-4">Usuario</th>
                <th class="text-left px-6 py-4">Nombre</th>
                <th class="text-left px-6 py-4">Registro</th>
                <th class="text-left px-6 py-4">Acciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
              <% adminsList.forEach(admin => { %>
                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                  <td class="px-6 py-4 font-semibold text-slate-900 dark:text-white">
                    <span><%= admin.username %></span>
                    <% if (admin.id === currentId) { %>
                      <span class="ml-2 inline-flex items-center rounded-md bg-sky-100 text-sky-700 dark:bg-sky-900/30 dark:text-sky-300 px-2 py-0.5 text-[11px] font-semibold leading-none">Tú</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-4 text-slate-700 dark:text-slate-300"><%= admin.name || '-' %></td>
                  <td class="px-6 py-4 text-slate-600 dark:text-slate-400">
                    <time datetime="<%= new Date(admin.createdAt).toISOString() %>"><%= fmtDate(admin.createdAt) %></time>
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex flex-wrap gap-2">
                      <!-- Editar -->
                      <button
                        class="inline-flex items-center gap-1 rounded-lg bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                        onclick="editAdmin('<%= admin.id %>')">
                        ✏️ <span>Editar</span>
                      </button>

                      <% if (admin.id === currentId) { %>
                        <!-- Cambiar mi contraseña -->
                        <button
                          class="inline-flex items-center gap-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                          onclick="changeMyPassword('<%= admin.id %>')">
                          🔑 <span>Cambiar Contraseña</span>
                        </button>
                      <% } else { %>
                        <!-- Resetear contraseña -->
                        <button
                          class="inline-flex items-center gap-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                          onclick="resetPassword('<%= admin.id %>')">
                          🔄 <span>Resetear Contraseña</span>
                        </button>

                        <!-- Eliminar -->
                        <button
                          class="inline-flex items-center gap-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                          onclick="deleteAdmin('<%= admin.id %>')">
                          🗑️ <span>Eliminar</span>
                        </button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="px-6 py-16 text-center">
          <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="inbox" class="icon-lg text-slate-400"></i>
          </div>
          <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Sin usuarios</p>
          <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Agrega el primer administrador</p>
        </div>
      <% } %>
    </section>
  </main>

  <!-- Modales (mismos estilos que dashboard: sin CSS inline extra) -->
  <div id="addModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-md w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="user-plus" class="icon text-primary"></i> Agregar Usuario Admin
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="hideModal('addModal')">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>
      <div class="p-6">
        <form onsubmit="addAdmin(event)" class="space-y-4">
          <div>
            <label for="username" class="block text-sm font-semibold mb-2">Usuario *</label>
            <input id="username" type="text" required placeholder="Ej: admin2"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500">
          </div>
          <div>
            <label for="name" class="block text-sm font-semibold mb-2">Nombre Completo</label>
            <input id="name" type="text" placeholder="Ej: Juan Pérez"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500">
          </div>
          <div>
            <label for="password" class="block text-sm font-semibold mb-2">Contraseña *</label>
            <input id="password" type="password" required minlength="6" placeholder="Mínimo 6 caracteres"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500">
          </div>
          <div class="flex justify-end gap-2 pt-2">
            <button type="button" class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white" onclick="hideModal('addModal')">
              Cancelar
            </button>
            <button type="submit" class="rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-3 py-2 shadow-soft">
              Crear Usuario
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div id="editModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-md w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="pencil" class="icon text-amber-600"></i> Editar Usuario
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="hideModal('editModal')">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>
      <div class="p-6">
        <form onsubmit="updateAdmin(event)" class="space-y-4">
          <input id="edit-id" type="hidden">
          <div>
            <label for="edit-username" class="block text-sm font-semibold mb-2">Usuario</label>
            <input id="edit-username" type="text" required
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500">
          </div>
          <div>
            <label for="edit-name" class="block text-sm font-semibold mb-2">Nombre Completo</label>
            <input id="edit-name" type="text"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500">
          </div>
          <div class="flex justify-end gap-2 pt-2">
            <button type="button" class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white" onclick="hideModal('editModal')">
              Cancelar
            </button>
            <button type="submit" class="rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-3 py-2 shadow-soft">
              Actualizar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div id="changePasswordModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-md w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="key-round" class="icon text-emerald-600"></i> Cambiar Mi Contraseña
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="hideModal('changePasswordModal')">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>
      <div class="p-6">
        <form onsubmit="changePassword(event)" class="space-y-4">
          <input id="change-id" type="hidden">
          <div class="rounded-lg border border-sky-300/40 bg-sky-50 text-sky-800 text-sm px-3 py-2 dark:bg-sky-900/30 dark:text-sky-200 dark:border-sky-700/40">
            💡 Debes ingresar tu contraseña actual para confirmar el cambio
          </div>
          <div>
            <label for="currentPassword" class="block text-sm font-semibold mb-2">Contraseña Actual *</label>
            <input id="currentPassword" type="password" required
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500">
          </div>
          <div>
            <label for="newPassword" class="block text-sm font-semibold mb-2">Nueva Contraseña *</label>
            <input id="newPassword" type="password" required minlength="6" placeholder="Mínimo 6 caracteres"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500">
          </div>
          <div>
            <label for="confirmPassword" class="block text-sm font-semibold mb-2">Confirmar Nueva Contraseña *</label>
            <input id="confirmPassword" type="password" required minlength="6"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500">
          </div>
          <div class="flex justify-end gap-2 pt-2">
            <button type="button" class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white" onclick="hideModal('changePasswordModal')">
              Cancelar
            </button>
            <button type="submit" class="rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-3 py-2 shadow-soft">
              Cambiar Contraseña
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div id="resetPasswordModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-md w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="rotate-ccw" class="icon text-amber-600"></i> Resetear Contraseña
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="hideModal('resetPasswordModal')">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>
      <div class="p-6">
        <form onsubmit="resetPasswordSubmit(event)" class="space-y-4">
          <input id="reset-id" type="hidden">
          <div class="rounded-lg border border-amber-300/40 bg-amber-50 text-amber-800 text-sm px-3 py-2 dark:bg-amber-900/30 dark:text-amber-200 dark:border-amber-700/40">
            ⚠️ Estás reseteando la contraseña de otro usuario. Asegúrate de comunicarle la nueva contraseña.
          </div>
          <div>
            <label for="resetNewPassword" class="block text-sm font-semibold mb-2">Nueva Contraseña *</label>
            <input id="resetNewPassword" type="password" required minlength="6" placeholder="Mínimo 6 caracteres"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500">
          </div>
          <div class="flex justify-end gap-2 pt-2">
            <button type="button" class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white" onclick="hideModal('resetPasswordModal')">
              Cancelar
            </button>
            <button type="submit" class="rounded-lg bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold px-3 py-2 shadow-soft">
              Resetear Contraseña
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script>
    // Iconos
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
    });

    // ====== Lógica CRUD (sin cambios) ======
    async function addAdmin(e) {
      e.preventDefault();
      const data = {
        username: document.getElementById('username').value,
        name: document.getElementById('name').value,
        password: document.getElementById('password').value
      };
      try {
        const res = await fetch('/admin-users/api', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
        const result = await res.json();
        if (result.success) { alert('✅ Usuario creado exitosamente'); location.reload(); }
        else { alert('❌ Error: ' + (result.error || 'No se pudo crear')); }
      } catch (err) { alert('❌ Error al crear usuario'); console.error(err); }
    }

    async function editAdmin(id) {
      try {
        const res = await fetch(`/admin-users/api/${id}`);
        const admin = await res.json();
        document.getElementById('edit-id').value = admin.id;
        document.getElementById('edit-username').value = admin.username;
        document.getElementById('edit-name').value = admin.name || '';
        showModal('editModal');
      } catch (err) { alert('❌ Error al cargar usuario'); console.error(err); }
    }

    async function updateAdmin(e) {
      e.preventDefault();
      const id = document.getElementById('edit-id').value;
      const data = {
        username: document.getElementById('edit-username').value,
        name: document.getElementById('edit-name').value
      };
      try {
        const res = await fetch(`/admin-users/api/${id}`, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
        const result = await res.json();
        if (result.success) { alert('✅ Usuario actualizado'); location.reload(); }
        else { alert('❌ Error al actualizar'); }
      } catch (err) { alert('❌ Error al actualizar usuario'); console.error(err); }
    }

    function changeMyPassword(id) {
      document.getElementById('change-id').value = id;
      document.getElementById('currentPassword').value = '';
      document.getElementById('newPassword').value = '';
      document.getElementById('confirmPassword').value = '';
      showModal('changePasswordModal');
    }

    async function changePassword(e) {
      e.preventDefault();
      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;
      if (newPassword !== confirmPassword) { alert('❌ Las contraseñas no coinciden'); return; }
      const data = { currentPassword: document.getElementById('currentPassword').value, newPassword };
      const id = document.getElementById('change-id').value;
      try {
        const res = await fetch(`/admin-users/api/${id}/change-password`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
        const result = await res.json();
        if (result.success) { alert('✅ Contraseña cambiada exitosamente'); hideModal('changePasswordModal'); }
        else { alert('❌ Error: ' + (result.error || 'No se pudo cambiar')); }
      } catch (err) { alert('❌ Error al cambiar contraseña'); console.error(err); }
    }

    function resetPassword(id) {
      document.getElementById('reset-id').value = id;
      document.getElementById('resetNewPassword').value = '';
      showModal('resetPasswordModal');
    }

    async function resetPasswordSubmit(e) {
      e.preventDefault();
      const id = document.getElementById('reset-id').value;
      const data = { newPassword: document.getElementById('resetNewPassword').value };
      try {
        const res = await fetch(`/admin-users/api/${id}/reset-password`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
        const result = await res.json();
        if (result.success) { alert('✅ Contraseña reseteada exitosamente'); hideModal('resetPasswordModal'); }
        else { alert('❌ Error: ' + (result.error || 'No se pudo resetear')); }
      } catch (err) { alert('❌ Error al resetear contraseña'); console.error(err); }
    }

    async function deleteAdmin(id) {
      if (!confirm('¿Eliminar este usuario administrador?\n\nEsta acción no se puede deshacer.')) return;
      try {
        const res = await fetch(`/admin-users/api/${id}`, { method:'DELETE' });
        const result = await res.json();
        if (result.success) { alert('✅ Usuario eliminado'); location.reload(); }
        else { alert('❌ Error: ' + (result.error || 'No se pudo eliminar')); }
      } catch (err) { alert('❌ Error al eliminar usuario'); console.error(err); }
    }

    // Modales (usamos clases Tailwind en lugar de CSS propio)
    function showModal(id){
      const el = document.getElementById(id);
      el.classList.remove('hidden');
      el.classList.add('flex');
    }
    function hideModal(id){
      const el = document.getElementById(id);
      el.classList.remove('flex');
      el.classList.add('hidden');
    }
    window.addEventListener('click', (e) => {
      document.querySelectorAll('#addModal,#editModal,#changePasswordModal,#resetPasswordModal').forEach(m => {
        if (e.target === m) hideModal(m.id);
      });
    });
  </script>
</body>
</html>
