<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente + Tailwind -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary: { DEFAULT:'#1e3a8a', 600:'#1e3a8a', 700:'#1e40af' },
          },
          boxShadow: {
            soft:'0 10px 25px -10px rgba(0,0,0,.15)',
          },
          borderColor: {
            subtle:'rgba(148,163,184,.2)'
          }
        }
      },
      darkMode:'media'
    }
  </script>

  <!-- Animaciones -->
  <script src="https://unpkg.com/@motionone/dom/dist/motion.min.js"></script>
  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration:0.001ms !important;
        animation-iteration-count:1 !important;
        transition-duration:0.001ms !important;
        scroll-behavior:auto !important;
      }
    }
    .sidebar-link-active{
      background-color:rgba(255,255,255,.12);
      color:#fff !important;
      font-weight:600;
    }
    /* helper para resaltar la opción de color seleccionada */
    .color-option-selected{
      outline:2px solid rgb(15 23 42 / 1); /* slate-900 */
      outline-offset:2px;
      box-shadow:0 0 0 2px #fff,0 0 0 4px rgb(15 23 42 / 1);
    }
  </style>
</head>

<body class="h-full bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
  <a href="#main-content"
     class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-3 focus:py-2 focus:rounded-lg shadow">
    Saltar al contenido
  </a>

  <% /* ===================== Helpers / Defaults ===================== */ %>
  <%
    // page debe venir del controlador, ej: res.render('tags', { page:'tags', ... })
    function isActive(p){
      return (page === p || (!page && p==='dashboard')) ? 'sidebar-link-active' : '';
    }
  %>

  <div class="min-h-screen w-full flex relative">
    <!-- Overlay móvil -->
    <div id="mobile-sidebar-overlay"
         class="fixed inset-0 bg-black/40 z-40 opacity-0 pointer-events-none transition-opacity md:hidden"></div>

    <!-- SIDEBAR -->
    <aside id="sidebar"
           class="w-[280px] flex flex-col bg-gradient-to-b from-primary to-primary-700 text-white shadow-soft
                  fixed inset-y-0 left-0 z-50 -translate-x-full transition-transform md:translate-x-0 md:relative md:flex"
           role="navigation"
           aria-label="Menú principal">

      <!-- header sidebar -->
      <div class="px-5 py-6 border-b border-white/10 bg-white/5 backdrop-blur flex items-center justify-between">
        <h2 class="text-xl font-semibold flex items-center gap-2">
          <i data-lucide="bot" class="w-5 h-5"></i> Bot Admin
        </h2>

        <!-- cerrar sidebar móvil -->
        <button id="close-sidebar-btn"
                class="md:hidden inline-flex items-center justify-center rounded-lg text-white/70 hover:text-white hover:bg-white/10 p-2"
                aria-label="Cerrar menú">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- nav -->
      <nav class="py-4 flex-1 overflow-y-auto">
        <ul class="px-2 space-y-1 text-[15px] leading-5">
          <li>
            <a href="/"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('dashboard') %>"
               aria-current="<%= isActive('dashboard') ? 'page' : false %>">
              <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
              <span>Dashboard</span>
            </a>
          </li>

          <li>
            <a href="/contacts"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('contacts') %>"
               aria-current="<%= isActive('contacts') ? 'page' : false %>">
              <i data-lucide="users" class="w-5 h-5"></i>
              <span>Contactos</span>
            </a>
          </li>

          <li>
            <a href="/conversations"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('conversations') %>"
               aria-current="<%= isActive('conversations') ? 'page' : false %>">
              <i data-lucide="message-circle" class="w-5 h-5"></i>
              <span>Conversaciones</span>
            </a>
          </li>

          <li>
            <a href="/blocked"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('blocked') %>"
               aria-current="<%= isActive('blocked') ? 'page' : false %>">
              <i data-lucide="ban" class="w-5 h-5"></i>
              <span>Bloqueados</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/calendar"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('calendar') %>"
               aria-current="<%= isActive('calendar') ? 'page' : false %>">
              <i data-lucide="calendar" class="w-5 h-5"></i>
              <span>Calendario</span>
            </a>
          </li>

          <li>
            <a href="/working-hours"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('working-hours') %>"
               aria-current="<%= isActive('working-hours') ? 'page' : false %>">
              <i data-lucide="clock" class="w-5 h-5"></i>
              <span>Horarios</span>
            </a>
          </li>

          <li>
            <a href="/admin-users"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('admin-users') %>"
               aria-current="<%= isActive('admin-users') ? 'page' : false %>">
              <i data-lucide="shield" class="w-5 h-5"></i>
              <span>Usuarios Admin</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/settings"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('settings') %>"
               aria-current="<%= isActive('settings') ? 'page' : false %>">
              <i data-lucide="settings" class="w-5 h-5"></i>
              <span>Configuración</span>
            </a>
          </li>

          <li>
            <a href="/departments"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('departments') %>"
               aria-current="<%= isActive('departments') ? 'page' : false %>">
              <i data-lucide="building-2" class="w-5 h-5"></i>
              <span>Departamentos</span>
            </a>
          </li>

          <li>
            <a href="/products"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('products') %>"
               aria-current="<%= isActive('products') ? 'page' : false %>">
              <i data-lucide="package" class="w-5 h-5"></i>
              <span>Productos</span>
            </a>
          </li>

          <li>
            <a href="/auto-responses"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('auto-responses') %>"
               aria-current="<%= isActive('auto-responses') ? 'page' : false %>">
              <i data-lucide="robot" class="w-5 h-5"></i>
              <span>Auto-respuestas</span>
            </a>
          </li>

          <li>
            <a href="/tags"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('tags') %>"
               aria-current="<%= isActive('tags') ? 'page' : false %>">
              <i data-lucide="tags" class="w-5 h-5"></i>
              <span>Tags</span>
            </a>
          </li>

          <li>
            <a href="/templates"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('templates') %>"
               aria-current="<%= isActive('templates') ? 'page' : false %>">
              <i data-lucide="file-text" class="w-5 h-5"></i>
              <span>Plantillas</span>
            </a>
          </li>

          <li>
            <a href="/metrics"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('metrics') %>"
               aria-current="<%= isActive('metrics') ? 'page' : false %>">
              <i data-lucide="line-chart" class="w-5 h-5"></i>
              <span>Métricas</span>
            </a>
          </li>
        </ul>
      </nav>

      <!-- footer sidebar -->
      <div class="mt-auto p-4 bg-white/5 border-t border-white/10">
        <div class="rounded-xl bg-white/10 p-3">
          <div class="text-[11px] uppercase tracking-wide opacity-80">Sesión activa</div>
          <div class="font-semibold text-sm mt-1 flex items-center gap-2">
            <i data-lucide="user" class="w-4 h-4"></i>
            <%= user || 'Admin' %>
          </div>
        </div>

        <form method="POST" action="/auth/logout" class="mt-3">
          <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>
          <button
            type="submit"
            class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-white/20 bg-red-500/20 hover:bg-red-500/30 text-white py-2.5 text-sm font-medium transition">
            <i data-lucide="log-out" class="w-4 h-4"></i> Cerrar sesión
          </button>
        </form>
      </div>
    </aside>

    <!-- MAIN -->
    <main id="main-content" class="flex-1 p-4 md:p-8 w-full md:w-auto md:ml-0">

      <!-- HEADER PRINCIPAL -->
      <header class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft px-6 py-5 mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-start justify-between w-full md:w-auto">
          <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white flex items-center gap-3">
            <i data-lucide="tags" class="w-7 h-7 text-primary"></i>
            Tags / Etiquetas
          </h1>

          <!-- Botón abrir sidebar móvil -->
          <button id="open-sidebar-btn"
                  class="md:hidden inline-flex items-center justify-center rounded-lg text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 p-2 shadow-soft"
                  aria-label="Abrir menú">
            <i data-lucide="menu" class="w-6 h-6"></i>
          </button>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:justify-end w-full md:w-auto">
          <button
            class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 text-sm font-semibold shadow-soft transition"
            onclick="openNewTagModal()">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Nueva Etiqueta
          </button>
        </div>
      </header>

      <!-- TIP -->
      <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-soft border border-slate-100/70 dark:border-white/5 mb-6">
        <div class="px-6 py-5 flex items-start gap-3 text-sm">
          <div class="rounded-lg bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 p-2 flex-shrink-0">
            <i data-lucide="info" class="w-4 h-4"></i>
          </div>
          <div class="text-slate-700 dark:text-slate-300">
            <p class="font-semibold text-slate-900 dark:text-white mb-1">
              Usa etiquetas para clasificar chats
            </p>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
              Ejemplo: <span class="font-medium">VIP</span>, <span class="font-medium">Urgente</span>,
              <span class="font-medium">Seguimiento</span>, <span class="font-medium">Resuelto</span>.
            </p>
          </div>
        </div>
      </section>

      <!-- LISTA DE TAGS -->
      <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-soft border border-slate-100/70 dark:border-white/5">
        <div class="px-6 py-4 border-b border-slate-100/70 dark:border-white/5 flex items-center justify-between">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <i data-lucide="list" class="w-5 h-5 text-primary"></i>
            Etiquetas Disponibles
          </h2>
        </div>

        <div class="p-6">
          <% if (tags && tags.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
              <% tags.forEach(tag => { %>
                <div class="relative rounded-xl border border-slate-200/80 dark:border-white/10 bg-white dark:bg-slate-900 p-5 shadow-soft hover:shadow-lg hover:border-indigo-400/60 hover:ring-2 hover:ring-indigo-100 dark:hover:ring-indigo-500/30 transition"
                     data-card>
                  <!-- Header tag -->
                  <div class="flex items-start justify-between mb-3">
                    <div class="flex items-start gap-3">
                      <div class="w-4 h-4 rounded-full mt-1 flex-shrink-0"
                           style="background:<%= tag.color || '#3b82f6' %>;">
                      </div>
                      <div>
                        <div class="text-base font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                          <%= tag.name %>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Descripción -->
                  <% if (tag.description) { %>
                    <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
                      <%= tag.description %>
                    </p>
                  <% } else { %>
                    <p class="text-sm text-slate-400 italic dark:text-slate-500 leading-relaxed mb-4">
                      (Sin descripción)
                    </p>
                  <% } %>

                  <!-- Acciones -->
                  <div class="flex flex-wrap gap-2 pt-3 border-t border-dashed border-slate-200/70 dark:border-white/10">
                    <button
                      class="inline-flex items-center gap-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-200 px-3 py-1.5 text-xs font-medium transition shadow"
                      onclick="editTag('<%= tag.id %>')">
                      <i data-lucide="edit-3" class="w-4 h-4"></i>
                      Editar
                    </button>

                    <button
                      class="inline-flex items-center gap-1 rounded-lg bg-rose-100 hover:bg-rose-200 text-rose-700 dark:bg-rose-900/40 dark:hover:bg-rose-900/60 dark:text-rose-300 px-3 py-1.5 text-xs font-medium transition shadow"
                      onclick="deleteTag('<%= tag.id %>')">
                      <i data-lucide="trash-2" class="w-4 h-4"></i>
                      Eliminar
                    </button>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center text-slate-500 dark:text-slate-400 py-16 text-sm">
              No hay etiquetas configuradas. Crea una nueva para comenzar.
            </div>
          <% } %>
        </div>
      </section>

    </main>
  </div>

  <!-- MODAL CREAR / EDITAR TAG -->
  <div id="tagModal"
       class="fixed inset-0 z-[1000] hidden items-center justify-center p-4 md:p-8 bg-black/50">
    <div class="w-full max-w-lg bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200/70 dark:border-white/10 flex flex-col max-h-[85vh] overflow-hidden">
      <!-- header modal -->
      <div class="px-5 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white" id="tagModalTitle">
          Nueva Etiqueta
        </h3>
        <button
          class="inline-flex items-center justify-center rounded-lg text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 p-2"
          onclick="closeTagModal()"
          aria-label="Cerrar">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- body modal -->
      <div class="px-5 py-4 overflow-y-auto">
        <form id="tagForm" class="space-y-5">
          <input type="hidden" id="tagId"/>

          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
              Nombre <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="tagName"
              required
              placeholder="ej: VIP, Urgente, Seguimiento"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm px-3 py-2.5 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"/>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
              Descripción
            </label>
            <textarea
              id="tagDescription"
              rows="3"
              placeholder="Descripción opcional..."
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm px-3 py-2.5 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"></textarea>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
              Color
            </label>

            <input
              type="text"
              id="tagColor"
              readonly
              value="#3b82f6"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm px-3 py-2.5 text-slate-900 dark:text-slate-100 cursor-pointer select-all"/>

            <div class="flex flex-wrap gap-3 mt-3" id="colorPicker">
              <div class="w-9 h-9 rounded-lg cursor-pointer ring-1 ring-slate-900/10 shadow-inner"
                   style="background:#3b82f6;"
                   data-color="#3b82f6"></div>
              <div class="w-9 h-9 rounded-lg cursor-pointer ring-1 ring-slate-900/10 shadow-inner"
                   style="background:#10b981;"
                   data-color="#10b981"></div>
              <div class="w-9 h-9 rounded-lg cursor-pointer ring-1 ring-slate-900/10 shadow-inner"
                   style="background:#f59e0b;"
                   data-color="#f59e0b"></div>
              <div class="w-9 h-9 rounded-lg cursor-pointer ring-1 ring-slate-900/10 shadow-inner"
                   style="background:#ef4444;"
                   data-color="#ef4444"></div>
              <div class="w-9 h-9 rounded-lg cursor-pointer ring-1 ring-slate-900/10 shadow-inner"
                   style="background:#8b5cf6;"
                   data-color="#8b5cf6"></div>
              <div class="w-9 h-9 rounded-lg cursor-pointer ring-1 ring-slate-900/10 shadow-inner"
                   style="background:#ec4899;"
                   data-color="#ec4899"></div>
              <div class="w-9 h-9 rounded-lg cursor-pointer ring-1 ring-slate-900/10 shadow-inner"
                   style="background:#14b8a6;"
                   data-color="#14b8a6"></div>
              <div class="w-9 h-9 rounded-lg cursor-pointer ring-1 ring-slate-900/10 shadow-inner"
                   style="background:#64748b;"
                   data-color="#64748b"></div>
            </div>
          </div>
        </form>
      </div>

      <!-- footer modal -->
      <div class="px-5 py-4 border-t border-slate-200/70 dark:border-white/10 flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
        <button
          type="button"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-200 px-4 py-2 text-sm font-medium shadow"
          onclick="closeTagModal()">
          <i data-lucide="x" class="w-4 h-4"></i>
          Cancelar
        </button>

        <button
          type="submit"
          form="tagForm"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 text-sm font-semibold shadow-soft transition">
          <i data-lucide="check-circle" class="w-4 h-4"></i>
          Guardar
        </button>
      </div>
    </div>
  </div>

  <!-- JS: icons + animaciones + sidebar móvil + modal tags -->
  <script>
    // iconos lucide
    window.lucide && lucide.createIcons();

    // sidebar móvil
    (function(){
      const sidebar   = document.getElementById('sidebar');
      const overlay   = document.getElementById('mobile-sidebar-overlay');
      const openBtn   = document.getElementById('open-sidebar-btn');
      const closeBtn  = document.getElementById('close-sidebar-btn');

      function openSidebar(){
        sidebar.classList.remove('-translate-x-full');
        overlay.classList.remove('opacity-0','pointer-events-none');
      }
      function closeSidebar(){
        sidebar.classList.add('-translate-x-full');
        overlay.classList.add('opacity-0','pointer-events-none');
      }

      if (openBtn)  openBtn.addEventListener('click', openSidebar);
      if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
      if (overlay)  overlay.addEventListener('click', closeSidebar);
    })();

    // animaciones suaves si no hay reduced motion
    (function(){
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReduced && window.motion) {
        const cards = document.querySelectorAll('[data-card]');
        cards.forEach((el, i) => {
          motion.animate(
            el,
            { opacity:[0,1], transform:['translateY(8px)','translateY(0)'] },
            { duration:.4, delay:i*0.04, easing:'ease-out' }
          );
          el.addEventListener('pointerenter', () =>
            motion.animate(el, { transform:['translateY(0)','translateY(-2px)'] }, { duration:.18, easing:'ease-out' })
          );
          el.addEventListener('pointerleave', () =>
            motion.animate(el, { transform:['translateY(-2px)','translateY(0)'] }, { duration:.18, easing:'ease-out' })
          );
        });
      }
    })();

    // ====== MODAL TAG ======
    const modal      = document.getElementById('tagModal');
    const tagForm    = document.getElementById('tagForm');
    const tagIdEl    = document.getElementById('tagId');
    const tagNameEl  = document.getElementById('tagName');
    const tagDescEl  = document.getElementById('tagDescription');
    const tagColorEl = document.getElementById('tagColor');
    const tagTitleEl = document.getElementById('tagModalTitle');

    // abrir/cerrar modal
    function openTagModal(){
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
    function closeTagModal(){
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // click fuera cierra
    modal.addEventListener('click', (e)=>{
      if(e.target === modal){
        closeTagModal();
      }
    });

    // ESC cierra
    window.addEventListener('keydown',(e)=>{
      if(e.key === 'Escape'){
        closeTagModal();
      }
    });

    // ====== SELECTOR DE COLOR ======
    function markSelectedColor(hex){
      const nodes = document.querySelectorAll('#colorPicker > div');
      nodes.forEach(n=>{
        n.classList.remove('color-option-selected');
        if(n.getAttribute('data-color') === hex){
          n.classList.add('color-option-selected');
        }
      });
    }

    document.querySelectorAll('#colorPicker > div').forEach(div=>{
      div.addEventListener('click', (ev)=>{
        const c = ev.currentTarget.getAttribute('data-color');
        tagColorEl.value = c;
        markSelectedColor(c);
      });
    });

    // ====== NUEVA ETIQUETA ======
    function openNewTagModal(){
      tagIdEl.value = '';
      tagNameEl.value = '';
      tagDescEl.value = '';
      tagColorEl.value = '#3b82f6';
      tagTitleEl.textContent = 'Nueva Etiqueta';

      markSelectedColor('#3b82f6');
      openTagModal();
    }

    // ====== EDITAR ETIQUETA ======
    async function editTag(id){
      try{
        const res = await fetch(`/tags/api/${id}`);
        const tag = await res.json();

        tagIdEl.value    = tag.id || '';
        tagNameEl.value  = tag.name || '';
        tagDescEl.value  = tag.description || '';
        tagColorEl.value = tag.color || '#3b82f6';
        tagTitleEl.textContent = 'Editar Etiqueta';

        markSelectedColor(tag.color || '#3b82f6');
        openTagModal();
      }catch(err){
        alert('Error: ' + err.message);
      }
    }

    // ====== GUARDAR ======
    tagForm.addEventListener('submit', async (e)=>{
      e.preventDefault();

      const id = tagIdEl.value;
      const data = {
        name: tagNameEl.value,
        description: tagDescEl.value,
        color: tagColorEl.value
      };

      try{
        const url = id ? `/tags/api/${id}` : '/tags/api';
        const method = id ? 'PUT' : 'POST';

        const res = await fetch(url, {
          method,
          headers:{ 'Content-Type':'application/json' },
          body:JSON.stringify(data)
        });

        if(res.ok){
          location.reload();
        }else{
          alert('Error al guardar etiqueta');
        }
      }catch(error){
        alert('Error: ' + error.message);
      }
    });

    // ====== ELIMINAR ======
    async function deleteTag(id){
      if(!confirm('¿Eliminar esta etiqueta?')) return;

      try{
        const res = await fetch(`/tags/api/${id}`, { method:'DELETE' });
        if(res.ok){
          location.reload();
        }else{
          alert('Error al eliminar');
        }
      }catch(error){
        alert('Error: ' + error.message);
      }
    }

    // exportar funciones globalmente (para onclick del HTML)
    window.openNewTagModal = openNewTagModal;
    window.closeTagModal   = closeTagModal;
    window.editTag         = editTag;
    window.deleteTag       = deleteTag;
  </script>
</body>
</html>
