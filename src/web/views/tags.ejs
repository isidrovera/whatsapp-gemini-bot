<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind (misma config del dashboard) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary:   { DEFAULT:'#667eea', 600:'#667eea', 700:'#5a67d8' },
            secondary: { DEFAULT:'#764ba2', 600:'#764ba2', 700:'#6b3fa0' },
          },
          boxShadow: {
            soft:'0 4px 6px -1px rgba(0,0,0,.08), 0 2px 4px -1px rgba(0,0,0,.04)',
            card:'0 10px 30px -5px rgba(0,0,0,.10)'
          }
        }
      },
      darkMode:'media'
    }
  </script>

  <!-- Utilidades externas del dashboard -->
  <link rel="stylesheet" href="/css/ui.css">

  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Gradient text */
    .gradient-text {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Icon sizes */
    .icon { width: 1.25rem; height: 1.25rem; }
    .icon-lg { width: 1.75rem; height: 1.75rem; }

    /* Color picker */
    .color-option {
      transition: all 0.2s ease;
    }
    
    .color-option:hover {
      transform: scale(1.1);
    }
    
    .color-option-selected {
      outline: 3px solid #667eea;
      outline-offset: 2px;
      transform: scale(1.15);
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
    }

    .tag-color-dot {
      box-shadow: 0 0 0 2px rgba(255,255,255,0.8), 0 0 8px rgba(0,0,0,0.1);
    }
  </style>
</head>

<body class="h-full bg-gradient-to-br from-slate-50 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 text-slate-800 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-4 focus:py-2 focus:rounded-lg shadow-lg">
    Saltar al contenido
  </a>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Volver al Dashboard + breadcrumb -->
    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <a href="/"
           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">
          <i data-lucide="arrow-left" class="icon"></i>
          <span>Volver al Dashboard</span>
        </a>
      </div>

      <nav aria-label="Breadcrumb" class="text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li class="inline-flex items-center gap-1">
            <a href="/" class="hover:underline inline-flex items-center gap-1">
              <i data-lucide="home" class="w-3.5 h-3.5"></i> Inicio
            </a>
          </li>
          <li class="select-none">/</li>
          <li class="inline-flex items-center gap-1">
            <i data-lucide="tags" class="w-3.5 h-3.5"></i>
            <span class="font-medium">Etiquetas</span>
          </li>
        </ol>
      </nav>
    </div>

    <!-- Header -->
    <header class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight gradient-text flex items-center gap-3">
            <i data-lucide="tags" class="icon-lg text-primary"></i>
            Etiquetas
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            Organiza y clasifica conversaciones con etiquetas personalizadas
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft transition"
            onclick="openNewTagModal()">
            <i data-lucide="plus-circle" class="icon"></i>
            <span>Nueva Etiqueta</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Tip informativo -->
    <section class="rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 border border-blue-200/50 dark:border-blue-800/30 overflow-hidden">
      <div class="px-6 py-4 flex items-start gap-4">
        <div class="w-10 h-10 rounded-lg bg-blue-500/10 dark:bg-blue-500/20 flex items-center justify-center flex-shrink-0">
          <i data-lucide="lightbulb" class="w-5 h-5 text-blue-600 dark:text-blue-400"></i>
        </div>
        <div class="flex-1">
          <h3 class="text-sm font-bold text-blue-900 dark:text-blue-200 mb-1">
            💡 Organiza tus conversaciones
          </h3>
          <p class="text-sm text-blue-800 dark:text-blue-300 leading-relaxed">
            Usa etiquetas para clasificar chats por categorías como 
            <span class="font-semibold">VIP</span>, 
            <span class="font-semibold">Urgente</span>, 
            <span class="font-semibold">Seguimiento</span>, o 
            <span class="font-semibold">Resuelto</span>. 
            Personaliza colores para identificarlas fácilmente.
          </p>
        </div>
      </div>
    </section>

    <!-- Lista de Etiquetas -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center">
            <i data-lucide="list" class="icon text-blue-600 dark:text-blue-400"></i>
          </div>
          Etiquetas Disponibles
          <% if (tags && tags.length > 0) { %>
            <span class="ml-auto text-sm font-normal text-slate-500 dark:text-slate-400">
              <%= tags.length %> <%= tags.length === 1 ? 'etiqueta' : 'etiquetas' %>
            </span>
          <% } %>
        </h2>
      </div>

      <div class="p-6">
        <% if (tags && tags.length > 0) { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            <% tags.forEach(tag => { %>
              <div class="relative rounded-xl border shadow-card p-5 bg-white dark:bg-slate-900
                         transition hover:shadow-lg hover:border-indigo-400/60 hover:bg-slate-50/60 dark:hover:bg-white/5
                         border-slate-200/70 dark:border-slate-700/70">
                
                <!-- Header con color y nombre -->
                <div class="flex items-start gap-3 mb-3">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 tag-color-dot"
                       style="background:<%= tag.color || '#3b82f6' %>;">
                    <i data-lucide="tag" class="w-5 h-5 text-white"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-base font-bold text-slate-900 dark:text-white truncate">
                      <%= tag.name %>
                    </div>
                    <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                      Color: <%= tag.color || '#3b82f6' %>
                    </div>
                  </div>
                </div>

                <!-- Descripción -->
                <% if (tag.description) { %>
                  <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4 line-clamp-2">
                    <%= tag.description %>
                  </p>
                <% } else { %>
                  <p class="text-sm text-slate-400 dark:text-slate-500 italic mb-4">
                    Sin descripción
                  </p>
                <% } %>

                <!-- Preview badge -->
                <div class="mb-4">
                  <div class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs font-semibold"
                       style="background:<%= tag.color %>20; color:<%= tag.color %>;">
                    <i data-lucide="tag" class="w-3 h-3"></i>
                    <%= tag.name %>
                  </div>
                </div>

                <!-- Acciones -->
                <div class="flex flex-wrap gap-2 pt-3 border-t border-slate-200/70 dark:border-slate-700/70">
                  <button
                    class="inline-flex items-center gap-1 rounded-lg bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                    onclick="editTag('<%= tag.id %>')">
                    <i data-lucide="edit-2" class="w-3.5 h-3.5"></i>
                    <span>Editar</span>
                  </button>

                  <button
                    class="inline-flex items-center gap-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                    onclick="deleteTag('<%= tag.id %>')">
                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    <span>Eliminar</span>
                  </button>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-16">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
              <i data-lucide="inbox" class="icon-lg text-slate-400"></i>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">No hay etiquetas configuradas</p>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Crea una nueva para comenzar a organizar tus conversaciones</p>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <!-- Modal Crear/Editar Etiqueta -->
  <div id="tag-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-lg w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between sticky top-0 bg-white dark:bg-slate-900 z-10">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="tag" class="icon text-primary"></i>
          <span id="tag-modal-title">Nueva Etiqueta</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="closeTagModal()">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6">
        <form id="tagForm" class="space-y-5">
          <input type="hidden" id="tagId"/>

          <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
              Nombre *
            </label>
            <input
              type="text"
              id="tagName"
              required
              placeholder="ej: VIP, Urgente, Seguimiento"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 transition"/>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
              Descripción
            </label>
            <textarea
              id="tagDescription"
              rows="3"
              placeholder="Descripción opcional..."
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 transition min-h-[80px]"></textarea>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
              Color de la etiqueta
            </label>

            <input
              type="text"
              id="tagColor"
              readonly
              value="#3b82f6"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-2.5 text-sm font-mono cursor-default mb-3"/>

            <div class="flex flex-wrap gap-3" id="colorPicker">
              <div class="w-12 h-12 rounded-xl cursor-pointer color-option shadow-soft"
                   style="background:#3b82f6;"
                   data-color="#3b82f6"
                   title="Azul">
              </div>
              <div class="w-12 h-12 rounded-xl cursor-pointer color-option shadow-soft"
                   style="background:#10b981;"
                   data-color="#10b981"
                   title="Verde">
              </div>
              <div class="w-12 h-12 rounded-xl cursor-pointer color-option shadow-soft"
                   style="background:#f59e0b;"
                   data-color="#f59e0b"
                   title="Ámbar">
              </div>
              <div class="w-12 h-12 rounded-xl cursor-pointer color-option shadow-soft"
                   style="background:#ef4444;"
                   data-color="#ef4444"
                   title="Rojo">
              </div>
              <div class="w-12 h-12 rounded-xl cursor-pointer color-option shadow-soft"
                   style="background:#8b5cf6;"
                   data-color="#8b5cf6"
                   title="Violeta">
              </div>
              <div class="w-12 h-12 rounded-xl cursor-pointer color-option shadow-soft"
                   style="background:#ec4899;"
                   data-color="#ec4899"
                   title="Rosa">
              </div>
              <div class="w-12 h-12 rounded-xl cursor-pointer color-option shadow-soft"
                   style="background:#14b8a6;"
                   data-color="#14b8a6"
                   title="Teal">
              </div>
              <div class="w-12 h-12 rounded-xl cursor-pointer color-option shadow-soft"
                   style="background:#64748b;"
                   data-color="#64748b"
                   title="Gris">
              </div>
            </div>

            <!-- Preview -->
            <div class="mt-4 p-4 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
              <div class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">
                Vista previa
              </div>
              <div id="tagPreview" class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs font-semibold"
                   style="background:#3b82f620; color:#3b82f6;">
                <i data-lucide="tag" class="w-3 h-3"></i>
                <span id="previewText">Nueva Etiqueta</span>
              </div>
            </div>
          </div>

          <div class="flex justify-end gap-2 pt-2 border-t border-slate-200 dark:border-slate-700">
            <button
              type="button"
              class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition"
              onclick="closeTagModal()">
              Cancelar
            </button>

            <button
              type="submit"
              class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition">
              <i data-lucide="save" class="w-4 h-4"></i>
              Guardar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    // Iconos
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
    });

    // === Refs
    const tagModal = 'tag-modal';
    const tagTitleEl = document.getElementById('tag-modal-title');
    const tagIdEl = document.getElementById('tagId');
    const tagNameEl = document.getElementById('tagName');
    const tagDescEl = document.getElementById('tagDescription');
    const tagColorEl = document.getElementById('tagColor');
    const tagPreviewEl = document.getElementById('tagPreview');
    const previewTextEl = document.getElementById('previewText');

    // === Modal helpers
    function openFlex(id){ 
      const el = document.getElementById(id); 
      el.classList.remove('hidden'); 
      el.classList.add('flex'); 
    }
    function closeFlex(id){ 
      const el = document.getElementById(id); 
      el.classList.remove('flex'); 
      el.classList.add('hidden'); 
    }

    // === Selector de color
    function markSelectedColor(hex){
      const nodes = document.querySelectorAll('#colorPicker .color-option');
      nodes.forEach(n => {
        n.classList.remove('color-option-selected');
        if(n.getAttribute('data-color') === hex){
          n.classList.add('color-option-selected');
        }
      });
    }

    function updatePreview(){
      const color = tagColorEl.value;
      const name = tagNameEl.value || 'Nueva Etiqueta';
      
      tagPreviewEl.style.background = color + '20';
      tagPreviewEl.style.color = color;
      previewTextEl.textContent = name;
      
      // Reiniciar iconos en el preview
      if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
    }

    document.querySelectorAll('#colorPicker .color-option').forEach(div => {
      div.addEventListener('click', (ev) => {
        const c = ev.currentTarget.getAttribute('data-color');
        tagColorEl.value = c;
        markSelectedColor(c);
        updatePreview();
      });
    });

    // Actualizar preview al escribir nombre
    tagNameEl.addEventListener('input', updatePreview);

    // === Nueva etiqueta
    function openNewTagModal(){
      tagIdEl.value = '';
      tagNameEl.value = '';
      tagDescEl.value = '';
      tagColorEl.value = '#3b82f6';
      tagTitleEl.textContent = 'Nueva Etiqueta';

      markSelectedColor('#3b82f6');
      updatePreview();
      openFlex(tagModal);
    }

    function closeTagModal(){
      closeFlex(tagModal);
    }

    // === Editar etiqueta
    async function editTag(id){
      try{
        const res = await fetch(`/tags/api/${id}`);
        const tag = await res.json();

        tagIdEl.value = tag.id || '';
        tagNameEl.value = tag.name || '';
        tagDescEl.value = tag.description || '';
        tagColorEl.value = tag.color || '#3b82f6';
        tagTitleEl.textContent = 'Editar Etiqueta';

        markSelectedColor(tag.color || '#3b82f6');
        updatePreview();
        openFlex(tagModal);
      }catch(err){
        alert('❌ Error al cargar la etiqueta');
        console.error(err);
      }
    }

    // === Guardar
    document.getElementById('tagForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const id = tagIdEl.value;
      const data = {
        name: tagNameEl.value.trim(),
        description: tagDescEl.value.trim(),
        color: tagColorEl.value
      };

      if (!data.name) {
        alert('El nombre es obligatorio');
        return;
      }

      try{
        const url = id ? `/tags/api/${id}` : '/tags/api';
        const method = id ? 'PUT' : 'POST';

        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if(res.ok){
          alert('✅ Etiqueta guardada');
          location.reload();
        } else {
          alert('❌ Error al guardar etiqueta');
        }
      }catch(error){
        alert('❌ Error: ' + error.message);
      }
    });

    // === Eliminar
    async function deleteTag(id){
      if(!confirm('¿Eliminar esta etiqueta? Esta acción no se puede deshacer.')) return;

      try{
        const res = await fetch(`/tags/api/${id}`, { method: 'DELETE' });
        if(res.ok){
          alert('✅ Etiqueta eliminada');
          location.reload();
        } else {
          alert('❌ No se pudo eliminar la etiqueta');
        }
      }catch(error){
        alert('❌ Error: ' + error.message);
      }
    }

    // Cerrar modales al click fuera
    window.addEventListener('click', (e) => {
      const m = document.getElementById(tagModal);
      if (e.target === m) closeFlex(tagModal);
    });

    // Exponer funciones
    window.openNewTagModal = openNewTagModal;
    window.closeTagModal = closeTagModal;
    window.editTag = editTag;
    window.deleteTag = deleteTag;
  </script>
</body>
</html>