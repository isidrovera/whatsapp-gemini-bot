    async function unblock(identifier) {
      if (!confirm('¿Eliminar esta restricción?')) return;

      try {
        const res = await fetch(`/blocked/api/${identifier}`, {
          method: 'DELETE'
        });

        const data = await res.json();

        if (data.success) {
          alert('✅ Eliminado');
          location.reload();
        } else {
          alert('❌ Error');
        }
      } catch (error) {
        alert('❌ Error');
      }
    }

    function showModal(id){
      const el = document.getElementById(id);
      el.classList.remove('hidden');
      el.classList.add('flex');
    }
    
    function hideModal(id){
      const el = document.getElementById(id);
      el.classList.remove('flex');
      el.classList.add('hidden');
      if (id === 'addModal') {
        document.getElementById('identifier').value = '';
        document.getElementById('type').value = '';
        document.getElementById('accessLevel').value = 'STANDARD';
        document.getElementById('reason').value = '';
      }
    }
    
    window.addEventListener('click', (e) => {
      const modal = document.getElementById('addModal');
      if (e.target === modal) hideModal('addModal');
    });
    // Permisos por nivel de acceso
const ACCESS_PERMISSIONS = {
  BLOCKED: { odoo: false, tickets: false, history: false, human: false, ai: false, autoresponse: false },
  RESTRICTED: { odoo: false, tickets: false, history: false, human: false, ai: false, autoresponse: true },
  LIMITED: { odoo: false, tickets: false, history: false, human: true, ai: true, autoresponse: true },
  STANDARD: { odoo: true, tickets: true, history: false, human: true, ai: true, autoresponse: true },
  FULL: { odoo: true, tickets: true, history: true, human: true, ai: true, autoresponse: true },
  VIP: { odoo: true, tickets: true, history: true, human: true, ai: true, autoresponse: true }
};

// Abrir modal de edición
async function editPermissions(identifier) {
  try {
    // Cargar permisos actuales
    const response = await fetch(`/blocked/api/permissions/${identifier}`);
    const data = await response.json();

    // Llenar el formulario
    document.getElementById('editIdentifier').value = decodeURIComponent(identifier);
    document.getElementById('editIdentifierDisplay').textContent = decodeURIComponent(identifier);
    document.getElementById('editAccessLevel').value = data.accessLevel || 'STANDARD';
    document.getElementById('editReason').value = data.reason || '';
    document.getElementById('editNotes').value = data.notes || '';

    // Cargar permisos
    document.getElementById('permOdoo').checked = data.permissions.odoo ?? true;
    document.getElementById('permTickets').checked = data.permissions.tickets ?? true;
    document.getElementById('permHistory').checked = data.permissions.history ?? false;
    document.getElementById('permHuman').checked = data.permissions.human ?? true;
    document.getElementById('permAI').checked = data.permissions.ai ?? true;
    document.getElementById('permAutoResponse').checked = data.permissions.autoresponse ?? true;

    // Deshabilitar custom perms por defecto
    document.getElementById('enableCustomPerms').checked = false;
    document.getElementById('customPermsContainer').classList.add('opacity-50', 'pointer-events-none');

    showModal('editModal');
    
    // Reiniciar iconos
    setTimeout(() => {
      if (window.lucide) lucide.createIcons();
    }, 100);
  } catch (error) {
    alert('❌ Error al cargar permisos');
    console.error(error);
  }
}

// Toggle permisos personalizados
function toggleCustomPermissions() {
  const enabled = document.getElementById('enableCustomPerms').checked;
  const container = document.getElementById('customPermsContainer');

  if (enabled) {
    container.classList.remove('opacity-50', 'pointer-events-none');
  } else {
    container.classList.add('opacity-50', 'pointer-events-none');
    updatePermissionsPreview();
  }
}

// Actualizar permisos basados en el nivel seleccionado
function updatePermissionsPreview() {
  const customEnabled = document.getElementById('enableCustomPerms').checked;
  if (customEnabled) return;

  const level = document.getElementById('editAccessLevel').value;
  const perms = ACCESS_PERMISSIONS[level] || ACCESS_PERMISSIONS.STANDARD;

  document.getElementById('permOdoo').checked = perms.odoo;
  document.getElementById('permTickets').checked = perms.tickets;
  document.getElementById('permHistory').checked = perms.history;
  document.getElementById('permHuman').checked = perms.human;
  document.getElementById('permAI').checked = perms.ai;
  document.getElementById('permAutoResponse').checked = perms.autoresponse;
}

// Guardar permisos
async function savePermissions(event) {
  event.preventDefault();

  const identifier = document.getElementById('editIdentifier').value;
  const accessLevel = document.getElementById('editAccessLevel').value;
  const reason = document.getElementById('editReason').value.trim();
  const notes = document.getElementById('editNotes').value.trim();
  const customEnabled = document.getElementById('enableCustomPerms').checked;

  try {
    // Actualizar nivel de acceso
    await fetch(`/blocked/api/${encodeURIComponent(identifier)}/access-level`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ accessLevel, reason })
    });

    // Si tiene permisos custom, actualizarlos
    if (customEnabled) {
      const permissions = {
        canUseOdoo: document.getElementById('permOdoo').checked,
        canCreateTickets: document.getElementById('permTickets').checked,
        canSeeHistory: document.getElementById('permHistory').checked,
        canTalkToHuman: document.getElementById('permHuman').checked,
        canUseAI: document.getElementById('permAI').checked,
        canUseAutoResponse: document.getElementById('permAutoResponse').checked
      };

      await fetch(`/blocked/api/${encodeURIComponent(identifier)}/permissions`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(permissions)
      });
    }

    alert('✅ Permisos actualizados');
    location.reload();
  } catch (error) {
    alert('❌ Error al guardar permisos');
    console.error(error);
  }
}
