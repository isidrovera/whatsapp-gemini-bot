<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente + Tailwind -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'media',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          boxShadow: {
            soft: '0 10px 25px -10px rgba(0,0,0,.15)',
            card: '0 25px 60px -10px rgba(0,0,0,.45)'
          },
          colors: {
            primary: { DEFAULT:'#1e3a8a', 700:'#1e40af' },
            brandA: '#667eea',
            brandB: '#764ba2',
          }
        }
      }
    };
  </script>

  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration:.001ms!important;
        animation-iteration-count:1!important;
        transition-duration:.001ms!important;
        scroll-behavior:auto!important
      }
    }
  </style>
</head>
<body class="h-full bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-3 focus:py-2 focus:rounded-lg shadow">
    Saltar al contenido
  </a>

  <div class="min-h-screen w-full flex">
    <!-- SIDEBAR -->
    <aside class="hidden md:flex w-[280px] flex-col bg-gradient-to-b from-primary to-primary-700 text-white shadow-soft">
      <!-- Header -->
      <div class="px-5 py-6 border-b border-white/10 bg-white/5 backdrop-blur">
        <h2 class="text-xl font-semibold flex items-center gap-2">
          <i data-lucide="bot" class="w-5 h-5"></i>
          Bot Admin
        </h2>
      </div>

      <!-- Nav -->
      <nav class="py-4 flex-1 overflow-y-auto">
        <ul class="px-2 space-y-1 text-[15px] leading-tight font-medium">
          <li>
            <a href="/" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition">
              <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
              Dashboard
            </a>
          </li>
          <li>
            <a href="/contacts" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition">
              <i data-lucide="users" class="w-5 h-5"></i>
              Contactos
            </a>
          </li>
          <li>
            <a href="/conversations" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition">
              <i data-lucide="message-circle" class="w-5 h-5"></i>
              Conversaciones
            </a>
          </li>
          <li>
            <a href="/blocked" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition">
              <i data-lucide="ban" class="w-5 h-5"></i>
              Bloqueados
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/calendar" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition">
              <i data-lucide="calendar" class="w-5 h-5"></i>
              Calendario
            </a>
          </li>
          <li>
            <a href="/working-hours" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition">
              <i data-lucide="clock" class="w-5 h-5"></i>
              Horarios
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/departments" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition">
              <i data-lucide="building-2" class="w-5 h-5"></i>
              Departamentos
            </a>
          </li>
          <li>
            <a href="/products" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition">
              <i data-lucide="package" class="w-5 h-5"></i>
              Productos
            </a>
          </li>
          <li>
            <a href="/auto-responses" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition">
              <i data-lucide="bot-message-square" class="w-5 h-5"></i>
              Respuestas Auto
            </a>
          </li>
          <li>
            <a href="/tags" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition">
              <i data-lucide="tag" class="w-5 h-5"></i>
              Etiquetas
            </a>
          </li>
          <li>
            <a href="/templates" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition">
              <i data-lucide="file-text" class="w-5 h-5"></i>
              Plantillas
            </a>
          </li>
          <li>
            <a href="/metrics" class="group flex items-center gap-3 rounded-lg px-3 py-2 bg-white/10 text-white transition">
              <i data-lucide="chart-line" class="w-5 h-5"></i>
              Métricas
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/admin-users" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition">
              <i data-lucide="shield" class="w-5 h-5"></i>
              Usuarios Admin
            </a>
          </li>
          <li>
            <a href="/settings" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition">
              <i data-lucide="settings" class="w-5 h-5"></i>
              Configuración
            </a>
          </li>
        </ul>
      </nav>

      <!-- Footer Sidebar -->
      <div class="mt-auto p-4 bg-white/5 border-t border-white/10">
        <div class="rounded-xl bg-white/10 p-3">
          <div class="text-[11px] uppercase tracking-wide opacity-80">
            Sesión activa
          </div>
          <div class="font-semibold text-sm mt-1 flex items-center gap-2">
            <i data-lucide="user" class="w-4 h-4"></i>
            <%= user || 'Admin' %>
          </div>
        </div>

        <form method="POST" action="/auth/logout" class="mt-3">
          <button
            type="submit"
            class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-white/20 bg-red-500/20 hover:bg-red-500/30 text-white py-2.5 text-sm font-semibold transition"
          >
            <i data-lucide="log-out" class="w-4 h-4"></i>
            Cerrar sesión
          </button>
        </form>
      </div>
    </aside>

    <!-- MAIN -->
    <main id="main" class="flex-1 p-4 md:p-8">
      <!-- Header principal -->
      <header class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft px-6 py-5 mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white flex items-center gap-3">
          <i data-lucide="chart-line" class="w-7 h-7 text-primary"></i>
          Métricas y Análisis
        </h1>

        <button
          class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 text-sm font-semibold transition"
          onclick="exportReport()"
        >
          <i data-lucide="download" class="w-4 h-4"></i>
          Exportar Reporte
        </button>
      </header>

      <!-- Filtros -->
      <section class="rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-slate-900 shadow-soft p-6 mb-6">
        <div class="grid gap-4 md:grid-cols-5">
          <div class="flex flex-col">
            <label class="text-[13px] font-semibold text-slate-700 dark:text-slate-200 mb-1">Desde</label>
            <input
              type="date"
              id="dateFrom"
              value="<%= dateFrom %>"
              class="rounded-lg border border-slate-300 dark:border-white/10 bg-white dark:bg-slate-950 px-3 py-2 text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-4 focus:ring-sky-200 dark:focus:ring-sky-900/40"
            />
          </div>

          <div class="flex flex-col">
            <label class="text-[13px] font-semibold text-slate-700 dark:text-slate-200 mb-1">Hasta</label>
            <input
              type="date"
              id="dateTo"
              value="<%= dateTo %>"
              class="rounded-lg border border-slate-300 dark:border-white/10 bg-white dark:bg-slate-950 px-3 py-2 text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-4 focus:ring-sky-200 dark:focus:ring-sky-900/40"
            />
          </div>

          <div class="flex flex-col md:col-span-2">
            <label class="text-[13px] font-semibold text-slate-700 dark:text-slate-200 mb-1">Departamento</label>
            <select
              id="departmentFilter"
              class="rounded-lg border border-slate-300 dark:border-white/10 bg-white dark:bg-slate-950 px-3 py-2 text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-4 focus:ring-sky-200 dark:focus:ring-sky-900/40"
            >
              <option value="">Todos</option>
              <% if (departments && departments.length > 0) { %>
                <% departments.forEach(dept => { %>
                  <option value="<%= dept.id %>"><%= dept.name %></option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <div class="flex items-end">
            <button
              class="inline-flex items-center justify-center w-full rounded-lg bg-sky-600 hover:bg-sky-700 text-white px-4 py-2.5 text-sm font-semibold transition shadow-sm shadow-sky-600/20"
              onclick="applyFilters()"
            >
              <i data-lucide="filter" class="w-4 h-4 mr-2"></i>
              Aplicar
            </button>
          </div>
        </div>
      </section>

      <!-- KPIs / Stats -->
      <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4 mb-6">
        <!-- Total Conversaciones -->
        <article class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 shadow-soft p-5 flex">
          <div class="mr-4 flex-shrink-0 rounded-xl bg-gradient-to-br from-sky-500 to-blue-600 text-white w-12 h-12 flex items-center justify-center text-xl font-bold shadow-lg shadow-blue-600/30">💬</div>
          <div class="flex flex-col">
            <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Total Conversaciones</span>
            <span class="text-3xl font-bold text-slate-900 dark:text-white"><%= stats.totalConversations || 0 %></span>
            <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">↗ +12% vs mes anterior</span>
          </div>
        </article>

        <!-- Resueltas -->
        <article class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 shadow-soft p-5 flex">
          <div class="mr-4 flex-shrink-0 rounded-xl bg-gradient-to-br from-emerald-500 to-green-600 text-white w-12 h-12 flex items-center justify-center text-xl font-bold shadow-lg shadow-emerald-600/30">✅</div>
          <div class="flex flex-col">
            <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Resueltas</span>
            <span class="text-3xl font-bold text-slate-900 dark:text-white"><%= stats.resolved || 0 %></span>
            <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">↗ +8% vs mes anterior</span>
          </div>
        </article>

        <!-- Tiempo Promedio -->
        <article class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 shadow-soft p-5 flex">
          <div class="mr-4 flex-shrink-0 rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 text-white w-12 h-12 flex items-center justify-center text-xl font-bold shadow-lg shadow-orange-600/30">⏱️</div>
          <div class="flex flex-col">
            <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Tiempo Promedio</span>
            <span class="text-3xl font-bold text-slate-900 dark:text-white"><%= stats.avgResponseTime || '0m' %></span>
            <span class="text-xs font-medium text-rose-600 dark:text-rose-400">↘ -5% vs mes anterior</span>
          </div>
        </article>

        <!-- Satisfacción -->
        <article class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 shadow-soft p-5 flex">
          <div class="mr-4 flex-shrink-0 rounded-xl bg-gradient-to-br from-purple-500 to-violet-600 text-white w-12 h-12 flex items-center justify-center text-xl font-bold shadow-lg shadow-violet-600/30">😊</div>
          <div class="flex flex-col">
            <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Satisfacción</span>
            <span class="text-3xl font-bold text-slate-900 dark:text-white"><%= stats.satisfaction || '0%' %></span>
            <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">↗ +3% vs mes anterior</span>
          </div>
        </article>
      </section>

      <!-- Gráficos -->
      <section class="grid gap-6 lg:grid-cols-2 mb-6">
        <!-- Conversaciones por Día -->
        <article class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 shadow-soft p-6">
          <header class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
              <span class="text-xl">📈</span>
              <span>Conversaciones por Día</span>
            </h2>
          </header>
          <div class="h-[260px] flex items-center justify-center rounded-xl bg-slate-50 dark:bg-slate-800/40 text-slate-400 text-sm border border-dashed border-slate-300 dark:border-slate-700">
            Gráfico de líneas (Chart.js)
          </div>
        </article>

        <!-- Conversaciones por Departamento -->
        <article class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 shadow-soft p-6">
          <header class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
              <span class="text-xl">🥧</span>
              <span>Conversaciones por Departamento</span>
            </h2>
          </header>
          <div class="h-[260px] flex items-center justify-center rounded-xl bg-slate-50 dark:bg-slate-800/40 text-slate-400 text-sm border border-dashed border-slate-300 dark:border-slate-700">
            Gráfico circular (Chart.js)
          </div>
        </article>
      </section>

      <!-- Top Productos -->
      <section class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 shadow-soft p-6 mb-6">
        <header class="mb-5 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="text-xl">🏆</span>
            <span>Top 5 Productos Consultados</span>
          </h2>
        </header>

        <% if (topProducts && topProducts.length > 0) { %>
          <ul class="space-y-2">
            <% topProducts.slice(0, 5).forEach((product, index) => { %>
              <li class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-white/10 bg-white dark:bg-slate-950/40 px-4 py-3 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
                <div class="flex items-center gap-3">
                  <div class="flex items-center justify-center w-9 h-9 rounded-full bg-sky-600 text-white font-semibold shadow-md shadow-sky-600/30 text-sm">
                    <%= index + 1 %>
                  </div>
                  <div>
                    <div class="font-semibold text-slate-900 dark:text-white text-sm"><%= product.name %></div>
                    <div class="text-xs text-slate-500 dark:text-slate-400">
                      📂 <%= product.category %>
                    </div>
                  </div>
                </div>
                <div class="text-right text-sky-600 dark:text-sky-400 text-lg font-bold tabular-nums">
                  <%= product.consultations || 0 %>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <div class="text-center py-10 text-slate-500 dark:text-slate-400">
            <div class="text-5xl mb-3">📦</div>
            <div class="text-sm font-medium">No hay datos de productos consultados</div>
          </div>
        <% } %>
      </section>

      <!-- Top Keywords -->
      <section class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 shadow-soft p-6 mb-6">
        <header class="mb-5 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="text-xl">🔑</span>
            <span>Palabras Clave Más Usadas</span>
          </h2>
        </header>

        <% if (topKeywords && topKeywords.length > 0) { %>
          <ul class="space-y-2">
            <% topKeywords.slice(0, 10).forEach((kw, index) => { %>
              <li class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-white/10 bg-white dark:bg-slate-950/40 px-4 py-3 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
                <div class="flex items-center gap-3">
                  <div class="flex items-center justify-center w-9 h-9 rounded-full bg-violet-600 text-white font-semibold shadow-md shadow-violet-600/30 text-sm">
                    <%= index + 1 %>
                  </div>
                  <div>
                    <div class="font-semibold text-slate-900 dark:text-white text-sm"><%= kw.keyword %></div>
                    <div class="text-xs text-slate-500 dark:text-slate-400">
                      🏷️ <%= kw.category || 'General' %>
                    </div>
                  </div>
                </div>
                <div class="text-right text-violet-600 dark:text-violet-400 text-lg font-bold tabular-nums">
                  <%= kw.count || 0 %>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <div class="text-center py-10 text-slate-500 dark:text-slate-400">
            <div class="text-5xl mb-3">🔑</div>
            <div class="text-sm font-medium">No hay datos de palabras clave</div>
          </div>
        <% } %>
      </section>

      <!-- Actividad Reciente -->
      <section class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 shadow-soft p-6 mb-6 overflow-x-auto">
        <header class="mb-5 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="text-xl">🕐</span>
            <span>Actividad Reciente</span>
          </h2>
        </header>

        <% if (recentActivity && recentActivity.length > 0) { %>
          <table class="min-w-full text-left text-sm">
            <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-600 dark:text-slate-300 text-[11px] uppercase tracking-wide font-semibold">
              <tr>
                <th class="px-3 py-2.5">Fecha/Hora</th>
                <th class="px-3 py-2.5">Contacto</th>
                <th class="px-3 py-2.5">Departamento</th>
                <th class="px-3 py-2.5">Tipo</th>
                <th class="px-3 py-2.5">Estado</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-white/10 text-slate-700 dark:text-slate-200">
              <% recentActivity.forEach(activity => { %>
                <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition">
                  <td class="px-3 py-2 align-top text-xs md:text-sm text-slate-600 dark:text-slate-400">
                    <%= new Date(activity.timestamp).toLocaleString('es-PE') %>
                  </td>
                  <td class="px-3 py-2 align-top text-xs md:text-sm font-semibold text-slate-800 dark:text-slate-100">
                    <%= activity.contactName || activity.phoneNumber %>
                  </td>
                  <td class="px-3 py-2 align-top text-xs md:text-sm text-slate-700 dark:text-slate-200">
                    <%= activity.department || '-' %>
                  </td>
                  <td class="px-3 py-2 align-top text-xs md:text-sm text-slate-700 dark:text-slate-200">
                    <%= activity.type || 'Consulta' %>
                  </td>
                  <td class="px-3 py-2 align-top text-xs md:text-sm">
                    <% const st = activity.status; %>
                    <span class="
                      inline-flex items-center rounded-md px-2 py-1 text-[11px] font-semibold
                      <%= st === 'resolved'
                          ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300'
                          : st === 'pending'
                          ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300'
                          : 'bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300'
                      %>
                    ">
                      <%= st === 'resolved' ? 'Resuelto' : st === 'pending' ? 'Pendiente' : 'En proceso' %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="text-center py-10 text-slate-500 dark:text-slate-400">
            <div class="text-5xl mb-3">📋</div>
            <div class="text-sm font-medium">No hay actividad reciente</div>
          </div>
        <% } %>
      </section>

      <!-- Tiempos de respuesta por Departamento -->
      <section class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 shadow-soft p-6 mb-10 overflow-x-auto">
        <header class="mb-5 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="text-xl">⏱️</span>
            <span>Tiempo de Respuesta por Departamento</span>
          </h2>
        </header>

        <% if (responseTimesByDept && responseTimesByDept.length > 0) { %>
          <table class="min-w-full text-left text-sm">
            <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-600 dark:text-slate-300 text-[11px] uppercase tracking-wide font-semibold">
              <tr>
                <th class="px-3 py-2.5">Departamento</th>
                <th class="px-3 py-2.5">Tiempo Promedio</th>
                <th class="px-3 py-2.5">Total Conversaciones</th>
                <th class="px-3 py-2.5">Eficiencia</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-white/10 text-slate-700 dark:text-slate-200">
              <% responseTimesByDept.forEach(dept => { %>
                <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition">
                  <td class="px-3 py-2 align-top text-xs md:text-sm font-semibold text-slate-800 dark:text-slate-100">
                    <%= dept.name %>
                  </td>
                  <td class="px-3 py-2 align-top text-xs md:text-sm text-slate-700 dark:text-slate-200">
                    <%= dept.avgTime || '0m' %>
                  </td>
                  <td class="px-3 py-2 align-top text-xs md:text-sm text-slate-700 dark:text-slate-200">
                    <%= dept.total || 0 %>
                  </td>
                  <td class="px-3 py-2 align-top text-xs md:text-sm">
                    <% const eff = dept.efficiency || 0; %>
                    <span class="
                      inline-flex items-center rounded-md px-2 py-1 text-[11px] font-semibold
                      <%= eff >= 80
                        ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300'
                        : eff >= 60
                        ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300'
                        : 'bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300'
                      %>
                    ">
                      <%= eff %>%
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="text-center py-10 text-slate-500 dark:text-slate-400">
            <div class="text-5xl mb-3">⏱️</div>
            <div class="text-sm font-medium">No hay datos de tiempo de respuesta</div>
          </div>
        <% } %>
      </section>
    </main>
  </div>

  <script>
    // Iconos lucide
    window.lucide && lucide.createIcons();

    function applyFilters() {
      const dateFrom = document.getElementById('dateFrom').value;
      const dateTo = document.getElementById('dateTo').value;
      const department = document.getElementById('departmentFilter').value;

      const params = new URLSearchParams();
      if (dateFrom) params.append('from', dateFrom);
      if (dateTo) params.append('to', dateTo);
      if (department) params.append('department', department);

      window.location.href = '/metrics?' + params.toString();
    }

    async function exportReport() {
      const dateFrom = document.getElementById('dateFrom').value;
      const dateTo = document.getElementById('dateTo').value;
      const department = document.getElementById('departmentFilter').value;

      const params = new URLSearchParams();
      if (dateFrom) params.append('from', dateFrom);
      if (dateTo) params.append('to', dateTo);
      if (department) params.append('department', department);

      try {
        const res = await fetch('/metrics/api/export?' + params.toString());
        const blob = await res.blob();

        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `reporte-${dateFrom || 'inicio'}-${dateTo || 'hoy'}.csv`;
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(url);
        document.body.removeChild(a);
      } catch (error) {
        alert('Error al exportar reporte: ' + error.message);
      }
    }

    // Auto-refresh cada 5 minutos
    setTimeout(() => {
      location.reload();
    }, 5 * 60 * 1000);
  </script>
</body>
</html>
