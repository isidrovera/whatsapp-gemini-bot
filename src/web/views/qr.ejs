<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Conectar WhatsApp - Bot Admin</title>

  <!-- Fuente + Tailwind -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'media',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            wa: {
              light: '#25D366',
              dark: '#128C7E'
            },
            primary: {
              DEFAULT:'#1e3a8a',
              700:'#1e40af'
            }
          },
          boxShadow: {
            card: '0 20px 60px rgba(0,0,0,.35)',
          },
          keyframes: {
            spin: { to: { transform: 'rotate(360deg)' } },
            fadeInPop: {
              '0%': { opacity:0, transform:'scale(.95) translateY(8px)' },
              '100%': { opacity:1, transform:'scale(1) translateY(0)' }
            }
          },
          animation: {
            spin: 'spin 1s linear infinite',
            fadeInPop: 'fadeInPop .4s ease-out forwards'
          }
        }
      }
    };
  </script>

  <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body class="h-full bg-gradient-to-br from-indigo-500 via-indigo-500 to-violet-600 dark:from-slate-900 dark:via-slate-900 dark:to-slate-800 flex items-center justify-center p-4 text-slate-800 dark:text-slate-100 font-sans">
  <main class="w-full max-w-lg rounded-2xl bg-white/90 dark:bg-slate-900/80 backdrop-blur-xl shadow-card border border-white/20 dark:border-white/10 animate-fadeInPop overflow-hidden">
    <!-- HEADER -->
    <header class="bg-gradient-to-r from-wa.light to-wa.dark text-white px-6 py-6 text-center dark:from-wa.dark dark:to-emerald-700">
      <h1 class="text-xl font-semibold flex items-center justify-center gap-2">
        <i data-lucide="smartphone" class="w-5 h-5"></i>
        Conectar WhatsApp
      </h1>
      <p class="text-sm text-white/90 mt-1">Escanea el código QR con tu teléfono</p>
    </header>

    <!-- BODY -->
    <section class="px-6 py-8 text-center space-y-6">
      <div id="statusContainer">
        <% if (isConnected) { %>
          <!-- Conectado -->
          <div class="flex flex-col items-center gap-3">
            <div class="flex items-center gap-2 rounded-lg bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300 px-3 py-2 text-sm font-semibold">
              <i data-lucide="check-circle" class="w-4 h-4"></i>
              <span>WhatsApp conectado exitosamente</span>
            </div>

            <p class="text-sm text-slate-500 dark:text-slate-400">
              Ya puedes acceder al panel de administración.
            </p>

            <a
              href="/"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 text-sm font-semibold shadow-sm shadow-emerald-600/20 transition"
            >
              <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
              Ir al Dashboard
            </a>
          </div>

        <% } else if (qrDataURL) { %>
          <!-- Esperando escaneo -->
          <div class="flex flex-col items-center gap-4">
            <div class="flex items-center gap-2 rounded-lg bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300 px-3 py-2 text-sm font-semibold">
              <div class="w-4 h-4 border-2 border-amber-500/30 border-t-amber-500 rounded-full animate-spin"></div>
              <span>Esperando escaneo del QR…</span>
            </div>

            <!-- QR -->
            <div class="bg-slate-50 dark:bg-slate-800/50 rounded-xl p-4 border border-slate-200 dark:border-white/10 shadow-inner">
              <img
                id="qrImage"
                src="<%= qrDataURL %>"
                alt="QR Code"
                class="w-64 h-64 object-contain rounded-md"
              />
            </div>

            <!-- instrucciones -->
            <div class="text-left w-full bg-slate-50 dark:bg-slate-800/50 rounded-xl border border-slate-200 dark:border-white/10 p-4 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
              <h3 class="flex items-center gap-2 text-slate-800 dark:text-white font-semibold text-[15px] mb-2">
                <i data-lucide="list-checks" class="w-4 h-4 text-sky-500"></i>
                Instrucciones
              </h3>
              <ol class="list-decimal pl-5 space-y-2">
                <li>Abre <strong class="text-slate-800 dark:text-white font-semibold">WhatsApp</strong> en tu teléfono.</li>
                <li>Ve a <span class="font-semibold">Configuración</span> → <span class="font-semibold">Dispositivos vinculados</span>.</li>
                <li>Toca en <span class="font-semibold">"Vincular un dispositivo"</span>.</li>
                <li>Escanea este código QR.</li>
              </ol>
            </div>

            <p class="text-[12px] text-slate-500 dark:text-slate-400 flex items-center gap-1">
              <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
              Verificando conexión automáticamente…
            </p>
          </div>

        <% } else { %>
          <!-- Error generando QR -->
          <div class="flex flex-col items-center gap-4">
            <div class="flex items-center gap-2 rounded-lg bg-rose-100 text-rose-800 dark:bg-rose-900/30 dark:text-rose-300 px-3 py-2 text-sm font-semibold">
              <i data-lucide="alert-triangle" class="w-4 h-4"></i>
              <span>No se pudo generar el QR</span>
            </div>

            <p class="text-sm text-slate-500 dark:text-slate-400 max-w-sm">
              Verifica que el bot esté ejecutándose correctamente.
            </p>

            <button
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 text-sm font-semibold shadow-sm shadow-indigo-600/20 transition"
              onclick="location.reload()"
            >
              <i data-lucide="refresh-cw" class="w-4 h-4"></i>
              Reintentar
            </button>
          </div>
        <% } %>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="px-6 py-5 bg-slate-50/60 dark:bg-slate-900/50 border-t border-slate-200/60 dark:border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm">
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 w-full sm:w-auto justify-center">
        <button
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 text-sm font-semibold shadow-sm shadow-indigo-600/20 transition w-full sm:w-auto"
          onclick="location.reload()"
        >
          <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
          Actualizar QR
        </button>

        <form method="POST" action="/auth/logout" class="w-full sm:w-auto">
          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-300 dark:border-white/10 bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 px-4 py-2 text-sm font-semibold transition w-full sm:w-auto"
          >
            <i data-lucide="log-out" class="w-4 h-4 text-rose-500"></i>
            Cerrar sesión
          </button>
        </form>
      </div>

      <p class="text-[11px] text-slate-400 dark:text-slate-500 text-center w-full sm:w-auto">
        WhatsApp Bot Admin • Seguro y en vivo 🔒
      </p>
    </footer>
  </main>

  <script>
    // lucide icons
    window.lucide && lucide.createIcons();

    // Poll de estado cada 3s si aún NO está conectado pero sí hay QR
    <% if (!isConnected && qrDataURL) { %>
    setInterval(async () => {
      try {
        const res = await fetch('/auth/api/status');
        const data = await res.json();

        if (data.connected) {
          window.location.href = '/';
          return;
        }

        // Si QR cambió, actualizamos la imagen en vivo
        if (data.qrDataURL && data.qrDataURL !== '<%= qrDataURL %>') {
          const img = document.getElementById('qrImage');
          if (img) img.src = data.qrDataURL;
        }
      } catch (err) {
        console.error('Error checking status:', err);
      }
    }, 3000);
    <% } %>
  </script>
</body>
</html>
