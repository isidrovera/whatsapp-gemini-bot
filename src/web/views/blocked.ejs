<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind (config del dashboard admin) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary:   { DEFAULT:'#667eea', 600:'#667eea', 700:'#5a67d8' },
            secondary: { DEFAULT:'#764ba2', 600:'#764ba2', 700:'#6b3fa0' },
          },
          boxShadow: {
            soft:'0 4px 6px -1px rgba(0,0,0,.08), 0 2px 4px -1px rgba(0,0,0,.04)',
            card:'0 10px 30px -5px rgba(0,0,0,.10)'
          }
        }
      },
      darkMode:'media'
    }
  </script>

  <!-- Utilidades externas del dashboard -->
  <link rel="stylesheet" href="/css/ui.css">

  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Gradient text */
    .gradient-text {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Icon sizes */
    .icon { width: 1.25rem; height: 1.25rem; }
    .icon-lg { width: 1.75rem; height: 1.75rem; }

    /* Import result styles */
    .import-result {
      margin-top: 20px;
      padding: 15px;
      border-radius: 8px;
      font-size: 14px;
    }
    .import-result.success {
      background: #d1fae5;
      border: 1px solid #6ee7b7;
      color: #065f46;
    }
    .import-result.error {
      background: #fee2e2;
      border: 1px solid #fca5a5;
      color: #991b1b;
    }
    .import-result.warning {
      background: #fef3c7;
      border: 1px solid #fcd34d;
      color: #92400e;
    }

    .spinner {
      display: inline-block;
      width: 16px;
      height: 16px;
      border: 2px solid #f3f4f6;
      border-top-color: #3b82f6;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body class="h-full bg-gradient-to-br from-slate-50 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 text-slate-800 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-4 focus:py-2 focus:rounded-lg shadow-lg">
    Saltar al contenido
  </a>

  <%
    const blockedList = Array.isArray(blocked) ? blocked : [];
    const df = new Intl.DateTimeFormat('es-PE', { dateStyle: 'short', timeStyle: 'short' });
    function fmtDate(d){ try { return df.format(new Date(d)); } catch { return '-'; } }
  %>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Volver al Dashboard + breadcrumb -->
    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <a href="/"
           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">
          <i data-lucide="arrow-left" class="icon"></i>
          <span>Volver al Dashboard</span>
        </a>
      </div>

      <nav aria-label="Breadcrumb" class="text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li class="inline-flex items-center gap-1">
            <a href="/" class="hover:underline inline-flex items-center gap-1">
              <i data-lucide="home" class="w-3.5 h-3.5"></i> Inicio
            </a>
          </li>
          <li class="select-none">/</li>
          <li class="inline-flex items-center gap-1">
            <i data-lucide="ban" class="w-3.5 h-3.5"></i>
            <span class="font-medium">Bloqueados</span>
          </li>
        </ol>
      </nav>
    </div>

    <!-- Header -->
    <header class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight gradient-text flex items-center gap-3">
            <i data-lucide="ban" class="icon-lg text-primary"></i>
            Bloqueados
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Gestión de números y grupos bloqueados</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button class="inline-flex items-center gap-2 rounded-xl bg-slate-600 hover:bg-slate-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft"
                  onclick="exportToExcel()">
            <i data-lucide="download" class="icon"></i>
            <span>Exportar Excel</span>
          </button>

          <button class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft"
                  onclick="showModal('addModal')">
            <i data-lucide="plus-circle" class="icon"></i>
            <span>Agregar Bloqueo</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Sección de importación -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center">
            <i data-lucide="file-spreadsheet" class="icon text-indigo-600 dark:text-indigo-400"></i>
          </div>
          Importar desde Excel
        </h2>
      </div>

      <div class="p-6">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
          Carga un archivo Excel con las columnas:
          <strong>identifier</strong>, <strong>type</strong> y <strong>reason</strong>.
        </p>

        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:flex-wrap">
          <a href="/blocked/api/template"
             class="inline-flex items-center gap-2 rounded-xl bg-slate-600 hover:bg-slate-700 text-white text-sm font-semibold px-4 py-2.5 shadow-soft transition"
             download>
            <i data-lucide="file-down" class="icon"></i>
            <span>Descargar Plantilla</span>
          </a>

          <form id="importForm"
                action="/blocked/api/import"
                method="POST"
                enctype="multipart/form-data"
                class="flex flex-col sm:flex-row sm:items-center gap-3 flex-wrap">

            <div class="relative flex items-center">
              <label for="excelFile"
                     class="inline-flex items-center gap-2 rounded-xl bg-white dark:bg-slate-800 border-2 border-slate-300 dark:border-slate-600 hover:border-indigo-500 text-slate-700 dark:text-slate-200 px-4 py-2.5 text-sm font-medium cursor-pointer transition">
                <i data-lucide="paperclip" class="icon"></i>
                <span>Seleccionar archivo</span>
              </label>

              <input
                type="file"
                id="excelFile"
                name="file"
                accept=".xlsx,.xls"
                class="absolute left-0 top-0 w-full h-full opacity-0 cursor-pointer"
                onchange="updateFileName(this)"
                required
              />
            </div>

            <span id="fileName" class="text-xs text-slate-500 dark:text-slate-400 min-h-[1rem]">
              Ningún archivo seleccionado
            </span>

            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white text-sm font-semibold px-4 py-2.5 shadow-soft transition">
              <i data-lucide="rocket" class="icon"></i>
              <span>Importar</span>
            </button>
          </form>
        </div>

        <div id="importResult" style="display:none;"></div>
      </div>
    </section>

    <!-- Tabla -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-rose-500/10 flex items-center justify-center">
            <i data-lucide="ban" class="icon text-rose-600 dark:text-rose-400"></i>
          </div>
          Lista de Bloqueados
        </h2>
      </div>

      <div class="p-6">
        <!-- Buscador -->
        <div class="mb-5">
          <input
            type="text"
            id="searchInput"
            placeholder="🔍 Buscar por número, grupo o razón..."
            onkeyup="filterTable()"
            class="w-full rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0 transition"
          />
        </div>

        <% if (blockedList.length > 0) { %>
          <div class="overflow-x-auto">
            <table id="blockedTable" class="min-w-full text-sm">
              <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-400 uppercase text-xs tracking-wider font-semibold">
                <tr>
                  <th class="text-left px-6 py-4">Identificador</th>
                  <th class="text-left px-6 py-4">Tipo</th>
                  <th class="text-left px-6 py-4">Razón</th>
                  <th class="text-left px-6 py-4">Fecha</th>
                  <th class="text-left px-6 py-4">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                <% blockedList.forEach(item => { %>
                  <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                    <td class="px-6 py-4 font-semibold text-slate-900 dark:text-white break-all">
                      <%= item.identifier %>
                    </td>
                    <td class="px-6 py-4">
                      <% if (item.type === 'PHONE') { %>
                        <span class="inline-flex items-center gap-1 rounded-md bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                          📱 Teléfono
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1 rounded-md bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                          👥 Grupo
                        </span>
                      <% } %>
                    </td>
                    <td class="px-6 py-4 text-slate-700 dark:text-slate-300 break-words"><%= item.reason || '-' %></td>
                    <td class="px-6 py-4 text-slate-600 dark:text-slate-400">
                      <time datetime="<%= new Date(item.blockedAt).toISOString() %>"><%= fmtDate(item.blockedAt) %></time>
                    </td>
                    <td class="px-6 py-4">
                      <button
                        class="inline-flex items-center gap-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                        onclick="unblock('<%= encodeURIComponent(item.identifier) %>')">
                        <i data-lucide="unlock" class="w-3.5 h-3.5"></i>
                        <span>Desbloquear</span>
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="px-6 py-16 text-center">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
              <i data-lucide="inbox" class="icon-lg text-slate-400"></i>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Sin bloqueos</p>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Los números y grupos bloqueados aparecerán aquí</p>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <!-- Modal Agregar Bloqueo -->
  <div id="addModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-md w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="ban" class="icon text-rose-600"></i>
          Bloquear Número/Grupo
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="hideModal('addModal')">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6">
        <form onsubmit="addBlock(event)" class="space-y-4">
          <div>
            <label for="identifier" class="block text-sm font-semibold mb-2">Número o ID de Grupo *</label>
            <input
              type="text"
              id="identifier"
              required
              placeholder="Ej: 51975399303 o 120363XXX@g.us"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500"
            />
            <small class="block text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
              Para teléfonos: incluir código de país (51975399303)<br/>
              Para grupos: usar el JID completo (120363XXX@g.us)
            </small>
          </div>

          <div>
            <label for="type" class="block text-sm font-semibold mb-2">Tipo *</label>
            <select
              id="type"
              required
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500"
            >
              <option value="">Seleccionar...</option>
              <option value="PHONE">📱 Teléfono</option>
              <option value="GROUP">👥 Grupo</option>
            </select>
          </div>

          <div>
            <label for="reason" class="block text-sm font-semibold mb-2">Razón (opcional)</label>
            <textarea
              id="reason"
              placeholder="Motivo del bloqueo..."
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 min-h-[80px] resize-y"
            ></textarea>
          </div>

          <div class="flex justify-end gap-2 pt-2">
            <button
              type="button"
              class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white"
              onclick="hideModal('addModal')">
              Cancelar
            </button>

            <button
              type="submit"
              class="rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-3 py-2 shadow-soft">
              Bloquear
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    // Iconos
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
    });

    // Actualizar nombre de archivo
    function updateFileName(input) {
      const fileName = document.getElementById('fileName');
      if (input.files.length > 0) {
        fileName.textContent = input.files[0].name;
        fileName.classList.remove('text-slate-500','dark:text-slate-400');
        fileName.classList.add('text-slate-800','dark:text-slate-200');
      } else {
        fileName.textContent = 'Ningún archivo seleccionado';
        fileName.classList.remove('text-slate-800','dark:text-slate-200');
        fileName.classList.add('text-slate-500','dark:text-slate-400');
      }
    }

    // Importar desde Excel
    const importForm = document.getElementById('importForm');
    if (importForm) {
      importForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const fileInput = document.getElementById('excelFile');
        if (!fileInput.files[0]) {
          alert('Por favor selecciona un archivo');
          return;
        }

        const formData = new FormData(importForm);
        const resultDiv = document.getElementById('importResult');
        resultDiv.style.display = 'block';
        resultDiv.className = 'import-result';
        resultDiv.innerHTML = '<div class="spinner"></div> Importando datos...';

        try {
          const response = await fetch('/blocked/api/import', {
            method: 'POST',
            body: formData
          });

          const result = await response.json();

          if (result.success) {
            resultDiv.className = 'import-result ' + (result.stats.failed > 0 ? 'warning' : 'success');

            let html = `
              <h4 class="font-semibold mb-1">✅ Importación completada</h4>
              <div class="import-stats text-sm">
                <strong>Total:</strong> ${result.stats.total} |
                <strong>Exitosos:</strong> ${result.stats.success} |
                <strong>Fallidos:</strong> ${result.stats.failed}
              </div>
            `;

            if (result.errors && result.errors.length > 0) {
              html += `
                <div class="error-list mt-3 max-h-[150px] overflow-y-auto bg-white rounded-md text-[12px] leading-relaxed border border-slate-200 p-3"
                     style="color:#334155;">
                  <strong class="block mb-2">Errores encontrados:</strong>
                  <ul class="list-none m-0 p-0">
                    ${result.errors.map(e => `<li class="py-1 border-b border-slate-100 last:border-none">${e}</li>`).join('')}
                  </ul>
                </div>
              `;
            }

            resultDiv.innerHTML = html;

            fileInput.value = '';
            const fn = document.getElementById('fileName');
            if (fn) fn.textContent = 'Ningún archivo seleccionado';

            if (result.stats.success > 0) {
              setTimeout(() => window.location.reload(), 3000);
            }
          } else {
            throw new Error(result.error || 'Error desconocido');
          }
        } catch (error) {
          resultDiv.className = 'import-result error';
          let errorMsg = error.message;

          if (error.message && error.message.includes('details')) {
            try {
              const errorData = JSON.parse(error.message);
              errorMsg = errorData.details.join(', ');
            } catch (e) {}
          }

          resultDiv.innerHTML = `
            <h4 class="font-semibold mb-1">❌ Error en la importación</h4>
            <p class="text-sm">${errorMsg}</p>
          `;
        }
      });
    }

    // Exportar a Excel
    async function exportToExcel() {
      try {
        const response = await fetch('/blocked/api/export');

        if (!response.ok) {
          throw new Error('Error al exportar');
        }

        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `bloqueados_${new Date().toISOString().split('T')[0]}.xlsx`;
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(url);
        document.body.removeChild(a);
      } catch (error) {
        alert('❌ Error al exportar: ' + error.message);
      }
    }

    // Filtrar tabla
    function filterTable() {
      const input = document.getElementById('searchInput');
      const filter = input.value.toLowerCase();
      const table = document.getElementById('blockedTable');
      if (!table) return;

      const tr = table.getElementsByTagName('tr');

      for (let i = 1; i < tr.length; i++) {
        const td = tr[i].getElementsByTagName('td');
        let found = false;

        for (let j = 0; j < td.length - 1; j++) {
          if (td[j].textContent.toLowerCase().indexOf(filter) > -1) {
            found = true;
            break;
          }
        }

        tr[i].style.display = found ? '' : 'none';
      }
    }

    // Agregar bloqueo
    async function addBlock(event) {
      event.preventDefault();

      const identifier = document.getElementById('identifier').value.trim();
      const type = document.getElementById('type').value;
      const reason = document.getElementById('reason').value.trim();

      if (!identifier || !type) {
        alert('Por favor completa los campos requeridos');
        return;
      }

      try {
        const res = await fetch('/blocked/api', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ identifier, type, reason })
        });

        const data = await res.json();

        if (data.success) {
          alert('✅ Bloqueado exitosamente');
          location.reload();
        } else {
          alert('❌ Error: ' + (data.error || 'No se pudo bloquear'));
        }
      } catch (error) {
        alert('❌ Error al bloquear');
        console.error(error);
      }
    }

    // Desbloquear
    async function unblock(identifier) {
      if (!confirm('¿Desbloquear este número/grupo?')) return;

      try {
        const res = await fetch(`/blocked/api/${identifier}`, {
          method: 'DELETE'
        });

        const data = await res.json();

        if (data.success) {
          alert('✅ Desbloqueado exitosamente');
          location.reload();
        } else {
          alert('❌ Error: ' + (data.error || 'No se pudo desbloquear'));
        }
      } catch (error) {
        alert('❌ Error al desbloquear');
        console.error(error);
      }
    }

    // Modales (usamos clases Tailwind)
    function showModal(id){
      const el = document.getElementById(id);
      el.classList.remove('hidden');
      el.classList.add('flex');
    }
    function hideModal(id){
      const el = document.getElementById(id);
      el.classList.remove('flex');
      el.classList.add('hidden');
      if (id === 'addModal') {
        document.getElementById('identifier').value = '';
        document.getElementById('type').value = '';
        document.getElementById('reason').value = '';
      }
    }
    window.addEventListener('click', (e) => {
      const modal = document.getElementById('addModal');
      if (e.target === modal) hideModal('addModal');
    });
  </script>
</body>
</html>