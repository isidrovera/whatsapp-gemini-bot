<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente + Tailwind -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary:{ DEFAULT:'#1e3a8a', 600:'#1e3a8a', 700:'#1e40af' },
          },
          boxShadow:{
            soft:'0 10px 25px -10px rgba(0,0,0,.15)',
          }
        }
      },
      darkMode:'media'
    }
  </script>

  <!-- motion + icons -->
  <script src="https://unpkg.com/@motionone/dom/dist/motion.min.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration:.001ms !important;
        animation-iteration-count:1 !important;
        transition-duration:.001ms !important;
        scroll-behavior:auto !important;
      }
    }

    /* link activo del sidebar */
    .sidebar-link-active{
      background-color:rgba(255,255,255,.12);
      color:#fff !important;
      font-weight:600;
    }

    /* El modal debe nacer oculto */
    .modal-hidden{
      display:none !important;
    }
  </style>
</head>

<body class="h-full bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
<a href="#main-content"
   class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-3 focus:py-2 focus:rounded-lg shadow">
  Saltar al contenido
</a>

<%
  // helper utilizado igual que dashboard
  function isActive(p){
    return (page === p || (!page && p==='dashboard')) ? 'sidebar-link-active' : '';
  }
%>

<div class="min-h-screen w-full flex relative">

  <!-- Overlay móvil del sidebar -->
  <div id="mobile-sidebar-overlay"
       class="fixed inset-0 bg-black/40 z-40 opacity-0 pointer-events-none transition-opacity md:hidden"></div>

  <!-- SIDEBAR -->
  <aside id="sidebar"
         class="w-[280px] flex flex-col bg-gradient-to-b from-primary to-primary-700 text-white shadow-soft
                fixed inset-y-0 left-0 z-50 -translate-x-full transition-transform md:translate-x-0 md:relative md:flex"
         role="navigation"
         aria-label="Menú principal">

    <div class="px-5 py-6 border-b border-white/10 bg-white/5 backdrop-blur flex items-center justify-between">
      <h2 class="text-xl font-semibold flex items-center gap-2">
        <i data-lucide="bot" class="w-5 h-5"></i> Bot Admin
      </h2>

      <!-- botón cerrar sidebar en móvil -->
      <button id="close-sidebar-btn"
              class="md:hidden inline-flex items-center justify-center rounded-lg text-white/70 hover:text-white hover:bg-white/10 p-2"
              aria-label="Cerrar menú">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <nav class="py-4 flex-1 overflow-y-auto">
      <ul class="px-2 space-y-1 text-[15px] leading-5">
        <li>
          <a href="/"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('dashboard') %>"
             aria-current="<%= isActive('dashboard') ? 'page' : false %>">
            <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
            <span>Dashboard</span>
          </a>
        </li>

        <li>
          <a href="/contacts"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('contacts') %>"
             aria-current="<%= isActive('contacts') ? 'page' : false %>">
            <i data-lucide="users" class="w-5 h-5"></i>
            <span>Contactos</span>
          </a>
        </li>

        <li>
          <a href="/conversations"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('conversations') %>"
             aria-current="<%= isActive('conversations') ? 'page' : false %>">
            <i data-lucide="message-circle" class="w-5 h-5"></i>
            <span>Conversaciones</span>
          </a>
        </li>

        <li>
          <a href="/blocked"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('blocked') %>"
             aria-current="<%= isActive('blocked') ? 'page' : false %>">
            <i data-lucide="ban" class="w-5 h-5"></i>
            <span>Bloqueados</span>
          </a>
        </li>

        <li><div class="my-3 h-px bg-white/10"></div></li>

        <li>
          <a href="/calendar"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('calendar') %>"
             aria-current="<%= isActive('calendar') ? 'page' : false %>">
            <i data-lucide="calendar" class="w-5 h-5"></i>
            <span>Calendario</span>
          </a>
        </li>

        <li>
          <a href="/working-hours"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white hover:bg-white/10 transition <%= isActive('working-hours') %>"
             aria-current="<%= isActive('working-hours') ? 'page' : false %>">
            <i data-lucide="clock" class="w-5 h-5"></i>
            <span>Horarios</span>
          </a>
        </li>

        <li>
          <a href="/admin-users"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('admin-users') %>"
             aria-current="<%= isActive('admin-users') ? 'page' : false %>">
            <i data-lucide="shield" class="w-5 h-5"></i>
            <span>Usuarios Admin</span>
          </a>
        </li>

        <li><div class="my-3 h-px bg-white/10"></div></li>

        <li>
          <a href="/settings"
             class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('settings') %>"
             aria-current="<%= isActive('settings') ? 'page' : false %>">
            <i data-lucide="settings" class="w-5 h-5"></i>
            <span>Configuración</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="mt-auto p-4 bg-white/5 border-t border-white/10">
      <div class="rounded-xl bg-white/10 p-3">
        <div class="text-[11px] uppercase tracking-wide opacity-80">Sesión activa</div>
        <div class="font-semibold text-sm mt-1 flex items-center gap-2">
          <i data-lucide="user" class="w-4 h-4"></i>
          <%= user || 'Admin' %>
        </div>
      </div>

      <form method="POST" action="/auth/logout" class="mt-3">
        <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% } %>
        <button type="submit"
                class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-white/20 bg-red-500/20 hover:bg-red-500/30 text-white py-2.5 text-sm font-medium transition">
          <i data-lucide="log-out" class="w-4 h-4"></i> Cerrar sesión
        </button>
      </form>
    </div>
  </aside>

  <!-- MAIN -->
  <main id="main-content" class="flex-1 p-4 md:p-8 w-full md:w-auto">

    <!-- HEADER -->
    <header class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft px-6 py-5 mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex items-start justify-between w-full md:w-auto">
        <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white flex items-center gap-3">
          <i data-lucide="clock" class="w-7 h-7 text-primary"></i>
          Horarios de Trabajo
        </h1>

        <!-- abrir sidebar móvil -->
        <button id="open-sidebar-btn"
                class="md:hidden inline-flex items-center justify-center rounded-lg text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 p-2 shadow-soft"
                aria-label="Abrir menú">
          <i data-lucide="menu" class="w-6 h-6"></i>
        </button>
      </div>

      <div class="flex items-center gap-3">
        <% if (isWorkingNow) { %>
          <div class="inline-flex items-center gap-2 rounded-lg bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300 px-3 py-2 text-sm font-semibold shadow-soft">
            <i data-lucide="check-circle" class="w-4 h-4"></i>
            <span>Abierto ahora</span>
          </div>
        <% } else { %>
          <div class="inline-flex items-center gap-2 rounded-lg bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300 px-3 py-2 text-sm font-semibold shadow-soft">
            <i data-lucide="x-circle" class="w-4 h-4"></i>
            <span>Cerrado ahora</span>
          </div>
        <% } %>
      </div>
    </header>

    <!-- INFO DE HOY -->
    <% if (todayHours) { %>
      <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-soft border border-slate-100/70 dark:border-white/5 mb-6">
        <div class="px-6 py-4 border-b border-slate-100/70 dark:border-white/5 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <i data-lucide="calendar-day" class="w-5 h-5 text-primary"></i>
            Hoy: <%= getDayName(todayHours.dayOfWeek) %>
          </h2>
        </div>

        <div class="px-6 py-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <div class="rounded-xl bg-slate-50 text-slate-800 dark:bg-white/5 dark:text-slate-100 p-4 shadow-inner">
            <div class="text-[11px] uppercase tracking-wide text-slate-500 dark:text-slate-400 font-medium mb-1">Estado</div>
            <div class="text-xl font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
              <% if (todayHours.isWorkday) { %>✅ Día laboral<% } else { %>❌ Cerrado<% } %>
            </div>
          </div>

          <% if (todayHours.openTime && todayHours.closeTime) { %>
            <div class="rounded-xl bg-slate-50 text-slate-800 dark:bg-white/5 dark:text-slate-100 p-4 shadow-inner">
              <div class="text-[11px] uppercase tracking-wide text-slate-500 dark:text-slate-400 font-medium mb-1">Horario</div>
              <div class="text-xl font-semibold text-slate-900 dark:text-white"><%= todayHours.openTime %> - <%= todayHours.closeTime %></div>
            </div>
          <% } %>

          <% if (todayHours.breakStart && todayHours.breakEnd) { %>
            <div class="rounded-xl bg-slate-50 text-slate-800 dark:bg-white/5 dark:text-slate-100 p-4 shadow-inner">
              <div class="text-[11px] uppercase tracking-wide text-slate-500 dark:text-slate-400 font-medium mb-1">Refrigerio</div>
              <div class="text-xl font-semibold text-slate-900 dark:text-white"><%= todayHours.breakStart %> - <%= todayHours.breakEnd %></div>
            </div>
          <% } %>
        </div>
      </section>
    <% } %>

    <!-- CONFIGURACIÓN SEMANAL -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-soft border border-slate-100/70 dark:border-white/5">
      <div class="px-6 py-4 border-b border-slate-100/70 dark:border-white/5 flex items-start justify-between flex-col lg:flex-row gap-3">
        <div>
          <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <i data-lucide="calendar-range" class="w-5 h-5 text-primary"></i>
            Configuración semanal
          </h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
            Define los horarios de atención por día, incluyendo refrigerio.
          </p>
        </div>
      </div>

      <div class="px-6 py-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        <% hours.forEach(day => { %>
          <div
            class="group relative rounded-xl border shadow-soft p-5 bg-white dark:bg-slate-900
                   transition hover:shadow-lg hover:border-indigo-400/60 hover:bg-slate-50/60 dark:hover:bg-white/5
                   <%= day.isWorkday
                        ? 'border-emerald-300/60 dark:border-emerald-600/50'
                        : 'border-rose-300/60 dark:border-rose-600/50 bg-rose-50/50 dark:bg-rose-900/10' %>"
          >
            <div class="flex items-start justify-between gap-3 mb-4">
              <div class="flex flex-col">
                <div class="text-base font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                  <%= getDayName(day.dayOfWeek) %>
                </div>
                <div class="mt-1">
                  <% if (day.isWorkday) { %>
                    <span class="inline-flex items-center gap-1 rounded-md bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300 px-2 py-1 text-[11px] font-semibold uppercase tracking-wide">
                      <i data-lucide="check" class="w-3.5 h-3.5"></i>
                      Laboral
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 rounded-md bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300 px-2 py-1 text-[11px] font-semibold uppercase tracking-wide">
                      <i data-lucide="x" class="w-3.5 h-3.5"></i>
                      Cerrado
                    </span>
                  <% } %>
                </div>
              </div>

              <button
                class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 text-xs font-semibold shadow-soft transition whitespace-nowrap"
                onclick="editDay(<%= day.dayOfWeek %>, '<%= getDayName(day.dayOfWeek) %>')">
                <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                Editar
              </button>
            </div>

            <% if (day.isWorkday) { %>
              <div class="grid grid-cols-2 gap-3 text-sm">
                <div class="rounded-lg bg-slate-50 dark:bg-white/5 p-3">
                  <div class="text-[10px] uppercase tracking-wide text-slate-500 dark:text-slate-400 font-medium mb-1">
                    Apertura
                  </div>
                  <div class="text-base font-semibold text-slate-900 dark:text-white">
                    <%= day.openTime || '-' %>
                  </div>
                </div>

                <div class="rounded-lg bg-slate-50 dark:bg-white/5 p-3">
                  <div class="text-[10px] uppercase tracking-wide text-slate-500 dark:text-slate-400 font-medium mb-1">
                    Cierre
                  </div>
                  <div class="text-base font-semibold text-slate-900 dark:text-white">
                    <%= day.closeTime || '-' %>
                  </div>
                </div>

                <% if (day.breakStart && day.breakEnd) { %>
                  <div class="rounded-lg bg-slate-50 dark:bg-white/5 p-3 col-span-1">
                    <div class="text-[10px] uppercase tracking-wide text-slate-500 dark:text-slate-400 font-medium mb-1">
                      Ref. Inicio
                    </div>
                    <div class="text-base font-semibold text-slate-900 dark:text-white">
                      <%= day.breakStart %>
                    </div>
                  </div>

                  <div class="rounded-lg bg-slate-50 dark:bg-white/5 p-3 col-span-1">
                    <div class="text-[10px] uppercase tracking-wide text-slate-500 dark:text-slate-400 font-medium mb-1">
                      Ref. Fin
                    </div>
                    <div class="text-base font-semibold text-slate-900 dark:text-white">
                      <%= day.breakEnd %>
                    </div>
                  </div>
                <% } %>
              </div>
            <% } else { %>
              <p class="text-sm text-slate-500 dark:text-slate-400">
                Día no laboral.
              </p>
            <% } %>
          </div>
        <% }) %>
      </div>
    </section>
  </main>
</div>

<!-- MODAL (INICIALMENTE OCULTO) -->
<div
  id="editModal"
  class="modal-hidden fixed inset-0 z-[1000] bg-black/40 backdrop-blur-sm p-4 md:p-8 flex items-center justify-center"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="modalTitle"
>
  <div class="w-full max-w-md rounded-2xl bg-white dark:bg-slate-900 shadow-2xl border border-slate-200/70 dark:border-white/10 overflow-hidden">
    <!-- header -->
    <div class="px-5 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-start justify-between gap-4">
      <div class="flex flex-col">
        <h2 id="modalTitle" class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <i data-lucide="pencil" class="w-5 h-5 text-indigo-600 dark:text-indigo-400"></i>
          <span>Editar Horario</span>
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Ajusta el horario laboral y el refrigerio.
        </p>
      </div>

      <button class="text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300 transition"
              onclick="hideModal('editModal')" aria-label="Cerrar">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <!-- body -->
    <div class="px-5 py-5 max-h-[70vh] overflow-y-auto">
      <form onsubmit="updateHours(event)" class="space-y-5">
        <input type="hidden" id="dayOfWeek"/>

        <!-- Día laboral toggle -->
        <div>
          <label class="flex items-start gap-3 text-sm font-medium text-slate-700 dark:text-slate-200">
            <input type="checkbox" id="isWorkday"
                   class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
                   onchange="toggleWorkdayFields()"/>
            <span>
              Día laboral
              <span class="block text-xs font-normal text-slate-500 dark:text-slate-400">
                Si está desmarcado, se considerará cerrado todo el día.
              </span>
            </span>
          </label>
        </div>

        <!-- Campos visibles solo si es laboral -->
        <div id="workdayFields" class="hidden space-y-5">
          <div class="rounded-xl bg-blue-50 text-blue-800 border-l-4 border-blue-400 p-4 text-sm leading-relaxed dark:bg-blue-900/30 dark:text-blue-200 dark:border-blue-700 shadow-soft">
            💡 Formato de hora: HH:MM (ej: 08:30, 18:00)
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col">
              <label class="text-sm font-medium text-slate-700 dark:text-slate-200 mb-1">
                Hora de Apertura
              </label>
              <input type="time" id="openTime"
                     class="rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"/>
            </div>

            <div class="flex flex-col">
              <label class="text-sm font-medium text-slate-700 dark:text-slate-200 mb-1">
                Hora de Cierre
              </label>
              <input type="time" id="closeTime"
                     class="rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"/>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col">
              <label class="text-sm font-medium text-slate-700 dark:text-slate-200 mb-1">
                Refrigerio Inicio (opcional)
              </label>
              <input type="time" id="breakStart"
                     class="rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"/>
            </div>

            <div class="flex flex-col">
              <label class="text-sm font-medium text-slate-700 dark:text-slate-200 mb-1">
                Refrigerio Fin (opcional)
              </label>
              <input type="time" id="breakEnd"
                     class="rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"/>
            </div>
          </div>
        </div>

        <!-- Footer botones -->
        <div class="flex items-center justify-end gap-3 pt-2">
          <button type="button"
                  class="inline-flex items-center justify-center rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-200 px-3 py-2 text-sm font-medium shadow transition"
                  onclick="hideModal('editModal')">
            Cancelar
          </button>

          <button type="submit"
                  class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 text-sm font-semibold shadow-soft transition">
            <i data-lucide="save" class="w-4 h-4"></i>
            Guardar
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // ===== ICONOS =====
  if (window.lucide) { lucide.createIcons(); }

  // ===== SIDEBAR MÓVIL =====
  (function(){
    const sidebar   = document.getElementById('sidebar');
    const overlay   = document.getElementById('mobile-sidebar-overlay');
    const openBtn   = document.getElementById('open-sidebar-btn');
    const closeBtn  = document.getElementById('close-sidebar-btn');

    function openSidebar(){
      sidebar.classList.remove('-translate-x-full');
      overlay.classList.remove('opacity-0','pointer-events-none');
    }
    function closeSidebar(){
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('opacity-0','pointer-events-none');
    }

    if (openBtn)  openBtn.addEventListener('click', openSidebar);
    if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
    if (overlay)  overlay.addEventListener('click', closeSidebar);
  })();

  // ===== ANIMACIÓN DE LAS CARDS =====
  (function(){
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReduced && window.motion) {
      const cards = document.querySelectorAll('.rounded-xl.border.shadow-soft');
      cards.forEach((el,i)=>{
        motion.animate(
          el,
          { opacity:[0,1], transform:['translateY(8px)','translateY(0)'] },
          { duration:.4, delay:i*0.03, easing:'ease-out' }
        );
        el.addEventListener('pointerenter', () =>
          motion.animate(el, { transform: ['translateY(0)','translateY(-2px)'] }, { duration:.18, easing:'ease-out' })
        );
        el.addEventListener('pointerleave', () =>
          motion.animate(el, { transform: ['translateY(-2px)','translateY(0)'] }, { duration:.18, easing:'ease-out' })
        );
      });
    }
  })();

  // ===== MODAL HELPERS =====
  function showModal(modalId){
    const modal = document.getElementById(modalId);
    if (!modal) return;
    modal.classList.remove('modal-hidden');
    modal.removeAttribute('hidden');
  }

  function hideModal(modalId){
    const modal = document.getElementById(modalId);
    if (!modal) return;
    modal.classList.add('modal-hidden');
    modal.setAttribute('hidden', '');
  }

  // cerrar modal si clic fuera de la caja blanca
  window.addEventListener('click',(e)=>{
    const overlay = document.getElementById('editModal');
    if (!overlay) return;
    const panel = overlay.querySelector('div.w-full.max-w-md');
    if (!panel) return;

    // si el overlay está oculto, no hacemos nada
    if (overlay.classList.contains('modal-hidden')) return;

    // clic directo en overlay (no dentro del panel): cerrar
    if (e.target === overlay) {
      hideModal('editModal');
    }
  });

  // cerrar con ESC
  window.addEventListener('keydown',(e)=>{
    if (e.key === 'Escape'){
      hideModal('editModal');
    }
  });

  // ===== LÓGICA DE DATOS =====

  // Mostrar/ocultar campos de horario según checkbox
  function toggleWorkdayFields(){
    const isWorkday = document.getElementById('isWorkday').checked;
    const box = document.getElementById('workdayFields');
    if (isWorkday){
      box.classList.remove('hidden');
    } else {
      box.classList.add('hidden');
    }
  }

  // Abrir modal para un día en específico
  async function editDay(dayOfWeek, dayName){
    try {
      const res   = await fetch(`/working-hours/api/${dayOfWeek}`);
      const hours = await res.json();

      // setear contenido modal
      const titleNode = document.getElementById('modalTitle');
      if (titleNode) {
        titleNode.querySelector('span:last-child').textContent = 'Editar ' + dayName;
      }

      document.getElementById('dayOfWeek').value      = dayOfWeek;
      document.getElementById('isWorkday').checked    = !!hours.isWorkday;
      document.getElementById('openTime').value       = hours.openTime   || '';
      document.getElementById('closeTime').value      = hours.closeTime  || '';
      document.getElementById('breakStart').value     = hours.breakStart || '';
      document.getElementById('breakEnd').value       = hours.breakEnd   || '';

      toggleWorkdayFields();
      showModal('editModal');
    } catch (err){
      alert('❌ Error al cargar horario');
      console.error(err);
    }
  }

  // Guardar cambios
  async function updateHours(e){
    e.preventDefault();

    const dayOfWeek = document.getElementById('dayOfWeek').value;
    const isWorkday = document.getElementById('isWorkday').checked;

    const data = {
      isWorkday,
      openTime:    isWorkday ? document.getElementById('openTime').value    : null,
      closeTime:   isWorkday ? document.getElementById('closeTime').value   : null,
      breakStart:  isWorkday ? (document.getElementById('breakStart').value || null) : null,
      breakEnd:    isWorkday ? (document.getElementById('breakEnd').value   || null) : null,
    };

    try {
      const res = await fetch(`/working-hours/api/${dayOfWeek}`, {
        method:'PUT',
        headers:{ 'Content-Type':'application/json' },
        body:JSON.stringify(data)
      });
      const result = await res.json();

      if (result.success){
        hideModal('editModal');
        alert('✅ Horario actualizado');
        location.reload();
      } else {
        alert('❌ Error al actualizar');
      }
    } catch (err){
      alert('❌ Error al actualizar horario');
      console.error(err);
    }
  }

  // Exponer funciones al DOM (porque las usamos en onclick del HTML)
  window.editDay = editDay;
  window.updateHours = updateHours;
  window.toggleWorkdayFields = toggleWorkdayFields;
  window.showModal = showModal;
  window.hideModal = hideModal;
</script>
</body>
</html>
