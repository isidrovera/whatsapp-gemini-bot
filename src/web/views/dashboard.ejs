<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Dashboard' %> - WhatsApp Bot Admin</title>

  <!-- Fuente -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary: { DEFAULT: '#667eea', 600:'#667eea', 700:'#5a67d8' },
            secondary:{ DEFAULT: '#764ba2', 600:'#764ba2', 700:'#6b3fa0' },
          },
          boxShadow: {
            soft: '0 4px 6px -1px rgba(0,0,0,.08), 0 2px 4px -1px rgba(0,0,0,.04)',
            card: '0 10px 30px -5px rgba(0,0,0,.1)',
          }
        }
      },
      darkMode: 'media'
    }
  </script>

  <!-- Utilidades externas -->
  <link rel="stylesheet" href="/css/ui.css">

  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Gradient text */
    .gradient-text {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Icon sizes */
    .icon { width: 1.25rem; height: 1.25rem; }
    .icon-lg { width: 1.75rem; height: 1.75rem; }

    /* Animaciones */
    @keyframes tick {
      0%, 100% { transform: rotate(0deg); }
      50% { transform: rotate(6deg); }
    }

    @keyframes pulse-ring {
      0% { box-shadow: 0 0 0 0 currentColor; }
      50% { box-shadow: 0 0 0 8px transparent; }
      100% { box-shadow: 0 0 0 0 transparent; }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    @keyframes spin-slow {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .clock-icon {
      animation: tick 2s ease-in-out infinite;
      transform-origin: center;
    }

    .pulse-ring {
      animation: pulse-ring 2s ease-out infinite;
    }

    .float-icon {
      animation: float 3s ease-in-out infinite;
    }

    .spin-slow {
      animation: spin-slow 20s linear infinite;
    }

    /* Cards con animación de entrada */
    .card-link {
      position: relative;
      overflow: hidden;
      opacity: 0;
      transform: translateY(20px);
      animation: slideUp 0.5s ease-out forwards;
    }

    @keyframes slideUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Barra de progreso animada */
    @keyframes progress-bar {
      from { width: 0%; }
    }

    .progress-bar {
      animation: progress-bar 1.5s ease-out;
    }

    /* Hover effects */
    .card-link::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
      transition: left 0.5s;
    }

    .card-link:hover::before {
      left: 100%;
    }
  </style>
</head>
<body class="h-full bg-gradient-to-br from-slate-50 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 text-slate-800 dark:text-slate-100">

  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-4 focus:py-2 focus:rounded-lg shadow-lg">
    Saltar al contenido
  </a>

  <%
    // ===== Helpers / Defaults =====
    const s  = (typeof stats !== 'undefined' && stats && typeof stats === 'object') ? stats : {};
    const rc = (typeof recentContacts !== 'undefined' && Array.isArray(recentContacts)) ? recentContacts : [];
    const rp = (typeof recentProducts !== 'undefined' && Array.isArray(recentProducts)) ? recentProducts : [];
    const ws = (typeof whatsappStatus !== 'undefined' && whatsappStatus && typeof whatsappStatus === 'object')
      ? whatsappStatus
      : { connected:false, hasQR:false };

    // Horarios
    const todayHours = (typeof workingHours !== 'undefined' && workingHours) ? workingHours : null;
    const isWorkingNow = (typeof workingNow !== 'undefined') ? workingNow : false;
    
    function getDayName(dow) {
      const days = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
      return days[dow] || 'N/A';
    }

    const nf = new Intl.NumberFormat('es-PE');
    const df = new Intl.DateTimeFormat('es-PE', { dateStyle: 'short' });
    function fmtNum(v){ return nf.format(Number(v || 0)); }
    function fmtDate(d){ try { return df.format(new Date(d)); } catch { return '-'; } }

    // KPIs clicables
    const cards = [
      { t:'TOTAL CONTACTOS',    n:fmtNum(s.totalContacts),       l:'Usuarios en el sistema',            tc:'text-blue-600 dark:text-blue-400',     i:'users',            href:'/contacts' },
      { t:'REGISTRADOS',        n:fmtNum(s.registeredContacts),  l:'Con DNI y RUC',                     tc:'text-emerald-600 dark:text-emerald-400',i:'user-check',       href:'/contacts?state=REGISTERED' },
      { t:'BLOQUEADOS',         n:fmtNum(s.blockedCount),        l:'Números/grupos bloqueados',         tc:'text-rose-600 dark:text-rose-400',      i:'user-x',           href:'/blocked' },
      { t:'MENSAJES TOTALES',   n:fmtNum(s.totalMessages),       l:'En historial completo',             tc:'text-violet-600 dark:text-violet-400',  i:'messages-square',  href:'/conversations' },
      { t:'MENSAJES HOY',       n:fmtNum(s.messagesToday),       l:'Conversaciones activas',            tc:'text-orange-600 dark:text-orange-400',  i:'message-circle',   href:'/conversations?date=today' },
      { t:'HUMAN TAKEOVER',     n:fmtNum(s.humanTakeovers),      l:'Intervenciones activas',            tc:'text-yellow-600 dark:text-yellow-400',  i:'hand',             href:'/conversations?human=1' },
      { t:'DEPARTAMENTOS',      n:fmtNum(s.departmentsCount),    l:'Áreas operativas',                  tc:'text-cyan-600 dark:text-cyan-400',      i:'building-2',       href:'/departments' },
      { t:'PRODUCTOS',          n:fmtNum(s.productsCount),       l:'Catálogo activo',                   tc:'text-indigo-600 dark:text-indigo-400',  i:'package',          href:'/products' },
      { t:'AUTO-RESPUESTAS',    n:fmtNum(s.autoResponsesCount),  l:'Flows y reglas',                    tc:'text-teal-600 dark:text-teal-400',      i:'bot',              href:'/auto-responses' },
      { t:'TAGS',               n:fmtNum(s.tagsCount),           l:'Segmentación',                      tc:'text-sky-600 dark:text-sky-400',        i:'tags',             href:'/tags' },
      { t:'PLANTILLAS',         n:fmtNum(s.templatesCount),      l:'Mensajes predefinidos',             tc:'text-fuchsia-600 dark:text-fuchsia-400',i:'file-text',        href:'/templates' }
    ];

    // Secciones
    const sections = [
      { href:'/',               icon:'layout-dashboard', label:'Dashboard' },
      { href:'/contacts',       icon:'users',            label:'Contactos' },
      { href:'/conversations',  icon:'message-circle',   label:'Conversaciones' },
      { href:'/blocked',        icon:'ban',              label:'Bloqueados' },
      { href:'/calendar',       icon:'calendar',         label:'Calendario' },
      { href:'/working-hours',  icon:'clock',            label:'Horarios' },
      { href:'/admin-users',    icon:'shield',           label:'Usuarios Admin' },
      { href:'/settings',       icon:'settings',         label:'Configuración' },
      { href:'/departments',    icon:'building-2',       label:'Departamentos' },
      { href:'/products',       icon:'package',          label:'Productos' },
      { href:'/auto-responses', icon:'bot',              label:'Auto-respuestas' },
      { href:'/tags',           icon:'tag',              label:'Tags' },
      { href:'/templates',      icon:'file-text',        label:'Plantillas' },
      { href:'/metrics',        icon:'bar-chart-3',      label:'Métricas' },
      { href:'/companies',      icon:'building',         label:'Empresas' }
    ];
  %>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- Header -->
    <header class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight gradient-text flex items-center gap-3">
            <i data-lucide="bar-chart-3" class="icon-lg text-primary float-icon"></i>
            Dashboard
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Vista general del sistema</p>
        </div>

        <!-- Estado WhatsApp -->
        <div class="flex flex-wrap items-center gap-3">
          <%
            const icon   = ws.connected ? 'check-circle' : (ws.hasQR ? 'qr-code' : 'x-circle');
            const label  = ws.connected ? 'Conectado' : (ws.hasQR ? 'Esperando escaneo' : 'Desconectado');
            const badgeClass = ws.connected
              ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20'
              : ws.hasQR
                ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20'
                : 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20';
          %>

          <div class="inline-flex items-center gap-2.5 rounded-xl px-4 py-2.5 text-sm font-medium border <%= badgeClass %> backdrop-blur-sm <%= ws.connected ? 'pulse-ring' : '' %>">
            <i data-lucide="<%= icon %>" class="icon"></i>
            <span class="font-semibold"><%= label %></span>
          </div>

          <% if (ws.connected && ws.botNumber) { %>
            <div class="inline-flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-3 py-2 rounded-xl">
              <i data-lucide="phone" class="icon"></i>
              <span class="font-medium"><%= ws.botNumber %></span>
            </div>
          <% } %>

          <% if (!ws.connected && ws.hasQR) { %>
            <a href="/auth/qr"
               class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white px-4 py-2.5 text-sm font-semibold transition-all shadow-lg hover:shadow-xl">
              <i data-lucide="qr-code" class="icon"></i>
              <span>Ver QR</span>
            </a>
          <% } %>

          <% if (ws.connected) { %>
            <button
              class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-rose-500 to-red-600 hover:from-rose-600 hover:to-red-700 text-white px-4 py-2.5 text-sm font-semibold transition-all shadow-lg hover:shadow-xl"
              onclick="disconnectWhatsApp()">
              <i data-lucide="power" class="icon"></i>
              <span>Desconectar</span>
            </button>
          <% } %>
        </div>
      </div>
    </header>

    <!-- Estado del Horario -->
    <% if (todayHours) { %>
      <section class="rounded-2xl overflow-hidden shadow-card border border-slate-200/50 dark:border-white/5 <%= todayHours.isWorkday ? 'bg-gradient-to-r from-emerald-50 to-teal-50 dark:from-emerald-900/20 dark:to-teal-900/20' : 'bg-gradient-to-r from-rose-50 to-orange-50 dark:from-rose-900/20 dark:to-orange-900/20' %>">
        <div class="px-6 py-5">
          <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
            
            <!-- Info principal -->
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-2xl <%= todayHours.isWorkday ? 'bg-emerald-500' : 'bg-rose-500' %> flex items-center justify-center shadow-lg">
                <i data-lucide="<%= todayHours.isWorkday ? 'clock' : 'moon' %>" class="w-7 h-7 text-white <%= todayHours.isWorkday ? 'clock-icon' : '' %>"></i>
              </div>
              
              <div>
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h3 class="text-lg font-bold <%= todayHours.isWorkday ? 'text-emerald-900 dark:text-emerald-200' : 'text-rose-900 dark:text-rose-200' %>">
                    <%= getDayName(todayHours.dayOfWeek) %>
                  </h3>
                  
                  <% if (isWorkingNow) { %>
                    <span class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold bg-emerald-500 text-white shadow-soft pulse-ring">
                      <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
                      ABIERTO AHORA
                    </span>
                  <% } else if (todayHours.isWorkday) { %>
                    <span class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold bg-amber-500 text-white shadow-soft">
                      <i data-lucide="clock" class="w-3.5 h-3.5"></i>
                      CERRADO
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold bg-rose-500 text-white shadow-soft">
                      <i data-lucide="x-circle" class="w-3.5 h-3.5"></i>
                      DÍA NO LABORAL
                    </span>
                  <% } %>
                </div>
                
                <p class="text-sm <%= todayHours.isWorkday ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-700 dark:text-rose-300' %> font-medium">
                  <% if (todayHours.isWorkday) { %>
                    Estado del servicio de atención hoy
                  <% } else { %>
                    No hay atención programada para hoy
                  <% } %>
                </p>
              </div>
            </div>

            <!-- Horarios -->
            <% if (todayHours.isWorkday && todayHours.openTime && todayHours.closeTime) { %>
              <div class="flex flex-wrap items-center gap-4">
                <!-- Horario -->
                <div class="flex items-center gap-3 rounded-xl bg-white/60 dark:bg-slate-900/40 backdrop-blur-sm px-4 py-3 border border-emerald-200/50 dark:border-emerald-800/30 shadow-soft">
                  <div class="w-10 h-10 rounded-lg bg-emerald-500/10 flex items-center justify-center">
                    <i data-lucide="clock" class="w-5 h-5 text-emerald-600 dark:text-emerald-400 clock-icon"></i>
                  </div>
                  <div>
                    <div class="text-xs font-medium text-emerald-700 dark:text-emerald-400 uppercase tracking-wide">
                      Horario
                    </div>
                    <div class="text-base font-bold text-emerald-900 dark:text-emerald-200">
                      <%= todayHours.openTime %> - <%= todayHours.closeTime %>
                    </div>
                  </div>
                </div>

                <!-- Refrigerio -->
                <% if (todayHours.breakStart && todayHours.breakEnd) { %>
                  <div class="flex items-center gap-3 rounded-xl bg-white/60 dark:bg-slate-900/40 backdrop-blur-sm px-4 py-3 border border-amber-200/50 dark:border-amber-800/30 shadow-soft">
                    <div class="w-10 h-10 rounded-lg bg-amber-500/10 flex items-center justify-center">
                      <i data-lucide="coffee" class="w-5 h-5 text-amber-600 dark:text-amber-400"></i>
                    </div>
                    <div>
                      <div class="text-xs font-medium text-amber-700 dark:text-amber-400 uppercase tracking-wide">
                        Refrigerio
                      </div>
                      <div class="text-base font-bold text-amber-900 dark:text-amber-200">
                        <%= todayHours.breakStart %> - <%= todayHours.breakEnd %>
                      </div>
                    </div>
                  </div>
                <% } %>

                <!-- Barra de progreso del día -->
                <% if (isWorkingNow) { 
                  // Calcular progreso del día
                  const now = new Date();
                  const [openHour, openMin] = todayHours.openTime.split(':').map(Number);
                  const [closeHour, closeMin] = todayHours.closeTime.split(':').map(Number);
                  const openMinutes = openHour * 60 + openMin;
                  const closeMinutes = closeHour * 60 + closeMin;
                  const currentMinutes = now.getHours() * 60 + now.getMinutes();
                  const progress = Math.min(100, Math.max(0, ((currentMinutes - openMinutes) / (closeMinutes - openMinutes)) * 100));
                %>
                  <div class="flex-1 min-w-[200px]">
                    <div class="flex items-center justify-between mb-1">
                      <span class="text-xs font-medium text-emerald-700 dark:text-emerald-400">Progreso del día</span>
                      <span class="text-xs font-bold text-emerald-900 dark:text-emerald-200"><%= Math.round(progress) %>%</span>
                    </div>
                    <div class="h-2 bg-white/60 dark:bg-slate-900/40 rounded-full overflow-hidden">
                      <div class="h-full bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full progress-bar" style="width: <%= progress %>%;"></div>
                    </div>
                  </div>
                <% } %>

                <!-- Link a horarios -->
                <a href="/working-hours" 
                   class="inline-flex items-center gap-2 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 px-4 py-3 text-sm font-semibold text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition-all shadow-sm hover:shadow">
                  <i data-lucide="settings" class="w-4 h-4 spin-slow"></i>
                  <span>Configurar</span>
                </a>
              </div>
            <% } %>
          </div>
        </div>
      </section>
    <% } %>

    <!-- KPIs -->
    <section aria-label="Indicadores principales" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      <% cards.forEach((card, idx) => { %>
        <a href="<%= card.href %>"
           class="card-link bg-white dark:bg-slate-900 border border-slate-200/50 dark:border-white/5 rounded-2xl p-6 shadow-soft hover:shadow-card transition-all"
           style="animation-delay:<%= idx * 0.05 %>s">
          <div class="absolute top-4 right-4 w-14 h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center opacity-40">
            <i data-lucide="<%= card.i %>" class="icon-lg <%= card.tc %>"></i>
          </div>
          <h3 class="text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 font-semibold mb-3"><%= card.t %></h3>
          <div class="text-5xl font-black <%= card.tc %> mb-2" data-kpi><%= card.n %></div>
          <p class="text-sm text-slate-600 dark:text-slate-400"><%= card.l %></p>
        </a>
      <% }) %>
    </section>

    <!-- Acciones rápidas -->
    <section aria-label="Accesos rápidos" class="space-y-4">
      <h2 class="text-xl font-bold text-slate-800 dark:text-white flex items-center gap-2">
        <i data-lucide="zap" class="icon text-primary"></i>
        Acciones rápidas
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/products/new" class="card-link bg-white dark:bg-slate-900 border border-slate-200/50 dark:border-white/5 rounded-2xl p-6 hover:shadow-card transition-all">
          <div class="relative flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-indigo-500/10 flex items-center justify-center">
              <i data-lucide="plus-circle" class="icon text-indigo-600 dark:text-indigo-400"></i>
            </div>
            <div>
              <h3 class="font-bold text-slate-800 dark:text-white mb-1">Nuevo producto</h3>
              <p class="text-sm text-slate-600 dark:text-slate-400">Agregar al catálogo</p>
            </div>
          </div>
        </a>

        <a href="/auto-responses/new" class="card-link bg-white dark:bg-slate-900 border border-slate-200/50 dark:border-white/5 rounded-2xl p-6 hover:shadow-card transition-all">
          <div class="relative flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center">
              <i data-lucide="sparkles" class="icon text-emerald-600 dark:text-emerald-400"></i>
            </div>
            <div>
              <h3 class="font-bold text-slate-800 dark:text-white mb-1">Auto-respuesta</h3>
              <p class="text-sm text-slate-600 dark:text-slate-400">Crear regla o flujo</p>
            </div>
          </div>
        </a>

        <a href="/templates/new" class="card-link bg-white dark:bg-slate-900 border border-slate-200/50 dark:border-white/5 rounded-2xl p-6 hover:shadow-card transition-all">
          <div class="relative flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-fuchsia-500/10 flex items-center justify-center">
              <i data-lucide="file-plus" class="icon text-fuchsia-600 dark:text-fuchsia-400"></i>
            </div>
            <div>
              <h3 class="font-bold text-slate-800 dark:text-white mb-1">Nueva plantilla</h3>
              <p class="text-sm text-slate-600 dark:text-slate-400">Mensaje predefinido</p>
            </div>
          </div>
        </a>
      </div>
    </section>

    <!-- Secciones -->
    <section aria-label="Secciones" class="space-y-4">
      <h2 class="text-xl font-bold text-slate-800 dark:text-white flex items-center gap-2">
        <i data-lucide="grid" class="icon text-primary"></i>
        Secciones
      </h2>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        <% sections.forEach((sx, idx) => { %>
          <a href="<%= sx.href %>" 
             class="card-link bg-white dark:bg-slate-900 border border-slate-200/50 dark:border-white/5 rounded-2xl p-4 flex items-center gap-3 hover:shadow-card transition-all"
             style="animation-delay:<%= (idx + cards.length) * 0.03 %>s">
            <span class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 inline-flex items-center justify-center">
              <i data-lucide="<%= sx.icon %>" class="icon"></i>
            </span>
            <span class="font-semibold text-sm"><%= sx.label %></span>
          </a>
        <% }) %>
      </div>
    </section>

    <!-- Contactos recientes -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-5 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center">
            <i data-lucide="user-round" class="icon text-blue-600 dark:text-blue-400"></i>
          </div>
          Contactos recientes
        </h2>
      </div>

      <% if (rc.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-400 uppercase text-xs tracking-wider font-semibold">
              <tr>
                <th class="text-left px-6 py-4">Teléfono</th>
                <th class="text-left px-6 py-4">Nombre</th>
                <th class="text-left px-6 py-4">Empresa</th>
                <th class="text-left px-6 py-4">Estado</th>
                <th class="text-left px-6 py-4">Registro</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
              <% rc.forEach(contact => { %>
                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                  <td class="px-6 py-4 font-semibold text-slate-900 dark:text-white"><%= contact.phoneNumber %></td>
                  <td class="px-6 py-4 text-slate-700 dark:text-slate-300"><%= contact.name || '-' %></td>
                  <td class="px-6 py-4 text-slate-600 dark:text-slate-400"><%= contact.companyName || '-' %></td>
                  <td class="px-6 py-4">
                    <% if (contact.state === 'REGISTERED') { %>
                      <span class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300">
                        <i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Registrado
                      </span>
                    <% } else if (contact.state === 'WAITING_DNI' || contact.state === 'WAITING_RUC') { %>
                      <span class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300">
                        <i data-lucide="clock" class="w-3.5 h-3.5"></i> Esperando
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold bg-sky-100 text-sky-700 dark:bg-sky-900/30 dark:text-sky-300">
                        <i data-lucide="sparkles" class="w-3.5 h-3.5"></i> Nuevo
                      </span>
                    <% } %>
                  </td>
                  <td class="px-6 py-4 text-slate-600 dark:text-slate-400">
                    <% const d = new Date(contact.createdAt); %>
                    <time datetime="<%= d.toISOString() %>"><%= fmtDate(d) %></time>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="px-6 py-16 text-center">
          <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="inbox" class="icon-lg text-slate-400"></i>
          </div>
          <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Sin contactos recientes</p>
          <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Los nuevos contactos aparecerán aquí</p>
        </div>
      <% } %>
    </section>

    <!-- Productos recientes -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-5 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-purple-500/10 flex items-center justify-center">
            <i data-lucide="shopping-bag" class="icon text-purple-600 dark:text-purple-400"></i>
          </div>
          Productos recientes
        </h2>
      </div>

      <% if (rp.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-400 uppercase text-xs tracking-wider font-semibold">
              <tr>
                <th class="text-left px-6 py-4">SKU</th>
                <th class="text-left px-6 py-4">Nombre</th>
                <th class="text-left px-6 py-4">Estado</th>
                <th class="text-left px-6 py-4">Creado</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
              <% rp.forEach(p => { %>
                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                  <td class="px-6 py-4 font-semibold text-slate-900 dark:text-white"><%= p.sku || '-' %></td>
                  <td class="px-6 py-4 text-slate-700 dark:text-slate-300"><%= p.name || '-' %></td>
                  <td class="px-6 py-4">
                    <% if (p.isActive) { %>
                      <span class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300">
                        <i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Activo
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-semibold bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300">
                        <i data-lucide="x-circle" class="w-3.5 h-3.5"></i> Inactivo
                      </span>
                    <% } %>
                  </td>
                  <td class="px-6 py-4 text-slate-600 dark:text-slate-400">
                    <% const d = new Date(p.createdAt); %>
                    <time datetime="<%= d.toISOString() %>"><%= fmtDate(d) %></time>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="px-6 py-16 text-center">
          <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="package-open" class="icon-lg text-slate-400"></i>
          </div>
          <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Sin productos recientes</p>
          <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Los últimos productos aparecerán aquí</p>
        </div>
      <% } %>
    </section>
  </main>

  <!-- Scripts -->
  <script>
    // Iconos
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
    });

    // Desconectar WhatsApp
    async function disconnectWhatsApp() {
      if (!confirm('¿Seguro que deseas desconectar WhatsApp?')) return;
      try {
        const res = await fetch('/auth/logout-whatsapp', { method: 'POST', credentials: 'include' });
        if (!res.ok) {
          const text = await res.text();
          alert('Error al desconectar: ' + text);
          return;
        }
        let msg = 'WhatsApp desconectado correctamente';
        const ct = res.headers.get('content-type') || '';
        if (ct.includes('application/json')) {
          const data = await res.json();
          if (data && data.message) msg = data.message;
        }
        alert('✅ ' + msg);
        window.location.reload();
      } catch (err) {
        alert('❌ Error al desconectar WhatsApp');
        console.error(err);
      }
    }

    // Animación KPIs
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReduced) {
      const nums = document.querySelectorAll('[data-kpi]');
      nums.forEach(node => {
        const finalText = node.textContent.trim();
        const cleanText = finalText.replace(/\./g,'').replace(/,/g,'');
        const finalVal = parseInt(cleanText) || 0;
        if (finalVal <= 0) return;

        let current = 0;
        const duration = 1500;
        const steps = 60;
        const increment = finalVal / steps;
        const stepDuration = duration / steps;
        const nf = new Intl.NumberFormat('es-PE');

        const counter = setInterval(() => {
          current += increment;
          if (current >= finalVal) {
            node.textContent = nf.format(finalVal);
            clearInterval(counter);
          } else {
            node.textContent = nf.format(Math.floor(current));
          }
        }, stepDuration);
      });
    }
  </script>
</body>
</html>