<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> - WhatsApp Bot Admin</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary:   { DEFAULT:'#667eea', 600:'#667eea', 700:'#5a67d8' },
            secondary: { DEFAULT:'#764ba2', 600:'#764ba2', 700:'#6b3fa0' },
          },
          boxShadow: {
            soft:'0 4px 6px -1px rgba(0,0,0,.08), 0 2px 4px -1px rgba(0,0,0,.04)',
            card:'0 10px 30px -5px rgba(0,0,0,.10)'
          }
        }
      },
      darkMode:'media'
    }
  </script>

  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    .gradient-text {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .icon { width: 1.25rem; height: 1.25rem; }
    .icon-lg { width: 1.75rem; height: 1.75rem; }

    .import-result {
      margin-top: 20px;
      padding: 15px;
      border-radius: 8px;
      font-size: 14px;
    }
    .import-result.success {
      background: #d1fae5;
      border: 1px solid #6ee7b7;
      color: #065f46;
    }
    .import-result.error {
      background: #fee2e2;
      border: 1px solid #fca5a5;
      color: #991b1b;
    }
    .import-result.warning {
      background: #fef3c7;
      border: 1px solid #fcd34d;
      color: #92400e;
    }

    .spinner {
      display: inline-block;
      width: 16px;
      height: 16px;
      border: 2px solid #f3f4f6;
      border-top-color: #3b82f6;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body class="h-full bg-gradient-to-br from-slate-50 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 text-slate-800 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-4 focus:py-2 focus:rounded-lg shadow-lg">
    Saltar al contenido
  </a>

  <%
    const blockedList = Array.isArray(blocked) ? blocked : [];
    const df = new Intl.DateTimeFormat('es-PE', { dateStyle: 'short', timeStyle: 'short' });
    function fmtDate(d){ try { return df.format(new Date(d)); } catch { return '-'; } }
    
    function getAccessLevelBadge(level) {
      const badges = {
        'BLOCKED': { color: 'rose', emoji: '🔴', label: 'Bloqueado' },
        'RESTRICTED': { color: 'orange', emoji: '⚠️', label: 'Restringido' },
        'LIMITED': { color: 'yellow', emoji: '⏸️', label: 'Limitado' },
        'STANDARD': { color: 'blue', emoji: '✅', label: 'Estándar' },
        'FULL': { color: 'green', emoji: '🟢', label: 'Completo' },
        'VIP': { color: 'purple', emoji: '👑', label: 'VIP' }
      };
      return badges[level] || badges['STANDARD'];
    }
  %>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <a href="/"
           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">
          <i data-lucide="arrow-left" class="icon"></i>
          <span>Volver al Dashboard</span>
        </a>
      </div>

      <nav aria-label="Breadcrumb" class="text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li class="inline-flex items-center gap-1">
            <a href="/" class="hover:underline inline-flex items-center gap-1">
              <i data-lucide="home" class="w-3.5 h-3.5"></i> Inicio
            </a>
          </li>
          <li class="select-none">/</li>
          <li class="inline-flex items-center gap-1">
            <i data-lucide="shield" class="w-3.5 h-3.5"></i>
            <span class="font-medium">Control de Acceso</span>
          </li>
        </ol>
      </nav>
    </div>

    <header class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight gradient-text flex items-center gap-3">
            <i data-lucide="shield" class="icon-lg text-primary"></i>
            Control de Acceso
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Gestión de permisos granulares por número/grupo</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button class="inline-flex items-center gap-2 rounded-xl bg-slate-600 hover:bg-slate-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft"
                  onclick="exportToExcel()">
            <i data-lucide="download" class="icon"></i>
            <span>Exportar Excel</span>
          </button>

          <button class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft"
                  onclick="showModal('addModal')">
            <i data-lucide="plus-circle" class="icon"></i>
            <span>Agregar Restricción</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Importación -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center">
            <i data-lucide="file-spreadsheet" class="icon text-indigo-600 dark:text-indigo-400"></i>
          </div>
          Importar desde Excel
        </h2>
      </div>

      <div class="p-6">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
          Columnas: <strong>identifier</strong>, <strong>type</strong>, <strong>accessLevel</strong>, <strong>reason</strong>
        </p>

        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:flex-wrap">
          <a href="/blocked/api/template"
             class="inline-flex items-center gap-2 rounded-xl bg-slate-600 hover:bg-slate-700 text-white text-sm font-semibold px-4 py-2.5 shadow-soft transition"
             download>
            <i data-lucide="file-down" class="icon"></i>
            <span>Descargar Plantilla</span>
          </a>

          <form id="importForm"
                action="/blocked/api/import"
                method="POST"
                enctype="multipart/form-data"
                class="flex flex-col sm:flex-row sm:items-center gap-3 flex-wrap">

            <div class="relative flex items-center">
              <label for="excelFile"
                     class="inline-flex items-center gap-2 rounded-xl bg-white dark:bg-slate-800 border-2 border-slate-300 dark:border-slate-600 hover:border-indigo-500 text-slate-700 dark:text-slate-200 px-4 py-2.5 text-sm font-medium cursor-pointer transition">
                <i data-lucide="paperclip" class="icon"></i>
                <span>Seleccionar archivo</span>
              </label>

              <input
                type="file"
                id="excelFile"
                name="file"
                accept=".xlsx,.xls"
                class="absolute left-0 top-0 w-full h-full opacity-0 cursor-pointer"
                onchange="updateFileName(this)"
                required
              />
            </div>

            <span id="fileName" class="text-xs text-slate-500 dark:text-slate-400 min-h-[1rem]">
              Ningún archivo seleccionado
            </span>

            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white text-sm font-semibold px-4 py-2.5 shadow-soft transition">
              <i data-lucide="rocket" class="icon"></i>
              <span>Importar</span>
            </button>
          </form>
        </div>

        <div id="importResult" style="display:none;"></div>
      </div>
    </section>

    <!-- Tabla -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-rose-500/10 flex items-center justify-center">
            <i data-lucide="list" class="icon text-rose-600 dark:text-rose-400"></i>
          </div>
          Lista de Restricciones
        </h2>
      </div>

      <div class="p-6">
        <div class="mb-5">
          <input
            type="text"
            id="searchInput"
            placeholder="🔍 Buscar..."
            onkeyup="filterTable()"
            class="w-full rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0 transition"
          />
        </div>

        <% if (blockedList.length > 0) { %>
          <div class="overflow-x-auto">
            <table id="blockedTable" class="min-w-full text-sm">
              <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-400 uppercase text-xs tracking-wider font-semibold">
                <tr>
                  <th class="text-left px-6 py-4">Identificador</th>
                  <th class="text-left px-6 py-4">Tipo</th>
                  <th class="text-left px-6 py-4">Nivel</th>
                  <th class="text-left px-6 py-4">Permisos</th>
                  <th class="text-left px-6 py-4">Razón</th>
                  <th class="text-left px-6 py-4">Fecha</th>
                  <th class="text-left px-6 py-4">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                <% blockedList.forEach(item => { 
                  const badge = getAccessLevelBadge(item.accessLevel);
                %>
                  <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                    <td class="px-6 py-4 font-semibold text-slate-900 dark:text-white break-all">
                      <%= item.identifier %>
                    </td>
                    <td class="px-6 py-4">
                      <% if (item.type === 'PHONE') { %>
                        <span class="inline-flex items-center gap-1 rounded-md bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300 px-2 py-0.5 text-[11px] font-semibold">
                          📱 Teléfono
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1 rounded-md bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 px-2 py-0.5 text-[11px] font-semibold">
                          👥 Grupo
                        </span>
                      <% } %>
                    </td>
                    <td class="px-6 py-4">
                      <span class="inline-flex items-center gap-1 rounded-md bg-<%= badge.color %>-100 text-<%= badge.color %>-700 dark:bg-<%= badge.color %>-900/30 dark:text-<%= badge.color %>-300 px-2 py-0.5 text-[11px] font-semibold">
                        <%= badge.emoji %> <%= badge.label %>
                      </span>
                    </td>
                    <td class="px-6 py-4">
                      <div class="flex flex-wrap gap-1 text-[10px]">
                        <% if (item.canUseOdoo) { %><span class="bg-green-100 text-green-700 px-1.5 py-0.5 rounded">Odoo</span><% } %>
                        <% if (item.canCreateTickets) { %><span class="bg-blue-100 text-blue-700 px-1.5 py-0.5 rounded">Tickets</span><% } %>
                        <% if (item.canUseAI) { %><span class="bg-purple-100 text-purple-700 px-1.5 py-0.5 rounded">AI</span><% } %>
                        <% if (item.canTalkToHuman) { %><span class="bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded">Humano</span><% } %>
                      </div>
                    </td>
                    <td class="px-6 py-4 text-slate-700 dark:text-slate-300 break-words max-w-xs"><%= item.reason || '-' %></td>
                    <td class="px-6 py-4 text-slate-600 dark:text-slate-400">
                      <time datetime="<%= new Date(item.blockedAt).toISOString() %>"><%= fmtDate(item.blockedAt) %></time>
                    </td>
                    <td class="px-6 py-4">
                      <div class="flex gap-2">
                        <button
                          class="inline-flex items-center gap-1 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                          onclick="editPermissions('<%= encodeURIComponent(item.identifier) %>')">
                          <i data-lucide="settings" class="w-3.5 h-3.5"></i>
                          <span>Editar</span>
                        </button>
                        <button
                          class="inline-flex items-center gap-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                          onclick="unblock('<%= encodeURIComponent(item.identifier) %>')">
                          <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                          <span>Eliminar</span>
                        </button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="px-6 py-16 text-center">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
              <i data-lucide="inbox" class="icon-lg text-slate-400"></i>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Sin restricciones</p>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Las restricciones aparecerán aquí</p>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <!-- Modal Agregar -->
  <div id="addModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-md w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="shield" class="icon text-indigo-600"></i>
          Agregar Restricción
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="hideModal('addModal')">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6">
        <form onsubmit="addBlock(event)" class="space-y-4">
          <div>
            <label class="block text-sm font-semibold mb-2">Identificador *</label>
            <input
              type="text"
              id="identifier"
              required
              placeholder="Ej: 51975399303"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2">Tipo *</label>
            <select
              id="type"
              required
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500"
            >
              <option value="">Seleccionar...</option>
              <option value="PHONE">📱 Teléfono</option>
              <option value="GROUP">👥 Grupo</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2">Nivel de Acceso *</label>
            <select
              id="accessLevel"
              required
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500"
            >
              <option value="BLOCKED">🔴 Bloqueado (sin acceso)</option>
              <option value="RESTRICTED">⚠️ Restringido (solo info básica)</option>
              <option value="LIMITED">⏸️ Limitado (sin Odoo ni tickets)</option>
              <option value="STANDARD" selected>✅ Estándar (acceso normal)</option>
              <option value="FULL">🟢 Completo (todo habilitado)</option>
              <option value="VIP">👑 VIP (prioridad)</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2">Razón</label>
            <textarea
              id="reason"
              placeholder="Motivo..."
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 min-h-[80px] resize-y"
            ></textarea>
          </div>

          <div class="flex justify-end gap-2 pt-2">
            <button
              type="button"
              class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white"
              onclick="hideModal('addModal')">
              Cancelar
            </button>

            <button
              type="submit"
              class="rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-3 py-2 shadow-soft">
              Guardar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <!-- Modal Editar Permisos -->
<div id="editModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm overflow-y-auto">
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-2xl w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden my-8">
    <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between">
      <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
        <i data-lucide="settings" class="icon text-indigo-600"></i>
        Editar Permisos
      </h2>
      <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="hideModal('editModal')">
        <i data-lucide="x" class="icon"></i>
      </button>
    </div>

    <div class="p-6 max-h-[calc(100vh-200px)] overflow-y-auto">
      <form onsubmit="savePermissions(event)" class="space-y-6">
        <input type="hidden" id="editIdentifier" />

        <!-- Info del contacto -->
        <div class="bg-slate-50 dark:bg-slate-800/50 rounded-lg p-4 border border-slate-200 dark:border-slate-700">
          <div class="text-sm font-semibold text-slate-900 dark:text-white mb-1">Identificador</div>
          <div id="editIdentifierDisplay" class="text-sm text-slate-600 dark:text-slate-400 font-mono break-all"></div>
        </div>

        <!-- Nivel de Acceso -->
        <div>
          <label class="block text-sm font-semibold mb-2">Nivel de Acceso</label>
          <select
            id="editAccessLevel"
            class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500"
            onchange="updatePermissionsPreview()"
          >
            <option value="BLOCKED">🔴 Bloqueado - Sin acceso al bot</option>
            <option value="RESTRICTED">⚠️ Restringido - Solo respuestas automáticas básicas</option>
            <option value="LIMITED">⏸️ Limitado - Sin Odoo ni tickets</option>
            <option value="STANDARD">✅ Estándar - Acceso normal</option>
            <option value="FULL">🟢 Completo - Todo habilitado</option>
            <option value="VIP">👑 VIP - Acceso prioritario</option>
          </select>
          <small class="block text-xs text-slate-500 dark:text-slate-400 mt-2">
            Cambia el nivel para aplicar permisos predefinidos
          </small>
        </div>

        <!-- Permisos Personalizados -->
        <div class="border-t border-slate-200 dark:border-slate-700 pt-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Permisos Personalizados</h3>
            <label class="inline-flex items-center gap-2 cursor-pointer">
              <input
                type="checkbox"
                id="enableCustomPerms"
                onchange="toggleCustomPermissions()"
                class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
              />
              <span class="text-xs text-slate-600 dark:text-slate-400">Habilitar personalización</span>
            </label>
          </div>

          <div id="customPermsContainer" class="space-y-3 opacity-50 pointer-events-none">
            <!-- Odoo -->
            <div class="flex items-start gap-3 p-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800">
              <input
                type="checkbox"
                id="permOdoo"
                class="mt-1 w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
              />
              <div class="flex-1">
                <label for="permOdoo" class="text-sm font-semibold text-slate-900 dark:text-white cursor-pointer flex items-center gap-2">
                  <span>🔧</span>
                  <span>Acceso a Odoo</span>
                </label>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                  Puede consultar tickets, equipos e historial de servicio desde Odoo
                </p>
              </div>
            </div>

            <!-- Crear Tickets -->
            <div class="flex items-start gap-3 p-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800">
              <input
                type="checkbox"
                id="permTickets"
