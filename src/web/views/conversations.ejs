<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind (misma config del dashboard) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary:   { DEFAULT:'#667eea', 600:'#667eea', 700:'#5a67d8' },
            secondary: { DEFAULT:'#764ba2', 600:'#764ba2', 700:'#6b3fa0' },
            whatsapp:  { DEFAULT: '#25D366', dark: '#128C7E' },
          },
          boxShadow: {
            soft:'0 4px 6px -1px rgba(0,0,0,.08), 0 2px 4px -1px rgba(0,0,0,.04)',
            card:'0 10px 30px -5px rgba(0,0,0,.10)'
          }
        }
      },
      darkMode:'media'
    }
  </script>



  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Gradient text */
    .gradient-text {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Icon sizes */
    .icon { width: 1.25rem; height: 1.25rem; }
    .icon-lg { width: 1.75rem; height: 1.75rem; }

    /* Chat layout */
    .chat-container {
      display: grid;
      grid-template-columns: 350px 1fr;
      height: calc(100vh - 280px);
      gap: 1rem;
    }

    @media (max-width: 768px) {
      .chat-container {
        grid-template-columns: 1fr;
        height: calc(100vh - 240px);
      }
      .contacts-panel.hidden-mobile {
        display: none;
      }
    }

    /* Custom scrollbar */
    .chat-messages::-webkit-scrollbar {
      width: 6px;
    }
    .chat-messages::-webkit-scrollbar-track {
      background: transparent;
    }
    .chat-messages::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.3);
      border-radius: 3px;
    }

    /* Message bubbles */
    .message-bubble {
      max-width: 75%;
      word-wrap: break-word;
      animation: slideIn 0.3s ease-out;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Typing indicator */
    .typing-indicator {
      display: inline-flex;
      gap: 4px;
      padding: 12px 16px;
      background: #e5e7eb;
      border-radius: 18px;
    }

    .typing-indicator span {
      width: 8px;
      height: 8px;
      background: #9ca3af;
      border-radius: 50%;
      animation: typing 1.4s infinite;
    }

    .typing-indicator span:nth-child(2) {
      animation-delay: 0.2s;
    }

    .typing-indicator span:nth-child(3) {
      animation-delay: 0.4s;
    }

    @keyframes typing {
      0%, 60%, 100% {
        transform: translateY(0);
      }
      30% {
        transform: translateY(-10px);
      }
    }

    /* Badge notification */
    .notification-badge {
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% {
        opacity: 1;
      }
      50% {
        opacity: 0.5;
      }
    }

    /* File preview */
    .file-preview {
      position: relative;
      display: inline-block;
    }

    .file-preview img {
      max-width: 200px;
      max-height: 200px;
      border-radius: 8px;
    }
  </style>
</head>

<body class="h-full bg-gradient-to-br from-slate-50 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 text-slate-800 dark:text-slate-100">
  
  <!-- Audio element for notifications -->
  <audio id="notificationSound" preload="auto">
    <source src="data:audio/wav;base64," type="audio/wav">
  </audio>

  <%
    const convList = Array.isArray(contacts) ? contacts : [];

    function fmtTime(d){
      try {
        const date = new Date(d);
        const now = new Date();
        const diff = now.getTime() - date.getTime();
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        
        if (days === 0) {
          return date.toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit' });
        } else if (days === 1) {
          return 'Ayer';
        } else if (days < 7) {
          return date.toLocaleDateString('es-PE', { weekday: 'short' });
        } else {
          return date.toLocaleDateString('es-PE', { day: '2-digit', month: '2-digit' });
        }
      } catch {
        return '';
      }
    }
  %>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Volver al Dashboard + breadcrumb -->
    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <a href="/"
           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">
          <i data-lucide="arrow-left" class="icon"></i>
          <span>Volver al Dashboard</span>
        </a>
      </div>

      <nav aria-label="Breadcrumb" class="text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li class="inline-flex items-center gap-1">
            <a href="/" class="hover:underline inline-flex items-center gap-1">
              <i data-lucide="home" class="w-3.5 h-3.5"></i> Inicio
            </a>
          </li>
          <li class="select-none">/</li>
          <li class="inline-flex items-center gap-1">
            <i data-lucide="message-circle" class="w-3.5 h-3.5"></i>
            <span class="font-medium">Conversaciones</span>
          </li>
        </ol>
      </nav>
    </div>

    <!-- Header -->
    <header class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight gradient-text flex items-center gap-3">
            <i data-lucide="messages-square" class="icon-lg text-primary"></i>
            Conversaciones
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Chat en tiempo real con tus contactos</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button id="toggleNotifications"
                  class="inline-flex items-center gap-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 px-4 py-2.5 text-sm font-semibold shadow-soft transition"
                  onclick="toggleNotifications()">
            <i data-lucide="bell" class="icon" id="bellIcon"></i>
            <span id="notificationStatus">Sonido ON</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Chat Container -->
    <div class="chat-container">
      
      <!-- Contacts Panel -->
      <div class="contacts-panel bg-white dark:bg-slate-900 rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 flex flex-col overflow-hidden">
        
        <!-- Search -->
        <div class="p-4 border-b border-slate-200 dark:border-slate-700 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
          <div class="relative">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
            <input
              id="searchInput"
              type="text"
              class="w-full rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 pl-10 pr-3 py-2 text-sm outline-none focus:border-primary transition"
              placeholder="Buscar contacto..."
              onkeyup="filterContacts()"
            />
          </div>
        </div>

        <!-- Contact List -->
        <div id="contactList" class="flex-1 overflow-y-auto">
          <% if (convList.length > 0) { %>
            <% convList.forEach((contact, idx) => { %>
              <div
                class="contact-item flex items-center gap-3 p-4 border-b border-slate-100 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/50 cursor-pointer transition"
                data-phone="<%= contact.phoneNumber %>"
                data-name="<%= contact.name || contact.phoneNumber %>"
                onclick="openChat('<%= contact.phoneNumber %>', '<%= contact.name || contact.phoneNumber %>')"
              >
                <!-- Avatar -->
                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-primary to-primary-700 flex items-center justify-center text-white font-semibold flex-shrink-0">
                  <%= (contact.name || contact.phoneNumber).substring(0, 2).toUpperCase() %>
                </div>

                <!-- Info -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between mb-1">
                    <h3 class="font-semibold text-slate-900 dark:text-white truncate">
                      <%= contact.name || contact.phoneNumber %>
                    </h3>
                    <span class="text-xs text-slate-500">
                      <%= fmtTime(contact.updatedAt) %>
                    </span>
                  </div>
                  <p class="text-sm text-slate-500 dark:text-slate-400 truncate">
                    <%= contact.phoneNumber %>
                  </p>
                </div>

                <!-- Unread badge (placeholder) -->
                <div class="unread-badge hidden w-6 h-6 rounded-full bg-whatsapp text-white text-xs font-bold flex items-center justify-center notification-badge">
                  0
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="flex flex-col items-center justify-center h-full p-8 text-center">
              <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
                <i data-lucide="inbox" class="icon-lg text-slate-400"></i>
              </div>
              <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">No hay conversaciones</p>
              <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Las conversaciones aparecerán aquí</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Chat Panel -->
      <div id="chatPanel" class="bg-white dark:bg-slate-900 rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 flex flex-col overflow-hidden">
        
        <!-- Empty State -->
        <div id="emptyState" class="flex flex-col items-center justify-center h-full p-8 text-center">
          <div class="w-24 h-24 rounded-full bg-gradient-to-br from-primary/10 to-primary/5 flex items-center justify-center mb-6">
            <i data-lucide="message-circle" class="w-12 h-12 text-primary"></i>
          </div>
          <h2 class="text-2xl font-bold text-slate-800 dark:text-white mb-2">Selecciona una conversación</h2>
          <p class="text-slate-500 dark:text-slate-400">Elige un contacto para ver el historial y enviar mensajes</p>
        </div>

        <!-- Active Chat (hidden by default) -->
        <div id="activeChat" class="hidden h-full flex flex-col">
          
          <!-- Chat Header -->
          <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200 dark:border-slate-700 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
            <div class="flex items-center gap-3">
              <button class="md:hidden" onclick="closeChat()">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
              </button>
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary to-primary-700 flex items-center justify-center text-white font-semibold">
                <span id="chatAvatar">A</span>
              </div>
              <div>
                <h3 id="chatName" class="font-bold text-slate-900 dark:text-white">Contacto</h3>
                <p id="chatPhone" class="text-sm text-slate-500 dark:text-slate-400">+51 999 999 999</p>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <button
                class="inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium bg-rose-500 hover:bg-rose-600 text-white transition shadow-soft"
                onclick="deleteCurrentConversation()">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
                <span class="hidden sm:inline">Eliminar</span>
              </button>
            </div>
          </div>

          <!-- Messages Container -->
          <div id="messagesContainer" class="flex-1 overflow-y-auto p-6 space-y-3 bg-slate-50 dark:bg-slate-900 chat-messages">
            <!-- Messages will be loaded here -->
          </div>

          <!-- Typing Indicator -->
          <div id="typingIndicator" class="hidden px-6 py-2">
            <div class="typing-indicator">
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>

          <!-- Message Input -->
          <div class="border-t border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-4">
            
            <!-- File Preview -->
            <div id="filePreviewContainer" class="hidden mb-3 p-3 bg-slate-50 dark:bg-slate-900 rounded-lg">
              <div class="flex items-start gap-3">
                <div id="filePreview" class="file-preview"></div>
                <div class="flex-1">
                  <p id="fileName" class="text-sm font-medium text-slate-700 dark:text-slate-300"></p>
                  <p id="fileSize" class="text-xs text-slate-500"></p>
                </div>
                <button onclick="removeFile()" class="text-rose-500 hover:text-rose-600">
                  <i data-lucide="x" class="w-5 h-5"></i>
                </button>
              </div>
            </div>

            <form id="messageForm" class="flex items-end gap-2">
              <input type="file" id="fileInput" class="hidden" accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx,.zip" onchange="handleFileSelect(event)">
              
              <button type="button"
                      class="flex-shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-lg bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 transition"
                      onclick="document.getElementById('fileInput').click()">
                <i data-lucide="paperclip" class="w-5 h-5"></i>
              </button>

              <div class="flex-1 relative">
                <textarea
                  id="messageInput"
                  rows="1"
                  class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 text-sm outline-none focus:border-primary transition resize-none"
                  placeholder="Escribe un mensaje..."
                  onkeydown="handleKeyDown(event)"
                  oninput="autoResize(this)"
                ></textarea>
              </div>

              <button type="submit"
                      class="flex-shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-lg bg-whatsapp hover:bg-whatsapp-dark text-white transition shadow-soft">
                <i data-lucide="send" class="w-5 h-5"></i>
              </button>
            </form>

            <div id="sendStatus" class="hidden mt-2 text-xs text-center"></div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    // Global state
    let currentPhone = null;
    let currentName = null;
    let notificationsEnabled = localStorage.getItem('notificationsEnabled') !== 'false';
    let lastMessageCheck = new Date().toISOString();
    let selectedFile = null;

    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
      updateNotificationButton();
      startMessagePolling();
    });

    // Notification toggle
    function toggleNotifications() {
      notificationsEnabled = !notificationsEnabled;
      localStorage.setItem('notificationsEnabled', notificationsEnabled);
      updateNotificationButton();
      
      if (notificationsEnabled) {
        showToast('✅ Notificaciones activadas', 'success');
        playNotificationSound();
      } else {
        showToast('🔕 Notificaciones desactivadas', 'info');
      }
    }

    function updateNotificationButton() {
      const btn = document.getElementById('toggleNotifications');
      const icon = document.getElementById('bellIcon');
      const status = document.getElementById('notificationStatus');
      
      if (notificationsEnabled) {
        btn.classList.remove('opacity-50');
        icon.setAttribute('data-lucide', 'bell');
        status.textContent = 'Sonido ON';
      } else {
        btn.classList.add('opacity-50');
        icon.setAttribute('data-lucide', 'bell-off');
        status.textContent = 'Sonido OFF';
      }
      
      if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
    }

    // Play notification sound
    function playNotificationSound() {
      if (!notificationsEnabled) return;
      
      const audio = document.getElementById('notificationSound');
      audio.play().catch(err => console.log('Could not play sound:', err));
    }

    // Filter contacts
    function filterContacts() {
      const input = document.getElementById('searchInput');
      const filter = input.value.toLowerCase();
      const contacts = document.querySelectorAll('.contact-item');

      contacts.forEach(contact => {
        const phone = contact.dataset.phone.toLowerCase();
        const name = contact.dataset.name.toLowerCase();
        
        if (phone.includes(filter) || name.includes(filter)) {
          contact.style.display = '';
        } else {
          contact.style.display = 'none';
        }
      });
    }

    // Open chat
    async function openChat(phone, name) {
      currentPhone = phone;
      currentName = name;

      document.getElementById('emptyState').classList.add('hidden');
      document.getElementById('activeChat').classList.remove('hidden');
      document.getElementById('chatName').textContent = name;
      document.getElementById('chatPhone').textContent = phone;
      document.getElementById('chatAvatar').textContent = name.substring(0, 2).toUpperCase();

      document.querySelectorAll('.contact-item').forEach(item => {
        item.classList.remove('bg-primary/10');
      });
      document.querySelector(`[data-phone="${phone}"]`)?.classList.add('bg-primary/10');

      if (window.innerWidth < 768) {
        document.querySelector('.contacts-panel').classList.add('hidden-mobile');
      }

      await loadMessages(phone);

      const badge = document.querySelector(`[data-phone="${phone}"] .unread-badge`);
      if (badge) {
        badge.classList.add('hidden');
        badge.textContent = '0';
      }
    }

    // Close chat (mobile)
    function closeChat() {
      document.getElementById('emptyState').classList.remove('hidden');
      document.getElementById('activeChat').classList.add('hidden');
      document.querySelector('.contacts-panel').classList.remove('hidden-mobile');
      currentPhone = null;
      currentName = null;
    }

    // Load messages
    async function loadMessages(phone) {
      try {
        const res = await fetch(`/conversations/api/${phone}`);
        const data = await res.json();

        const container = document.getElementById('messagesContainer');
        
        if (data.messages && data.messages.length > 0) {
          container.innerHTML = data.messages.map(msg => renderMessage(msg)).join('');
        } else {
          container.innerHTML = `
            <div class="flex flex-col items-center justify-center h-full text-center text-slate-400">
              <i data-lucide="inbox" class="w-12 h-12 mb-3 opacity-50"></i>
              <p class="text-sm">No hay mensajes en esta conversación</p>
            </div>
          `;
        }

        if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
        scrollToBottom();
      } catch (error) {
        console.error('Error loading messages:', error);
        showToast('❌ Error al cargar mensajes', 'error');
      }
    }

    // Render message
    function renderMessage(msg) {
      const isUser = msg.role === 'USER';
      const time = new Date(msg.createdAt).toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit' });

      return `
        <div class="flex ${isUser ? 'justify-end' : 'justify-start'}">
          <div class="message-bubble ${isUser ? 'bg-primary text-white rounded-br-none' : 'bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-bl-none'} px-4 py-2 rounded-2xl shadow-soft">
            <p class="text-sm whitespace-pre-wrap break-words">${escapeHtml(msg.content)}</p>
            <p class="text-xs ${isUser ? 'text-white/70' : 'text-slate-400'} mt-1 text-right">${time}</p>
          </div>
        </div>
      `;
    }

    // File handling
    function handleFileSelect(event) {
      const file = event.target.files[0];
      if (!file) return;

      selectedFile = file;

      const container = document.getElementById('filePreviewContainer');
      const preview = document.getElementById('filePreview');
      const fileName = document.getElementById('fileName');
      const fileSize = document.getElementById('fileSize');

      fileName.textContent = file.name;
      fileSize.textContent = formatFileSize(file.size);

      if (file.type.startsWith('image/')) {
        const reader = new FileReader();
        reader.onload = (e) => {
          preview.innerHTML = `<img src="${e.target.result}" alt="Preview" class="max-w-[150px] max-h-[150px] rounded-lg">`;
        };
        reader.readAsDataURL(file);
      } else {
        preview.innerHTML = `<div class="w-16 h-16 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center"><i data-lucide="file" class="w-8 h-8 text-slate-400"></i></div>`;
        if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
      }

      container.classList.remove('hidden');
    }

    function removeFile() {
      selectedFile = null;
      document.getElementById('fileInput').value = '';
      document.getElementById('filePreviewContainer').classList.add('hidden');
    }

    function formatFileSize(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    // Send message
    document.getElementById('messageForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (!currentPhone) {
        showToast('⚠️ Selecciona un contacto primero', 'warning');
        return;
      }

      const input = document.getElementById('messageInput');
      const message = input.value.trim();

      if (selectedFile) {
        await sendFile();
        return;
      }

      if (!message) return;

      try {
        showSendStatus('Enviando...', 'loading');

        const res = await fetch(`/conversations/api/${currentPhone}/send`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message })
        });

        const data = await res.json();

        if (data.success) {
          input.value = '';
          input.style.height = 'auto';
          
          const container = document.getElementById('messagesContainer');
          const emptyMsg = container.querySelector('.flex.flex-col.items-center');
          if (emptyMsg) container.innerHTML = '';

          container.innerHTML += renderMessage({
            role: 'ASSISTANT',
            content: message,
            createdAt: new Date().toISOString()
          });

          if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
          scrollToBottom();
          showSendStatus('✓ Enviado', 'success');
          
          setTimeout(() => hideSendStatus(), 2000);
        } else {
          showSendStatus('✗ Error: ' + data.error, 'error');
        }
      } catch (error) {
        console.error('Error sending message:', error);
        showSendStatus('✗ Error al enviar', 'error');
      }
    });

    // Send file
    async function sendFile() {
      if (!selectedFile || !currentPhone) return;

      try {
        showSendStatus('Enviando archivo...', 'loading');

        const formData = new FormData();
        formData.append('file', selectedFile);
        formData.append('caption', document.getElementById('messageInput').value.trim());

        const res = await fetch(`/conversations/api/${currentPhone}/send-media`, {
          method: 'POST',
          body: formData
        });

        const data = await res.json();

        if (data.success) {
          document.getElementById('messageInput').value = '';
          removeFile();

          const container = document.getElementById('messagesContainer');
          container.innerHTML += renderMessage({
            role: 'ASSISTANT',
            content: `📎 ${selectedFile.name}`,
            createdAt: new Date().toISOString()
          });

          if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
          scrollToBottom();
          showSendStatus('✓ Archivo enviado', 'success');
          
          setTimeout(() => hideSendStatus(), 2000);
        } else {
          showSendStatus('✗ Error: ' + data.error, 'error');
        }
      } catch (error) {
        console.error('Error sending file:', error);
        showSendStatus('✗ Error al enviar archivo', 'error');
      }
    }

    // Send status
    function showSendStatus(text, type) {
      const status = document.getElementById('sendStatus');
      status.textContent = text;
      status.className = `mt-2 text-xs text-center ${
        type === 'loading' ? 'text-blue-600' :
        type === 'success' ? 'text-green-600' :
        type === 'error' ? 'text-red-600' : ''
      }`;
      status.classList.remove('hidden');
    }

    function hideSendStatus() {
      document.getElementById('sendStatus').classList.add('hidden');
    }

    // Auto-resize textarea
    function autoResize(textarea) {
      textarea.style.height = 'auto';
      textarea.style.height = Math.min(textarea.scrollHeight, 150) + 'px';
    }

    // Handle Enter key
    function handleKeyDown(event) {
      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault();
        document.getElementById('messageForm').dispatchEvent(new Event('submit'));
      }
    }

    // Delete conversation
    async function deleteCurrentConversation() {
      if (!currentPhone) return;
      
      if (!confirm(`¿Eliminar toda la conversación con ${currentName}?\n\nEsta acción no se puede deshacer.`)) return;

      try {
        const res = await fetch(`/conversations/api/${currentPhone}`, {
          method: 'DELETE'
        });

        const data = await res.json();

        if (data.success) {
          showToast('✅ Conversación eliminada', 'success');
          closeChat();
          
          document.querySelector(`[data-phone="${currentPhone}"]`)?.remove();
        } else {
          showToast('❌ Error al eliminar', 'error');
        }
      } catch (error) {
        console.error('Error deleting conversation:', error);
        showToast('❌ Error al eliminar', 'error');
      }
    }

    // Message polling
    function startMessagePolling() {
      setInterval(checkNewMessages, 3000);
    }

    async function checkNewMessages() {
      try {
        const res = await fetch(`/conversations/api/new-messages/check?lastCheck=${lastMessageCheck}`);
        const data = await res.json();

        if (data.hasNew && data.messages.length > 0) {
          lastMessageCheck = new Date().toISOString();
          playNotificationSound();

          data.messages.forEach(msg => {
            const badge = document.querySelector(`[data-phone="${msg.phoneNumber}"] .unread-badge`);
            if (badge) {
              const current = parseInt(badge.textContent) || 0;
              badge.textContent = current + 1;
              badge.classList.remove('hidden');
            }
          });

          if (currentPhone && data.messages.some(m => m.phoneNumber === currentPhone)) {
            await loadMessages(currentPhone);
          }

          showToast(`💬 ${data.count} mensaje(s) nuevo(s)`, 'info');
        }
      } catch (error) {
        console.error('Error checking messages:', error);
      }
    }

    // Toast notification
    function showToast(message, type = 'info') {
      const toast = document.createElement('div');
      toast.className = `fixed bottom-6 right-6 z-50 px-6 py-3 rounded-lg shadow-lg text-white font-medium transform translate-y-0 transition-all duration-300 ${
        type === 'success' ? 'bg-green-500' :
        type === 'error' ? 'bg-red-500' :
        type === 'warning' ? 'bg-amber-500' :
        'bg-blue-500'
      }`;
      toast.textContent = message;
      
      document.body.appendChild(toast);
      
      setTimeout(() => {
        toast.style.transform = 'translateY(100px)';
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    // Scroll to bottom
    function scrollToBottom() {
      const container = document.getElementById('messagesContainer');
      requestAnimationFrame(() => {
        container.scrollTop = container.scrollHeight;
      });
    }

    // Escape HTML
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }
  </script>
</body>
</html>