<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind (misma config del dashboard) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary:   { DEFAULT:'#667eea', 600:'#667eea', 700:'#5a67d8' },
            secondary: { DEFAULT:'#764ba2', 600:'#764ba2', 700:'#6b3fa0' },
          },
          boxShadow: {
            soft:'0 4px 6px -1px rgba(0,0,0,.08), 0 2px 4px -1px rgba(0,0,0,.04)',
            card:'0 10px 30px -5px rgba(0,0,0,.10)'
          }
        }
      },
      darkMode:'media'
    }
  </script>

  <!-- Utilidades externas del dashboard -->
  <link rel="stylesheet" href="/css/ui.css">

  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Gradient text */
    .gradient-text {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Icon sizes */
    .icon { width: 1.25rem; height: 1.25rem; }
    .icon-lg { width: 1.75rem; height: 1.75rem; }

    .hidden-row { display: none; }
    .badge-on  { background-color: rgba(16,185,129,.15); color:#059669; }
    .badge-off { background-color: rgba(244,63,94,.15);  color:#e11d48; }
  </style>
</head>

<body class="h-full bg-gradient-to-br from-slate-50 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 text-slate-800 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-4 focus:py-2 focus:rounded-lg shadow-lg">
    Saltar al contenido
  </a>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Volver al Dashboard + breadcrumb (mismos estilos) -->
    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <a href="/"
           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">
          <i data-lucide="arrow-left" class="icon"></i>
          <span>Volver al Dashboard</span>
        </a>
      </div>

      <nav aria-label="Breadcrumb" class="text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li class="inline-flex items-center gap-1">
            <a href="/" class="hover:underline inline-flex items-center gap-1">
              <i data-lucide="home" class="w-3.5 h-3.5"></i> Inicio
            </a>
          </li>
          <li class="select-none">/</li>
          <li class="inline-flex items-center gap-1">
            <i data-lucide="building-2" class="w-3.5 h-3.5"></i>
            <span class="font-medium">Departamentos</span>
          </li>
        </ol>
      </nav>
    </div>

    <!-- Header (igual estilo que Empresas) -->
    <header class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight gradient-text flex items-center gap-3">
            <i data-lucide="building-2" class="icon-lg text-primary"></i>
            Departamentos
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            Gestión de áreas, palabras clave y contactos responsables
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white px-4 py-2.5 text-sm font-semibold shadow-soft transition"
            onclick="openDeptModal()">
            <i data-lucide="plus-circle" class="icon"></i>
            <span>Nuevo Departamento</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Buscador (calc igual que Empresas) -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center">
            <i data-lucide="search" class="icon text-indigo-600 dark:text-indigo-400"></i>
          </div>
          Buscar Departamentos
        </h2>
      </div>

      <div class="p-6">
        <div class="flex flex-col sm:flex-row sm:items-end gap-4">
          <div class="flex-1">
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
              Buscar por nombre, descripción o teléfono
            </label>
            <input
              id="searchInput"
              type="text"
              class="w-full rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 transition"
              placeholder="Ej: Ventas, Soporte, 51999988877"
              oninput="filterRows()"
            />
          </div>

          <div class="text-sm text-slate-500 dark:text-slate-400 flex-shrink-0">
            Total: <span id="countVisible" class="font-semibold text-slate-700 dark:text-slate-200"><%= (departments||[]).length %></span> / <%= (departments||[]).length %> departamentos
          </div>
        </div>
      </div>
    </section>

    <!-- Lista en tabla (mismos estilos de “Lista de Empresas”) -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center">
            <i data-lucide="list" class="icon text-blue-600 dark:text-blue-400"></i>
          </div>
          Lista de Departamentos
        </h2>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full text-sm" id="deptsTable">
          <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-400 uppercase text-xs tracking-wider font-semibold">
            <tr>
              <th class="text-left px-6 py-4">Nombre</th>
              <th class="text-left px-6 py-4">Estado</th>
              <th class="text-left px-6 py-4">Teléfono</th>
              <th class="text-left px-6 py-4">Palabras clave</th>
              <th class="text-left px-6 py-4">Contactos</th>
              <th class="text-left px-6 py-4">Acciones</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-100 dark:divide-slate-800" id="deptsTbody">
            <% const depts = (departments||[]); %>
            <% if (depts.length > 0) { %>
              <% depts.forEach(d => { %>
                <tr
                  class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors"
                  data-row-id="<%= d.id %>"
                  data-search-text="<%- [
                    d.name || '',
                    d.description || '',
                    d.phoneNumber || '',
                    ...(d.keywords||[]).map(k=>k.keyword).join(' '),
                    ...(d.contacts||[]).map(c=>`${c.name} ${c.phoneNumber||''} ${c.role||''}`).join(' ')
                  ].join(' ').toLowerCase() %>"
                >
                  <td class="px-6 py-4">
                    <div class="font-semibold text-slate-900 dark:text-white"><%= d.name %></div>
                    <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                      <%= d.description || 'Sin descripción' %>
                    </div>
                  </td>

                  <td class="px-6 py-4">
                    <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-semibold leading-none <%= d.isActive ? 'badge-on' : 'badge-off' %>">
                      <%= d.isActive ? 'Activo' : 'Inactivo' %>
                    </span>
                  </td>

                  <td class="px-6 py-4 text-slate-700 dark:text-slate-300">
                    <%= d.phoneNumber || '-' %>
                  </td>

                  <td class="px-6 py-4">
                    <div class="flex flex-wrap gap-1.5">
                      <% (d.keywords||[]).forEach(k => { %>
                        <span class="inline-flex items-center gap-1 rounded-md bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                          <%= k.keyword %>
                          <button class="ml-1 hover:text-rose-600" title="Eliminar" onclick="removeKeyword('<%= k.id %>')">
                            <i data-lucide="x" class="w-3.5 h-3.5"></i>
                          </button>
                        </span>
                      <% }) %>

                      <button
                        class="inline-flex items-center gap-1 text-sky-700 dark:text-sky-300 hover:underline text-xs font-semibold"
                        onclick="openKwModal('<%= d.id %>')">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i> Agregar
                      </button>
                    </div>
                  </td>

                  <td class="px-6 py-4">
                    <div class="flex flex-wrap gap-1.5">
                      <% (d.contacts||[]).forEach(c => { %>
                        <span class="inline-flex items-center gap-1 rounded-md bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                          <i data-lucide="user" class="w-3.5 h-3.5"></i>
                          <span class="truncate max-w-[160px]"><%= c.name %> <%= c.phoneNumber?('· '+c.phoneNumber):'' %> <%= c.role?('· '+c.role):'' %></span>
                          <button class="ml-1 hover:text-rose-600" title="Eliminar" onclick="removeContact('<%= c.id %>')">
                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                          </button>
                        </span>
                      <% }) %>

                      <button
                        class="inline-flex items-center gap-1 text-emerald-700 dark:text-emerald-300 hover:underline text-xs font-semibold"
                        onclick="openCtModal('<%= d.id %>')">
                        <i data-lucide="user-plus" class="w-3.5 h-3.5"></i> Agregar
                      </button>
                    </div>
                  </td>

                  <td class="px-6 py-4">
                    <div class="flex flex-wrap gap-2">
                      <button
                        class="inline-flex items-center gap-1 rounded-lg bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                        onclick="openDeptModal('<%= d.id %>')">
                        <i data-lucide="edit-2" class="w-3.5 h-3.5"></i>
                        <span>Editar</span>
                      </button>

                      <button
                        class="inline-flex items-center gap-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                        onclick="deleteDept('<%= d.id %>')">
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        <span>Eliminar</span>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" class="px-6 py-16 text-center">
                  <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4">
                    <i data-lucide="inbox" class="icon-lg text-slate-400"></i>
                  </div>
                  <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">No hay departamentos</p>
                  <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Crea el primero con “Nuevo Departamento”</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <!-- Modal Crear/Editar Departamento -->
  <div id="dept-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-xl w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between sticky top-0 bg-white dark:bg-slate-900 z-10">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="building-2" class="icon text-primary"></i>
          <span id="dept-modal-title">Nuevo Departamento</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="closeDeptModal()">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6">
        <input type="hidden" id="deptId" />

        <div class="grid gap-4 md:grid-cols-2">
          <div class="md:col-span-2">
            <label class="block text-sm font-semibold mb-2">Nombre *</label>
            <input id="deptName" type="text" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>

          <div class="md:col-span-2">
            <label class="block text-sm font-semibold mb-2">Descripción</label>
            <textarea id="deptDesc" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 min-h-[80px]"></textarea>
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2">Teléfono</label>
            <input id="deptPhone" type="text" placeholder="51999888777" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2">Estado</label>
            <select id="deptActive" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500">
              <option value="true">Activo</option>
              <option value="false">Inactivo</option>
            </select>
          </div>
        </div>

        <div class="mt-6 flex justify-end gap-2 pt-2 border-t border-slate-200 dark:border-slate-700">
          <button
            type="button"
            class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition"
            onclick="closeDeptModal()">
            Cancelar
          </button>

          <button
            id="dept-save-btn"
            class="rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition"
            onclick="saveDept()">
            Guardar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Keyword -->
  <div id="kw-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-md w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="key" class="icon text-primary"></i>
          <span>Agregar palabra clave</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="closeKwModal()">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6">
        <input type="hidden" id="kwDeptId" />
        <div class="grid gap-4">
          <div>
            <label class="block text-sm font-semibold mb-2">Palabra clave *</label>
            <input id="kwText" type="text" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>
          <div>
            <label class="block text-sm font-semibold mb-2">Prioridad</label>
            <input id="kwPriority" type="number" value="1" min="1" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>
        </div>

        <div class="mt-6 flex justify-end gap-2 pt-2 border-t border-slate-200 dark:border-slate-700">
          <button class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition" onclick="closeKwModal()">Cancelar</button>
          <button class="rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition" onclick="addKeyword()">Agregar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Contacto -->
  <div id="ct-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-md w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="user-plus" class="icon text-primary"></i>
          <span>Agregar contacto</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="closeCtModal()">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6">
        <input type="hidden" id="ctDeptId" />
        <div class="grid gap-4">
          <div>
            <label class="block text-sm font-semibold mb-2">Nombre *</label>
            <input id="ctName" type="text" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>
          <div>
            <label class="block text-sm font-semibold mb-2">Teléfono *</label>
            <input id="ctPhone" type="text" placeholder="51999888777" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>
          <div>
            <label class="block text-sm font-semibold mb-2">Cargo</label>
            <input id="ctRole" type="text" placeholder="Vendedor Senior" class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500" />
          </div>
        </div>

        <div class="mt-6 flex justify-end gap-2 pt-2 border-t border-slate-200 dark:border-slate-700">
          <button class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition" onclick="closeCtModal()">Cancelar</button>
          <button class="rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition" onclick="addContact()">Agregar</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Iconos
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
    });

    // === Refs
    const tbodyEl        = document.getElementById('deptsTbody');
    const searchInputEl  = document.getElementById('searchInput');
    const countVisibleEl = document.getElementById('countVisible');

    // === Buscador
    function filterRows() {
      const q = (searchInputEl.value || '').trim().toLowerCase();
      const rows = tbodyEl.querySelectorAll('tr[data-row-id]');
      let visible = 0;
      rows.forEach(row => {
        const hay = row.getAttribute('data-search-text') || '';
        const match = !q || hay.includes(q);
        row.classList.toggle('hidden-row', !match);
        if (match) visible++;
      });
      countVisibleEl.textContent = String(visible);
    }

    // === Modales (helpers comunes)
    function openFlex(id){ const el = document.getElementById(id); el.classList.remove('hidden'); el.classList.add('flex'); }
    function closeFlex(id){ const el = document.getElementById(id); el.classList.remove('flex'); el.classList.add('hidden'); }

    // === Departamento CRUD
    const deptModal      = 'dept-modal';
    const deptTitleEl    = document.getElementById('dept-modal-title');
    const deptIdEl       = document.getElementById('deptId');
    const deptNameEl     = document.getElementById('deptName');
    const deptDescEl     = document.getElementById('deptDesc');
    const deptPhoneEl    = document.getElementById('deptPhone');
    const deptActiveEl   = document.getElementById('deptActive');

    function openDeptModal(id='') {
      if (id) {
        deptTitleEl.textContent = 'Editar Departamento';
        fetch(`/departments/api/${id}`)
          .then(r => r.json())
          .then(d => {
            deptIdEl.value     = d.id || '';
            deptNameEl.value   = d.name || '';
            deptDescEl.value   = d.description || '';
            deptPhoneEl.value  = d.phoneNumber || '';
            deptActiveEl.value = d.isActive ? 'true' : 'false';
            openFlex(deptModal);
          })
          .catch(() => alert('❌ Error al cargar el departamento'));
      } else {
        deptTitleEl.textContent = 'Nuevo Departamento';
        deptIdEl.value = ''; deptNameEl.value=''; deptDescEl.value=''; deptPhoneEl.value=''; deptActiveEl.value='true';
        openFlex(deptModal);
      }
    }
    function closeDeptModal(){ closeFlex(deptModal); }

    async function saveDept() {
      const id   = deptIdEl.value;
      const data = {
        name: deptNameEl.value.trim(),
        description: deptDescEl.value.trim(),
        phoneNumber: deptPhoneEl.value.trim(),
        isActive: deptActiveEl.value === 'true'
      };
      if (!data.name) { alert('Nombre es obligatorio'); return; }

      try {
        const res = await fetch(id ? `/departments/api/${id}` : '/departments/api', {
          method: id ? 'PUT' : 'POST',
          headers: { 'Content-Type':'application/json' },
          body: JSON.stringify(data)
        });
        if (!res.ok) throw new Error();
        alert('✅ Departamento guardado');
        location.reload();
      } catch {
        alert('❌ No se pudo guardar');
      }
    }

    async function deleteDept(id){
      if (!confirm('¿Eliminar este departamento? Esta acción no se puede deshacer.')) return;
      try {
        const res = await fetch(`/departments/api/${id}`, { method:'DELETE' });
        if (!res.ok) throw new Error();
        alert('✅ Departamento eliminado');
        location.reload();
      } catch {
        alert('❌ No se pudo eliminar');
      }
    }

    // === Keywords
    const kwModal  = 'kw-modal';
    const kwDeptId = document.getElementById('kwDeptId');
    const kwText   = document.getElementById('kwText');
    const kwPrio   = document.getElementById('kwPriority');

    function openKwModal(deptId){ kwDeptId.value = deptId; kwText.value=''; kwPrio.value='1'; openFlex(kwModal); }
    function closeKwModal(){ closeFlex(kwModal); }

    async function addKeyword(){
      const deptId = kwDeptId.value;
      const payload = { keyword: kwText.value.trim(), priority: parseInt(kwPrio.value||'1',10) };
      if (!payload.keyword){ alert('Ingresa una palabra clave'); return; }
      try {
        const res = await fetch(`/departments/api/${deptId}/keywords`, {
          method:'POST',
          headers:{ 'Content-Type':'application/json' },
          body: JSON.stringify(payload)
        });
        if (!res.ok) throw new Error();
        alert('✅ Palabra clave agregada');
        location.reload();
      } catch { alert('❌ No se pudo agregar'); }
    }

    async function removeKeyword(id){
      if (!confirm('¿Eliminar esta palabra clave?')) return;
      try {
        const res = await fetch(`/departments/api/keywords/${id}`, { method:'DELETE' });
        if (!res.ok) throw new Error();
        alert('✅ Palabra clave eliminada');
        location.reload();
      } catch { alert('❌ No se pudo eliminar'); }
    }

    // === Contactos
    const ctModal  = 'ct-modal';
    const ctDeptId = document.getElementById('ctDeptId');
    const ctName   = document.getElementById('ctName');
    const ctPhone  = document.getElementById('ctPhone');
    const ctRole   = document.getElementById('ctRole');

    function openCtModal(deptId){ ctDeptId.value=deptId; ctName.value=''; ctPhone.value=''; ctRole.value=''; openFlex(ctModal); }
    function closeCtModal(){ closeFlex(ctModal); }

    async function addContact(){
      const deptId = ctDeptId.value;
      const payload = { name: ctName.value.trim(), phoneNumber: ctPhone.value.trim(), role: ctRole.value.trim() };
      if (!payload.name || !payload.phoneNumber){ alert('Nombre y Teléfono son obligatorios'); return; }
      try {
        const res = await fetch(`/departments/api/${deptId}/contacts`, {
          method:'POST',
          headers:{ 'Content-Type':'application/json' },
          body: JSON.stringify(payload)
        });
        if (!res.ok) throw new Error();
        alert('✅ Contacto agregado');
        location.reload();
      } catch { alert('❌ No se pudo agregar'); }
    }

    async function removeContact(id){
      if (!confirm('¿Eliminar este contacto?')) return;
      try {
        const res = await fetch(`/departments/api/contacts/${id}`, { method:'DELETE' });
        if (!res.ok) throw new Error();
        alert('✅ Contacto eliminado');
        location.reload();
      } catch { alert('❌ No se pudo eliminar'); }
    }

    // Cerrar modales al click fuera
    window.addEventListener('click', (e) => {
      ['dept-modal','kw-modal','ct-modal'].forEach(mid=>{
        const m = document.getElementById(mid);
        if (e.target === m) closeFlex(mid);
      });
    });

    // Exponer
    window.filterRows   = filterRows;
    window.openDeptModal= openDeptModal;
    window.closeDeptModal=closeDeptModal;
    window.saveDept     = saveDept;
    window.deleteDept   = deleteDept;

    window.openKwModal  = openKwModal;
    window.closeKwModal = closeKwModal;
    window.addKeyword   = addKeyword;
    window.removeKeyword= removeKeyword;

    window.openCtModal  = openCtModal;
    window.closeCtModal = closeCtModal;
    window.addContact   = addContact;
    window.removeContact= removeContact;
  </script>
</body>
</html>
