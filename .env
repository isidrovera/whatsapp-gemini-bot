# ===== Database (en Docker el host es 'db') =====
DATABASE_URL=postgresql://postgres:system15@db:5432/whatsapp_bot?schema=public

# ===== Gemini AI =====
GEMINI_API_KEY=

# ===== External APIs (opcional) =====
RENIEC_API_TOKEN=
SUNAT_API_TOKEN=

# ===== Web Server =====
WEB_PORT=3000

# ===== Sesión / Cookies =====
SESSION_SECRET=whatsapp-bot-super-secret-key-change-in-production
COOKIE_SECURE=true          # <— **true**: estás detrás de HTTPS real
TRUST_PROXY=1               # <— **1**: Express confía en el proxy (equivale a app.set('trust proxy', 1))
# Si tu panel y dominio son el MISMO origen, NO pongas SameSite=None.
# Si necesitas cross-site (otro dominio/origen), añade:
# CROSS_SITE=true           # fuerza SameSite=None (requiere Secure=true)

# ===== Entorno / Zona horaria =====
NODE_ENV=production
TZ=America/Lima

# ===== Prisma =====
PRISMA_CLIENT_ENGINE_TYPE=binary
