<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente + Tailwind -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui'] },
          colors: {
            primary: { DEFAULT: '#1e3a8a', 600: '#1e3a8a', 700:'#1e40af' },
          },
          boxShadow: {
            soft: '0 10px 25px -10px rgba(0,0,0,.15)',
          }
        }
      },
      darkMode: 'media'
    }
  </script>

  <!-- Animaciones / icons -->
  <script src="https://unpkg.com/@motionone/dom/dist/motion.min.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    .sidebar-link-active {
      background-color: rgba(255,255,255,.12);
      color:#fff !important;
      font-weight:600;
    }

    /* Import result styles (reusamos tu semántica) */
    .import-result {
      margin-top: 20px;
      padding: 15px;
      border-radius: 8px;
      font-size: 14px;
    }
    .import-result.success {
      background: #d1fae5;
      border: 1px solid #6ee7b7;
      color: #065f46;
    }
    .import-result.error {
      background: #fee2e2;
      border: 1px solid #fca5a5;
      color: #991b1b;
    }
    .import-result.warning {
      background: #fef3c7;
      border: 1px solid #fcd34d;
      color: #92400e;
    }

    .spinner {
      display: inline-block;
      width: 16px;
      height: 16px;
      border: 2px solid #f3f4f6;
      border-top-color: #3b82f6;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Modal (mantengo tu comportamiento show/hide con display:block/none) */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1000;
      background: rgba(0,0,0,0.6);
      backdrop-filter: blur(4px);
    }
  </style>
</head>
<body class="h-full bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-3 focus:py-2 focus:rounded-lg shadow">
    Saltar al contenido
  </a>

  <%
    const blockedList = Array.isArray(blocked) ? blocked : [];
    function isActive(p){
      return (page === p || (!page && p==='dashboard')) ? 'sidebar-link-active' : '';
    }
  %>

  <div class="min-h-screen w-full flex relative">

    <!-- Overlay móvil -->
    <div id="mobile-sidebar-overlay"
         class="fixed inset-0 bg-black/40 z-40 opacity-0 pointer-events-none transition-opacity md:hidden">
    </div>

    <!-- Sidebar -->
    <aside id="sidebar"
           class="w-[280px] flex flex-col bg-gradient-to-b from-primary to-primary-700 text-white shadow-soft
                  fixed inset-y-0 left-0 z-50 -translate-x-full transition-transform md:translate-x-0 md:relative md:flex"
           role="navigation"
           aria-label="Menú principal">

      <div class="px-5 py-6 border-b border-white/10 bg-white/5 backdrop-blur flex items-center justify-between">
        <h2 class="text-xl font-semibold flex items-center gap-2">
          <i data-lucide="bot" class="w-5 h-5"></i> Bot Admin
        </h2>

        <!-- Botón cerrar sidebar móvil -->
        <button id="close-sidebar-btn"
                class="md:hidden inline-flex items-center justify-center rounded-lg text-white/70 hover:text-white hover:bg-white/10 p-2"
                aria-label="Cerrar menú">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <nav class="py-4 flex-1 overflow-y-auto">
        <ul class="px-2 space-y-1 text-[15px] leading-5">
          <li>
            <a href="/"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('dashboard') %>">
              <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
              <span>Dashboard</span>
            </a>
          </li>

          <li>
            <a href="/contacts"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('contacts') %>">
              <i data-lucide="users" class="w-5 h-5"></i>
              <span>Contactos</span>
            </a>
          </li>

          <li>
            <a href="/conversations"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('conversations') %>">
              <i data-lucide="message-circle" class="w-5 h-5"></i>
              <span>Conversaciones</span>
            </a>
          </li>

          <li>
            <a href="/blocked"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('blocked') %>">
              <i data-lucide="ban" class="w-5 h-5"></i>
              <span>Bloqueados</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/calendar"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('calendar') %>">
              <i data-lucide="calendar" class="w-5 h-5"></i>
              <span>Calendario</span>
            </a>
          </li>

          <li>
            <a href="/working-hours"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('working-hours') %>">
              <i data-lucide="clock" class="w-5 h-5"></i>
              <span>Horarios</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/departments"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('departments') %>">
              <i data-lucide="building-2" class="w-5 h-5"></i>
              <span>Departamentos</span>
            </a>
          </li>

          <li>
            <a href="/products"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('products') %>">
              <i data-lucide="package" class="w-5 h-5"></i>
              <span>Productos</span>
            </a>
          </li>

          <li>
            <a href="/auto-responses"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('auto-responses') %>">
              <i data-lucide="robot" class="w-5 h-5"></i>
              <span>Auto-respuestas</span>
            </a>
          </li>

          <li>
            <a href="/tags"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('tags') %>">
              <i data-lucide="tags" class="w-5 h-5"></i>
              <span>Tags</span>
            </a>
          </li>

          <li>
            <a href="/templates"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('templates') %>">
              <i data-lucide="file-text" class="w-5 h-5"></i>
              <span>Plantillas</span>
            </a>
          </li>

          <li>
            <a href="/metrics"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('metrics') %>">
              <i data-lucide="line-chart" class="w-5 h-5"></i>
              <span>Métricas</span>
            </a>
          </li>

          <li><div class="my-3 h-px bg-white/10"></div></li>

          <li>
            <a href="/admin-users"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('admin-users') %>">
              <i data-lucide="shield" class="w-5 h-5"></i>
              <span>Usuarios Admin</span>
            </a>
          </li>

          <li>
            <a href="/settings"
               class="group flex items-center gap-3 rounded-lg px-3 py-2 text-white/90 hover:text-white hover:bg-white/10 transition <%= isActive('settings') %>">
              <i data-lucide="settings" class="w-5 h-5"></i>
              <span>Configuración</span>
            </a>
          </li>
        </ul>
      </nav>

      <div class="mt-auto p-4 bg-white/5 border-t border-white/10">
        <div class="rounded-xl bg-white/10 p-3">
          <div class="text-[11px] uppercase tracking-wide opacity-80">Sesión activa</div>
          <div class="font-semibold text-sm mt-1 flex items-center gap-2">
            <i data-lucide="user" class="w-4 h-4"></i>
            <span><%= user || 'Admin' %></span>
          </div>
        </div>

        <form method="POST" action="/auth/logout" class="mt-3">
          <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>
          <button type="submit"
            class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-white/20 bg-red-500/20 hover:bg-red-500/30 text-white py-2.5 text-sm font-medium transition">
            <i data-lucide="log-out" class="w-4 h-4"></i> Cerrar sesión
          </button>
        </form>
      </div>
    </aside>

    <!-- Main Content -->
    <main id="main-content" class="flex-1 p-4 md:p-8 md:ml-0 ml-0 w-full md:w-auto">
      <!-- Header -->
      <header class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft px-6 py-5 mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-start justify-between w-full md:w-auto">
          <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white flex items-center gap-3">
            <i data-lucide="ban" class="w-7 h-7 text-primary"></i>
            <span>Bloqueados</span>
          </h1>

          <!-- Sidebar móvil -->
          <button id="open-sidebar-btn"
                  class="md:hidden inline-flex items-center justify-center rounded-lg text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 p-2 shadow-soft"
                  aria-label="Abrir menú">
            <i data-lucide="menu" class="w-6 h-6"></i>
          </button>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:justify-end w-full md:w-auto">
          <button class="inline-flex items-center gap-2 rounded-lg bg-slate-600 hover:bg-slate-700 text-white px-3 py-2 text-sm font-semibold shadow-soft transition"
                  onclick="exportToExcel()">
            <i data-lucide="download" class="w-4 h-4"></i>
            <span>Exportar Excel</span>
          </button>

          <button class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 text-sm font-semibold shadow-soft transition"
                  onclick="showModal('addModal')">
            <i data-lucide="plus-circle" class="w-4 h-4"></i>
            <span>Agregar Bloqueo</span>
          </button>
        </div>
      </header>

      <!-- Card grande -->
      <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-soft border border-slate-100/70 dark:border-white/5 p-6">
        <!-- Import Section -->
        <div class="rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 p-5 mb-8">
          <h3 class="text-base font-semibold text-slate-900 dark:text-white flex items-center gap-2 mb-2">
            <i data-lucide="file-spreadsheet" class="w-5 h-5 text-primary"></i>
            <span>Importar desde Excel</span>
          </h3>

          <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Carga un archivo Excel con las columnas:
            <strong>identifier</strong>,
            <strong>type</strong> y
            <strong>reason</strong>.
          </p>

          <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:flex-wrap">
            <a href="/blocked/api/template"
               class="inline-flex items-center gap-2 rounded-lg bg-slate-600 hover:bg-slate-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition"
               download>
              <i data-lucide="file-down" class="w-4 h-4"></i>
              <span>Descargar Plantilla</span>
            </a>

            <!-- FORM IMPORT corregido -->
            <form id="importForm"
                  action="/blocked/api/import"
                  method="POST"
                  enctype="multipart/form-data"
                  class="flex flex-col sm:flex-row sm:items-center gap-3 flex-wrap">

              <div class="relative flex items-center">
                <label for="excelFile"
                       class="inline-flex items-center gap-2 rounded-lg bg-white dark:bg-slate-800 border-2 border-slate-300 dark:border-slate-600 hover:border-indigo-500 text-slate-700 dark:text-slate-200 px-3 py-2 text-sm font-medium cursor-pointer transition">
                  <i data-lucide="paperclip" class="w-4 h-4"></i>
                  <span>Seleccionar archivo</span>
                </label>

                <input
                  type="file"
                  id="excelFile"
                  name="file"
                  accept=".xlsx,.xls"
                  class="absolute left-0 top-0 w-full h-full opacity-0 cursor-pointer"
                  onchange="updateFileName(this)"
                  required
                />
              </div>

              <span id="fileName" class="text-xs text-slate-500 dark:text-slate-400 min-h-[1rem]">
                Ningún archivo seleccionado
              </span>

              <button type="submit"
                      class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition">
                <i data-lucide="rocket" class="w-4 h-4"></i>
                <span>Importar</span>
              </button>
            </form>
          </div>

          <div id="importResult" style="display:none;"></div>
        </div>

        <!-- Buscador -->
        <div class="mb-5">
          <input
            type="text"
            id="searchInput"
            placeholder="🔍 Buscar por número, grupo o razón..."
            onkeyup="filterTable()"
            class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
          />
        </div>

        <!-- Tabla -->
        <% if (blockedList.length > 0) { %>
          <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-white/10">
            <table id="blockedTable" class="min-w-full text-sm bg-white dark:bg-slate-900 rounded-xl overflow-hidden">
              <thead class="bg-slate-50/60 dark:bg-white/5 text-slate-500 dark:text-slate-400 uppercase text-[11px] tracking-wide font-semibold border-b border-slate-200 dark:border-white/10">
                <tr>
                  <th class="text-left px-4 py-3">Identificador</th>
                  <th class="text-left px-4 py-3">Tipo</th>
                  <th class="text-left px-4 py-3">Razón</th>
                  <th class="text-left px-4 py-3">Fecha</th>
                  <th class="text-left px-4 py-3">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 dark:divide-white/10 text-slate-700 dark:text-slate-200">
                <% blockedList.forEach(item => { %>
                  <tr class="hover:bg-slate-50/50 dark:hover:bg-white/5 transition">
                    <td class="px-4 py-3 font-semibold text-slate-900 dark:text-white break-all">
                      <%= item.identifier %>
                    </td>
                    <td class="px-4 py-3">
                      <% if (item.type === 'PHONE') { %>
                        <span class="inline-flex items-center gap-1 rounded-md bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                          📱 Teléfono
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1 rounded-md bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 px-2 py-0.5 text-[11px] font-semibold leading-none">
                          👥 Grupo
                        </span>
                      <% } %>
                    </td>
                    <td class="px-4 py-3 break-words"><%= item.reason || '-' %></td>
                    <td class="px-4 py-3 whitespace-nowrap text-xs text-slate-500 dark:text-slate-400">
                      <%= new Date(item.blockedAt).toLocaleString('es-PE') %>
                    </td>
                    <td class="px-4 py-3">
                      <button
                        class="inline-flex items-center gap-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                        onclick="unblock('<%= encodeURIComponent(item.identifier) %>')">
                        Desbloquear
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center text-slate-500 dark:text-slate-400 py-16">
            <div class="text-4xl mb-3">😌</div>
            <p class="text-base font-semibold text-slate-700 dark:text-white mb-1">
              Sin bloqueos
            </p>
            <p class="text-sm text-slate-500 dark:text-slate-400">
              Los números y grupos bloqueados aparecerán aquí
            </p>
          </div>
        <% } %>
      </section>
    </main>
  </div>

  <!-- Modal Agregar Bloqueo -->
  <div id="addModal" class="modal">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-soft max-w-md w-[90%] mx-auto my-20 border border-slate-200 dark:border-white/10 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200 dark:border-white/10 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
          <span>➕</span>
          <span>Bloquear Número/Grupo</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:text-slate-400 dark:hover:text-white text-xl leading-none"
                onclick="hideModal('addModal')">
          &times;
        </button>
      </div>

      <div class="p-6">
        <form onsubmit="addBlock(event)" class="space-y-4">
          <div>
            <label for="identifier" class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
              Número o ID de Grupo *
            </label>
            <input
              type="text"
              id="identifier"
              required
              placeholder="Ej: 51975399303 o 120363XXX@g.us"
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
            />
            <small class="block text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
              Para teléfonos: incluir código de país (51975399303)<br/>
              Para grupos: usar el JID completo (120363XXX@g.us)
            </small>
          </div>

          <div>
            <label for="type" class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
              Tipo *
            </label>
            <select
              id="type"
              required
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0"
            >
              <option value="">Seleccionar...</option>
              <option value="PHONE">📱 Teléfono</option>
              <option value="GROUP">👥 Grupo</option>
            </select>
          </div>

          <div>
            <label for="reason" class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
              Razón (opcional)
            </label>
            <textarea
              id="reason"
              placeholder="Motivo del bloqueo..."
              class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm text-slate-900 dark:text-white outline-none focus:border-indigo-500 focus:ring-0 min-h-[80px] resize-y"
            ></textarea>
          </div>

          <div class="flex justify-end gap-2 pt-2">
            <button
              type="button"
              class="inline-flex items-center justify-center rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition"
              onclick="hideModal('addModal')">
              Cancelar
            </button>

            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition">
              Bloquear
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    // Iconos
    window.lucide && lucide.createIcons();

    // Sidebar móvil
    (function(){
      const sidebar   = document.getElementById('sidebar');
      const overlay   = document.getElementById('mobile-sidebar-overlay');
      const openBtn   = document.getElementById('open-sidebar-btn');
      const closeBtn  = document.getElementById('close-sidebar-btn');

      function openSidebar(){
        sidebar.classList.remove('-translate-x-full');
        overlay.classList.remove('opacity-0','pointer-events-none');
      }
      function closeSidebar(){
        sidebar.classList.add('-translate-x-full');
        overlay.classList.add('opacity-0','pointer-events-none');
      }

      if (openBtn)  openBtn.addEventListener('click', openSidebar);
      if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
      if (overlay)  overlay.addEventListener('click', closeSidebar);
    })();

    // ======================
    // LÓGICA
    // ======================

    // Actualizar nombre de archivo
    function updateFileName(input) {
      const fileName = document.getElementById('fileName');
      if (input.files.length > 0) {
        fileName.textContent = input.files[0].name;
        fileName.classList.remove('text-slate-500','dark:text-slate-400');
        fileName.classList.add('text-slate-800','dark:text-slate-200');
      } else {
        fileName.textContent = 'Ningún archivo seleccionado';
        fileName.classList.remove('text-slate-800','dark:text-slate-200');
        fileName.classList.add('text-slate-500','dark:text-slate-400');
      }
    }

    // Importar desde Excel (POST multipart/form-data)
    const importForm = document.getElementById('importForm');
    if (importForm) {
      importForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const fileInput = document.getElementById('excelFile');
        if (!fileInput.files[0]) {
          alert('Por favor selecciona un archivo');
          return;
        }

        // Usa el propio form para no equivocarte en los nombres
        const formData = new FormData(importForm);

        const resultDiv = document.getElementById('importResult');
        resultDiv.style.display = 'block';
        resultDiv.className = 'import-result';
        resultDiv.innerHTML = '<div class="spinner"></div> Importando datos...';

        try {
          const response = await fetch('/blocked/api/import', {
            method: 'POST',
            body: formData
          });

          const result = await response.json();

          if (result.success) {
            resultDiv.className = 'import-result ' + (result.stats.failed > 0 ? 'warning' : 'success');

            let html = `
              <h4 class="font-semibold mb-1">✅ Importación completada</h4>
              <div class="import-stats text-sm">
                <strong>Total:</strong> ${result.stats.total} |
                <strong>Exitosos:</strong> ${result.stats.success} |
                <strong>Fallidos:</strong> ${result.stats.failed}
              </div>
            `;

            if (result.errors && result.errors.length > 0) {
              html += `
                <div class="error-list mt-3 max-h-[150px] overflow-y-auto bg-white rounded-md text-[12px] leading-relaxed border border-slate-200 p-3"
                     style="color:#334155;">
                  <strong class="block mb-2">Errores encontrados:</strong>
                  <ul class="list-none m-0 p-0">
                    ${result.errors.map(e => `<li class="py-1 border-b border-slate-100 last:border-none">${e}</li>`).join('')}
                  </ul>
                </div>
              `;
            }

            resultDiv.innerHTML = html;

            // Limpiar el formulario
            fileInput.value = '';
            const fn = document.getElementById('fileName');
            if (fn) fn.textContent = 'Ningún archivo seleccionado';

            if (result.stats.success > 0) {
              setTimeout(() => window.location.reload(), 3000);
            }
          } else {
            // backend devolvió success=false
            throw new Error(result.error || 'Error desconocido');
          }
        } catch (error) {
          resultDiv.className = 'import-result error';
          let errorMsg = error.message;

          // intentar decodificar detalles si viene como json string
          if (error.message && error.message.includes('details')) {
            try {
              const errorData = JSON.parse(error.message);
              errorMsg = errorData.details.join(', ');
            } catch (e) {}
          }

          resultDiv.innerHTML = `
            <h4 class="font-semibold mb-1">❌ Error en la importación</h4>
            <p class="text-sm">${errorMsg}</p>
          `;
        }
      });
    }

    // Exportar a Excel
    async function exportToExcel() {
      try {
        const response = await fetch('/blocked/api/export');

        if (!response.ok) {
          throw new Error('Error al exportar');
        }

        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `bloqueados_${new Date().toISOString().split('T')[0]}.xlsx`;
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(url);
        document.body.removeChild(a);
      } catch (error) {
        alert('❌ Error al exportar: ' + error.message);
      }
    }

    // Filtrar tabla
    function filterTable() {
      const input = document.getElementById('searchInput');
      const filter = input.value.toLowerCase();
      const table = document.getElementById('blockedTable');
      if (!table) return;

      const tr = table.getElementsByTagName('tr');

      for (let i = 1; i < tr.length; i++) {
        const td = tr[i].getElementsByTagName('td');
        let found = false;

        for (let j = 0; j < td.length - 1; j++) {
          if (td[j].textContent.toLowerCase().indexOf(filter) > -1) {
            found = true;
            break;
          }
        }

        tr[i].style.display = found ? '' : 'none';
      }
    }

    // Agregar bloqueo
    async function addBlock(event) {
      event.preventDefault();

      const identifier = document.getElementById('identifier').value.trim();
      const type = document.getElementById('type').value;
      const reason = document.getElementById('reason').value.trim();

      if (!identifier || !type) {
        alert('Por favor completa los campos requeridos');
        return;
      }

      try {
        const res = await fetch('/blocked/api', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ identifier, type, reason })
        });

        const data = await res.json();

        if (data.success) {
          alert('✅ Bloqueado exitosamente');
          location.reload();
        } else {
          alert('❌ Error: ' + (data.error || 'No se pudo bloquear'));
        }
      } catch (error) {
        alert('❌ Error al bloquear');
        console.error(error);
      }
    }

    // Desbloquear
    async function unblock(identifier) {
      if (!confirm('¿Desbloquear este número/grupo?')) return;

      try {
        const res = await fetch(`/blocked/api/${identifier}`, {
          method: 'DELETE'
        });

        const data = await res.json();

        if (data.success) {
          alert('✅ Desbloqueado exitosamente');
          location.reload();
        } else {
          alert('❌ Error: ' + (data.error || 'No se pudo desbloquear'));
        }
      } catch (error) {
        alert('❌ Error al desbloquear');
        console.error(error);
      }
    }

    // Modal show / hide
    function showModal(modalId) {
      document.getElementById(modalId).style.display = 'block';
    }

    function hideModal(modalId) {
      document.getElementById(modalId).style.display = 'none';
      if (modalId === 'addModal') {
        document.getElementById('identifier').value = '';
        document.getElementById('type').value = '';
        document.getElementById('reason').value = '';
      }
    }

    // Cerrar modal al hacer clic fuera
    window.onclick = function(event) {
      const modals = document.getElementsByClassName('modal');
      for (let modal of modals) {
        if (event.target == modal) {
          modal.style.display = 'none';
        }
      }
    }
  </script>
</body>
</html>
