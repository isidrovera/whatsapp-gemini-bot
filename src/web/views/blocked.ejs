    async function addBlock(event) {
  event.preventDefault();

  const identifier = document.getElementById('identifier').value.trim();
  const type = document.getElementById('type').value;
  const accessLevel = document.getElementById('accessLevel').value;
  const reason = document.getElementById('reason').value.trim();

  // Validaciones frontend
  if (!identifier) {
    alert('⚠️ Por favor ingresa un identificador (número o ID de grupo)');
    document.getElementById('identifier').focus();
    return;
  }

  if (!type) {
    alert('⚠️ Por favor selecciona un tipo (Teléfono o Grupo)');
    document.getElementById('type').focus();
    return;
  }

  if (!accessLevel) {
    alert('⚠️ Por favor selecciona un nivel de acceso');
    document.getElementById('accessLevel').focus();
    return;
  }

  // Preparar payload
  const payload = { 
    identifier, 
    type, 
    accessLevel,
    reason: reason || 'Agregado desde panel web'
  };

  console.log('📤 Enviando restricción:', payload);

  try {
    const res = await fetch('/blocked/api', {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify(payload)
    });

    // Leer respuesta
    const data = await res.json();
    console.log('📥 Respuesta del servidor:', data);

    if (res.ok && data.success) {
      alert('✅ Restricción agregada exitosamente');
      hideModal('addModal');
      setTimeout(() => location.reload(), 500);
    } else {
      const errorMsg = data.error || data.message || 'Error desconocido del servidor';
      alert('❌ Error: ' + errorMsg);
      console.error('Error del servidor:', data);
    }
    
  } catch (error) {
    console.error('💥 Error de conexión:', error);
    alert('❌ Error de conexión. Verifica que el servidor esté funcionando correctamente.\n\nDetalle: ' + error.message);
  }
}
