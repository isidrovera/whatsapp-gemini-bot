<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %> - WhatsApp Bot Admin</title>

  <!-- Fuente -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind (misma config del dashboard) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','ui-sans-serif','system-ui'] },
          colors: {
            primary:   { DEFAULT:'#667eea', 600:'#667eea', 700:'#5a67d8' },
            secondary: { DEFAULT:'#764ba2', 600:'#764ba2', 700:'#6b3fa0' },
          },
          boxShadow: {
            soft:'0 4px 6px -1px rgba(0,0,0,.08), 0 2px 4px -1px rgba(0,0,0,.04)',
            card:'0 10px 30px -5px rgba(0,0,0,.10)'
          }
        }
      },
      darkMode:'media'
    }
  </script>


  <!-- Iconos -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @media (prefers-reduced-motion: reduce){
      *{
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Gradient text */
    .gradient-text {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Icon sizes */
    .icon { width: 1.25rem; height: 1.25rem; }
    .icon-lg { width: 1.75rem; height: 1.75rem; }

    /* Reloj animado */
    @keyframes tick {
      0%, 100% { transform: rotate(0deg); }
      50% { transform: rotate(6deg); }
    }

    .clock-icon {
      animation: tick 2s ease-in-out infinite;
      transform-origin: center;
    }

    /* Status badges */
    .badge-open  { background-color: rgba(16,185,129,.15); color:#059669; }
    .badge-closed { background-color: rgba(244,63,94,.15);  color:#e11d48; }
  </style>
</head>

<body class="h-full bg-gradient-to-br from-slate-50 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 text-slate-800 dark:text-slate-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white dark:focus:bg-slate-900 focus:text-slate-900 dark:focus:text-white focus:px-4 focus:py-2 focus:rounded-lg shadow-lg">
    Saltar al contenido
  </a>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Volver al Dashboard + breadcrumb -->
    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <a href="/"
           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">
          <i data-lucide="arrow-left" class="icon"></i>
          <span>Volver al Dashboard</span>
        </a>
      </div>

      <nav aria-label="Breadcrumb" class="text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li class="inline-flex items-center gap-1">
            <a href="/" class="hover:underline inline-flex items-center gap-1">
              <i data-lucide="home" class="w-3.5 h-3.5"></i> Inicio
            </a>
          </li>
          <li class="select-none">/</li>
          <li class="inline-flex items-center gap-1">
            <i data-lucide="clock" class="w-3.5 h-3.5"></i>
            <span class="font-medium">Horarios de Trabajo</span>
          </li>
        </ol>
      </nav>
    </div>

    <!-- Header -->
    <header class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl rounded-2xl shadow-card border border-slate-200/50 dark:border-white/5 px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight gradient-text flex items-center gap-3">
            <i data-lucide="clock" class="icon-lg text-primary clock-icon"></i>
            Horarios de Trabajo
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            Configura los horarios de atención por día de la semana
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <% if (isWorkingNow) { %>
            <div class="inline-flex items-center gap-2 rounded-xl badge-open px-4 py-2.5 text-sm font-semibold shadow-soft">
              <i data-lucide="check-circle" class="icon"></i>
              <span>Abierto ahora</span>
            </div>
          <% } else { %>
            <div class="inline-flex items-center gap-2 rounded-xl badge-closed px-4 py-2.5 text-sm font-semibold shadow-soft">
              <i data-lucide="x-circle" class="icon"></i>
              <span>Cerrado ahora</span>
            </div>
          <% } %>
        </div>
      </div>
    </header>

    <!-- Info de HOY -->
    <% if (todayHours) { %>
      <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
          <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
            <div class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center">
              <i data-lucide="calendar-days" class="icon text-indigo-600 dark:text-indigo-400"></i>
            </div>
            Horario de Hoy: <%= getDayName(todayHours.dayOfWeek) %>
          </h2>
        </div>

        <div class="p-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <div class="rounded-xl bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-800/50 dark:to-slate-800/30 p-5 shadow-inner border border-slate-200/50 dark:border-white/5">
            <div class="flex items-center gap-3 mb-2">
              <div class="w-10 h-10 rounded-lg bg-white dark:bg-slate-900 flex items-center justify-center shadow-soft">
                <i data-lucide="<%= todayHours.isWorkday ? 'check-circle' : 'x-circle' %>" class="w-5 h-5 <%= todayHours.isWorkday ? 'text-emerald-600' : 'text-rose-600' %>"></i>
              </div>
              <div>
                <div class="text-[10px] uppercase tracking-wide text-slate-500 dark:text-slate-400 font-semibold">
                  Estado
                </div>
                <div class="text-lg font-bold text-slate-900 dark:text-white">
                  <% if (todayHours.isWorkday) { %>Día laboral<% } else { %>Cerrado<% } %>
                </div>
              </div>
            </div>
          </div>

          <% if (todayHours.openTime && todayHours.closeTime) { %>
            <div class="rounded-xl bg-gradient-to-br from-emerald-50 to-emerald-100 dark:from-emerald-900/20 dark:to-emerald-900/10 p-5 shadow-inner border border-emerald-200/50 dark:border-emerald-800/30">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-lg bg-white dark:bg-slate-900 flex items-center justify-center shadow-soft">
                  <i data-lucide="clock" class="w-5 h-5 text-emerald-600"></i>
                </div>
                <div>
                  <div class="text-[10px] uppercase tracking-wide text-emerald-700 dark:text-emerald-400 font-semibold">
                    Horario
                  </div>
                  <div class="text-lg font-bold text-emerald-900 dark:text-emerald-200">
                    <%= todayHours.openTime %> - <%= todayHours.closeTime %>
                  </div>
                </div>
              </div>
            </div>
          <% } %>

          <% if (todayHours.breakStart && todayHours.breakEnd) { %>
            <div class="rounded-xl bg-gradient-to-br from-amber-50 to-amber-100 dark:from-amber-900/20 dark:to-amber-900/10 p-5 shadow-inner border border-amber-200/50 dark:border-amber-800/30">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-lg bg-white dark:bg-slate-900 flex items-center justify-center shadow-soft">
                  <i data-lucide="coffee" class="w-5 h-5 text-amber-600"></i>
                </div>
                <div>
                  <div class="text-[10px] uppercase tracking-wide text-amber-700 dark:text-amber-400 font-semibold">
                    Refrigerio
                  </div>
                  <div class="text-lg font-bold text-amber-900 dark:text-amber-200">
                    <%= todayHours.breakStart %> - <%= todayHours.breakEnd %>
                  </div>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </section>
    <% } %>

    <!-- Configuración Semanal -->
    <section class="rounded-2xl bg-white dark:bg-slate-900 shadow-card border border-slate-200/50 dark:border-white/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 bg-gradient-to-r from-slate-50 to-transparent dark:from-slate-800/50">
        <h2 class="text-lg font-bold flex items-center gap-2.5 text-slate-800 dark:text-white">
          <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center">
            <i data-lucide="calendar-range" class="icon text-blue-600 dark:text-blue-400"></i>
          </div>
          Configuración Semanal
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
          Define los horarios de atención por día, incluyendo refrigerio
        </p>
      </div>

      <div class="p-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        <% hours.forEach(day => { %>
          <div
            class="group relative rounded-xl border shadow-card p-5 bg-white dark:bg-slate-900
                   transition hover:shadow-lg hover:border-indigo-400/60 hover:bg-slate-50/60 dark:hover:bg-white/5
                   <%= day.isWorkday
                        ? 'border-emerald-300/60 dark:border-emerald-600/50'
                        : 'border-rose-300/60 dark:border-rose-600/50 bg-rose-50/30 dark:bg-rose-900/10' %>"
          >
            <!-- Header con día y estado -->
            <div class="flex items-start justify-between gap-3 mb-4">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <div class="w-8 h-8 rounded-lg bg-gradient-to-br <%= day.isWorkday ? 'from-emerald-500 to-emerald-600' : 'from-rose-500 to-rose-600' %> flex items-center justify-center shadow-soft">
                    <i data-lucide="<%= day.isWorkday ? 'check' : 'x' %>" class="w-4 h-4 text-white"></i>
                  </div>
                  <div class="text-base font-bold text-slate-900 dark:text-white">
                    <%= getDayName(day.dayOfWeek) %>
                  </div>
                </div>
                
                <span class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-[11px] font-semibold uppercase tracking-wide
                             <%= day.isWorkday
                                  ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300'
                                  : 'bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300' %>">
                  <%= day.isWorkday ? 'Laboral' : 'Cerrado' %>
                </span>
              </div>

              <button
                class="inline-flex items-center gap-1 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-2.5 py-1.5 text-xs font-medium shadow-soft transition"
                onclick="editDay(<%= day.dayOfWeek %>, '<%= getDayName(day.dayOfWeek) %>')">
                <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                <span>Editar</span>
              </button>
            </div>

            <!-- Horarios (solo si es laboral) -->
            <% if (day.isWorkday) { %>
              <div class="space-y-3">
                <!-- Apertura y Cierre -->
                <div class="grid grid-cols-2 gap-3">
                  <div class="rounded-lg bg-slate-50 dark:bg-white/5 p-3 border border-slate-200/50 dark:border-white/5">
                    <div class="flex items-center gap-2 mb-1">
                      <i data-lucide="sunrise" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400"></i>
                      <div class="text-[10px] uppercase tracking-wide text-slate-500 dark:text-slate-400 font-semibold">
                        Apertura
                      </div>
                    </div>
                    <div class="text-base font-bold text-slate-900 dark:text-white">
                      <%= day.openTime || '-' %>
                    </div>
                  </div>

                  <div class="rounded-lg bg-slate-50 dark:bg-white/5 p-3 border border-slate-200/50 dark:border-white/5">
                    <div class="flex items-center gap-2 mb-1">
                      <i data-lucide="sunset" class="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400"></i>
                      <div class="text-[10px] uppercase tracking-wide text-slate-500 dark:text-slate-400 font-semibold">
                        Cierre
                      </div>
                    </div>
                    <div class="text-base font-bold text-slate-900 dark:text-white">
                      <%= day.closeTime || '-' %>
                    </div>
                  </div>
                </div>

                <!-- Refrigerio (si existe) -->
                <% if (day.breakStart && day.breakEnd) { %>
                  <div class="rounded-lg bg-amber-50 dark:bg-amber-900/20 p-3 border border-amber-200/50 dark:border-amber-800/30">
                    <div class="flex items-center gap-2 mb-2">
                      <i data-lucide="coffee" class="w-3.5 h-3.5 text-amber-600 dark:text-amber-400"></i>
                      <div class="text-[10px] uppercase tracking-wide text-amber-700 dark:text-amber-400 font-semibold">
                        Refrigerio
                      </div>
                    </div>
                    <div class="text-sm font-semibold text-amber-900 dark:text-amber-200">
                      <%= day.breakStart %> - <%= day.breakEnd %>
                    </div>
                  </div>
                <% } else { %>
                  <div class="rounded-lg bg-slate-50 dark:bg-white/5 p-3 border border-slate-200/50 dark:border-white/5">
                    <div class="flex items-center gap-2">
                      <i data-lucide="coffee" class="w-3.5 h-3.5 text-slate-400"></i>
                      <span class="text-xs text-slate-400 italic">Sin refrigerio configurado</span>
                    </div>
                  </div>
                <% } %>
              </div>
            <% } else { %>
              <div class="rounded-lg bg-slate-50 dark:bg-white/5 p-4 border border-slate-200/50 dark:border-white/5 text-center">
                <i data-lucide="moon" class="w-6 h-6 text-slate-400 mx-auto mb-2"></i>
                <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">
                  Día no laboral
                </p>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    </section>
  </main>

  <!-- Modal Editar Horario -->
  <div id="edit-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-card max-w-xl w-[90%] border border-slate-200/70 dark:border-white/10 overflow-hidden max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-slate-200/70 dark:border-white/10 flex items-center justify-between sticky top-0 bg-white dark:bg-slate-900 z-10">
        <h2 class="text-lg font-semibold flex items-center gap-2 text-slate-900 dark:text-white">
          <i data-lucide="pencil" class="icon text-primary"></i>
          <span id="edit-modal-title">Editar Horario</span>
        </h2>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-white" onclick="closeEditModal()">
          <i data-lucide="x" class="icon"></i>
        </button>
      </div>

      <div class="p-6">
        <form onsubmit="updateHours(event)" class="space-y-5">
          <input type="hidden" id="dayOfWeek"/>

          <!-- Día laboral toggle -->
          <div class="rounded-xl bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 p-4">
            <label class="flex items-start gap-3 text-sm font-medium text-slate-700 dark:text-slate-200 cursor-pointer">
              <input type="checkbox" id="isWorkday"
                     class="mt-0.5 h-5 w-5 rounded border-slate-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500"
                     onchange="toggleWorkdayFields()"/>
              <div>
                <span class="font-semibold text-slate-900 dark:text-white">Día laboral</span>
                <span class="block text-xs font-normal text-slate-500 dark:text-slate-400 mt-0.5">
                  Si está desmarcado, se considerará cerrado todo el día
                </span>
              </div>
            </label>
          </div>

          <!-- Campos visibles solo si es laboral -->
          <div id="workdayFields" class="hidden space-y-5">
            <div class="rounded-xl bg-indigo-50 dark:bg-indigo-900/20 border-l-4 border-indigo-500 p-4">
              <div class="flex items-start gap-3">
                <i data-lucide="info" class="w-5 h-5 text-indigo-600 dark:text-indigo-400 flex-shrink-0 mt-0.5"></i>
                <div class="text-sm text-indigo-800 dark:text-indigo-200 leading-relaxed">
                  <strong>Formato de hora:</strong> HH:MM (ej: 08:30, 18:00)
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
                  <i data-lucide="sunrise" class="w-4 h-4 inline mr-1 text-emerald-600"></i>
                  Hora de Apertura *
                </label>
                <input type="time" id="openTime"
                       class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 transition"/>
              </div>

              <div>
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
                  <i data-lucide="sunset" class="w-4 h-4 inline mr-1 text-indigo-600"></i>
                  Hora de Cierre *
                </label>
                <input type="time" id="closeTime"
                       class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 transition"/>
              </div>
            </div>

            <div class="border-t border-slate-200 dark:border-slate-700 pt-5">
              <div class="flex items-center gap-2 mb-4">
                <i data-lucide="coffee" class="w-5 h-5 text-amber-600"></i>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wide">
                  Refrigerio (opcional)
                </h3>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
                    Inicio
                  </label>
                  <input type="time" id="breakStart"
                         class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 transition"/>
                </div>

                <div>
                  <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
                    Fin
                  </label>
                  <input type="time" id="breakEnd"
                         class="w-full rounded-lg border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm outline-none focus:border-indigo-500 transition"/>
                </div>
              </div>
            </div>
          </div>

          <!-- Footer botones -->
          <div class="flex justify-end gap-2 pt-2 border-t border-slate-200 dark:border-slate-700">
            <button type="button"
                    class="rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-sm font-medium px-3 py-2 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white transition"
                    onclick="closeEditModal()">
              Cancelar
            </button>

            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-3 py-2 shadow-soft transition">
              <i data-lucide="save" class="w-4 h-4"></i>
              Guardar Cambios
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    // Iconos
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) lucide.createIcons({ attrs: { 'stroke-width': '1.75' } });
    });

    // === Refs
    const editModal = 'edit-modal';
    const editModalTitle = document.getElementById('edit-modal-title');
    const dayOfWeekEl = document.getElementById('dayOfWeek');
    const isWorkdayEl = document.getElementById('isWorkday');
    const openTimeEl = document.getElementById('openTime');
    const closeTimeEl = document.getElementById('closeTime');
    const breakStartEl = document.getElementById('breakStart');
    const breakEndEl = document.getElementById('breakEnd');
    const workdayFieldsEl = document.getElementById('workdayFields');

    // === Modal helpers
    function openFlex(id){ 
      const el = document.getElementById(id); 
      el.classList.remove('hidden'); 
      el.classList.add('flex'); 
    }
    function closeFlex(id){ 
      const el = document.getElementById(id); 
      el.classList.remove('flex'); 
      el.classList.add('hidden'); 
    }

    // Mostrar/ocultar campos de horario según checkbox
    function toggleWorkdayFields(){
      const isWorkday = isWorkdayEl.checked;
      if (isWorkday){
        workdayFieldsEl.classList.remove('hidden');
      } else {
        workdayFieldsEl.classList.add('hidden');
      }
    }

    // Abrir modal para un día en específico
    async function editDay(dayOfWeek, dayName){
      try {
        const res = await fetch(`/working-hours/api/${dayOfWeek}`);
        const hours = await res.json();

        editModalTitle.textContent = `Editar ${dayName}`;
        dayOfWeekEl.value = dayOfWeek;
        isWorkdayEl.checked = !!hours.isWorkday;
        openTimeEl.value = hours.openTime || '';
        closeTimeEl.value = hours.closeTime || '';
        breakStartEl.value = hours.breakStart || '';
        breakEndEl.value = hours.breakEnd || '';

        toggleWorkdayFields();
        openFlex(editModal);
      } catch (err){
        alert('❌ Error al cargar horario');
        console.error(err);
      }
    }

    function closeEditModal(){
      closeFlex(editModal);
    }

    // Guardar cambios
    async function updateHours(e){
      e.preventDefault();

      const dayOfWeek = dayOfWeekEl.value;
      const isWorkday = isWorkdayEl.checked;

      const data = {
        isWorkday,
        openTime: isWorkday ? openTimeEl.value : null,
        closeTime: isWorkday ? closeTimeEl.value : null,
        breakStart: isWorkday ? (breakStartEl.value || null) : null,
        breakEnd: isWorkday ? (breakEndEl.value || null) : null,
      };

      try {
        const res = await fetch(`/working-hours/api/${dayOfWeek}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();

        if (result.success){
          closeEditModal();
          alert('✅ Horario actualizado');
          location.reload();
        } else {
          alert('❌ Error al actualizar');
        }
      } catch (err){
        alert('❌ Error al actualizar horario');
        console.error(err);
      }
    }

    // Cerrar modales al click fuera
    window.addEventListener('click', (e) => {
      const m = document.getElementById(editModal);
      if (e.target === m) closeFlex(editModal);
    });

    // Exponer funciones
    window.editDay = editDay;
    window.closeEditModal = closeEditModal;
    window.updateHours = updateHours;
    window.toggleWorkdayFields = toggleWorkdayFields;
  </script>
</body>
</html>